# ============================================================
# TikSaveHub — Instagram environment variables
# ============================================================

# These are NOT required for TikTok. They are only used to fetch
# Instagram stories, reels and posts, because Instagram removed
# anonymous (logged-out) access to that content in 2026.

# --- Instagram session (recommended; required for stories) ---
# 1. Log into the Instagram account you want the server to use.
# 2. Open browser DevTools -> Application -> Cookies -> instagram.com
# 3. Copy the VALUE of each cookie below.
#
# Only IG_SESSIONID is required. IG_DS_USER_ID and IG_CSRF_TOKEN
# are optional but help reliability.
#
# IMPORTANT: This account can see everything the account can see.
# Use a dedicated account you don't mind being restricted, since heavy
# usage may get it flagged or rate-limited. Never commit these values.
IG_SESSIONID=
IG_DS_USER_ID=
IG_CSRF_TOKEN=

# --- yt-dlp fallback provider (recommended; used when anonymous fetches fail) ---
# Install yt-dlp on the server (e.g. "apt install yt-dlp" or download the
# binary). If the binary is not on PATH, point to its absolute path.
#
# YTDLP_PATH=/usr/local/bin/yt-dlp
# YTDLP_ENABLED=true
# YTDLP_TIMEOUT_MS=40000
# (optional) feed the session cookie above to yt-dlp automatically via IG_SESSIONID

# --- ffmpeg (MP3 bitrate re-encoding) ---
# Install ffmpeg on the server (e.g. "apt install ffmpeg"). This enables the
# honest bitrate selector (e.g. 96/128 kbps) on the TikTok → MP3 converter.
# The options shown never exceed the source audio's real bitrate.
#
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# FFMPEG_ENABLED=true
# FFPROBE_TIMEOUT_MS=20000

# --- Server port (Astro dev / preview) ---
# PORT=3000

# --- Media cache (persistent KV, stored on disk) ---
# Results are cached for repeated URLs so heavy extraction (tikwm / yt-dlp)
# only happens once per canonical link.
#
# CACHE_FILE=/var/lib/tiksavehub/media-cache.json
# CACHE_MAX_ENTRIES=2000
# MEDIA_TTL_MS=86400000            # 24h — TikTok
# INSTAGRAM_MEDIA_TTL_MS=43200000  # 12h — Instagram
# YTDLP_TTL_MS=172800000           # 48h — yt-dlp results
# MAX_CACHE_AGE_MS=172800000       # hard ceiling, 48h

# --- Rate limiting (per IP per minute, 0 disables) ---
# RATE_LIMIT_PER_MIN=30

# --- IndexNow (Bing / Google / Yandex / Seznam / Naver instant indexing) ---
# The proof key file lives at public/{key}.txt (served at the domain root).
# URL list is published via `npm run indexnow`. Optional override.
# INDEXNOW_KEY=d36fb3cc3f7e47c3baf2c076c12899da

# --- Google Indexing API (instant indexing for new pages/blog posts) ---
# 1. Google Cloud Console: enable the "Web Search Indexing API"
#    https://console.cloud.google.com/apis/library/indexing.googleapis.com
# 2. Create a Service Account -> add a JSON key, save it as service-account.json
# 3. In Google Search Console, add the service account email as an owner
#    (Settings -> Users and permissions) for https://tiksavehub.com
# 4. Run: npm run google-index  (or: npm run google-index -- --urls=/new-page)
# GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
# GOOGLE_INDEXING_TYPE=URL_UPDATED   # or URL_DELETED