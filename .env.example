# ============================================================
# TikSaveHub — Processor Backend (Cloudflare Workers proxy)
# ============================================================

# When deploying to Cloudflare Workers, heavy processing (yt-dlp, ffmpeg)
# must be proxied through a separate VPS/origin server because CF Workers
# cannot run child_process. Set this to your backend URL.
# The backend runs the same Node.js server but is NOT behind CF proxy.
# Example: https://api.tiksavehub.com or http://your-vps-ip:3001
#
# PROCESSOR_BACKEND_URL=

# ============================================================
# TikSaveHub — Instagram environment variables
# ============================================================

# These are NOT required for TikTok. They are only used to fetch
# Instagram stories, reels and posts, because Instagram removed
# anonymous (logged-out) access to that content in 2026.

# --- Instagram session (REQUIRED for story downloads; recommended for reels) ---
# Instagram removed anonymous story access in 2025-2026: the story page is a JS
# shell, the public GraphQL endpoints are dead, and the private API returns
# 403/empty to guests. EVERY working story downloader runs a logged-in session
# server-side — this app is no different. WITHOUT these variables the
# story tool cannot work (it returns a fast, honest message instead).
#
# ─── Cookie Pooling (NEW — recommended) ───────────────────────────────
# Provide 2+ cookies from different aged accounts to distribute load and
# prevent bans.  The system uses round-robin rotation and auto-fallback:
# if Cookie 1 fails (401/429/checkpoint), Cookie 2 is tried instantly.
#
# IG_COOKIE_1 and IG_COOKIE_2 each hold a FULL cookie jar string (the same
# format as IG_COOKIES below).  You can also add IG_COOKIE_3 / IG_COOKIE_4.
# When IG_COOKIE_* are set they take priority over the legacy IG_COOKIES var.
#
# How to get each cookie jar:
#   1. Log into Account A in Chrome (incognito recommended for Account B)
#   2. DevTools (F12) -> Network -> refresh instagram.com
#   3. Right-click the "www.instagram.com" request -> Copy as cURL (bash)
#   4. Inside the copied text find `cookie: '...'` — paste that WHOLE string
#      into IG_COOKIE_1 (Account A) and IG_COOKIE_2 (Account B).
#
# ─── Legacy single-cookie setup (still works, backward compatible) ─────
# If you only have one cookie, set IG_COOKIES (full jar) or the three
# individual vars below.  The pool auto-detects single-cookie mode.
#
# How to get the cookies (single account):
# OPTION A (recommended — full cookie jar, most reliable in 2026):
#   1. Log into the Instagram account you want the server to use (a dedicated
#      burner account is recommended — heavy usage can get it flagged).
#   2. Open DevTools (F12) -> Network tab -> refresh instagram.com
#   3. Right-click the "www.instagram.com" request -> Copy -> "Copy as cURL (bash)"
#   4. Inside the copied text find `cookie: '...'` — paste that WHOLE string
#      into IG_COOKIES below (it contains ~15 cookies: sessionid, mid, ig_did,
#      rur, datr...). Instagram's API now rejects partial cookie sets with 403.
# OPTION B (minimum): Application -> Cookies -> instagram.com, copy the VALUE
#   (the part AFTER the =) of each cookie.
#
# IMPORTANT: These accounts can see everything the account can see.
# Never commit these values.
IG_COOKIE_1=
IG_COOKIE_2=
# IG_COOKIE_3=
# IG_COOKIE_4=
IG_SESSIONID=
IG_DS_USER_ID=
IG_CSRF_TOKEN=
IG_COOKIES=

# Quick check that the session is wired up (restart the server first):
#   Invoke-RestMethod "http://localhost:3000/api/instagram-download?url=https://www.instagram.com/stories/someuser/1234567890123456789/&type=story"
# A 200 + media URL = working. A "protected content" message = session missing/expired.

# ============================================================
# TikSaveHub — Facebook environment variables
# ============================================================

# Facebook cookies enable authenticated page fetches, bypassing login walls
# and IP-based rate limits. This makes the Facebook downloader faster and
# more reliable, especially on flagged/VPS IPs.
#
# How to get the cookies:
#   1. Log into Facebook in Chrome
#   2. Open DevTools (F12) -> Network tab -> visit any Facebook page
#   3. Right-click any request -> Copy -> "Copy as cURL (bash)"
#   4. Paste the full command here — or copy just the cookie value:
#      Application -> Cookies -> facebook.com -> copy all cookies
#
# Required cookies: c_user, xs, datr (the rest are optional but recommended)
FB_COOKIES=

# --- yt-dlp fallback provider (recommended; used when anonymous fetches fail) ---
# Install yt-dlp on the server (e.g. "apt install yt-dlp" or download the
# binary). If the binary is not on PATH, point to its absolute path.
#
# YTDLP_PATH=/usr/local/bin/yt-dlp
# YTDLP_ENABLED=true
# YTDLP_TIMEOUT_MS=40000
# (optional) feed the session cookie above to yt-dlp automatically via IG_SESSIONID

# --- ffmpeg (MP3 bitrate re-encoding) ---
# Install ffmpeg on the server (e.g. "apt install ffmpeg"). This enables the
# honest bitrate selector (e.g. 96/128 kbps) on the TikTok → MP3 converter.
# The options shown never exceed the source audio's real bitrate.
#
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# FFMPEG_ENABLED=true
# FFPROBE_TIMEOUT_MS=20000

# --- Server port (Astro dev / preview) ---
# PORT=3000

# --- Media cache (persistent KV, stored on disk) ---
# Results are cached for repeated URLs so heavy extraction (tikwm / yt-dlp)
# only happens once per canonical link.
#
# CACHE_FILE=/var/lib/tiksavehub/media-cache.json
# CACHE_MAX_ENTRIES=2000
# MEDIA_TTL_MS=86400000            # 24h — TikTok
# INSTAGRAM_MEDIA_TTL_MS=43200000  # 12h — Instagram
# YTDLP_TTL_MS=172800000           # 48h — yt-dlp results
# MAX_CACHE_AGE_MS=172800000       # hard ceiling, 48h

# --- Rate limiting (per IP per minute, 0 disables) ---
# RATE_LIMIT_PER_MIN=30

# --- IndexNow (Bing / Google / Yandex / Seznam / Naver instant indexing) ---
# The proof key file lives at public/{key}.txt (served at the domain root).
# URL list is published via `npm run indexnow`. Optional override.
# INDEXNOW_KEY=d36fb3cc3f7e47c3baf2c076c12899da

# --- Google Indexing API (instant indexing for new pages/blog posts) ---
# 1. Google Cloud Console: enable the "Web Search Indexing API"
#    https://console.cloud.google.com/apis/library/indexing.googleapis.com
# 2. Create a Service Account -> add a JSON key, save it as service-account.json
# 3. In Google Search Console, add the service account email as an owner
#    (Settings -> Users and permissions) for https://tiksavehub.com
# 4. Run: npm run google-index  (or: npm run google-index -- --urls=/new-page)
# GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
# GOOGLE_INDEXING_TYPE=URL_UPDATED   # or URL_DELETED

# ============================================================
# TikSaveHub — Email Notifications (cookie expiry alerts)
# ============================================================

# Get email alerts when Instagram cookies expire or are about to expire.
# The server checks cookie health every 6 hours and sends an email if
# something needs attention.
#
# Gmail setup (recommended, free):
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Generate an App Password for "Mail" (requires 2FA enabled)
#   3. Paste the 16-char password below as SMTP_PASS
#
# Outlook/Hotmail setup:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#
# Or custom SMTP:
#   Just fill in your SMTP server details below.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
NOTIFY_TO=your-email@gmail.com

# --- Cookie health thresholds (optional) ---
# COOKIE_HEALTH_CHECK_INTERVAL_MS=21600000   # 6h — alert checks (only emails on problems)
# COOKIE_DAILY_REPORT_INTERVAL_MS=86400000   # 24h — daily report (always emails full status)
# COOKIE_WARN_DAYS=75                         # warn when cookie > 75d old
# COOKIE_CRITICAL_DAYS=85                     # critical when > 85d old
# COOKIE_HEALTH_FILE=/var/lib/tiksavehub/cookie-health.json