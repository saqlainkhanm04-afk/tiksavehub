# ============================================================
# TikSaveHub — PRODUCTION environment (fill in + save as .env.production)
# ------------------------------------------------------------
# IMPORTANT: the Node standalone server does NOT auto-load .env files.
# These variables must reach the process — recommended path: copy this
# file to /etc/tiksavehub/env (chmod 600) and let the systemd unit load
# it via `EnvironmentFile` (see deploy/tiksavehub.service).
# ============================================================

# ---- Instagram session (recommended; REQUIRED for stories) ----
# Get the cookies from a browser logged into the IG account the server
# will impersonate (DevTools -> Application -> Cookies -> instagram.com).
# Only IG_SESSIONID is required; the other two improve reliability.
IG_SESSIONID=
IG_DS_USER_ID=
IG_CSRF_TOKEN=

# ---- yt-dlp fallback provider ----
# Installed by scripts/setup-server.sh to /usr/local/bin/yt-dlp.
# Keep it updated on the server: sudo yt-dlp -U
YTDLP_PATH=/usr/local/bin/yt-dlp
YTDLP_ENABLED=true
YTDLP_TIMEOUT_MS=40000

# ---- ffmpeg (MP3 bitrate re-encode) ----
# Installed by apt in scripts/setup-server.sh.
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_ENABLED=true
FFPROBE_TIMEOUT_MS=20000

# ---- Media cache ----
# MUST live outside the deploy directory (dist/ is wiped on every
# redeploy). scripts/setup-server.sh creates /var/lib/tiksavehub.
CACHE_FILE=/var/lib/tiksavehub/media-cache.json
CACHE_MAX_ENTRIES=2000
MEDIA_TTL_MS=86400000            # 24h — TikTok
INSTAGRAM_MEDIA_TTL_MS=43200000  # 12h — Instagram
YTDLP_TTL_MS=172800000           # 48h — yt-dlp results
MAX_CACHE_AGE_MS=172800000       # hard ceiling, 48h

# ---- Server ----
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# ---- Rate limiting (per IP per minute, 0 disables) ----
RATE_LIMIT_PER_MIN=30

# ---- IndexNow key (public proof file, not a secret) ----
INDEXNOW_KEY=d36fb3cc3f7e47c3baf2c076c12899da