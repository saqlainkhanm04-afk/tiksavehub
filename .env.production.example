# ============================================================
# TikSaveHub — PRODUCTION environment (fill in + save as .env.production)
# ------------------------------------------------------------
# IMPORTANT: the Node standalone server does NOT auto-load .env files.
# These variables must reach the process — recommended path: copy this
# file to /etc/tiksavehub/env (chmod 600) and let the systemd unit load
# it via `EnvironmentFile` (see deploy/tiksavehub.service).
# ============================================================

# ---- Instagram session (REQUIRED for story downloads; recommended for reels) ----
# Instagram removed anonymous story access (2025-2026): story pages are JS
# shells, public GraphQL is dead, private API 403s to guests. Every story
# downloader keeps a logged-in session server-side — this app needs the same.
# A dedicated burner account is recommended. Without these, the story tool
# returns a fast honest "protected content" message instead of working.
#
# ─── Cookie Pooling (recommended for production) ──────────────────────
# Provide 2+ cookies from different aged accounts to distribute load and
# prevent bans.  Round-robin rotation + auto-fallback on 401/429/checkpoint.
#
# IG_COOKIE_1 and IG_COOKIE_2 each hold a FULL cookie jar string (same format
# as IG_COOKIES below).  IG_COOKIE_3/IG_COOKIE_4 also supported.
# When IG_COOKIE_* are set they take priority over IG_COOKIES.
#
# How to get each cookie jar:
#   1. Log into Account A in Chrome (incognito for Account B)
#   2. DevTools (F12) -> Network -> refresh instagram.com
#   3. Right-click the "www.instagram.com" request -> Copy as cURL (bash)
#   4. Paste the `cookie: '...'` value into IG_COOKIE_1 / IG_COOKIE_2.
#
# ─── Legacy single-cookie setup (backward compatible) ─────────────────
# If only one cookie is available, set IG_COOKIES or the three individual vars.
#
# How to get the cookies (single account):
# OPTION A (recommended — full cookie jar): DevTools -> Network -> refresh
# instagram.com -> right-click the www.instagram.com request -> Copy as cURL ->
# paste the whole `cookie: '...'` value into IG_COOKIES (it has ~15 cookies:
# sessionid, mid, ig_did, rur, datr...). Partial cookie sets get 403 in 2026.
# OPTION B (minimum): DevTools -> Application -> Cookies -> instagram.com,
# copy each value (the part AFTER the =).
IG_COOKIE_1=
IG_COOKIE_2=
# IG_COOKIE_3=
# IG_COOKIE_4=
IG_SESSIONID=
IG_DS_USER_ID=
IG_CSRF_TOKEN=
IG_COOKIES=

# ---- yt-dlp fallback provider ----
# Installed by scripts/setup-server.sh to /usr/local/bin/yt-dlp.
# Keep it updated on the server: sudo yt-dlp -U
YTDLP_PATH=/usr/local/bin/yt-dlp
YTDLP_ENABLED=true
YTDLP_TIMEOUT_MS=40000

# ---- ffmpeg (MP3 bitrate re-encode) ----
# Installed by apt in scripts/setup-server.sh.
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_ENABLED=true
FFPROBE_TIMEOUT_MS=20000

# ---- Media cache ----
# MUST live outside the deploy directory (dist/ is wiped on every
# redeploy). scripts/setup-server.sh creates /var/lib/tiksavehub.
CACHE_FILE=/var/lib/tiksavehub/media-cache.json
CACHE_MAX_ENTRIES=2000
MEDIA_TTL_MS=86400000            # 24h — TikTok
INSTAGRAM_MEDIA_TTL_MS=43200000  # 12h — Instagram
YTDLP_TTL_MS=172800000           # 48h — yt-dlp results
MAX_CACHE_AGE_MS=172800000       # hard ceiling, 48h

# ---- Server ----
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# ---- Rate limiting (per IP per minute, 0 disables) ----
RATE_LIMIT_PER_MIN=30

# ---- IndexNow key (public proof file, not a secret) ----
INDEXNOW_KEY=d36fb3cc3f7e47c3baf2c076c12899da