# The sitemap integration emits sitemap-index.xml + sitemap-0.xml (never /sitemap.xml).
# External tools and old GSC properties assume /sitemap.xml, so point them at the real index.
/sitemap.xml /sitemap-index.xml 301

/tiktok-video-downloader /tiktok-video-downloader-without-watermark 301
/instagram-reels-downloader /instagram-reels-downloader-without-watermark 301
/instagram-video-downloader /instagram-video-downloader-without-watermark 301
/instagram-story-downloader /instagram-story-downloader-without-watermark 301

# Keyword-cannibalization cleanup: the two TikTok blog posts now target
# informational / long-tail keywords instead of the product keyword.
/blog/tiktok-video-downloader-without-watermark /blog/how-to-download-tiktok-videos 301
/blog/best-tiktok-video-downloader-2026 /blog/tiktok-downloader-troubleshooting 301

# Canonicalisation: trailingSlash: 'never' — any URL that ends in "/" 301s to
# the slash-less canonical (never 307). `*` swallows everything before the final
# slash, so "/blog/" -> "/blog", "/de/tiktok-to-mp3/" -> "/de/tiktok-to-mp3".
# "/" itself does not match (the pattern needs two slashes).
/*/ /:splat 301

# Localized Snapchat blog posts now live under /{lang}/blog/{slug} as real pages.
# Unknown localized blog slugs are redirected to English by src/middleware.ts
# (resolvePathRedirect) — do NOT add a blanket /de/blog/* -> /blog/* rule here,
# it would 301 the real localized posts.

# Double locale prefix (Google crawled /de/de/... from pre-prefixed links)
/de/de/* /de/:splat 301
/es/es/* /es/:splat 301
/ja/ja/* /ja/:splat 301
/fr/fr/* /fr/:splat 301
/it/it/* /it/:splat 301
/pt/pt/* /pt/:splat 301
/ko/ko/* /ko/:splat 301
