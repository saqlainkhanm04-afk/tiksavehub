---
import Layout from '../layouts/Layout.astro';
import SocialShare from './SocialShare.astro';

export interface CompareTool {
  name: string;
  href: string;
  tagline: string;
}

export interface CompareRow {
  label: string;
  a: string;
  b: string;
  winner?: 'a' | 'b';
}

export interface CompareBlock {
  id: string;
  eyebrow: string;
  headline: string;
  body: string[];
  points?: { term: string; text: string }[];
}

export interface CompareFaq {
  id: string;
  q: string;
  a: string;
}

export interface Props {
  canonical: string;
  title: string;
  description: string;
  keywords: string;
  eyebrow: string;
  headline: string;
  lede: string;
  a: CompareTool;
  b: CompareTool;
  tableHeadline: string;
  tableSub: string;
  rows: CompareRow[];
  tableNote: string;
  blocks: CompareBlock[];
  verdictEyebrow: string;
  verdictHeadline: string;
  verdict: string[];
  faqs: CompareFaq[];
  ctaHeadline: string;
  ctaText: string;
  ctaLabel: string;
}

const {
  canonical,
  title,
  description,
  keywords,
  eyebrow,
  headline,
  lede,
  a,
  b,
  tableHeadline,
  tableSub,
  rows,
  tableNote,
  blocks,
  verdictEyebrow,
  verdictHeadline,
  verdict,
  faqs,
  ctaHeadline,
  ctaText,
  ctaLabel,
} = Astro.props;

const ctaHref = '/snapchat-downloader';
const site = String(Astro.site ?? 'https://tiksavehub.com').replace(/\/+$/, '');
const pageUrl = new URL(canonical, site).toString();
const plain = (html: string) => html.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: plain(f.a) },
      })),
    },
    {
      '@type': 'ItemList',
      name: `${a.name} vs ${b.name}`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: a.name, url: new URL(a.href, site).toString() },
        { '@type': 'ListItem', position: 2, name: b.name, url: new URL(b.href, site).toString() },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site },
        { '@type': 'ListItem', position: 2, name: headline, item: pageUrl },
      ],
    },
  ],
});
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  ogImage="/og-downloader.png"
  jsonLd={jsonLd}
  skipSoftwareApp
  localizedHreflang={false}
  platform="snapchat"
>
  <!-- Hero -->
  <section class="cmp-hero" aria-labelledby="cmp-headline">
    <div class="cmp-hero-inner container-page">
      <span class="cmp-eyebrow text-caption-mono">{eyebrow}</span>
      <h1 id="cmp-headline" class="cmp-h1">{headline}</h1>
      <p class="cmp-lede text-body-lg">{lede}</p>

      <div class="cmp-tools">
        <a class="cmp-tool" href={a.href}>
          <span class="cmp-tool-role text-caption-mono">Option A</span>
          <span class="cmp-tool-name">{a.name}</span>
          <span class="cmp-tool-tagline">{a.tagline}</span>
          <span class="cmp-tool-cta">Open this tool
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>
        <span class="cmp-vs" aria-hidden="true">vs</span>
        <a class="cmp-tool" href={b.href}>
          <span class="cmp-tool-role text-caption-mono">Option B</span>
          <span class="cmp-tool-name">{b.name}</span>
          <span class="cmp-tool-tagline">{b.tagline}</span>
          <span class="cmp-tool-cta">Open this resource
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section class="cmp-section cmp-band-soft" aria-labelledby="cmp-table-headline">
    <div class="cmp-inner container-page">
      <header class="cmp-header">
        <span class="cmp-eyebrow text-caption-mono">Side by side</span>
        <h2 id="cmp-table-headline" class="cmp-headline">{tableHeadline}</h2>
        <p class="cmp-sub text-body-lg">{tableSub}</p>
      </header>

      <div class="cmp-table-wrap" role="region" aria-label={`Comparison table: ${a.name} versus ${b.name}`} tabindex="0">
        <table class="cmp-table">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col"><a href={a.href}>{a.name}</a></th>
              <th scope="col"><a href={b.href}>{b.name}</a></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td class={row.winner === 'a' ? 'cmp-win' : undefined}>{row.a}</td>
                <td class={row.winner === 'b' ? 'cmp-win' : undefined}>{row.b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cmp-note">{tableNote}</p>
    </div>
  </section>

  <!-- Deep-dive blocks -->
  <section class="cmp-section" aria-label="Detailed comparison">
    <div class="cmp-inner container-page">
      {blocks.map((block) => (
        <div class="cmp-block" id={block.id}>
          <header class="cmp-block-header">
            <span class="cmp-eyebrow text-caption-mono">{block.eyebrow}</span>
            <h2 class="cmp-headline cmp-headline-left">{block.headline}</h2>
          </header>
          {block.body.map((p) => (
            <p class="cmp-p">{p}</p>
          ))}
          {block.points && (
            <ul class="cmp-points">
              {block.points.map((point) => (
                <li class="cmp-point">
                  <span class="cmp-point-term">{point.term}</span>
                  <span class="cmp-point-text">{point.text}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Verdict -->
  <section class="cmp-section cmp-band-soft" aria-labelledby="cmp-verdict-headline">
    <div class="cmp-inner container-page">
      <div class="cmp-verdict">
        <span class="cmp-eyebrow text-caption-mono">{verdictEyebrow}</span>
        <h2 id="cmp-verdict-headline" class="cmp-headline cmp-headline-left">{verdictHeadline}</h2>
        {verdict.map((p) => (
          <p class="cmp-p" set:html={p} />
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="cmp-section" aria-labelledby="cmp-faq-headline">
    <div class="cmp-inner container-page">
      <header class="cmp-header">
        <span class="cmp-eyebrow text-caption-mono">FAQ</span>
        <h2 id="cmp-faq-headline" class="cmp-headline">Frequently asked questions.</h2>
      </header>

      <div class="cmp-faq-list" role="list">
        {faqs.map((faq) => (
          <div class="cmp-faq-item" role="listitem">
            <button class="cmp-faq-trigger" type="button" aria-expanded="false" aria-controls={`${faq.id}-panel`}>
              <span class="cmp-faq-q">{faq.q}</span>
              <span class="cmp-faq-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </button>
            <div id={`${faq.id}-panel`} class="cmp-faq-panel" role="region" hidden>
              <p class="cmp-faq-a" set:html={faq.a}></p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cmp-cta" aria-labelledby="cmp-cta-headline">
    <div class="cmp-cta-inner container-page">
      <h2 id="cmp-cta-headline" class="cmp-cta-headline">{ctaHeadline}</h2>
      <p class="cmp-cta-sub">{ctaText}</p>
      <a href={ctaHref} class="btn-primary cmp-cta-btn">
        {ctaLabel}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <div class="cmp-share container-page">
    <SocialShare url={canonical} title={title} description={description} image="/og-downloader.png" />
  </div>

  <script>
    const cmpTriggers = document.querySelectorAll<HTMLButtonElement>('.cmp-faq-trigger');

    cmpTriggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        const panel = document.getElementById(btn.getAttribute('aria-controls') || '');

        cmpTriggers.forEach((otherBtn) => {
          if (otherBtn !== btn) {
            otherBtn.setAttribute('aria-expanded', 'false');
            const otherId = otherBtn.getAttribute('aria-controls') || '';
            if (otherId) document.getElementById(otherId)?.setAttribute('hidden', '');
          }
        });

        if (isOpen) {
          btn.setAttribute('aria-expanded', 'false');
          panel?.setAttribute('hidden', '');
        } else {
          btn.setAttribute('aria-expanded', 'true');
          panel?.removeAttribute('hidden');
        }
      });
    });
  </script>
</Layout>

<style>
  .cmp-hero {
    background-color: var(--color-canvas);
    padding: var(--spacing-4xl) var(--spacing-lg) var(--spacing-5xl);
    text-align: center;
    border-bottom: 1px solid var(--color-hairline);
  }

  .cmp-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
  }

  .cmp-eyebrow {
    display: block;
    color: var(--color-mute);
  }

  .cmp-h1 {
    font-size: var(--text-display-xl);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -2.4px;
    color: var(--color-ink);
    margin: 0;
    max-width: 820px;
  }

  .cmp-lede {
    color: var(--color-body);
    margin: 0;
    max-width: 680px;
  }

  .cmp-tools {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-xl);
    width: 100%;
    max-width: 880px;
  }

  .cmp-tool {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-xs);
    text-align: left;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    text-decoration: none;
    color: inherit;
    box-shadow: 0px 1px 1px #00000005, 0px 2px 2px #0000000a;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .cmp-tool:hover {
    transform: translateY(-3px);
    border-color: var(--color-hairline);
    box-shadow: 0px 2px 2px #0000000a, 0px 8px 16px -4px #0000001a;
  }

  .cmp-tool:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .cmp-tool-role {
    color: var(--color-mute);
  }

  .cmp-tool-name {
    font-size: var(--text-body-lg);
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .cmp-tool-tagline {
    font-size: var(--text-body-sm);
    color: var(--color-body);
    line-height: 1.5;
  }

  .cmp-tool-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--spacing-xs);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-link);
  }

  .cmp-vs {
    align-self: center;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 0 var(--spacing-sm);
    border-radius: var(--radius-pill);
    background-color: var(--color-ink);
    color: var(--color-on-primary);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cmp-section {
    padding: var(--spacing-4xl) var(--spacing-lg);
  }

  .cmp-band-soft {
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }

  .cmp-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .cmp-headline {
    font-size: var(--text-display-lg);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -1.28px;
    color: var(--color-ink);
    margin: 0;
    max-width: 640px;
  }

  .cmp-headline-left {
    text-align: left;
    max-width: 720px;
  }

  .cmp-sub {
    color: var(--color-body);
    margin: 0;
    max-width: 640px;
  }

  /* Table */
  .cmp-table-wrap {
    width: 100%;
    overflow-x: auto;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: 0px 1px 1px #00000005, 0px 2px 2px #0000000a;
  }

  .cmp-table-wrap:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .cmp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-body-sm);
    text-align: left;
    min-width: 560px;
  }

  .cmp-table thead th {
    padding: var(--spacing-md);
    font-weight: 600;
    color: var(--color-ink);
    background-color: var(--color-canvas-soft);
    border-bottom: 2px solid var(--color-hairline);
    white-space: nowrap;
  }

  .cmp-table thead th a {
    color: inherit;
    text-decoration: none;
  }

  .cmp-table thead th a:hover {
    color: var(--color-link);
    text-decoration: underline;
  }

  .cmp-table tbody th {
    padding: var(--spacing-md);
    font-weight: 500;
    color: var(--color-body);
    border-bottom: 1px solid var(--color-hairline);
    vertical-align: top;
  }

  .cmp-table tbody td {
    padding: var(--spacing-md);
    color: var(--color-body);
    border-bottom: 1px solid var(--color-hairline);
    vertical-align: top;
  }

  .cmp-table tbody tr:last-child th,
  .cmp-table tbody tr:last-child td {
    border-bottom: none;
  }

  .cmp-table tbody td.cmp-win {
    color: var(--color-ink);
    font-weight: 500;
  }

  .cmp-note {
    color: var(--color-body);
    font-size: var(--text-body-sm);
    line-height: 1.7;
    margin: var(--spacing-lg) 0 0 0;
    max-width: 820px;
  }

  /* Deep-dive blocks */
  .cmp-block + .cmp-block {
    margin-top: var(--spacing-3xl);
    padding-top: var(--spacing-3xl);
    border-top: 1px solid var(--color-hairline);
  }

  .cmp-block-header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }

  .cmp-p {
    font-size: var(--text-body-md);
    line-height: 1.75;
    color: var(--color-body);
    margin: 0 0 var(--spacing-md) 0;
    max-width: 760px;
  }

  .cmp-p:last-child {
    margin-bottom: 0;
  }

  .cmp-p :global(a) {
    color: var(--color-link);
  }

  .cmp-points {
    list-style: none;
    margin: var(--spacing-lg) 0 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
    max-width: 900px;
  }

  .cmp-point {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
  }

  .cmp-point-term {
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-ink);
  }

  .cmp-point-text {
    font-size: var(--text-body-sm);
    line-height: 1.55;
    color: var(--color-body);
  }

  /* Verdict */
  .cmp-verdict {
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: var(--spacing-2xl);
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    box-shadow: 0px 1px 1px #00000005, 0px 2px 2px #0000000a;
  }

  .cmp-verdict .cmp-eyebrow {
    margin-bottom: 0;
  }

  /* FAQ */
  .cmp-faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    max-width: 820px;
    margin: 0 auto;
  }

  .cmp-faq-item {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .cmp-faq-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    width: 100%;
    padding: var(--spacing-md);
    min-height: 48px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: var(--color-ink);
  }

  .cmp-faq-trigger:hover {
    background-color: var(--color-canvas-soft);
  }

  .cmp-faq-trigger:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: -2px;
  }

  .cmp-faq-q {
    font-size: var(--text-body-md);
    font-weight: 600;
    line-height: 1.4;
  }

  .cmp-faq-chevron {
    flex: 0 0 auto;
    display: inline-flex;
    color: var(--color-mute);
    transition: transform 0.2s ease;
  }

  .cmp-faq-trigger[aria-expanded='true'] .cmp-faq-chevron {
    transform: rotate(180deg);
  }

  .cmp-faq-panel {
    padding: 0 var(--spacing-md) var(--spacing-md) var(--spacing-md);
  }

  .cmp-faq-a {
    font-size: var(--text-body-md);
    line-height: 1.7;
    color: var(--color-body);
    margin: 0;
  }

  .cmp-faq-a :global(a) {
    color: var(--color-link);
  }

  /* CTA */
  .cmp-cta {
    background-color: var(--color-ink);
    color: var(--color-on-primary);
    padding: var(--spacing-5xl) var(--spacing-lg);
    text-align: center;
  }

  .cmp-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .cmp-cta-headline {
    font-size: var(--text-display-lg);
    font-weight: 600;
    letter-spacing: -1.28px;
    color: var(--color-on-primary);
    margin: 0;
  }

  .cmp-cta-sub {
    font-size: var(--text-body-lg);
    color: color-mix(in srgb, var(--color-on-primary), transparent 40%);
    margin: 0;
    max-width: 520px;
  }

  .cmp-cta-btn {
    gap: 8px;
    background-color: var(--color-canvas) !important;
    color: var(--color-ink) !important;
  }

  .cmp-cta-btn:hover {
    background-color: var(--color-canvas-soft) !important;
    transform: translateY(-2px);
  }

  .cmp-share {
    padding: var(--spacing-3xl) var(--spacing-lg);
    text-align: center;
  }

  @media (max-width: 760px) {
    .cmp-h1 {
      font-size: var(--text-display-lg);
      letter-spacing: -1.28px;
    }

    .cmp-tools {
      flex-direction: column;
    }

    .cmp-vs {
      align-self: center;
    }

    .cmp-points {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .cmp-hero {
      padding: var(--spacing-3xl) var(--spacing-md) var(--spacing-4xl);
    }

    .cmp-section {
      padding: var(--spacing-3xl) var(--spacing-md);
    }

    .cmp-verdict {
      padding: var(--spacing-lg);
    }

    .cmp-cta {
      padding: var(--spacing-3xl) var(--spacing-md);
    }
  }
</style>
