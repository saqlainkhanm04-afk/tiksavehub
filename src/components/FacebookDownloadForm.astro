<script is:inline>
  (function initFacebookFormLazy() {
    var trigger = document.getElementById('download-form') || document.querySelector('.download-form-section');
    if (!trigger) return;
    var loaded = false;
    var obs = new IntersectionObserver(function(entries) {
      if (!loaded && entries.some(function(e) { return e.isIntersecting; })) {
        loaded = true;
        obs.disconnect();
        var s = document.createElement('script');
        s.src = '/scripts/facebook-form.js';
        s.type = 'module';
        document.body.appendChild(s);
      }
    }, { rootMargin: '200px' });
    obs.observe(trigger);
  })();
</script>