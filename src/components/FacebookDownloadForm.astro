---
// FacebookDownloadForm — interactive Facebook video URL input with fetch & result rendering
// Supports Reels, Watch links, video posts, fb.watch short links and mobile hosts.
// API: POST /api/facebook (metadata) + GET /api/facebook?url=&dl= (file download).
// mode: 'video' (default) | 'reels' | 'story' | 'mp3' — adjusts copy and, for mp3,
// promotes the Audio tile to first position with a Recommended badge.
interface Props {
  mode?: 'video' | 'reels' | 'story' | 'mp3' | 'photo';
  lang?: string;
}

const { mode = 'video', lang = 'en' } = Astro.props;

const photoTips: Record<string, string> = {
  en: '<strong>Tip:</strong> For albums with multiple photos, paste the direct link of each photo individually. To get this: open the photo in your browser, then copy the URL from the address bar (not the "Share" button link) — then paste that here.',
  es: '<strong>Consejo:</strong> Para álbumes con varias fotos, pega el enlace directo de cada foto individualmente. Para obtenerlo: abre la foto en tu navegador, luego copia la URL de la barra de direcciones (no el enlace del botón "Compartir") — y pégalo aquí.',
  ja: '<strong>ヒント:</strong> 複数の写真が含まれるアルバムの場合、各写真の直接リンクを個別に貼り付けてください。取得方法: ブラウザで写真を開き、アドレスバーからURLをコピーします（「共有」ボタンのリンクではありません）— そこに貼り付けます。',
  fr: '<strong>Astuce :</strong> Pour les albums avec plusieurs photos, collez le lien direct de chaque photo individuellement. Pour l\'obtenir : ouvrez la photo dans votre navigateur, puis copiez l\'URL de la barre d\'adresse (pas le lien du bouton "Partager") — puis collez-la ici.',
  de: '<strong>Tipp:</strong> Bei Alben mit mehreren Fotos füge den direkten Link jedes Fotos einzeln ein. So erhältst du ihn: Öffne das Foto in deinem Browser und kopiere die URL aus der Adresszeile (nicht den Link der "Teilen"-Schaltfläche) — und füge ihn hier ein.',
  pt: '<strong>Dica:</strong> Para álbuns com várias fotos, cole o link direto de cada foto individualmente. Para obtê-la: abra a foto no navegador e copie a URL da barra de endereço (não o link do botão "Compartilhar") — e cole aqui.',
  ko: '<strong>팁:</strong> 여러 장의 사진이 있는 앨범의 경우 각 사진의 직접 링크를 개별적으로 붙여넣으세요. 얻는 방법: 브라우저에서 사진을 열고 주소 표시줄에서 URL을 복사합니다 ("공유" 버튼 링크가 아님) — 그런 다음 여기에 붙여넣으세요.',
  it: '<strong>Suggerimento:</strong> Per gli album con più foto, incolla il link diretto di ogni foto singolarmente. Per ottenerlo: apri la foto nel browser e copia l\'URL dalla barra degli indirizzi (non il link del pulsante "Condivisione") — poi incollalo qui.',
};

const tabLinks = [
  {
    mode: 'video',
    label: 'Video',
    href: '/facebook-video-downloader',
    active: mode === 'video',
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><polygon points="10 8 16 12 10 16 10 8"/></svg>',
  },
  {
    mode: 'reels',
    label: 'Reels',
    href: '/facebook-reels-downloader',
    active: mode === 'reels',
    main: true,
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>',
  },
  {
    mode: 'story',
    label: 'Story',
    href: '/facebook-story-downloader',
    active: mode === 'story',
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  },
  {
    mode: 'mp3',
    label: 'Audio',
    href: '/facebook-to-mp3',
    active: mode === 'mp3',
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>',
  },
  {
    mode: 'photo',
    label: 'Photo',
    href: '/facebook-photo-downloader',
    active: mode === 'photo',
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>',
  },
];

const copy = {
  video: {
    placeholder: 'Paste Facebook video link',
    inputAria: 'Facebook video URL',
    pasteAria: 'Paste Facebook link from clipboard',
    submitAria: 'Download Facebook video',
    fetch: 'Please wait, <strong>fetching your video</strong>… TikSaveHub\'s free Facebook video downloader is processing your link — it usually takes just a few seconds, and you get the video in HD, no login needed.',
  },
  reels: {
    placeholder: 'Paste Facebook Reels link',
    inputAria: 'Facebook Reels URL',
    pasteAria: 'Paste Facebook Reels link from clipboard',
    submitAria: 'Download Facebook Reels video',
    fetch: 'Please wait, <strong>fetching your Reel</strong>… TikSaveHub\'s free Facebook Reels downloader is processing your link — it usually takes just a few seconds, and you get the Reel in HD, no login needed.',
  },
  story: {
    placeholder: 'Paste Facebook story link',
    inputAria: 'Facebook story URL',
    pasteAria: 'Paste Facebook story link from clipboard',
    submitAria: 'Download Facebook story',
    fetch: 'Please wait, <strong>fetching your story</strong>… TikSaveHub\'s free Facebook story downloader is processing your link — it usually takes just a few seconds, and you get the story in HD, no login needed.',
  },
  mp3: {
    placeholder: 'Paste Facebook video or Reels link to convert to MP3',
    inputAria: 'Facebook video or Reels URL to convert to MP3',
    pasteAria: 'Paste Facebook link from clipboard to convert to MP3',
    submitAria: 'Convert Facebook video to MP3',
    fetch: 'Please wait, <strong>fetching your audio</strong>… TikSaveHub\'s free Facebook to MP3 converter is processing your link — it usually takes just a few seconds, and you get a high-quality MP3, no login needed.',
  },
  photo: {
    placeholder: 'Paste Facebook photo link',
    inputAria: 'Facebook photo URL',
    pasteAria: 'Paste Facebook photo link from clipboard',
    submitAria: 'Download Facebook photo',
    fetch: 'Please wait, <strong>fetching your photo</strong>… TikSaveHub\'s free Facebook photo downloader is processing your link — it usually takes just a few seconds, and you get the full-resolution photo, no login needed.',
  },
}[mode];
---

<section id="download-form" class="download-form-section" data-type="facebook" data-mode={mode}>
  <!-- Cloudflare Turnstile — invisible widget for cobalt API auth -->
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  <div id="cf-turnstile-container" style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;" aria-hidden="true"></div>
  <div class="download-form-wrap">
    <nav class="fb-tabs" aria-label="Choose Facebook download type">
      {
        tabLinks.map((tab) => (
          <a
            class:list={[
              'fb-tab',
              tab.active && 'fb-tab-active',
              tab.main && 'fb-tab-main',
            ]}
            href={tab.href}
            aria-current={tab.active ? 'page' : undefined}
            set:html={`${tab.icon}<span>${tab.label}</span>`}
          >
          </a>
        ))
      }
    </nav>

    <form id="facebook-form" class="form-row" role="search" aria-label="Facebook video download form" onsubmit="return false;">
      <div class="input-wrap">
        <span class="input-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
        </span>
        <input
          id="facebook-url"
          name="url"
          type="url"
          class="form-input-lg url-input"
          placeholder={copy.placeholder}
          required
          autocomplete="off"
          spellcheck="false"
          aria-label={copy.inputAria}
        />
        <button
          type="button"
          class="clear-btn"
          id="facebook-clear"
          aria-label="Clear Facebook URL input"
          hidden
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
        <button
          type="button"
          class="paste-btn"
          data-paste-target="facebook-url"
          aria-label={copy.pasteAria}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
          </svg>
          <span class="paste-btn-label">Paste</span>
        </button>
      </div>
      <button
        id="download-btn"
        type="submit"
        class="btn-primary download-submit-btn"
        aria-label={copy.submitAria}
      >
        <span id="btn-label" class="btn-icon-only">
          <svg class="icon-download" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </span>
        <span id="btn-spinner" class="spinner-wrap" hidden aria-label="Loading">
          <span class="spinner animate-spin" aria-hidden="true"></span>
          Processing…
        </span>
      </button>
    </form>

<p class="hero-notice" role="note">
      Notice: For personal use only. We do not host any media files on our servers. Please respect content creators' rights.
    </p>

    {mode === 'photo' && (
      <p class="hero-tip" role="note" set:html={photoTips[lang] || photoTips.en} />
    )}

    <p class="fetch-note" id="fetch-note" role="status" aria-live="polite" hidden>
      <span class="fetch-note-dot" aria-hidden="true"></span>
      <span set:html={copy.fetch}></span>
    </p>

    <!-- Error banner -->
    <div id="error-msg" class="error-toast" hidden role="alert" aria-live="assertive">
      <span class="error-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </span>
      <span id="error-text" class="error-text-msg">Something went wrong. Please try again.</span>
    </div>

    <!-- Result card mount point -->
    <div id="result-mount" class="result-mount"></div>

    <!-- Monetag ad slot — reserved height prevents layout shift (CLS) when the ad loads -->
    <div class="ad-slot" data-ad-slot="hero" aria-hidden="true"></div>
  </div>
</section>

<style>
  .download-form-section {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  /* ——— Tab Group ——— */
  .fb-tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
    flex-wrap: wrap;
    animation: fadeInUp 0.5s ease 0.35s both;
  }

  .fb-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
    color: var(--color-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    letter-spacing: -0.28px;
    cursor: pointer;
    font-family: inherit;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    min-height: 44px;
    transition: color 0.25s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .fb-tab svg {
    color: var(--color-mute);
    transition: color 0.2s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .fb-tab::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 60%;
    height: 100%;
    background: linear-gradient(105deg, transparent 20%, rgba(255, 255, 255, 0.45) 50%, transparent 80%);
    transform: translateX(-160%) skewX(-20deg);
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .fb-tab:hover {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -2px rgba(124, 58, 237, 0.15);
  }

  .fb-tab:hover::after {
    transform: translateX(260%) skewX(-20deg);
  }

  .fb-tab:hover svg {
    color: var(--color-ink);
    transform: scale(1.15) rotate(-8deg);
  }

  .fb-tab-active {
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.14), rgba(236, 72, 153, 0.14)) !important;
    border-color: rgba(124, 58, 237, 0.4) !important;
    color: #7c3aed !important;
    font-weight: 600 !important;
  }

  .fb-tab-active svg {
    color: #7c3aed !important;
  }

  html.dark .fb-tab {
    background-color: var(--color-canvas);
    border-color: rgba(255, 255, 255, 0.1);
    color: #a3a3a3;
  }

  html.dark .fb-tab::after {
    background: linear-gradient(105deg, transparent 20%, rgba(255, 255, 255, 0.18) 50%, transparent 80%);
  }

  html.dark .fb-tab:hover {
    color: #fafafa;
    border-color: rgba(255, 255, 255, 0.2);
  }

  html.dark .fb-tab:hover svg {
    color: #fafafa;
  }

  html.dark .fb-tab-active {
    color: #c084fc !important;
    border-color: rgba(192, 132, 252, 0.4) !important;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.14), rgba(236, 72, 153, 0.14)) !important;
  }

  html.dark .fb-tab-active svg {
    color: #c084fc !important;
  }

  /* ——— Reels Tab — main Facebook tool — brand purple/pink pill ——— */
  .fb-tab-main {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #7c3aed, #ec4899) !important;
    border: 1px solid rgba(124, 58, 237, 0.6) !important;
    color: #ffffff !important;
    font-weight: 600 !important;
    position: relative;
    overflow: hidden;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    animation: fb-tab-pulse 2s ease-in-out infinite;
  }

  .fb-tab-main svg {
    color: #ffffff !important;
    transition: color 0.2s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .fb-tab-main:hover {
    transform: translateY(-1px);
    background: linear-gradient(135deg, #6d28d9, #db2777) !important;
    color: #ffffff !important;
    border-color: rgba(124, 58, 237, 0.8) !important;
    box-shadow:
      0 0 20px rgba(124, 58, 237, 0.35),
      0 0 40px rgba(236, 72, 153, 0.2) !important;
    animation: none !important;
  }

  .fb-tab-main:active {
    transform: translateY(0);
    transition-duration: 0.1s;
  }

  .fb-tab-main:hover svg {
    color: #ffffff !important;
    transform: scale(1.2) rotate(-10deg);
  }

  html.dark .fb-tab-main {
    background: linear-gradient(135deg, #7c3aed, #ec4899) !important;
    border: 1px solid rgba(192, 132, 252, 0.5) !important;
    color: #ffffff !important;
    animation-name: fb-tab-pulse-dark;
  }

  html.dark .fb-tab-main svg {
    color: #ffffff !important;
  }

  html.dark .fb-tab-main:hover {
    background: linear-gradient(135deg, #6d28d9, #db2777) !important;
    color: #ffffff !important;
    border-color: rgba(192, 132, 252, 0.7) !important;
  }

  .fb-tab-main.fb-tab-active {
    background: linear-gradient(135deg, #7c3aed, #ec4899) !important;
    border-color: rgba(124, 58, 237, 0.6) !important;
    color: #ffffff !important;
  }

  .fb-tab-main.fb-tab-active svg {
    color: #ffffff !important;
  }

  html.dark .fb-tab-main.fb-tab-active {
    background: linear-gradient(135deg, #7c3aed, #ec4899) !important;
    border-color: rgba(192, 132, 252, 0.5) !important;
    color: #ffffff !important;
  }

  @keyframes fb-tab-pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(124, 58, 237, 0);
    }
    50% {
      box-shadow: 0 0 8px 2px rgba(124, 58, 237, 0.25);
    }
  }

  @keyframes fb-tab-pulse-dark {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(192, 132, 252, 0);
    }
    50% {
      box-shadow: 0 0 8px 2px rgba(192, 132, 252, 0.2);
    }
  }

  @media (max-width: 600px) {
    .fb-tabs {
      gap: 6px;
    }

    .fb-tab {
      padding: var(--spacing-xs) var(--spacing-sm);
      font-size: var(--text-caption);
    }
  }

  .form-row {
    display: flex;
    gap: var(--spacing-sm);
    align-items: center;
    width: 100%;
  }

  .hero-notice {
    font-size: var(--text-caption);
    color: var(--color-mute);
    text-align: center;
    margin: var(--spacing-md) 0 0 0;
    line-height: 1.5;
    letter-spacing: -0.1px;
  }

  .hero-tip {
    font-size: var(--text-caption);
    color: var(--color-text);
    text-align: center;
    margin: var(--spacing-sm) 0 0 0;
    line-height: 1.5;
    letter-spacing: -0.1px;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: var(--radius-md, 10px);
    background: rgba(59, 130, 246, 0.05);
  }

  .hero-tip strong {
    color: #2563eb;
  }

  html.dark .hero-tip {
    border-color: rgba(96, 165, 250, 0.25);
    background: rgba(96, 165, 250, 0.08);
  }

  html.dark .hero-tip strong {
    color: #60a5fa;
  }

  .fetch-note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--text-caption);
    color: var(--color-mute);
    text-align: left;
    margin: var(--spacing-sm) 0 0 0;
    line-height: 1.5;
    letter-spacing: -0.1px;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid rgba(121, 40, 202, 0.15);
    border-radius: var(--radius-md, 10px);
    background: rgba(121, 40, 202, 0.04);
    animation: fetch-note-in 0.25s ease;
  }

  html.dark .fetch-note {
    border-color: rgba(121, 40, 202, 0.35);
    background: rgba(121, 40, 202, 0.08);
  }

  .fetch-note[hidden] {
    display: none;
  }

  .fetch-note-dot {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    margin-top: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    box-shadow: 0 0 8px rgba(236, 72, 153, 0.6);
    animation: fetch-dot-pulse 1s ease-in-out infinite;
  }

  @keyframes fetch-note-in {
    from { opacity: 0; transform: translateY(-3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fetch-dot-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .ad-slot {
    min-height: 90px;
    margin: var(--spacing-sm) 0 0 0;
  }

  .input-wrap {
    position: relative;
    flex: 1;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-mute);
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .paste-btn,
  .clear-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 36px;
    padding: 0 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    cursor: pointer;
    z-index: 2;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .paste-btn:focus-visible,
  .clear-btn:focus-visible {
    outline: 2px solid var(--color-grad-develop-start);
    outline-offset: 2px;
  }

  .paste-btn {
    right: 8px;
  }

  .clear-btn {
    right: 96px;
    width: 36px;
    padding: 0;
    justify-content: center;
    color: var(--color-mute);
  }

  .paste-btn:hover,
