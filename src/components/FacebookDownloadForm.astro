---
// FacebookDownloadForm — interactive Facebook video URL input with fetch & result rendering
// Supports Reels, Watch links, video posts, fb.watch short links and mobile hosts.
// API: POST /api/facebook (metadata) + GET /api/facebook?url=&dl= (file download).
---

<section id="download-form" class="download-form-section" data-type="facebook">
  <div class="download-form-wrap">
    <form id="facebook-form" class="form-row" role="search" aria-label="Facebook video download form" onsubmit="return false;">
      <div class="input-wrap">
        <span class="input-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
        </span>
        <input
          id="facebook-url"
          name="url"
          type="url"
          class="form-input-lg url-input"
          placeholder="Paste Facebook video or Reels link"
          required
          autocomplete="off"
          spellcheck="false"
          aria-label="Facebook video or Reels URL"
        />
        <button
          type="button"
          class="clear-btn"
          id="facebook-clear"
          aria-label="Clear Facebook URL input"
          hidden
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
        <button
          type="button"
          class="paste-btn"
          data-paste-target="facebook-url"
          aria-label="Paste Facebook link from clipboard"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
          </svg>
          <span class="paste-btn-label">Paste</span>
        </button>
      </div>
      <button
        id="download-btn"
        type="submit"
        class="btn-primary download-submit-btn"
        aria-label="Download Facebook video"
      >
        <span id="btn-label" class="btn-icon-only">
          <svg class="icon-download" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </span>
        <span id="btn-spinner" class="spinner-wrap" hidden aria-label="Loading">
          <span class="spinner animate-spin" aria-hidden="true"></span>
          Processing…
        </span>
      </button>
    </form>

    <p class="hero-notice" role="note">
      Notice: For personal use only. We do not host any media files on our servers. Please respect content creators' rights.
    </p>

    <!-- Error banner -->
    <div id="error-msg" class="error-toast" hidden role="alert" aria-live="assertive">
      <span class="error-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </span>
      <span id="error-text">Something went wrong. Please try again.</span>
    </div>

    <!-- Result card mount point -->
    <div id="result-mount" class="result-mount"></div>
  </div>
</section>

<style>
  .download-form-section {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  .form-row {
    display: flex;
    gap: var(--spacing-sm);
    align-items: center;
    width: 100%;
  }

  .hero-notice {
    font-size: var(--text-caption);
    color: var(--color-mute);
    text-align: center;
    margin: var(--spacing-md) 0 0 0;
    line-height: 1.5;
    letter-spacing: -0.1px;
  }

  .input-wrap {
    position: relative;
    flex: 1;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-mute);
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .url-input {
    padding-left: 42px !important;
    padding-right: 128px !important;
  }

  .paste-btn,
  .clear-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 36px;
    padding: 0 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    cursor: pointer;
    z-index: 2;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .paste-btn:focus-visible,
  .clear-btn:focus-visible {
    outline: 2px solid var(--color-grad-develop-start);
    outline-offset: 2px;
  }

  .paste-btn {
    right: 8px;
  }

  .clear-btn {
    right: 96px;
    width: 36px;
    padding: 0;
    justify-content: center;
    color: var(--color-mute);
  }

  .paste-btn:hover,
  .clear-btn:hover {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
  }

  .paste-btn:active,
  .clear-btn:active {
    transform: translateY(-50%) scale(0.96);
  }

  .paste-btn svg,
  .clear-btn svg {
    flex-shrink: 0;
    color: currentColor;
  }

  .dark .paste-btn,
  .dark .clear-btn {
    background: rgba(255, 255, 255, 0.08);
    color: #a3a3a3;
    border-color: rgba(255, 255, 255, 0.1);
  }

  .dark .paste-btn:hover,
  .dark .clear-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  @media (max-width: 520px) {
    .paste-btn .paste-btn-label {
      display: none;
    }

    .paste-btn {
      width: 36px;
      padding: 0;
      justify-content: center;
    }

    .clear-btn {
      right: 52px;
    }

    .url-input {
      padding-right: 96px !important;
    }
  }

  .download-submit-btn {
    flex-shrink: 0;
    gap: 8px;
    padding: 0 var(--spacing-sm) !important;
    min-width: 48px;
    position: relative;
    overflow: hidden;
  }

  .btn-icon-only {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .spinner-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .spinner {
    display: block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
  }

  .download-submit-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--color-grad-develop-start), var(--color-grad-develop-end));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .download-submit-btn:hover::after {
    opacity: 1;
  }

  .download-submit-btn > * {
    position: relative;
    z-index: 1;
  }

  .download-submit-btn:hover .icon-download {
    animation: download-bounce 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55);
    filter: drop-shadow(0 2px 4px rgba(0, 124, 240, 0.4));
  }

  @keyframes download-bounce {
    0% { transform: translateY(0) scale(1); }
    30% { transform: translateY(-4px) scale(1.1); }
    50% { transform: translateY(-2px) scale(1.05); }
    70% { transform: translateY(-3px) scale(1.08); }
    100% { transform: translateY(0) scale(1); }
  }

  .error-toast {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    background-color: var(--color-error-soft);
    color: var(--color-error-deep);
    font-size: var(--text-body-sm);
    font-weight: 500;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    margin-top: var(--spacing-md);
    border: 1px solid #f5b3b380;
    animation: fadeInUp 0.3s ease forwards;
  }

  .error-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .result-mount {
    margin-top: var(--spacing-lg);
  }

  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
      align-items: stretch;
    }

    .download-submit-btn {
      width: 100%;
      height: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .download-submit-btn:hover .icon-download {
      animation: none;
    }
  }
</style>

<style is:global>
  .result-card {
    background-color: var(--color-canvas);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow:
      inset 0 0 0 1px #00000014,
      0px 2px 2px #0000000a,
      0px 8px 16px -4px #0000001a;
  }

  .result-header {
    display: flex;
    gap: var(--spacing-md);
    align-items: stretch;
    min-height: 160px;
  }

  .result-thumb-wrap {
    position: relative;
    flex-shrink: 0;
    width: 120px;
    min-height: 160px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-canvas-soft-2);
  }

  .result-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .result-thumb-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-mute);
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--color-grad-develop-start) 10%, white), transparent 60%),
      var(--color-canvas-soft-2);
  }

  html.dark .result-thumb-fallback {
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--color-grad-develop-start) 18%, transparent), transparent 70%),
      rgba(255, 255, 255, 0.04);
  }

  .result-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--spacing-sm);
  }

  .result-meta {
    min-width: 0;
  }

  .result-title {
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.4;
    letter-spacing: -0.2px;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .result-duration-badge {
    position: absolute;
    bottom: 6px;
    right: 6px;
    background-color: rgba(0, 0, 0, 0.78);
    color: #fff;
    padding: 3px 7px;
    border-radius: var(--radius-xs);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .result-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .dl-tile {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--color-hairline);
    background-color: var(--color-canvas);
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    position: relative;
    overflow: hidden;
    box-shadow: 0px 1px 2px #00000006;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .dl-tile:hover {
    border-color: var(--color-hairline-strong);
    transform: translateY(-1px);
    box-shadow: 0px 4px 12px #0000000a;
  }

  .dl-tile:active {
    transform: translateY(0);
  }

  .dl-tile:focus-visible {
    outline: 2px solid var(--color-grad-develop-start);
    outline-offset: 2px;
  }

  .dl-proc-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: linear-gradient(90deg, #007cf0, #00dfd8, #7928ca, #007cf0);
    background-size: 200% 100%;
    border-radius: 0 0 8px 8px;
    transition: none;
    pointer-events: none;
  }

  .dl-tile-processing {
    pointer-events: none;
  }

  .dl-tile-processing .dl-tile-icon svg {
    animation: dl-pulse 1s ease-in-out infinite;
  }

  .dl-tile-done {
    border-color: #22c55e !important;
    background-color: #f0fdf4 !important;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  html.dark .dl-tile-done {
    background-color: rgba(34, 197, 94, 0.1) !important;
    border-color: rgba(34, 197, 94, 0.4) !important;
  }

  .dl-tile-error {
    border-color: #ef4444 !important;
    background-color: #fef2f2 !important;
    animation: dl-shake 0.4s ease;
  }

  html.dark .dl-tile-error {
    background-color: rgba(239, 68, 68, 0.1) !important;
    border-color: rgba(239, 68, 68, 0.4) !important;
  }

  @keyframes dl-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.9); }
  }

  @keyframes dl-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    50% { transform: translateX(4px); }
    75% { transform: translateX(-2px); }
  }

  /* Facebook HD tile — brand blue accent */
  .dl-tile-fb {
    background: linear-gradient(135deg, #eef4ff, #e0ecfd);
    border-color: #9fc2f5;
  }

  html.dark .dl-tile-fb {
    background: linear-gradient(135deg, rgba(24, 119, 242, 0.08), rgba(24, 119, 242, 0.14));
    border-color: rgba(66, 145, 250, 0.4);
  }

  .dl-tile-fb:hover {
    border-color: #1877f2;
    box-shadow: 0px 4px 16px rgba(24, 119, 242, 0.18);
  }

  .dl-tile-fb .dl-tile-icon {
    color: #1877f2;
    background-color: rgba(24, 119, 242, 0.1);
  }

  .dl-tile-fb .dl-tile-label strong {
    color: #1877f2;
  }

  html.dark .dl-tile-fb .dl-tile-icon {
    background-color: rgba(24, 119, 242, 0.18);
  }

  html.dark .dl-tile-fb .dl-tile-label strong {
    color: #6eb1fd;
  }

  /* Audio tile — violet accent */
  .dl-tile-audio {
    background: linear-gradient(135deg, #f5f1ff, #ece3fd);
    border-color: #cbb7f2;
  }

  html.dark .dl-tile-audio {
    background: linear-gradient(135deg, rgba(121, 40, 202, 0.08), rgba(121, 40, 202, 0.14));
    border-color: rgba(139, 92, 246, 0.4);
  }

  .dl-tile-audio:hover {
    border-color: #7928ca;
    box-shadow: 0px 4px 16px rgba(121, 40, 202, 0.18);
  }

  .dl-tile-audio .dl-tile-icon {
    color: #7928ca;
    background-color: rgba(121, 40, 202, 0.1);
  }

  .dl-tile-audio .dl-tile-label strong {
    color: #7928ca;
  }

  html.dark .dl-tile-audio .dl-tile-icon {
    background-color: rgba(121, 40, 202, 0.18);
  }

  html.dark .dl-tile-audio .dl-tile-label strong {
    color: #b794f6;
  }

  .dl-tile-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    color: var(--color-mute);
    background-color: var(--color-canvas-soft);
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .dl-tile-label {
    flex: 1;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.3;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dl-tile-label strong {
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .result-header {
      min-height: 120px;
    }

    .result-thumb-wrap {
      width: 90px;
      min-height: 120px;
    }

    .dl-tile {
      padding: 10px 12px;
      gap: 8px;
    }

    .dl-tile-icon {
      width: 32px;
      height: 32px;
    }

    .dl-tile-icon svg {
      width: 16px;
      height: 16px;
    }

    .dl-tile-label {
      font-size: 12px;
    }
  }
</style>

<script>
  const form = document.getElementById('facebook-form') as HTMLFormElement;
  const urlInput = document.getElementById('facebook-url') as HTMLInputElement;
  const clearBtn = document.getElementById('facebook-clear') as HTMLButtonElement;
  const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
  const btnLabel = document.getElementById('btn-label') as HTMLElement;
  const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;
  const errorMsg = document.getElementById('error-msg') as HTMLElement;
  const errorText = document.getElementById('error-text') as HTMLElement;
  const resultMount = document.getElementById('result-mount') as HTMLElement;

  const URL_PATTERN =
    /^(https?:\/\/)?(www\.|m\.|mbasic\.|web\.|touch\.)?(facebook\.com|fb\.com)\//i;
  const SHORT_PATTERN = /^(https?:\/\/)?fb\.watch\//i;

  function setLoading(loading: boolean) {
    downloadBtn.disabled = loading;
    btnLabel.hidden = loading;
    btnSpinner.hidden = !loading;
  }

  function showError(msg: string) {
    errorText.textContent = msg;
    errorMsg.removeAttribute('hidden');
    resultMount.innerHTML = '';
  }

  function hideError() {
    errorMsg.setAttribute('hidden', '');
  }

  function updateClearState() {
    clearBtn.hidden = !urlInput.value.trim();
  }

  urlInput.addEventListener('input', updateClearState);

  document.querySelectorAll<HTMLButtonElement>('.paste-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.pasteTarget || '') as HTMLInputElement | null;
      if (!target) return;
      let text = '';
      try {
        if (navigator.clipboard && window.isSecureContext) {
          text = await navigator.clipboard.readText();
        } else if ((window as any).clipboardData && (window as any).clipboardData.getData) {
          text = (window as any).clipboardData.getData('Text');
        }
      } catch {}
      if (text) {
        target.value = text.trim();
        target.focus();
        updateClearState();
      } else {
        target.focus();
      }
    });
  });

  clearBtn.addEventListener('click', () => {
    urlInput.value = '';
    urlInput.focus();
    updateClearState();
    hideError();
    resultMount.innerHTML = '';
  });

  function formatDuration(secs: number): string {
    const m = Math.floor(secs / 60);
    const s = secs % 60;
    return `${m}:${s.toString().padStart(2, '0')}`;
  }

  const dlIcon = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';
  const musicIcon = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>';

  function renderResult(data: any, inputUrl: string) {
    const { cover, duration, title, hdplay, sdplay, play } = data || {};
    const hdUrl: string = hdplay || play || '';
    const sdUrl: string = sdplay || play || '';
    const videoTitle: string = title || 'Facebook Video';

    resultMount.innerHTML = `
      <div class="result-card animate-fade-in-up" role="region" aria-label="Download result">
        <div class="result-header">
          <div class="result-thumb-wrap">
            <img
              src="${cover || ''}"
              alt="Video thumbnail"
              class="result-thumb"
              loading="lazy"
              width="120"
              height="160"
              ${!cover ? 'hidden' : ''} />
            ${!cover ? `<div class="result-thumb-fallback" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                <line x1="7" y1="2" x2="7" y2="22"/>
                <line x1="17" y1="2" x2="17" y2="22"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <line x1="2" y1="7" x2="7" y2="7"/>
                <line x1="2" y1="17" x2="7" y2="17"/>
                <line x1="17" y1="17" x2="22" y2="17"/>
                <line x1="17" y1="7" x2="22" y2="7"/>
              </svg>
            </div>` : ''}
            <span class="result-duration-badge text-caption-mono">${formatDuration(duration || 0)}</span>
          </div>
          <div class="result-info">
            <div class="result-meta">
              <p class="result-title">${videoTitle}</p>
            </div>
            <div class="result-actions">
              <button class="dl-tile dl-tile-fb" id="btn-dl-hd" type="button">
                <span class="dl-tile-icon" aria-hidden="true">${dlIcon}</span>
                <span class="dl-tile-label">Download <strong>HD Video</strong></span>
                <span class="dl-proc-bar"></span>
              </button>
              <button class="dl-tile" id="btn-dl-sd" type="button">
                <span class="dl-tile-icon" aria-hidden="true">${dlIcon}</span>
                <span class="dl-tile-label">Download <strong>SD Video</strong></span>
                <span class="dl-proc-bar"></span>
              </button>
              <button class="dl-tile dl-tile-audio" id="btn-dl-audio" type="button">
                <span class="dl-tile-icon" aria-hidden="true">${musicIcon}</span>
                <span class="dl-tile-label">Download <strong>Audio (MP3)</strong></span>
                <span class="dl-proc-bar"></span>
              </button>
            </div>
          </div>
        </div>
      </div>
    `;

    const hdBtn = document.getElementById('btn-dl-hd') as HTMLButtonElement | null;
    const sdBtn = document.getElementById('btn-dl-sd') as HTMLButtonElement | null;
    const audioBtn = document.getElementById('btn-dl-audio') as HTMLButtonElement | null;

    if (!hdUrl || !hdBtn) hdBtn?.setAttribute('disabled', '');
    if (!sdUrl || !sdBtn) sdBtn?.setAttribute('disabled', '');

    function startDownload(mode: string, btn: HTMLButtonElement | null) {
      if (!btn) return;
      btn.classList.add('dl-tile-processing');
      btn.disabled = true;
      const labelEl = btn.querySelector('.dl-tile-label') as HTMLElement | null;
      const origLabel = labelEl?.textContent || '';
      if (labelEl) labelEl.textContent = 'Processing… 0%';
      const bar = btn.querySelector('.dl-proc-bar') as HTMLElement | null;
      if (bar) {
        bar.style.transition = 'none';
        bar.style.width = '0%';
      }

      const xhr = new XMLHttpRequest();
      xhr.open('GET', `/api/facebook?url=${encodeURIComponent(inputUrl)}&dl=${mode}`);
      xhr.responseType = 'blob';

      xhr.onprogress = function (e) {
        if (e.lengthComputable && bar && labelEl) {
          const pct = Math.round((e.loaded / e.total) * 100);
          bar.style.transition = 'none';
          bar.style.width = pct + '%';
          labelEl.textContent = 'Processing… ' + pct + '%';
        }
      };

      xhr.onload = function () {
        if (xhr.status === 200) {
          const blob = xhr.response;
          const blobUrl = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = blobUrl;
          a.download = mode === 'audio' ? 'tiksavehub-facebook-audio.mp3' : 'tiksavehub-facebook-video.mp4';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(blobUrl), 60_000);
          btn.classList.add('dl-tile-done');
          setTimeout(() => btn.classList.remove('dl-tile-done'), 1500);
        } else {
          btn.classList.add('dl-tile-error');
          setTimeout(() => btn.classList.remove('dl-tile-error'), 2000);
        }
        btn.classList.remove('dl-tile-processing');
        btn.disabled = false;
        if (labelEl) labelEl.textContent = origLabel;
        if (bar) bar.style.width = '0%';
      };

      xhr.onerror = function () {
        btn.classList.add('dl-tile-error');
        setTimeout(() => btn.classList.remove('dl-tile-error'), 2000);
        btn.classList.remove('dl-tile-processing');
        btn.disabled = false;
        if (labelEl) labelEl.textContent = origLabel;
        if (bar) bar.style.width = '0%';
      };

      xhr.send();
    }

    hdBtn?.addEventListener('click', () => startDownload('hd', hdBtn));
    sdBtn?.addEventListener('click', () => startDownload('sd', sdBtn));
    audioBtn?.addEventListener('click', () => startDownload('audio', audioBtn));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    const url = urlInput.value.trim();

    if (!url) {
      showError('Please paste a Facebook video URL.');
      return;
    }

    if (!URL_PATTERN.test(url) && !SHORT_PATTERN.test(url)) {
      showError('Please enter a valid Facebook video link (e.g. facebook.com/reel/… or fb.watch/…).');
      return;
    }

    setLoading(true);
    resultMount.innerHTML = '';

    try {
      const res = await fetch('/api/facebook', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      const text = await res.text();
      let json: any;
      try {
        json = JSON.parse(text);
      } catch {
        throw new Error('Invalid Facebook link or the API is busy. Please check the link and try again.');
      }

      if (!res.ok || !json.success) {
        throw new Error(json.error || 'Failed to fetch the video. Please try again.');
      }

      renderResult(json.video, url);
    } catch (err: any) {
      showError(err.message || 'Something went wrong. Please try again.');
    } finally {
      setLoading(false);
    }
  });
</script>