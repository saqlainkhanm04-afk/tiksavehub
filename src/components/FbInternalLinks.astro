---
// FbInternalLinks -- cross-linking cards for related tools
import { getLocalizedPath, type Lang } from '../i18n/utils';

interface Link {
  href: string;
  title: string;
  desc: string;
  icon: 'fb' | 'reels' | 'mp3' | 'story' | 'ig' | 'igreels' | 'igstory' | 'tiktok' | 'music' | 'video' | 'photo';
}

interface Props {
  headline?: string;
  links: Link[];
  lang?: Lang;
}

const { headline = 'More free tools', links, lang } = Astro.props;

const icons: Record<Link['icon'], string> = {
  fb: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>',
  reels: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/></svg>',
  mp3: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>',
  story: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>',
  ig: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>',
  igreels: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>',
  igstory: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>',
  tiktok: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>',
  music: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>',
  video: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>',
  photo: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>',
};
---

<section class="dl-internal-section" aria-labelledby="dl-internal-headline">
  <div class="dl-internal-inner container-page">
    <h2 id="dl-internal-headline" class="section-headline dl-internal-headline">
      {headline}
    </h2>

    <div class="dl-internal-grid">
      {links.map((link) => (
        <a href={lang ? getLocalizedPath(link.href, lang) : link.href} class="dl-internal-card">
          <span class="dl-internal-icon" aria-hidden="true" set:html={icons[link.icon]}></span>
          <span class="dl-internal-title">{link.title}</span>
          <span class="dl-internal-desc">{link.desc}</span>
          <span class="dl-internal-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .dl-internal-section {
    background-color: var(--color-canvas-soft);
    padding: var(--spacing-5xl) var(--spacing-lg);
    border-top: 1px solid var(--color-hairline);
  }

  .section-headline {
    font-size: var(--text-display-lg);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -1.28px;
    color: var(--color-ink);
    margin: 0;
    max-width: 540px;
  }

  .dl-internal-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-3xl);
  }

  .dl-internal-headline {
    text-align: center;
    max-width: 400px;
  }

  .dl-internal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    width: 100%;
  }

  .dl-internal-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    position: relative;
  }

  .dl-internal-card:hover {
    border-color: var(--color-hairline-strong);
    transform: translateY(-3px);
    box-shadow:
      inset 0 0 0 1px #00000008,
      0px 2px 2px #0000000a,
      0px 8px 16px -4px #0000001a;
  }

  .dl-internal-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #007cf012, #00dfd818);
    color: var(--color-grad-develop-start);
    box-shadow: inset 0 0 0 1px #007cf020;
  }

  .dl-internal-title {
    font-size: var(--text-body-md-strong);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.3px;
  }

  .dl-internal-desc {
    font-size: var(--text-body-sm);
    color: var(--color-body);
    line-height: 1.5;
    margin: 0;
  }

  .dl-internal-arrow {
    position: absolute;
    top: var(--spacing-lg);
    right: var(--spacing-lg);
    color: var(--color-mute);
    font-size: 18px;
    transition: color 0.15s ease, transform 0.25s ease;
  }

  .dl-internal-card:hover .dl-internal-arrow {
    color: var(--color-ink);
    transform: translateX(4px);
  }

  @media (max-width: 960px) {
    .dl-internal-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
    }
  }

  @media (max-width: 600px) {
    .dl-internal-section {
      padding: var(--spacing-3xl) var(--spacing-md);
    }
  }
</style>