---
// FbUseCasesSection — use-case card grid (dl-usecases pattern)
interface Prop {
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  sub?: string;
  uses: Prop[];
}

const { eyebrow = 'Use Cases', headline, sub, uses } = Astro.props;
---

<section class="usecases-section" aria-labelledby="usecases-headline">
  <div class="usecases-inner container-page">
    <div class="usecases-header">
      <span class="section-eyebrow text-caption-mono">{eyebrow}</span>
      <h2 id="usecases-headline" class="section-headline">{headline}</h2>
      {sub && <p class="section-sub text-body-lg">{sub}</p>}
    </div>

    <div class="usecases-grid">
      {uses.map((use) => (
        <article class="usecase-card">
          <h3 class="usecase-title">{use.title}</h3>
          <p class="usecase-body">{use.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .usecases-section {
    background-color: var(--color-canvas);
    padding: var(--spacing-5xl) var(--spacing-lg);
  }

  .section-eyebrow {
    color: var(--color-mute);
  }

  .section-headline {
    font-size: var(--text-display-lg);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -1.28px;
    color: var(--color-ink);
    margin: 0;
    max-width: 540px;
  }

  .section-sub {
    color: var(--color-body);
    margin: 0;
    max-width: 480px;
  }

  .usecases-inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4xl);
  }

  .usecases-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
  }

  .usecases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .usecase-card {
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .usecase-card:hover {
    border-color: var(--color-hairline-strong);
    box-shadow:
      inset 0 0 0 1px #00000008,
      0px 1px 1px #00000005,
      0px 4px 8px #0000000a;
  }

  .usecase-title {
    font-size: var(--text-display-sm);
    font-weight: 600;
    letter-spacing: -0.6px;
    color: var(--color-ink);
    margin: 0 0 var(--spacing-sm) 0;
  }

  .usecase-body {
    font-size: var(--text-body-sm);
    color: var(--color-body);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 600px) {
    .usecases-section {
      padding: var(--spacing-3xl) var(--spacing-md);
    }

    .usecases-grid {
      grid-template-columns: 1fr;
    }
  }
</style>