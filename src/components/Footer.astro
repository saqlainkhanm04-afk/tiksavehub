---
// Footer component — 3-column footer following DESIGN.md footer spec
import { getLangFromUrl, useTranslations } from '../i18n/utils';
interface Props {
  platform?: 'tiktok' | 'instagram' | 'facebook' | 'x' | 'snapchat';
}

const { platform = 'tiktok' } = Astro.props;
const year = new Date().getFullYear();
const isInstagram = platform === 'instagram';
const isFacebook = platform === 'facebook';
const isX = platform === 'x';
const isSnapchat = platform === 'snapchat';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

function localPath(path: string): string {
  if (lang === 'en') return path;
  return `/${lang}${path}`;
}
---

<footer id="site-footer" class="site-footer">
  <div class="footer-inner container-page">
    <!-- Brand Column — explicit vertical stack (flex-col + gap-y-4) so the
         logo, tagline, copyright and badge can never overlap on any viewport.
         min-w-0 lets long text wrap instead of widening the grid track. -->
    <div class="footer-brand flex min-w-0 flex-col gap-y-4">
      <a href={localPath('/')} class="footer-logo" id="footer-logo" aria-label="TikSaveHub home">
        <span class="footer-logo-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="28" height="28" rx="8" class="logo-icon-rect"/>
            <path d="M10 8L18 14L10 20V8Z" class="logo-icon-path"/>
            <path d="M12 18L16 22H20L16 18" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-icon-stroke"/>
            <line x1="13" y1="20" x2="21" y2="20" stroke="white" stroke-width="1.5" stroke-linecap="round" class="logo-icon-stroke"/>
          </svg>
        </span>
        <span class="footer-logo-text">TikSaveHub</span>
      </a>
      <p class="footer-tagline">
        {t(`footer.tagline.${platform}`)}
      </p>
      <p class="footer-copy">{t('footer.copyright').replace('{year}', String(year))}</p>
      <div class="footer-marketingdb-badge">
        <a href="https://marketingdb.live" target="_blank" rel="noopener noreferrer nofollow sponsored"><img src="https://marketingdb.live/badge.svg" alt="Listed on MarketingDB" width="190" height="44" class="block h-auto max-w-full"/></a>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="footer-col">
      <p class="footer-col-label text-caption-mono">{t('footer.tools')}</p>
      <ul class="footer-link-list">
        <li><a href={localPath('/tiktok-video-downloader-without-watermark')} class="footer-link" id="footer-link-tiktok">TikTok Downloader</a></li>
        <li><a href={localPath('/tiktok-to-mp3')} class="footer-link" id="footer-link-tiktok-mp3">TikTok to MP3</a></li>
        <li><a href={localPath('/instagram-reels-downloader-without-watermark')} class="footer-link" id="footer-link-ig-reels">Instagram Reels Downloader</a></li>
        <li><a href={localPath('/instagram-video-downloader-without-watermark')} class="footer-link" id="footer-link-ig-video">Instagram Video Downloader</a></li>
        <li><a href={localPath('/instagram-story-downloader-without-watermark')} class="footer-link" id="footer-link-ig-story">Instagram Story Downloader</a></li>
        <li><a href={localPath('/facebook-video-downloader')} class="footer-link" id="footer-link-fb-video">Facebook Video Downloader</a></li>
        <li><a href={localPath('/facebook-reels-downloader')} class="footer-link" id="footer-link-fb-reels">Facebook Reels Downloader</a></li>
        <li><a href={localPath('/facebook-to-mp3')} class="footer-link" id="footer-link-fb-mp3">Facebook to MP3</a></li>
        <li><a href={localPath('/x-video-downloader')} class="footer-link" id="footer-link-x">X (Twitter) Downloader</a></li>
        <li><a href={localPath('/snapchat-downloader')} class="footer-link" id="footer-link-sc">Snapchat Downloader</a></li>
        <li><a href={localPath('/snapchat-story-downloader')} class="footer-link" id="footer-link-sc-story">Snapchat Story Downloader</a></li>
        <li><a href={localPath('/snapchat-to-mp3')} class="footer-link" id="footer-link-sc-mp3">Snapchat to MP3</a></li>
      </ul>
    </div>

    <!-- Resources -->
    <div class="footer-col">
      <p class="footer-col-label text-caption-mono">{t('footer.resources')}</p>
      <ul class="footer-link-list">
        <li><a href={localPath('/blog')} class="footer-link" id="footer-link-blog">{t('nav.blog')}</a></li>
        <!-- /about is English-only (no /{locale}/about route), so it is never localized. -->
        <li><a href="/about" class="footer-link" id="footer-link-about">About Us</a></li>
        <li><a href="#how-it-works" class="footer-link" id="footer-link-how-it-works">{t('nav.how_it_works')}</a></li>
        <li><a href="#features" class="footer-link" id="footer-link-features">{t('nav.features')}</a></li>
        <li><a href="#faq" class="footer-link" id="footer-link-faq">{t('nav.faq')}</a></li>
        <li><a href={localPath('/privacy')} class="footer-link" id="footer-link-privacy">{t('footer.privacy')}</a></li>
        <li><a href={localPath('/terms')} class="footer-link" id="footer-link-terms">{t('footer.terms')}</a></li>
        <li><a href={localPath('/dmca')} class="footer-link" id="footer-link-dmca">{t('footer.dmca')}</a></li>
        <li><a href={localPath('/contact')} class="footer-link" id="footer-link-contact">{t('footer.contact')}</a></li>
      </ul>
    </div>

    <!-- Popular Searches -->
    <div class="footer-col">
      <p class="footer-col-label text-caption-mono">Popular Searches</p>
      <ul class="footer-link-list">
        <li><a href={localPath('/facebook-photo-downloader')} class="footer-link" id="footer-link-pop-photo">Download Facebook photos</a></li>
        <li><a href={localPath('/facebook-to-mp3')} class="footer-link" id="footer-link-pop-mp3">Convert Facebook to MP3</a></li>
        <li><a href={localPath('/instagram-story-downloader-without-watermark')} class="footer-link" id="footer-link-pop-ig-story">Save Instagram Stories</a></li>
        <li><a href={localPath('/instagram-audio-downloader')} class="footer-link" id="footer-link-pop-ig-audio">Instagram audio to MP3</a></li>
        <li><a href={localPath('/tiktok-video-downloader-without-watermark')} class="footer-link" id="footer-link-pop-tiktok">TikTok video no watermark</a></li>
        <li><a href={localPath('/x-video-downloader')} class="footer-link" id="footer-link-pop-x">X video downloader</a></li>
      </ul>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="container-page footer-bottom-inner">
      <p class="footer-bottom-text">
        {t(`footer.disclaimer.${platform}`)}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
    margin-top: 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 180px 180px 180px;
    gap: var(--spacing-4xl);
    padding-top: var(--spacing-4xl);
    padding-bottom: var(--spacing-4xl);
  }

  /* .footer-brand is a flex column with gap-y-4 (16px) — child margins are
     intentionally zero so spacing never doubles and nothing can ride up. */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    text-decoration: none;
  }

  .footer-logo-icon {
    display: flex;
    align-items: center;
  }

  .dark .logo-icon-rect {
    fill: var(--color-canvas);
  }
  .dark .logo-icon-path {
    fill: var(--color-ink);
  }
  .dark .logo-icon-stroke {
    stroke: var(--color-ink);
  }

  .footer-logo-text {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.5px;
    background: linear-gradient(135deg, #007cf0, #7928ca, #ff0080);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-tagline {
    font-size: var(--text-body-sm);
    color: var(--color-body);
    line-height: 1.5;
    margin: 0;
    max-width: 280px;
    overflow-wrap: break-word;
  }

  .footer-copy {
    font-size: var(--text-caption);
    color: var(--color-mute);
    margin: 0;
    overflow-wrap: break-word;
  }

  .footer-marketingdb-badge {
    display: flex;
    flex-wrap: wrap;
    max-width: 100%;
    margin: 0;
  }

  .footer-marketingdb-badge a {
    display: flex;
    max-width: 100%;
    /* line-height: 0 was collapsing the badge's alt text when the image was
       blocked/unavailable, painting it over the logo block. Flex removes the
       baseline gap instead, so alt text now renders inside its own box. */
  }

  .footer-marketingdb-badge a:hover {
    opacity: 0.85;
  }

  .footer-col-label {
    color: var(--color-mute);
    margin: 0 0 var(--spacing-md) 0;
  }

  .footer-link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .footer-link {
    font-size: var(--text-body-sm);
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease;
    letter-spacing: -0.28px;
    padding: var(--spacing-xxs) 0;
    display: inline-block;
  }

  .footer-link:hover {
    color: var(--color-ink);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-hairline);
    padding: var(--spacing-md) 0;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-bottom-text {
    font-size: var(--text-caption);
    color: var(--color-mute);
    text-align: center;
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 1060px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }

    /* Mobile: brand column is a full-width vertical stack — logo → tagline →
       copyright → badge, each separated by gap-y-4 (16px), never overlapping. */
    .footer-brand {
      width: 100%;
      min-width: 0;
      row-gap: var(--spacing-md);
    }

    .footer-marketingdb-badge {
      width: 100%;
    }

    .footer-link-list {
      gap: var(--spacing-xs);
    }

    .footer-bottom-text {
      font-size: var(--text-caption);
    }
  }
</style>
