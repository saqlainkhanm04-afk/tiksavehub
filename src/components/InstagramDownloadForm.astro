---
// InstagramDownloadForm — interactive Instagram URL input with fetch & result rendering
// type prop: 'video' | 'reels' | 'story' | 'audio'
const { type = 'video' } = Astro.props as { type?: 'video' | 'reels' | 'story' | 'audio' };

const tabLinks = [
  {
    type: 'video',
    label: 'Video',
    href: '/instagram-video-downloader-without-watermark',
    active: type === 'video',
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><polygon points="10 8 16 12 10 16 10 8"/></svg>',
  },
  {
    type: 'reels',
    label: 'Reels',
    href: '/instagram-reels-downloader-without-watermark',
    active: type === 'reels',
    reels: true,
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>',
  },
  {
    type: 'story',
    label: 'Story',
    href: '/instagram-story-downloader-without-watermark',
    active: type === 'story',
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  },
  {
    type: 'audio',
    label: 'Audio',
    href: '/instagram-audio-downloader',
    active: type === 'audio',
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>',
  },
];

const typeMeta = {
  video: {
    placeholder: 'Paste Instagram video link',
    inputAria: 'Instagram video URL',
    formAria: 'Instagram video download form',
    btnAria: 'Download Instagram video',
    noUrlMsg: 'Please paste an Instagram video URL.',
    pattern: /^(https?:\/\/)?(www\.)?instagram\.com\/(p|tv)\//,
    example: 'https://www.instagram.com/p/…',
  },
  reels: {
    placeholder: 'Paste Instagram Reels link',
    inputAria: 'Instagram Reels URL',
    formAria: 'Instagram Reels download form',
    btnAria: 'Download Instagram Reels',
    noUrlMsg: 'Please paste an Instagram Reels URL.',
    pattern: /^(https?:\/\/)?(www\.)?instagram\.com\/reel\//,
    example: 'https://www.instagram.com/reel/…',
  },
  story: {
    placeholder: 'Paste Instagram Story link',
    inputAria: 'Instagram Story URL',
    formAria: 'Instagram Story download form',
    btnAria: 'Download Instagram Story',
    noUrlMsg: 'Please paste an Instagram Story URL.',
    pattern: /^(https?:\/\/)?(www\.)?instagram\.com\/stories\//,
    example: 'https://www.instagram.com/stories/…',
  },
  audio: {
    placeholder: 'Paste Instagram link to extract audio',
    inputAria: 'Instagram audio URL',
    formAria: 'Instagram audio extractor form',
    btnAria: 'Extract Instagram audio',
    noUrlMsg: 'Please paste an Instagram video or Reels URL.',
    pattern: /^(https?:\/\/)?(www\.)?instagram\.com\/(p|tv|reel)\//,
    example: 'https://www.instagram.com/reel/…',
  },
} as const;

const meta = typeMeta[type];
---

<section id="download-form" class="download-form-section" data-type={type}>
  <div class="download-form-wrap">
    <nav class="ig-tabs" aria-label="Choose Instagram download type">
      {
        tabLinks.map((tab) => (
          <a
            class:list={[
              'ig-tab',
              tab.active && 'ig-tab-active',
              tab.reels && 'ig-tab-reels',
            ]}
            href={tab.href}
            aria-current={tab.active ? 'page' : undefined}
            set:html={`${tab.icon}<span>${tab.label}</span>`}
          >
          </a>
        ))
      }
    </nav>

    <form id="instagram-form" class="form-row" role="search" aria-label={meta.formAria} onsubmit="return false;">
      <div class="input-wrap">
        <span class="input-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
        </span>
        <input
          id="instagram-url"
          name="url"
          type="url"
          class="form-input-lg url-input"
          placeholder={meta.placeholder}
          required
          autocomplete="off"
          spellcheck="false"
          aria-label={meta.inputAria}
        />
        <button
          type="button"
          class="paste-btn"
          data-paste-target="instagram-url"
          aria-label="Paste Instagram link from clipboard"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
          </svg>
          <span class="paste-btn-label">Paste</span>
        </button>
      </div>
      <button
        id="download-btn"
        type="submit"
        class="btn-primary download-submit-btn"
        aria-label={meta.btnAria}
      >
        <span id="btn-label" class="btn-icon-only">
          <svg class="icon-download" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <defs>
              <linearGradient id="download-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:var(--color-grad-develop-start)"/>
                <stop offset="100%" style="stop-color:var(--color-grad-develop-end)"/>
              </linearGradient>
            </defs>
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </span>
        <span id="btn-spinner" class="spinner-wrap" hidden aria-label="Loading">
          <span class="spinner animate-spin" aria-hidden="true"></span>
          Processing…
        </span>
      </button>
    </form>

    <p class="hero-notice" role="note">
      Notice: For personal use only. We do not host any media files on our servers. Please respect content creators' rights.
    </p>

    <!-- Error message -->
    <div id="error-msg" class="error-toast" hidden role="alert" aria-live="assertive">
      <span class="error-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </span>
      <span id="error-text">Something went wrong. Please try again.</span>
    </div>

    <!-- Result card mount point -->
    <div id="result-mount" class="result-mount"></div>
  </div>
</section>

<style>
  .download-form-section {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  /* ——— Tab Group ——— */
  .ig-tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
    flex-wrap: wrap;
    animation: fadeInUp 0.5s ease 0.35s both;
  }

  .ig-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
    color: var(--color-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    letter-spacing: -0.28px;
    cursor: pointer;
    font-family: inherit;
    position: relative;
    overflow: hidden;
    transition: color 0.25s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ig-tab svg {
    color: var(--color-mute);
    transition: color 0.2s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ig-tab::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 60%;
    height: 100%;
    background: linear-gradient(105deg, transparent 20%, rgba(255, 255, 255, 0.45) 50%, transparent 80%);
    transform: translateX(-160%) skewX(-20deg);
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .ig-tab:hover {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -2px rgba(0, 124, 240, 0.1);
  }

  .ig-tab:hover::after {
    transform: translateX(260%) skewX(-20deg);
  }

  .ig-tab:hover svg {
    color: var(--color-ink);
    transform: scale(1.15) rotate(-8deg);
  }

  .ig-tab-active {
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.14), rgba(255, 77, 77, 0.14)) !important;
    border-color: rgba(245, 166, 35, 0.4) !important;
    color: #d97706 !important;
    font-weight: 600 !important;
  }

  .ig-tab-active svg {
    color: #d97706 !important;
  }

  /* ——— Reels Tab — navbar button style ——— */
  .ig-tab-reels {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #111111 !important;
    border: 1px solid #111111 !important;
    color: #ffffff !important;
    font-weight: 600 !important;
    position: relative;
    overflow: hidden;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    animation: ig-tool-pulse 2s ease-in-out infinite;
  }

  .ig-tab-reels svg {
    color: #ffffff !important;
    transition: color 0.2s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ig-tab-reels:hover {
    transform: translateY(-1px);
    background: #2b2b2b !important;
    color: #ffffff !important;
    border-color: #2b2b2b !important;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25), 0 12px 32px -6px rgba(0, 0, 0, 0.35);
    animation: none !important;
  }

  .ig-tab-reels:active {
    transform: translateY(0);
    transition-duration: 0.1s;
  }

  .ig-tab-reels:hover svg {
    color: #ffffff !important;
    transform: scale(1.2) rotate(-10deg);
  }

  .dark .ig-tab-reels {
    background: #000000 !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    color: #ffffff !important;
    animation-name: ig-tool-pulse-dark;
  }

  .dark .ig-tab-reels svg {
    color: #ffffff !important;
  }

  .dark .ig-tab-reels:hover {
    background: #1a1a1a !important;
    color: #ffffff !important;
    border-color: rgba(255, 255, 255, 0.35) !important;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.15), 0 12px 32px -6px rgba(0, 0, 0, 0.6);
  }

  .dark .ig-tab-reels:hover svg {
    color: #ffffff !important;
  }

  .ig-tab-reels.ig-tab-active {
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.14), rgba(255, 77, 77, 0.14)) !important;
    border-color: rgba(245, 166, 35, 0.4) !important;
    color: #d97706 !important;
  }

  .ig-tab-reels.ig-tab-active svg {
    color: #d97706 !important;
  }

  .ig-tab-reels.ig-tab-active:hover {
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.2), rgba(255, 77, 77, 0.2)) !important;
    color: #b45309 !important;
    border-color: rgba(245, 166, 35, 0.5) !important;
  }

  .ig-tab-reels.ig-tab-active:hover svg {
    color: #b45309 !important;
  }

  .dark .ig-tab-reels.ig-tab-active {
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.12), rgba(255, 77, 77, 0.12)) !important;
    border-color: rgba(251, 191, 36, 0.4) !important;
    color: #fbbf24 !important;
  }

  .dark .ig-tab-reels.ig-tab-active svg {
    color: #fbbf24 !important;
  }

  .dark .ig-tab-reels.ig-tab-active:hover {
    color: #fde68a !important;
    border-color: rgba(251, 191, 36, 0.5) !important;
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.18), rgba(255, 77, 77, 0.18)) !important;
  }

  .dark .ig-tab-reels.ig-tab-active:hover svg {
    color: #fde68a !important;
  }

  @keyframes ig-tool-pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
    }
    50% {
      box-shadow: 0 0 8px 2px rgba(0, 0, 0, 0.15);
    }
  }

  @keyframes ig-tool-pulse-dark {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
    }
    50% {
      box-shadow: 0 0 8px 2px rgba(255, 255, 255, 0.08);
    }
  }

  @media (max-width: 600px) {
    .ig-tab-reels {
      padding: var(--spacing-xs) var(--spacing-sm);
      font-size: var(--text-caption);
    }
  }

  .dark .ig-tab {
    background-color: var(--color-canvas);
    border-color: rgba(255, 255, 255, 0.1);
    color: #a3a3a3;
  }

  .dark .ig-tab::after {
    background: linear-gradient(105deg, transparent 20%, rgba(255, 255, 255, 0.18) 50%, transparent 80%);
  }

  .dark .ig-tab:hover {
    color: #fafafa;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .dark .ig-tab:hover svg {
    color: #fafafa;
  }

  .dark .ig-tab-active {
    color: #fbbf24 !important;
    border-color: rgba(251, 191, 36, 0.4) !important;
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.12), rgba(255, 77, 77, 0.12)) !important;
  }

  .dark .ig-tab-active svg {
    color: #fbbf24 !important;
  }

  @media (max-width: 600px) {
    .ig-tabs {
      gap: 6px;
    }

    .ig-tab {
      padding: var(--spacing-xs) var(--spacing-sm);
      font-size: var(--text-caption);
    }
  }

  .form-row {
    display: flex;
    gap: var(--spacing-sm);
    align-items: center;
    width: 100%;
  }

  .hero-notice {
    font-size: var(--text-caption);
    color: var(--color-mute);
    text-align: center;
    margin: var(--spacing-md) 0 0 0;
    line-height: 1.5;
    letter-spacing: -0.1px;
  }

  .input-wrap {
    position: relative;
    flex: 1;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-mute);
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .url-input {
    padding-left: 42px !important;
    padding-right: 88px !important;
  }

  .paste-btn {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 36px;
    padding: 0 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    cursor: pointer;
    z-index: 2;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .paste-btn:hover {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
  }

  .paste-btn:active {
    transform: translateY(-50%) scale(0.96);
  }

  .paste-btn svg {
    flex-shrink: 0;
    color: var(--color-mute);
  }

  .dark .paste-btn {
    background: rgba(255, 255, 255, 0.08);
    color: #a3a3a3;
    border-color: rgba(255, 255, 255, 0.1);
  }

  .dark .paste-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .dark .paste-btn:hover svg {
    color: #ffffff;
  }

  @media (max-width: 420px) {
    .paste-btn .paste-btn-label {
      display: none;
    }

    .paste-btn {
      width: 36px;
      padding: 0;
      justify-content: center;
    }

    .url-input {
      padding-right: 52px !important;
    }
  }

  .download-submit-btn {
    flex-shrink: 0;
    gap: 8px;
    padding: 0 var(--spacing-sm) !important;
    min-width: 48px;
    position: relative;
    overflow: hidden;
  }

  .download-submit-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--color-grad-develop-start), var(--color-grad-develop-end));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .download-submit-btn:hover::after {
    opacity: 1;
  }

  .download-submit-btn > * {
    position: relative;
    z-index: 1;
  }

  .download-submit-btn:hover .icon-download {
    animation: download-bounce 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55);
    filter: drop-shadow(0 2px 4px rgba(0, 124, 240, 0.4));
  }

  @keyframes download-bounce {
    0% { transform: translateY(0) scale(1); }
    30% { transform: translateY(-4px) scale(1.1); }
    50% { transform: translateY(-2px) scale(1.05); }
    70% { transform: translateY(-3px) scale(1.08); }
    100% { transform: translateY(0) scale(1); }
  }

  .btn-icon-only {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .spinner-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .spinner {
    display: block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: white;
    border-radius: 50%;
  }

  .error-toast {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    background-color: var(--color-error-soft);
    color: var(--color-error-deep);
    font-size: var(--text-body-sm);
    font-weight: 500;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    margin-top: var(--spacing-md);
    border: 1px solid #f5b3b380;
    animation: fadeInUp 0.3s ease forwards;
  }

  .error-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .result-mount {
    margin-top: var(--spacing-lg);
  }

  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
      align-items: stretch;
    }

    .download-submit-btn {
      width: 100%;
      height: 48px;
    }
  }
</style>

<script>
  const form = document.getElementById('instagram-form') as HTMLFormElement;
  const urlInput = document.getElementById('instagram-url') as HTMLInputElement;
  const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
  const btnLabel = document.getElementById('btn-label') as HTMLElement;
  const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;
  const errorMsg = document.getElementById('error-msg') as HTMLElement;
  const errorText = document.getElementById('error-text') as HTMLElement;
  const resultMount = document.getElementById('result-mount') as HTMLElement;

  const section = document.getElementById('download-form') as HTMLElement;
  const currentTabType = (section?.dataset.type || 'video') as 'video' | 'reels' | 'story' | 'audio';
  const typeLabel = currentTabType.charAt(0).toUpperCase() + currentTabType.slice(1);

  document.querySelectorAll<HTMLButtonElement>('.paste-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.pasteTarget || '') as HTMLInputElement | null;
      if (!target) return;
      let text = '';
      try {
        if (navigator.clipboard && window.isSecureContext) {
          text = await navigator.clipboard.readText();
        } else if ((window as any).clipboardData && (window as any).clipboardData.getData) {
          text = (window as any).clipboardData.getData('Text');
        }
      } catch {}
      if (text) {
        target.value = text.trim();
        target.focus();
      } else {
        target.focus();
      }
    });
  });
  const tabPatterns: Record<string, RegExp> = {
    video: /^(https?:\/\/)?(www\.)?instagram\.com\/(p|tv)\//,
    reels: /^(https?:\/\/)?(www\.)?instagram\.com\/reel\//,
    story: /^(https?:\/\/)?(www\.)?instagram\.com\/stories\//,
    audio: /^(https?:\/\/)?(www\.)?instagram\.com\/(p|tv|reel)\//,
  };

  function setLoading(loading: boolean) {
    downloadBtn.disabled = loading;
    btnLabel.hidden = loading;
    btnSpinner.hidden = !loading;
  }

  function showError(msg: string) {
    errorText.textContent = msg;
    errorMsg.removeAttribute('hidden');
    resultMount.innerHTML = '';
  }

  function hideError() {
    errorMsg.setAttribute('hidden', '');
  }

  function formatDuration(secs: number): string {
    const m = Math.floor(secs / 60);
    const s = secs % 60;
    return `${m}:${s.toString().padStart(2, '0')}`;
  }

  function renderResult(data: any, inputUrl: string) {
    const {
      cover,      // thumbnail
      duration,
    } = data;

    const dlIcon = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';

    let actions = '';
    if (currentTabType === 'audio') {
      actions = `
        <button class="dl-tile dl-tile-hd" id="btn-dl-audio" type="button">
          <span class="dl-tile-icon" aria-hidden="true">${dlIcon}</span>
          <span class="dl-tile-label">Download <strong>MP3 Audio</strong></span>
          <span class="dl-proc-bar"></span>
        </button>`;
    } else if (currentTabType === 'story') {
      actions = `
        <button class="dl-tile dl-tile-sd" id="btn-dl-story" type="button">
          <span class="dl-tile-icon" aria-hidden="true">${dlIcon}</span>
          <span class="dl-tile-label">Download <strong>Story</strong></span>
          <span class="dl-proc-bar"></span>
        </button>`;
    } else {
      actions = `
        <button class="dl-tile dl-tile-sd" id="btn-dl-sd" type="button">
          <span class="dl-tile-icon" aria-hidden="true">${dlIcon}</span>
          <span class="dl-tile-label">Without Watermark</span>
          <span class="dl-proc-bar"></span>
        </button>
        <button class="dl-tile dl-tile-hd" id="btn-dl-hd" type="button">
          <span class="dl-tile-icon" aria-hidden="true">${dlIcon}</span>
          <span class="dl-tile-label">Without Watermark <strong>HD</strong></span>
          <span class="dl-proc-bar"></span>
        </button>`;
    }

    resultMount.innerHTML = `
      <div class="result-card animate-fade-in-up" role="region" aria-label="Download result">
        <div class="result-header">
          <div class="result-thumb-wrap">
            <img
              src="${cover}"
              alt="Video thumbnail"
              class="result-thumb"
              loading="lazy"
              width="120"
              height="160" />
            <span class="result-duration-badge text-caption-mono">${formatDuration(duration || 0)}</span>
          </div>
          <div class="result-info">
            <div class="result-actions">
          ${actions}
        </div>
          </div>
        </div>
      </div>
    `;

    const sdBtn = document.getElementById('btn-dl-sd') as HTMLButtonElement;
    const hdBtn = document.getElementById('btn-dl-hd') as HTMLButtonElement;
    const audioBtn = document.getElementById('btn-dl-audio') as HTMLButtonElement;
    const storyBtn = document.getElementById('btn-dl-story') as HTMLButtonElement;
    const origUrl = inputUrl;

    function startDownload(type: string, btn: HTMLButtonElement) {
      btn.classList.add('dl-tile-processing');
      btn.disabled = true;
      const labelEl = btn.querySelector('.dl-tile-label') as HTMLElement;
      const origLabel = labelEl?.textContent || '';
      if (labelEl) labelEl.textContent = 'Processing… 0%';
      const bar = btn.querySelector('.dl-proc-bar') as HTMLElement;
      if (bar) { bar.style.transition = 'none'; bar.style.width = '0%'; }

      const xhr = new XMLHttpRequest();
      xhr.open('GET', `/api/instagram-download?url=${encodeURIComponent(origUrl)}&type=${currentTabType}&dl=${type}`);
      xhr.responseType = 'blob';

      xhr.onprogress = function (e) {
        if (e.lengthComputable && bar && labelEl) {
          const pct = Math.round((e.loaded / e.total) * 100);
          bar.style.transition = 'none';
          bar.style.width = pct + '%';
          labelEl.textContent = 'Processing… ' + pct + '%';
        }
      };

      xhr.onload = function () {
        if (xhr.status === 200) {
          const blob = xhr.response;
          const blobUrl = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = blobUrl;
          a.download = currentTabType === 'audio' ? 'tiksavehub-audio.m4a' : 'tiksavehub-video.mp4';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(blobUrl), 60_000);
          btn.classList.add('dl-tile-done');
          setTimeout(() => btn.classList.remove('dl-tile-done'), 1500);
        } else {
          btn.classList.add('dl-tile-error');
          setTimeout(() => btn.classList.remove('dl-tile-error'), 2000);
        }
        btn.classList.remove('dl-tile-processing');
        btn.disabled = false;
        if (labelEl) labelEl.textContent = origLabel;
        if (bar) bar.style.width = '0%';
      };

      xhr.onerror = function () {
        btn.classList.add('dl-tile-error');
        setTimeout(() => btn.classList.remove('dl-tile-error'), 2000);
        btn.classList.remove('dl-tile-processing');
        btn.disabled = false;
        if (labelEl) labelEl.textContent = origLabel;
        if (bar) bar.style.width = '0%';
      };

      xhr.send();
    }

    sdBtn?.addEventListener('click', () => startDownload('sd', sdBtn));
    hdBtn?.addEventListener('click', () => startDownload('hd', hdBtn));
    audioBtn?.addEventListener('click', () => startDownload('audio', audioBtn));
    storyBtn?.addEventListener('click', () => startDownload('story', storyBtn));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    const url = urlInput.value.trim();

    if (!url) {
      showError(`Please paste an Instagram ${typeLabel} URL.`);
      return;
    }

    const pattern = tabPatterns[currentTabType];
    if (!pattern.test(url)) {
      const example =
        currentTabType === 'video'
          ? 'https://www.instagram.com/p/…'
          : `https://www.instagram.com/${currentTabType === 'audio' ? 'reel' : currentTabType}/…`;
      showError(`Please enter a valid Instagram ${typeLabel} URL (e.g. ${example})`);
      return;
    }

    setLoading(true);
    resultMount.innerHTML = '';

    try {
      const res = await fetch(`/api/instagram-download?url=${encodeURIComponent(url)}&type=${currentTabType}`);
      const text = await res.text();
      let json: any;
      try {
        json = JSON.parse(text);
      } catch {
        throw new Error('Invalid Instagram link or API is busy. Please check the link and try again.');
      }

      if (!res.ok || !json.success) {
        throw new Error(json.error || 'Failed to fetch content. Please try again.');
      }

      renderResult(json.video, url);
    } catch (err: any) {
      showError(err.message || 'Something went wrong. Please try again.');
    } finally {
      setLoading(false);
    }
  });
</script>

