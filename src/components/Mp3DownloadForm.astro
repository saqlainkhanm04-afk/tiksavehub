---
// Mp3DownloadForm — TikTok URL input for MP3 audio extraction
---

<section id="download-form" class="mp3-form-section">
  <div class="mp3-form-wrap">
    <form id="mp3-tiktok-form" class="form-row" role="search" aria-label="TikTok to MP3 converter" onsubmit="return false;">
      <div class="input-wrap">
        <span class="input-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18V5l12-2v13"/>
            <circle cx="6" cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
          </svg>
        </span>
        <input
          id="mp3-tiktok-url"
          name="url"
          type="url"
          class="form-input-lg url-input"
          placeholder="Paste TikTok link to convert to MP3"
          required
          autocomplete="off"
          spellcheck="false"
          aria-label="TikTok video URL for MP3 conversion"
        />
        <button
          type="button"
          class="paste-btn"
          data-paste-target="mp3-tiktok-url"
          aria-label="Paste TikTok link from clipboard"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
          </svg>
          <span class="paste-btn-label">Paste</span>
        </button>
      </div>
      <button
        id="mp3-download-btn"
        type="submit"
        class="btn-primary download-submit-btn mp3-submit-btn"
        aria-label="Convert to MP3"
      >
        <span id="mp3-btn-label" class="btn-icon-only">
          <svg class="icon-music" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18V5l12-2v13"/>
            <circle cx="6" cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
          </svg>
        </span>
        <span id="mp3-btn-spinner" class="spinner-wrap" hidden aria-label="Loading">
          <span class="spinner animate-spin" aria-hidden="true"></span>
          Converting…
        </span>
      </button>
    </form>

<p class="hero-notice" role="note">
      Notice: For personal use only. We do not host any media files on our servers. Please respect content creators' rights.
    </p>

    <p class="fetch-note" id="fetch-note" role="status" aria-live="polite" hidden>
      <span class="fetch-note-dot" aria-hidden="true"></span>
      <span>
        Please wait, <strong>fetching your audio</strong>… TikSaveHub's free TikTok to MP3
        converter is processing your link — it usually takes just a few seconds, and you get
        high-quality MP3 audio, no sign-up needed.
      </span>
    </p>

    <div id="mp3-error-msg" class="error-toast" hidden role="alert" aria-live="assertive">
      <span class="error-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </span>
      <span id="mp3-error-text">Something went wrong. Please try again.</span>
    </div>

    <div id="mp3-result-mount" class="result-mount"></div>

    <!-- Monetag ad slot — reserved height prevents layout shift (CLS) when the ad loads -->
    <div class="ad-slot" data-ad-slot="hero" aria-hidden="true"></div>
  </div>
</section>

<style>
  .mp3-form-section {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  .form-row {
    display: flex;
    gap: var(--spacing-sm);
    align-items: center;
    width: 100%;
  }

  .hero-notice {
    font-size: var(--text-caption);
    color: var(--color-mute);
    text-align: center;
    margin: var(--spacing-md) 0 0 0;
    line-height: 1.5;
    letter-spacing: -0.1px;
  }

  .fetch-note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--text-caption);
    color: var(--color-mute);
    text-align: left;
    margin: var(--spacing-sm) 0 0 0;
    line-height: 1.5;
    letter-spacing: -0.1px;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid rgba(121, 40, 202, 0.15);
    border-radius: var(--radius-md, 10px);
    background: rgba(121, 40, 202, 0.04);
    animation: fetch-note-in 0.25s ease;
  }

  html.dark .fetch-note {
    border-color: rgba(121, 40, 202, 0.35);
    background: rgba(121, 40, 202, 0.08);
  }

  .fetch-note[hidden] {
    display: none;
  }

  .fetch-note-dot {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    margin-top: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    box-shadow: 0 0 8px rgba(236, 72, 153, 0.6);
    animation: fetch-dot-pulse 1s ease-in-out infinite;
  }

  @keyframes fetch-note-in {
    from { opacity: 0; transform: translateY(-3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fetch-dot-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .ad-slot {
    min-height: 90px;
    margin: var(--spacing-sm) 0 0 0;
  }

  .input-wrap {
    position: relative;
    flex: 1;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-mute);
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .paste-btn {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 36px;
    padding: 0 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    cursor: pointer;
    z-index: 2;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .paste-btn:hover {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
  }

  .paste-btn:active {
    transform: translateY(-50%) scale(0.96);
  }

  .paste-btn svg {
    flex-shrink: 0;
    color: var(--color-mute);
  }

  .dark .paste-btn {
    background: rgba(255, 255, 255, 0.08);
    color: #a3a3a3;
    border-color: rgba(255, 255, 255, 0.1);
  }

  .dark .paste-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .dark .paste-btn:hover svg {
    color: #ffffff;
  }

  @media (max-width: 420px) {
    .paste-btn .paste-btn-label {
      display: none;
    }

    .paste-btn {
      width: 36px;
      padding: 0;
      justify-content: center;
    }

    .url-input {
      padding-right: 52px !important;
    }
  }

  .download-submit-btn {
    flex-shrink: 0;
    gap: 8px;
    padding: 0 var(--spacing-sm) !important;
    min-width: 48px;
    position: relative;
    overflow: hidden;
  }

  .mp3-submit-btn {
    background: linear-gradient(135deg, #7c3aed, #ec4899) !important;
  }

  .mp3-submit-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, #8b5cf6, #f472b6);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mp3-submit-btn:hover::after {
    opacity: 1;
  }

  .mp3-submit-btn > * {
    position: relative;
    z-index: 1;
  }

  .mp3-submit-btn:hover .icon-music {
    animation: music-bounce 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55);
    filter: drop-shadow(0 2px 4px rgba(124, 58, 237, 0.4));
  }

  @keyframes music-bounce {
    0% { transform: translateY(0) scale(1); }
    30% { transform: translateY(-4px) scale(1.1); }
    50% { transform: translateY(-2px) scale(1.05); }
    70% { transform: translateY(-3px) scale(1.08); }
    100% { transform: translateY(0) scale(1); }
  }

  .btn-icon-only {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .spinner-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .spinner {
    display: block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: white;
    border-radius: 50%;
  }

  .error-toast {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    background-color: var(--color-error-soft);
    color: var(--color-error-deep);
    font-size: var(--text-body-sm);
    font-weight: 500;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    margin-top: var(--spacing-md);
    border: 1px solid var(--color-error-soft);
    animation: fadeInUp 0.3s ease forwards;
  }

  .error-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .result-mount {
    margin-top: var(--spacing-lg);
  }

  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
      align-items: stretch;
      gap: var(--spacing-xs);
    }

    .download-submit-btn {
      width: 100%;
      height: 44px;
    }

    .paste-btn {
      min-height: 44px;
      min-width: 44px;
    }

    .error-toast {
      font-size: var(--text-caption);
      padding: var(--spacing-xs) var(--spacing-sm);
    }
  }
</style>

<script is:inline>
  (function initMp3FormLazy() {
    var trigger = document.getElementById('download-form') || document.querySelector('.mp3-form-section');
    if (!trigger) return;
    var loaded = false;
    var obs = new IntersectionObserver(function(entries) {
      if (!loaded && entries.some(function(e) { return e.isIntersecting; })) {
        loaded = true;
        obs.disconnect();
        var s = document.createElement('script');
        s.src = '/scripts/mp3-form.js';
        s.type = 'module';
        document.body.appendChild(s);
      }
    }, { rootMargin: '200px' });
    obs.observe(trigger);
  })();
</script>

<style is:global>
  .result-card {
    background-color: var(--color-canvas);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow:
      inset 0 0 0 1px #00000014,
      0px 2px 2px #0000000a,
      0px 8px 16px -4px #0000001a;
  }

  .result-header {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .result-thumb-wrap {
    position: relative;
    flex-shrink: 0;
    width: 80px;
    height: 108px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-canvas-soft-2);
  }

  .result-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .result-duration {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background-color: rgba(0,0,0,0.7);
    color: white;
    padding: 2px 5px;
    border-radius: 4px;
    font-size: 10px;
  }

  .result-info {
    flex: 1;
    min-width: 0;
  }

  .result-author {
    color: var(--color-mute);
    margin: 0 0 4px 0;
  }

  .result-title {
    font-size: var(--text-body-md);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0 0 var(--spacing-sm) 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    letter-spacing: -0.3px;
  }

  .result-stats {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .result-stat {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-caption);
    color: var(--color-body);
    font-family: var(--font-mono);
  }

  .result-actions {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-sm);
  }

  .result-btn {
    flex: 1;
    min-width: 160px;
    height: 44px !important;
    font-size: 14px !important;
  }

  .mp3-dl-btn {
    background: linear-gradient(135deg, #7c3aed, #ec4899) !important;
  }

  .mp3-dl-btn:hover {
    background: linear-gradient(135deg, #8b5cf6, #f472b6) !important;
    transform: translateY(-2px);
    box-shadow:
      0 4px 12px -2px rgba(124, 58, 237, 0.3),
      0 8px 24px -4px rgba(0, 0, 0, 0.15);
  }

  .audio-preview-wrap {
    margin-bottom: var(--spacing-sm);
    animation: fadeInUp 0.25s ease forwards;
  }

  .audio-player {
    width: 100%;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--color-canvas-soft);
  }

  .result-notice {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-caption);
    color: var(--color-mute);
    margin: 0;
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--color-hairline);
  }

  .no-audio-msg {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-body-sm);
    color: var(--color-mute);
    margin: 0;
    padding: var(--spacing-md);
    background-color: var(--color-canvas-soft);
    border-radius: var(--radius-md);
    width: 100%;
    justify-content: center;
  }

  .bitrate-selector {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
    padding: var(--spacing-md);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas-soft);
  }

  .bitrate-label {
    color: var(--color-mute);
    letter-spacing: 0.08em;
  }

  .bitrate-options {
    display: flex;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .bitrate-option {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-pill-sm);
    border: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
    color: var(--color-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .bitrate-option:hover {
    border-color: var(--color-hairline-strong);
    color: var(--color-ink);
  }

  .bitrate-option-active {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    border-color: transparent;
    color: #ffffff;
  }

  .bitrate-option-active:hover {
    color: #ffffff;
  }

  .bitrate-max {
    font-size: 10px;
    font-weight: 700;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: var(--radius-full);
    background-color: rgba(124, 58, 237, 0.15);
    color: #7c3aed;
  }

  .bitrate-option-active .bitrate-max {
    background-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  .bitrate-hint {
    font-size: var(--text-caption);
    color: var(--color-mute);
    margin: 0;
    line-height: 1.5;
  }

  html.dark .bitrate-option {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    color: #d4d4d4;
  }

  html.dark .bitrate-option-active {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #ffffff;
  }

  @media (max-width: 600px) {
    .bitrate-option {
      flex: 1;
      justify-content: center;
      padding: var(--spacing-xs);
    }
  }

  @media (max-width: 600px) {
    .result-header {
      flex-direction: row;
    }

    .result-thumb-wrap {
      width: 64px;
      height: 88px;
    }

    .result-actions {
      flex-direction: column;
    }

    .result-btn {
      width: 100%;
    }
  }
</style>
