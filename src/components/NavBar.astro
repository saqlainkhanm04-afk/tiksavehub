---
// NavBar component — sticky top nav following DESIGN.md nav-bar spec
import { sectionHref } from '../lib/pageSections';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LanguagePicker from './LanguagePicker.astro';

const currentPath = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const downloadHref = sectionHref(currentPath, 'download-form');

function localPath(path: string): string {
  if (lang === 'en') return path;
  return `/${lang}${path}`;
}
---

<header id="site-nav" class="site-nav">
  <div class="nav-inner">
    <!-- Logo -->
    <a href="/" class="nav-logo" id="nav-logo-link" aria-label="TikSaveHub home">
      <span class="nav-logo-text">TikSaveHub</span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="nav-links" role="navigation" aria-label="Main navigation">
      <a href={localPath('/tiktok-video-downloader-without-watermark')} class="nav-link nav-link-downloader" id="nav-link-downloader">
        <span class="dl-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        </span>
        {t('nav.downloader')}
      </a>
      <a href={localPath('/tiktok-to-mp3')} class="nav-link nav-link-mp3" id="nav-link-mp3">
        <span class="mp3-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        </span>
        {t('nav.mp3')}
      </a>
      <a href={localPath('/instagram-reels-downloader-without-watermark')} class="nav-link nav-link-ig" id="nav-link-ig">
        <span class="ig-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </span>
        {t('nav.instagram')}
      </a>
      <a href={localPath('/facebook-reels-downloader')} class="nav-link nav-link-fb" id="nav-link-fb">
        <span class="fb-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </span>
        {t('nav.facebook')}
      </a>
      <a href={localPath('/x-video-downloader')} class="nav-link nav-link-x" id="nav-link-x">
        <span class="x-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </span>
        {t('nav.twitter')}
      </a>
      <a href={localPath('/snapchat-downloader')} class="nav-link nav-link-sc" id="nav-link-sc">
        <span class="sc-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
        </span>
        {t('nav.snapchat')}
      </a>
      <a href={localPath('/blog')} class="nav-link nav-link-blog" id="nav-link-blog">
        <span class="blog-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </span>
        {t('nav.blog')}
      </a>
    </nav>

    <!-- Page Section Links + CTAs -->
    <div class="nav-right">
    <!-- Nav CTAs -->
    <div class="nav-ctas">
      <LanguagePicker />
      <button class="btn-nav theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        </button>
      <a href={downloadHref} class="btn-nav nav-cta-download" id="nav-cta-download">{t('nav.download_free')}</a>
    </div>
    </div>

    <!-- Mobile Hamburger -->
    <div class="nav-mobile-right">
      <div class="mobile-lang-wrap">
      <LanguagePicker uid="lang-mob" />
      </div>
      <button
        class="nav-hamburger"
        id="nav-hamburger"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu" hidden aria-label="Mobile navigation">
    <div class="mobile-menu-inner">
      <a href={localPath('/tiktok-video-downloader-without-watermark')} class="mobile-nav-link mobile-nav-link-downloader" id="mob-link-downloader">
        <span class="dl-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        </span>
        {t('nav.downloader')}
      </a>
      <a href={localPath('/tiktok-to-mp3')} class="mobile-nav-link mobile-nav-link-mp3" id="mob-link-mp3">
        <span class="mp3-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        </span>
        {t('nav.mp3')}
      </a>
      <a href={localPath('/instagram-reels-downloader-without-watermark')} class="mobile-nav-link mobile-nav-link-ig" id="mob-link-ig">
        <span class="ig-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </span>
        {t('nav.instagram')}
      </a>
      <a href={localPath('/facebook-reels-downloader')} class="mobile-nav-link mobile-nav-link-fb" id="mob-link-fb">
        <span class="fb-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </span>
        {t('nav.facebook')}
      </a>
      <a href={localPath('/x-video-downloader')} class="mobile-nav-link mobile-nav-link-x" id="mob-link-x">
        <span class="x-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </span>
        {t('nav.twitter')}
      </a>
      <a href={localPath('/snapchat-downloader')} class="mobile-nav-link mobile-nav-link-sc" id="mob-link-sc">
        <span class="sc-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
        </span>
        {t('nav.snapchat')}
      </a>
      <a href={localPath('/blog')} class="mobile-nav-link mobile-nav-link-blog" id="mob-link-blog">
        <span class="blog-nav-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </span>
        {t('nav.blog')}
      </a>
      <div class="mobile-section-divider" aria-hidden="true"></div>
      <a href="#how-it-works" class="mobile-nav-link" id="mob-link-how-it-works">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {t('nav.how_it_works')}
      </a>
      <a href="#features" class="mobile-nav-link" id="mob-link-features">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        {t('nav.features')}
      </a>
      <a href="#faq" class="mobile-nav-link" id="mob-link-faq">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        {t('nav.faq')}
      </a>
      <div class="mobile-row">
        <a href={downloadHref} class="btn-primary mobile-cta" id="mob-cta-download">{t('nav.download_free')}</a>
        <button class="btn-nav theme-toggle mobile-theme-toggle" id="mobile-theme-toggle" aria-label="Toggle dark mode" title="Toggle theme">
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-hairline);
    height: 64px;
    overflow: visible;
    transition: box-shadow 0.2s ease, background-color 0.3s ease;
  }

  .site-nav > .nav-inner {
    display: flex;
    align-items: center;
    height: 100%;
  }



  .dark .site-nav {
    background-color: rgba(23, 23, 23, 0.92) !important;
  }

  .dark .logo-icon-rect {
    fill: var(--color-canvas);
  }
  .dark .logo-icon-path {
    fill: var(--color-ink);
  }
  .dark .logo-icon-stroke {
    stroke: var(--color-ink);
  }

  .dark .nav-link {
    color: #a3a3a3;
  }

  .dark .nav-link:hover {
    color: #fafafa;
    background-color: rgba(255, 255, 255, 0.08);
  }

  .dark .nav-link-mp3 {
    color: #c084fc !important;
  }

  .dark .nav-link-mp3:hover {
    color: #e9d5ff !important;
    background-color: rgba(192, 132, 252, 0.12) !important;
  }

  .dark .mobile-nav-link {
    color: #a3a3a3;
  }

  .dark .mobile-nav-link:hover {
    color: #fafafa;
    background-color: rgba(255, 255, 255, 0.08);
  }

  .dark .mobile-nav-link-mp3 {
    color: #c084fc !important;
  }

  .dark .mobile-nav-link-mp3:hover {
    color: #e9d5ff !important;
    background-color: rgba(192, 132, 252, 0.12) !important;
  }

  .dark .theme-toggle {
    color: #fafafa;
  }

  .dark .hamburger-bar {
    background-color: #fafafa;
  }

  .site-nav.scrolled {
    box-shadow: 0px 1px 1px #00000008, 0px 4px 8px #0000000a;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    height: 100%;
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: var(--spacing-lg);
    overflow: visible;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo-icon {
    display: flex;
    align-items: center;
  }

  .nav-logo-text {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.8px;
    background: linear-gradient(135deg, #007cf0 0%, #00dfd8 50%, #7928ca 100%);
    background-size: 150% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: 0;
    flex-shrink: 1;
    min-width: 0;
    justify-content: flex-start;
    overflow-x: auto;
    overflow-y: hidden;
    flex-wrap: nowrap;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-link {
    color: var(--color-body);
    font-size: var(--text-body-sm);
    font-weight: 400;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
    letter-spacing: -0.28px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-link:hover {
    color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
  }

  /* ─── Snapchat Nav Button ─── */
  .nav-link-sc {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: linear-gradient(135deg, rgba(255, 252, 0, 0.12), rgba(255, 200, 0, 0.12)) !important;
    border: 1px solid rgba(255, 200, 0, 0.25) !important;
    color: #ca8a04 !important;
    font-weight: 600 !important;
    position: relative;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    animation: sc-nav-pulse 2s ease-in-out infinite;
  }

  .nav-link-sc::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255, 252, 0, 0.15), rgba(255, 200, 0, 0.15));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .nav-link-sc:hover {
    transform: scale(1.05) !important;
    box-shadow:
      0 0 20px rgba(255, 252, 0, 0.3),
      0 0 40px rgba(255, 200, 0, 0.15) !important;
    border-color: rgba(255, 200, 0, 0.5) !important;
    color: #a16207 !important;
    animation: none !important;
  }

  .nav-link-sc:hover::before { opacity: 1; }
  .nav-link-sc:active { transform: scale(0.92) !important; transition-duration: 0.1s !important; }
  .nav-link-sc > * { position: relative; z-index: 1; }
  .nav-link-sc:hover .sc-nav-icon { animation: sc-icon-bounce 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55); }
  .sc-nav-icon { display: flex; align-items: center; transition: transform 0.2s ease; }

  @keyframes sc-nav-pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(255, 252, 0, 0); } 50% { box-shadow: 0 0 8px 2px rgba(255, 252, 0, 0.15); } }
  @keyframes sc-icon-bounce { 0% { transform: translateY(0) scale(1); } 30% { transform: translateY(-3px) scale(1.15); } 50% { transform: translateY(-1px) scale(1.05); } 70% { transform: translateY(-2px) scale(1.1); } 100% { transform: translateY(0) scale(1); } }

  .dark .nav-link-sc { color: #facc15 !important; }
  .dark .nav-link-sc:hover { color: #fde047 !important; border-color: rgba(250, 204, 21, 0.5) !important; }

  /* ─── Mobile Snapchat Nav Link ─── */
  .mobile-nav-link-sc {
    display: flex !important;
    align-items: center;
    gap: 6px;
    color: #ca8a04 !important;
    font-weight: 600 !important;
    background: linear-gradient(135deg, rgba(255, 252, 0, 0.08), rgba(255, 200, 0, 0.08)) !important;
    border: 1px solid rgba(255, 200, 0, 0.2) !important;
    margin-top: 2px;
    margin-bottom: 2px;
    transition: color 0.25s ease, background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease !important;
    animation: sc-nav-pulse 2s ease-in-out infinite;
  }

  .mobile-nav-link-sc:hover {
    background: linear-gradient(135deg, rgba(255, 252, 0, 0.15), rgba(255, 200, 0, 0.15)) !important;
    border-color: rgba(255, 200, 0, 0.4) !important;
    transform: translateX(4px);
  }

  /* ─── Snapchat Click Animation ─── */
  .nav-link-sc.sc-clicked,
  .mobile-nav-link-sc.sc-clicked {
    animation: sc-click-pop 0.4s cubic-bezier(0.68, -0.55, 0.27, 1.55) !important;
  }

  @keyframes sc-click-pop {
    0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 252, 0, 0.4); }
    30% { transform: scale(0.88); box-shadow: 0 0 0 6px rgba(255, 252, 0, 0); }
    60% { transform: scale(1.08); box-shadow: 0 0 20px 4px rgba(255, 252, 0, 0.2); }
    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 252, 0, 0); }
  }

  /* ─── Blog Nav Button ─── */
  .nav-link-blog {
    display: inline-flex;
    align-items: center;
    gap: 4px;
