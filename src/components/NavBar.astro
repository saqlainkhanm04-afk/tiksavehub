<script>
  // Scroll effect (throttled via rAF)
  const nav = document.getElementById('site-nav');
  let navTicking = false;
  window.addEventListener('scroll', () => {
    if (navTicking) return;
    navTicking = true;
    requestAnimationFrame(() => {
      if (window.scrollY > 8) {
        nav?.classList.add('scrolled');
      } else {
        nav?.classList.remove('scrolled');
      }
      navTicking = false;
    });
  }, { passive: true });

  // Hamburger toggle
  const hamburger = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  hamburger?.addEventListener('click', () => {
    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', String(!isOpen));
    if (isOpen) {
      mobileMenu?.setAttribute('hidden', '');
    } else {
      mobileMenu?.removeAttribute('hidden');
    }
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      hamburger?.setAttribute('aria-expanded', 'false');
      mobileMenu?.setAttribute('hidden', '');
    });
  });

  // MP3 nav button click animation
  const mp3NavLinks = document.querySelectorAll('.nav-link-mp3, .mobile-nav-link-mp3');
  mp3NavLinks.forEach(link => {
    link.addEventListener('click', () => {
      link.classList.add('mp3-clicked');
      setTimeout(() => link.classList.remove('mp3-clicked'), 400);
    });
  });

  // Downloader nav button click animation
  const dlNavLinks = document.querySelectorAll('.nav-link-downloader, .mobile-nav-link-downloader');
  dlNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      link.classList.add('dl-clicked');
      setTimeout(() => link.classList.remove('dl-clicked'), 400);
    });
  });

  // Blog nav button click animation
  const blogNavLinks = document.querySelectorAll('.nav-link-blog, .mobile-nav-link-blog');
  blogNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      link.classList.add('blog-clicked');
      setTimeout(() => link.classList.remove('blog-clicked'), 400);
    });
  });

  // Instagram nav button click animation
  const igNavLinks = document.querySelectorAll('.nav-link-ig, .mobile-nav-link-ig');
  igNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      link.classList.add('ig-clicked');
      setTimeout(() => link.classList.remove('ig-clicked'), 400);
    });
  });

  // Facebook nav button click animation
  const fbNavLinks = document.querySelectorAll('.nav-link-fb, .mobile-nav-link-fb');
  fbNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      link.classList.add('fb-clicked');
      setTimeout(() => link.classList.remove('fb-clicked'), 400);
    });
  });

  // X/Twitter nav button click animation
  const xNavLinks = document.querySelectorAll('.nav-link-x, .mobile-nav-link-x');
  xNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      link.classList.add('x-clicked');
      setTimeout(() => link.classList.remove('x-clicked'), 400);
    });
  });

  // Snapchat nav button click animation
  const scNavLinks = document.querySelectorAll('.nav-link-sc, .mobile-nav-link-sc');
  scNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      link.classList.add('sc-clicked');
      setTimeout(() => link.classList.remove('sc-clicked'), 400);
    });
  });

  // Dark mode toggle with animation
  const themeToggle = document.getElementById('theme-toggle');
  const mobileThemeToggle = document.getElementById('mobile-theme-toggle');

  function toggleTheme(btn: HTMLElement) {
    if (!btn) return;
    btn.classList.add('animating');
    setTimeout(() => btn.classList.remove('animating'), 500);

    const html = document.documentElement;
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
  }

  themeToggle?.addEventListener('click', () => toggleTheme(themeToggle));
  mobileThemeToggle?.addEventListener('click', () => toggleTheme(mobileThemeToggle));

  // Active nav link highlighting based on current route
  (function setActiveNavLink() {
    const path = window.location.pathname;
    const linkMap: Record<string, string[]> = {
      'nav-link-downloader': ['/tiktok-video-downloader-without-watermark'],
      'nav-link-mp3': ['/tiktok-to-mp3'],
      'nav-link-ig': ['/instagram-video-downloader-without-watermark', '/instagram-reels-downloader-without-watermark', '/instagram-story-downloader-without-watermark', '/instagram-audio-downloader'],
      'nav-link-fb': ['/facebook-video-downloader', '/facebook-reels-downloader', '/facebook-to-mp3', '/facebook-story-downloader', '/facebook-photo-downloader'],
      'nav-link-x': ['/x-video-downloader'],
      'nav-link-sc': ['/snapchat-downloader', '/snapchat-story-downloader', '/snapchat-to-mp3'],
      'nav-link-blog': ['/blog'],
    };

    const mobMap: Record<string, string[]> = {
      'mob-link-downloader': ['/tiktok-video-downloader-without-watermark'],
      'mob-link-mp3': ['/tiktok-to-mp3'],
      'mob-link-ig': ['/instagram-video-downloader-without-watermark', '/instagram-reels-downloader-without-watermark', '/instagram-story-downloader-without-watermark', '/instagram-audio-downloader'],
      'mob-link-fb': ['/facebook-video-downloader', '/facebook-reels-downloader', '/facebook-to-mp3', '/facebook-story-downloader', '/facebook-photo-downloader'],
      'mob-link-x': ['/x-video-downloader'],
      'mob-link-sc': ['/snapchat-downloader', '/snapchat-story-downloader', '/snapchat-to-mp3'],
      'mob-link-blog': ['/blog'],
    };

    function applyActive(map: Record<string, string[]>) {
      for (const [id, routes] of Object.entries(map)) {
        const el = document.getElementById(id);
        if (!el) continue;
        const isActive = routes.some(r => path === r || path.startsWith(r + '/'));
        if (isActive) {
          el.classList.add('nav-link-active');
        }
      }
    }

    applyActive(linkMap);
    applyActive(mobMap);
  })();
</script>
