<script>
  // Scroll effect
  const nav = document.getElementById('site-nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 8) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Hamburger toggle
  const hamburger = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  hamburger?.addEventListener('click', () => {
    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', String(!isOpen));
    if (isOpen) {
      mobileMenu?.setAttribute('hidden', '');
    } else {
      mobileMenu?.removeAttribute('hidden');
    }
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      hamburger?.setAttribute('aria-expanded', 'false');
      mobileMenu?.setAttribute('hidden', '');
    });
  });

  // MP3 nav button click animation
  const mp3NavLinks = document.querySelectorAll('.nav-link-mp3, .mobile-nav-link-mp3');
  mp3NavLinks.forEach(link => {
    link.addEventListener('click', () => {
      link.classList.add('mp3-clicked');
      setTimeout(() => link.classList.remove('mp3-clicked'), 400);
    });
  });

  // Downloader nav button click animation
  const dlNavLinks = document.querySelectorAll('.nav-link-downloader, .mobile-nav-link-downloader');
  dlNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      link.classList.add('dl-clicked');
      setTimeout(() => link.classList.remove('dl-clicked'), 400);
    });
  });

  // Blog nav button click animation
  const blogNavLinks = document.querySelectorAll('.nav-link-blog, .mobile-nav-link-blog');
  blogNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      link.classList.add('blog-clicked');
      setTimeout(() => link.classList.remove('blog-clicked'), 400);
    });
  });

  // Instagram nav button click animation
  const igNavLinks = document.querySelectorAll('.nav-link-ig, .mobile-nav-link-ig');
  igNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      link.classList.add('ig-clicked');
      setTimeout(() => link.classList.remove('ig-clicked'), 400);
    });
  });

  // Dark mode toggle with animation
  const themeToggle = document.getElementById('theme-toggle');
  const mobileThemeToggle = document.getElementById('mobile-theme-toggle');

  function toggleTheme(btn: HTMLElement) {
    if (!btn) return;
    btn.classList.add('animating');
    setTimeout(() => btn.classList.remove('animating'), 500);

    const html = document.documentElement;
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
  }

  themeToggle?.addEventListener('click', () => toggleTheme(themeToggle));
  mobileThemeToggle?.addEventListener('click', () => toggleTheme(mobileThemeToggle));
</script>
