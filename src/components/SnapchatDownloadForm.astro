---
// SnapchatDownloadForm — interactive Snapchat video URL input with fetch & result rendering
// Supports Spotlight, Story, and Post links.
// API: POST /api/snapchat (metadata) + GET /api/snapchat?url=&dl= (file download).
// mode: 'video' (default) | 'story' | 'mp3' — adjusts copy and tab highlighting.

interface Props {
  mode?: 'video' | 'story' | 'mp3';
  showAudio?: boolean;
}

const { mode = 'video', showAudio = true } = Astro.props;

const tabLinks = [
  {
    mode: 'video',
    label: 'Snapchat',
    href: '/snapchat-downloader',
    active: mode === 'video',
    main: true,
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>',
  },
  {
    mode: 'story',
    label: 'Story',
    href: '/snapchat-story-downloader',
    active: mode === 'story',
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  },
  ...(showAudio ? [{
    mode: 'mp3' as const,
    label: 'Audio',
    href: '/snapchat-to-mp3',
    active: mode === 'mp3',
    icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>',
  }] : []),
];

const copy = {
  video: {
    placeholder: 'Paste Snapchat Spotlight or video link',
    inputAria: 'Snapchat video URL',
    pasteAria: 'Paste Snapchat link from clipboard',
    submitAria: 'Download Snapchat video',
    fetch: 'Please wait, <strong>fetching your video</strong>… TikSaveHub\'s free Snapchat video downloader is processing your link — it usually takes just a few seconds, and you get the video in HD, no login needed.',
  },
  story: {
    placeholder: 'Paste Snapchat story link',
    inputAria: 'Snapchat story URL',
    pasteAria: 'Paste Snapchat story link from clipboard',
    submitAria: 'Download Snapchat story',
    fetch: 'Please wait, <strong>fetching your story</strong>… TikSaveHub\'s free Snapchat story downloader is processing your link — it usually takes just a few seconds, and you get the story in HD, no login needed.',
  },
  mp3: {
    placeholder: 'Paste Snapchat video or Spotlight link to convert to MP3',
    inputAria: 'Snapchat video URL to convert to MP3',
    pasteAria: 'Paste Snapchat link from clipboard to convert to MP3',
    submitAria: 'Convert Snapchat video to MP3',
    fetch: 'Please wait, <strong>fetching your audio</strong>… TikSaveHub\'s free Snapchat to MP3 converter is processing your link — it usually takes just a few seconds, and you get a high-quality MP3, no login needed.',
  },
}[mode];
---

<section id="download-form" class="download-form-section" data-type="snapchat" data-mode={mode}>
  <!-- Cloudflare Turnstile — invisible widget for cobalt API auth -->
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  <div id="cf-turnstile-container" style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;" aria-hidden="true"></div>
  <div class="download-form-wrap">
    <nav class="sc-tabs" aria-label="Choose Snapchat download type">
      {
        tabLinks.map((tab) => (
          <a
            class:list={[
              'sc-tab',
              tab.active && 'sc-tab-active',
              tab.main && 'sc-tab-main',
            ]}
            href={tab.href}
            aria-current={tab.active ? 'page' : undefined}
            set:html={`${tab.icon}<span>${tab.label}</span>`}
          >
          </a>
        ))
      }
    </nav>

    <form id="snapchat-form" class="form-row" role="search" aria-label="Snapchat video download form" onsubmit="return false;">
      <div class="input-wrap">
        <span class="input-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
        </span>
        <input
          id="snapchat-url"
          name="url"
          type="url"
          class="form-input-lg url-input"
          placeholder={copy.placeholder}
          required
          autocomplete="off"
          spellcheck="false"
          aria-label={copy.inputAria}
        />
        <button
          type="button"
          class="clear-btn"
          id="snapchat-clear"
          aria-label="Clear Snapchat URL input"
          hidden
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
        <button
          type="button"
          class="paste-btn"
          data-paste-target="snapchat-url"
          aria-label={copy.pasteAria}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
          </svg>
          <span class="paste-btn-label">Paste</span>
        </button>
      </div>
      <button
        id="download-btn"
        type="submit"
        class="btn-primary download-submit-btn"
        aria-label={copy.submitAria}
      >
        <span id="btn-label" class="btn-icon-only">
          <svg class="icon-download" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </span>
        <span id="btn-spinner" class="spinner-wrap" hidden aria-label="Loading">
          <span class="spinner animate-spin" aria-hidden="true"></span>
          Processing…
        </span>
      </button>
    </form>

    <p class="hero-notice" role="note">
      Notice: For personal use only. We do not host any media files on our servers. Please respect content creators' rights.
    </p>

    <p class="fetch-note" id="fetch-note" role="status" aria-live="polite" hidden>
      <span class="fetch-note-dot" aria-hidden="true"></span>
      <span set:html={copy.fetch}></span>
    </p>

    <!-- Error banner -->
    <div id="error-msg" class="error-toast" hidden role="alert" aria-live="assertive">
      <span class="error-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </span>
      <span id="error-text">Something went wrong. Please try again.</span>
    </div>

    <!-- Result card mount point -->
    <div id="result-mount" class="result-mount"></div>

    <!-- Monetag ad slot — reserved height prevents layout shift (CLS) when the ad loads -->
    <div class="ad-slot" data-ad-slot="hero" aria-hidden="true"></div>
  </div>
</section>

<style>
  .download-form-section {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  /* ——— Tab Group ——— */
  .sc-tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
    flex-wrap: wrap;
    animation: fadeInUp 0.5s ease 0.35s both;
  }

  .sc-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
    color: var(--color-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    letter-spacing: -0.28px;
    cursor: pointer;
    font-family: inherit;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    min-height: 44px;
    transition: color 0.25s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sc-tab svg {
    color: var(--color-mute);
    transition: color 0.2s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sc-tab::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 60%;
    height: 100%;
    background: linear-gradient(105deg, transparent 20%, rgba(255, 255, 255, 0.45) 50%, transparent 80%);
    transform: translateX(-160%) skewX(-20deg);
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .sc-tab:hover {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -2px rgba(255, 252, 0, 0.15);
  }

  .sc-tab:hover::after {
    transform: translateX(260%) skewX(-20deg);
  }

  .sc-tab:hover svg {
    color: var(--color-ink);
    transform: scale(1.15) rotate(-8deg);
  }

  .sc-tab-active {
    background: linear-gradient(135deg, rgba(255, 252, 0, 0.14), rgba(255, 200, 0, 0.14)) !important;
    border-color: rgba(255, 200, 0, 0.4) !important;
    color: #ca8a04 !important;
    font-weight: 600 !important;
  }

  .sc-tab-active svg {
    color: #ca8a04 !important;
  }

  html.dark .sc-tab {
    background-color: var(--color-canvas);
    border-color: rgba(255, 255, 255, 0.1);
    color: #a3a3a3;
  }

  html.dark .sc-tab::after {
    background: linear-gradient(105deg, transparent 20%, rgba(255, 255, 255, 0.18) 50%, transparent 80%);
  }

  html.dark .sc-tab:hover {
    color: #fafafa;
    border-color: rgba(255, 255, 255, 0.2);
  }

  html.dark .sc-tab:hover svg {
    color: #fafafa;
  }

  html.dark .sc-tab-active {
    color: #facc15 !important;
    border-color: rgba(250, 204, 21, 0.4) !important;
    background: linear-gradient(135deg, rgba(255, 252, 0, 0.14), rgba(255, 200, 0, 0.14)) !important;
  }

  html.dark .sc-tab-active svg {
    color: #facc15 !important;
  }

  /* ——— Snapchat Tab — main tool — brand yellow pill ——— */
  .sc-tab-main {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #FFFC00, #FFC800) !important;
    border: 1px solid rgba(255, 252, 0, 0.6) !important;
    color: #000000 !important;
    font-weight: 600 !important;
    position: relative;
    overflow: hidden;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    animation: sc-tab-pulse 2s ease-in-out infinite;
  }

  .sc-tab-main svg {
    color: #000000 !important;
    transition: color 0.2s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sc-tab-main:hover {
    transform: translateY(-1px);
    background: linear-gradient(135deg, #F5F200, #E6B800) !important;
    color: #000000 !important;
    border-color: rgba(255, 252, 0, 0.8) !important;
    box-shadow:
      0 0 20px rgba(255, 252, 0, 0.35),
      0 0 40px rgba(255, 200, 0, 0.2) !important;
    animation: none !important;
  }

  .sc-tab-main:active {
    transform: translateY(0);
    transition-duration: 0.1s;
  }

  .sc-tab-main:hover svg {
    color: #000000 !important;
    transform: scale(1.2) rotate(-10deg);
  }

  html.dark .sc-tab-main {
    background: linear-gradient(135deg, #FFFC00, #FFC800) !important;
    border: 1px solid rgba(250, 204, 21, 0.5) !important;
    color: #000000 !important;
    animation-name: sc-tab-pulse-dark;
  }

  html.dark .sc-tab-main svg {
    color: #000000 !important;
  }

  html.dark .sc-tab-main:hover {
    background: linear-gradient(135deg, #F5F200, #E6B800) !important;
    color: #000000 !important;
    border-color: rgba(250, 204, 21, 0.7) !important;
  }

  .sc-tab-main.sc-tab-active {
    background: linear-gradient(135deg, #FFFC00, #FFC800) !important;
    border-color: rgba(255, 252, 0, 0.6) !important;
    color: #000000 !important;
  }

  .sc-tab-main.sc-tab-active svg {
    color: #000000 !important;
  }

  html.dark .sc-tab-main.sc-tab-active {
    background: linear-gradient(135deg, #FFFC00, #FFC800) !important;
    border-color: rgba(250, 204, 21, 0.5) !important;
    color: #000000 !important;
  }

  @keyframes sc-tab-pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(255, 252, 0, 0);
    }
    50% {
      box-shadow: 0 0 8px 2px rgba(255, 252, 0, 0.25);
    }
  }

  @keyframes sc-tab-pulse-dark {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(250, 204, 21, 0);
    }
    50% {
      box-shadow: 0 0 8px 2px rgba(250, 204, 21, 0.2);
    }
  }

  @media (max-width: 600px) {
    .sc-tabs {
      gap: 6px;
    }

    .sc-tab {
      padding: var(--spacing-xs) var(--spacing-sm);
      font-size: var(--text-caption);
    }
  }

  .form-row {
    display: flex;
    gap: var(--spacing-sm);
    align-items: center;
    width: 100%;
  }

  .hero-notice {
    font-size: var(--text-caption);
    color: var(--color-mute);
    text-align: center;
    margin: var(--spacing-md) 0 0 0;
    line-height: 1.5;
    letter-spacing: -0.1px;
  }

  .fetch-note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--text-caption);
    color: var(--color-mute);
    text-align: left;
    margin: var(--spacing-sm) 0 0 0;
    line-height: 1.5;
    letter-spacing: -0.1px;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid rgba(202, 138, 4, 0.15);
    border-radius: var(--radius-md, 10px);
    background: rgba(202, 138, 4, 0.04);
    animation: fetch-note-in 0.25s ease;
  }

  html.dark .fetch-note {
    border-color: rgba(202, 138, 4, 0.35);
    background: rgba(202, 138, 4, 0.08);
  }

  .fetch-note[hidden] {
    display: none;
  }

  .fetch-note-dot {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    margin-top: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, #FFFC00, #FFC800);
    box-shadow: 0 0 8px rgba(255, 200, 0, 0.6);
    animation: fetch-dot-pulse 1s ease-in-out infinite;
  }

  @keyframes fetch-note-in {
    from { opacity: 0; transform: translateY(-3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fetch-dot-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .ad-slot {
    min-height: 90px;
    margin: var(--spacing-sm) 0 0 0;
  }

  .input-wrap {
    position: relative;
    flex: 1;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-mute);
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .paste-btn,
  .clear-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 36px;
    padding: 0 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    cursor: pointer;
    z-index: 2;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .paste-btn:focus-visible,
  .clear-btn:focus-visible {
    outline: 2px solid #ca8a04;
    outline-offset: 2px;
  }

  .paste-btn {
    right: 8px;
  }

  .clear-btn {
    right: 96px;
    width: 36px;
    padding: 0;
    justify-content: center;
    color: var(--color-mute);
  }

  .paste-btn:hover,
  .clear-btn:hover {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
  }

  .paste-btn:active,
  .clear-btn:active {
    transform: translateY(-50%) scale(0.96);
  }

  .paste-btn svg,
  .clear-btn svg {
    flex-shrink: 0;
    color: currentColor;
  }

  .dark .paste-btn,
  .dark .clear-btn {
    background: rgba(255, 255, 255, 0.08);
    color: #a3a3a3;
    border-color: rgba(255, 255, 255, 0.1);
  }

  .dark .paste-btn:hover,
  .dark .clear-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  @media (max-width: 520px) {
    .paste-btn .paste-btn-label {
      display: none;
    }

    .paste-btn {
      width: 36px;
      padding: 0;
      justify-content: center;
    }

    .clear-btn {
      right: 52px;
    }

    .url-input {
      padding-right: 96px !important;
    }
  }

  .download-submit-btn {
    flex-shrink: 0;
    gap: 8px;
    padding: 0 var(--spacing-sm) !important;
    min-width: 48px;
    position: relative;
    overflow: hidden;
  }

  .btn-icon-only {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .spinner-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .spinner {
    display: block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
  }

  .download-submit-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--color-grad-develop-start), var(--color-grad-develop-end));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .download-submit-btn:hover::after {
    opacity: 1;
  }

  .download-submit-btn > * {
    position: relative;
    z-index: 1;
  }

  .download-submit-btn:hover .icon-download {
    animation: download-bounce 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55);
    filter: drop-shadow(0 2px 4px rgba(0, 124, 240, 0.4));
  }

  @keyframes download-bounce {
    0% { transform: translateY(0) scale(1); }
    30% { transform: translateY(-4px) scale(1.1); }
    50% { transform: translateY(-2px) scale(1.05); }
    70% { transform: translateY(-3px) scale(1.08); }
    100% { transform: translateY(0) scale(1); }
  }

  .error-toast {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    background-color: var(--color-error-soft);
    color: var(--color-error-deep);
    font-size: var(--text-body-sm);
    font-weight: 500;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    margin-top: var(--spacing-md);
    border: 1px solid var(--color-error-soft);
    animation: fadeInUp 0.3s ease forwards;
  }

  .error-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .result-mount {
    margin-top: var(--spacing-lg);
  }

  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
      align-items: stretch;
      gap: var(--spacing-xs);
    }

    .download-submit-btn {
      width: 100%;
      height: 44px;
    }

    .paste-btn {
      min-height: 44px;
      min-width: 44px;
    }

    .error-toast {
      font-size: var(--text-caption);
      padding: var(--spacing-xs) var(--spacing-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .download-submit-btn:hover .icon-download {
      animation: none;
    }
  }
</style>

<style is:global>
  .sc-result-card {
    background-color: var(--color-canvas);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow:
      inset 0 0 0 1px #00000014,
      0px 2px 2px #0000000a,
      0px 8px 16px -4px #0000001a;
  }

  .sc-result-header {
    display: flex;
    gap: var(--spacing-md);
    align-items: stretch;
    min-height: 160px;
  }

  .sc-result-thumb-wrap {
    position: relative;
    flex-shrink: 0;
    width: 120px;
    min-height: 160px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-canvas-soft-2);
  }

  .sc-result-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .sc-result-thumb-wrap.thumb-failed .sc-result-thumb {
    display: none;
  }

  .sc-result-thumb-wrap.thumb-failed {
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, #FFFC00 10%, white), transparent 60%),
      var(--color-canvas-soft-2);
  }

  .sc-result-thumb-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-mute);
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, #FFFC00 10%, white), transparent 60%),
      var(--color-canvas-soft-2);
  }

  html.dark .sc-result-thumb-fallback {
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, #FFFC00 18%, transparent), transparent 70%),
      rgba(255, 255, 255, 0.04);
  }

  .sc-result-duration-badge {
    position: absolute;
    bottom: 6px;
    right: 6px;
    background-color: rgba(0, 0, 0, 0.78);
    color: #fff;
    padding: 3px 7px;
    border-radius: var(--radius-xs);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .sc-result-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--spacing-sm);
  }

  .sc-result-title {
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.4;
    letter-spacing: -0.2px;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sc-result-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  /* Download tiles */
  .sc-dl-tile {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--color-hairline);
    background-color: var(--color-canvas);
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    position: relative;
    overflow: hidden;
    box-shadow: 0px 1px 2px #00000006;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .sc-dl-tile:hover {
    border-color: var(--color-hairline-strong);
    transform: translateY(-1px);
    box-shadow: 0px 4px 12px #0000000a;
  }

  .sc-dl-tile:active {
    transform: translateY(0);
  }

  .sc-dl-tile:focus-visible {
    outline: 2px solid #ca8a04;
    outline-offset: 2px;
  }

  .sc-dl-proc-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2.5px;
    width: 0;
    background: linear-gradient(90deg, #FFFC00, #FFC800, #ca8a04, #FFFC00);
    background-size: 200% 100%;
    border-radius: 0 0 8px 8px;
    transition: none;
    pointer-events: none;
    animation: sc-proc-shimmer 1.5s linear infinite;
  }

  @keyframes sc-proc-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .sc-dl-tile-processing {
    pointer-events: none;
  }

  .sc-dl-tile-processing .sc-dl-tile-icon svg {
    animation: sc-dl-pulse 1s ease-in-out infinite;
  }

  .sc-dl-tile-done {
    border-color: #22c55e !important;
    background-color: #f0fdf4 !important;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  html.dark .sc-dl-tile-done {
    background-color: rgba(34, 197, 94, 0.1) !important;
    border-color: rgba(34, 197, 94, 0.4) !important;
  }

  .sc-dl-tile-error {
    border-color: #ef4444 !important;
    background-color: #fef2f2 !important;
    animation: sc-dl-shake 0.4s ease;
  }

  html.dark .sc-dl-tile-error {
    background-color: rgba(239, 68, 68, 0.1) !important;
    border-color: rgba(239, 68, 68, 0.4) !important;
  }

  @keyframes sc-dl-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.9); }
  }

  @keyframes sc-dl-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    50% { transform: translateX(4px); }
    75% { transform: translateX(-2px); }
  }

  .sc-dl-tile-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    color: #fff;
    background: linear-gradient(135deg, #FFFC00, #FFC800);
    box-shadow:
      0 3px 10px -2px rgba(255, 252, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transition: transform 0.2s ease;
  }

  .sc-dl-tile:hover .sc-dl-tile-icon {
    transform: scale(1.06);
  }

  .sc-dl-tile-label {
    flex: 1;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.3;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sc-dl-tile-label strong {
    font-weight: 700;
    background: linear-gradient(135deg, #ca8a04, #eab308);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 1px;
  }

  html.dark .sc-dl-tile-label strong {
    background: linear-gradient(135deg, #facc15, #fde047);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .sc-dl-badge {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000000;
    background: linear-gradient(135deg, #FFFC00, #FFC800);
    padding: 3px 8px;
    border-radius: 6px;
    box-shadow:
      0 2px 8px rgba(255, 252, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    position: relative;
    z-index: 1;
  }

  html.dark .sc-dl-tile-icon {
    background: linear-gradient(135deg, #F5F200, #FFC800);
    box-shadow:
      0 3px 10px -2px rgba(255, 252, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  /* Audio tile */
  .sc-dl-tile-audio {
    background: linear-gradient(135deg, #f5f1ff, #ece3fd);
    border-color: #cbb7f2;
  }

  html.dark .sc-dl-tile-audio {
    background: linear-gradient(135deg, rgba(121, 40, 202, 0.08), rgba(121, 40, 202, 0.14));
    border-color: rgba(139, 92, 246, 0.4);
  }

  .sc-dl-tile-audio:hover {
    border-color: #7928ca;
    box-shadow: 0px 4px 16px rgba(121, 40, 202, 0.18);
  }

  .sc-dl-tile-audio .sc-dl-tile-icon {
    color: #7928ca;
    background-color: rgba(121, 40, 202, 0.1);
    box-shadow: none;
  }

  .sc-dl-tile-audio .sc-dl-tile-label strong {
    background: linear-gradient(135deg, #7928ca, #a855f7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  html.dark .sc-dl-tile-audio .sc-dl-tile-icon {
    background-color: rgba(121, 40, 202, 0.18);
  }

  html.dark .sc-dl-tile-audio .sc-dl-tile-label strong {
    background: linear-gradient(135deg, #b794f6, #c084fc);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Audio tile — violet accent */
  .sc-dl-tile-audio.sc-dl-tile-prime {
    border-color: #7928ca;
    box-shadow: 0px 4px 16px rgba(121, 40, 202, 0.22);
  }

  .sc-dl-tile-audio.sc-dl-tile-prime:hover {
    border-color: #6d28d9;
    box-shadow: 0px 6px 20px rgba(121, 40, 202, 0.28);
  }

  .sc-dl-tile-badge {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, #FFFC00, #FFC800);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    box-shadow: 0 2px 8px rgba(255, 252, 0, 0.35);
    color: #000000;
  }

  @media (max-width: 600px) {
    .sc-result-header {
      flex-direction: column;
    }

    .sc-result-thumb-wrap {
      width: 100%;
      min-height: 180px;
    }

    .sc-dl-tile {
      padding: 10px 12px;
      gap: 8px;
    }

    .sc-dl-tile-icon {
      width: 32px;
      height: 32px;
    }

    .sc-dl-tile-icon svg {
      width: 16px;
      height: 16px;
    }

    .sc-dl-tile-label {
      font-size: 12px;
    }

    .sc-dl-badge {
      font-size: 9px;
      padding: 2px 6px;
      letter-spacing: 0.08em;
    }
  }
</style>

<script>
  const form = document.getElementById('snapchat-form') as HTMLFormElement;
  const urlInput = document.getElementById('snapchat-url') as HTMLInputElement;
  const clearBtn = document.getElementById('snapchat-clear') as HTMLButtonElement;
  const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
  const btnLabel = document.getElementById('btn-label') as HTMLElement;
  const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;
  const errorMsg = document.getElementById('error-msg') as HTMLElement;
  const errorText = document.getElementById('error-text') as HTMLElement;
  const resultMount = document.getElementById('result-mount') as HTMLElement;

  const URL_PATTERN =
    /^(https?:\/\/)?(www\.|m\.|)?(snapchat\.com|story\.snapchat\.com)\//i;

  function setLoading(loading: boolean) {
    downloadBtn.disabled = loading;
    btnLabel.hidden = loading;
    btnSpinner.hidden = !loading;
    const fetchNote = document.getElementById('fetch-note');
    if (fetchNote) fetchNote.hidden = !loading;
  }

  function showError(msg: string) {
    errorText.textContent = msg;
    errorMsg.removeAttribute('hidden');
    resultMount.innerHTML = '';
  }

  function hideError() {
    errorMsg.setAttribute('hidden', '');
  }

  function updateClearState() {
    clearBtn.hidden = !urlInput.value.trim();
  }

  urlInput.addEventListener('input', updateClearState);

  document.querySelectorAll<HTMLButtonElement>('.paste-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.pasteTarget || '') as HTMLInputElement | null;
      if (!target) return;
      let text = '';
      try {
        if (navigator.clipboard && window.isSecureContext) {
          text = await navigator.clipboard.readText();
        } else if ((window as any).clipboardData && (window as any).clipboardData.getData) {
          text = (window as any).clipboardData.getData('Text');
        }
      } catch {}
      if (text) {
        target.value = text.trim();
        target.focus();
        updateClearState();
      } else {
        target.focus();
      }
    });
  });

  clearBtn.addEventListener('click', () => {
    urlInput.value = '';
    urlInput.focus();
    updateClearState();
    hideError();
    resultMount.innerHTML = '';
  });

  function formatDuration(secs: number): string {
    const m = Math.floor(secs / 60);
    const s = Math.floor(secs % 60);
    return m + ':' + s.toString().padStart(2, '0');
  }

  const dlIcon = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';
  const musicIcon = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>';

  const MODE = (document.getElementById('download-form') as HTMLElement | null)?.dataset.mode || 'video';
  const isMp3Mode = MODE === 'mp3';

  // --- Cloudflare Turnstile for cobalt API auth ---
  const COBALT_TURNSTILE_SITEKEY = '0x4AAAAAAAhUvTuTxLs2HYH4';
  let turnstileToken: string | null = null;
  let turnstileReady = false;

  function initTurnstile() {
    if (typeof (window as any).turnstile === 'undefined') {
      // Script not loaded yet — retry in 500ms
      setTimeout(initTurnstile, 500);
      return;
    }
    const container = document.getElementById('cf-turnstile-container');
    if (!container) return;
    (window as any).turnstile.render(container, {
      sitekey: COBALT_TURNSTILE_SITEKEY,
      appearance: 'interaction-only',
      callback: (token: string) => { turnstileToken = token; turnstileReady = true; },
      'error-callback': () => { turnstileToken = null; turnstileReady = false; },
      'expired-callback': () => { turnstileToken = null; turnstileReady = false; },
    });
  }
  initTurnstile();

  /** Get a fresh turnstile token — re-render if expired or missing. */
  function getTurnstileToken(): Promise<string | null> {
    return new Promise((resolve) => {
      if (turnstileToken && turnstileReady) { resolve(turnstileToken); return; }
      // Re-render widget to get a fresh token
      const container = document.getElementById('cf-turnstile-container');
      if (!container || typeof (window as any).turnstile === 'undefined') { resolve(null); return; }
      container.innerHTML = '';
      (window as any).turnstile.render(container, {
        sitekey: COBALT_TURNSTILE_SITEKEY,
        appearance: 'interaction-only',
        callback: (token: string) => { turnstileToken = token; turnstileReady = true; resolve(token); },
        'error-callback': () => { turnstileToken = null; turnstileReady = false; resolve(null); },
        'expired-callback': () => { turnstileToken = null; turnstileReady = false; resolve(null); },
      });
      // Timeout fallback — if turnstile doesn't resolve in 8s, proceed without token
      setTimeout(() => resolve(turnstileToken), 8000);
    });
  }
  // --- End Turnstile ---

  function renderResult(video: any, _inputUrl: string) {
    if (!video) {
      showError('No video data found. Please check the link and try again.');
      return;
    }

    const { thumbnail, duration, title, videoHd, videoSd, videoUrl } = video || {};
    const hdUrl: string = videoHd || videoUrl || '';
    const sdUrl: string = videoSd || videoHd || videoUrl || '';
    const videoTitle: string = title || 'Snapchat Video';

    const thumbHtml = thumbnail
      ? '<img src="' + thumbnail + '" alt="Snapchat media" class="sc-result-thumb" loading="lazy" width="120" height="160" referrerpolicy="no-referrer" onerror="this.closest(\'.sc-result-thumb-wrap\').classList.add(\'thumb-failed\')" />'
      : '<div class="sc-result-thumb-fallback" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg></div>';

    const durationBadge = duration
      ? '<span class="sc-result-duration-badge">' + formatDuration(duration) + '</span>'
      : '';

    const hasHd = Boolean(hdUrl);
    const hasSd = Boolean(sdUrl);

    const hdTile = hasHd
      ? '<button class="sc-dl-tile" id="sc-btn-dl-hd" type="button" data-dl="hd" aria-label="Download HD video"><span class="sc-dl-tile-icon" aria-hidden="true">' + dlIcon + '</span><span class="sc-dl-tile-label">Download <strong>HD Video</strong></span><span class="sc-dl-badge" aria-hidden="true">HD</span><span class="sc-dl-proc-bar"></span></button>'
      : '';

    const sdTile = hasSd
      ? '<button class="sc-dl-tile" id="sc-btn-dl-sd" type="button" data-dl="sd" aria-label="Download SD video"><span class="sc-dl-tile-icon" aria-hidden="true">' + dlIcon + '</span><span class="sc-dl-tile-label">Download <strong>SD Video</strong></span><span class="sc-dl-proc-bar"></span></button>'
      : '';

    const audioTile = '<button class="sc-dl-tile sc-dl-tile-audio' + (isMp3Mode ? ' sc-dl-tile-prime' : '') + '" id="sc-btn-dl-audio" type="button" data-dl="audio" aria-label="Download audio as MP3"><span class="sc-dl-tile-icon" aria-hidden="true">' + musicIcon + '</span><span class="sc-dl-tile-label">Download <strong>Audio (MP3)</strong></span>' + (isMp3Mode ? '<span class="sc-dl-tile-badge">Recommended</span>' : '') + '<span class="sc-dl-proc-bar"></span></button>';

    const tiles = isMp3Mode ? [audioTile] : [hdTile, sdTile].filter(Boolean).join('');

    resultMount.innerHTML =
      '<div class="sc-result-card animate-fade-in-up" role="region" aria-label="Download result">' +
        '<div class="sc-result-header">' +
          '<div class="sc-result-thumb-wrap">' +
            thumbHtml +
            durationBadge +
          '</div>' +
          '<div class="sc-result-info">' +
            '<div class="sc-result-meta">' +
              '<p class="sc-result-title">' + videoTitle.replace(/</g, '&lt;') + '</p>' +
            '</div>' +
            '<div class="sc-result-actions">' +
              tiles +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>';

    if (!hasHd && !hasSd) {
      showError('No downloadable video found. Please try another link.');
    }

    resultMount.querySelectorAll<HTMLButtonElement>('.sc-dl-tile').forEach((btn) => {
      btn.addEventListener('click', () => startDownload(btn));
    });
  }

  function startDownload(btn: HTMLButtonElement) {
    const dlType = btn.dataset.dl;
    if (!dlType) return;

    const url = urlInput.value.trim();
    const labelEl = btn.querySelector('.sc-dl-tile-label') as HTMLElement;
    const origLabel = labelEl?.textContent || '';
    const bar = btn.querySelector('.sc-dl-proc-bar') as HTMLElement;

    btn.classList.add('sc-dl-tile-processing');
    btn.disabled = true;
    if (labelEl) labelEl.textContent = 'Processing… 0%';
    if (bar) { bar.style.transition = 'none'; bar.style.width = '0%'; }

    // Get fresh turnstile token before download
    getTurnstileToken().then((token) => {
      const xhr = new XMLHttpRequest();
      const tokenParam = token ? '&turnstileToken=' + encodeURIComponent(token) : '';
      xhr.open('GET', '/api/snapchat?url=' + encodeURIComponent(url) + '&dl=' + dlType + tokenParam);
    xhr.responseType = 'blob';
    xhr.timeout = 120_000;

    xhr.onprogress = function (e) {
      if (e.lengthComputable && bar && labelEl) {
        const pct = Math.round((e.loaded / e.total) * 100);
        bar.style.transition = 'none';
        bar.style.width = pct + '%';
        labelEl.textContent = 'Processing… ' + pct + '%';
      }
    };

    xhr.onload = function () {
      if (xhr.status === 200) {
        const blob = xhr.response;
        const blobUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = dlType === 'audio' ? 'tiksavehub-snapchat-audio.mp3' : 'tiksavehub-snapchat-video.mp4';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(blobUrl), 60_000);
        btn.classList.add('sc-dl-tile-done');
        if (labelEl) labelEl.innerHTML = origLabel;
        setTimeout(() => btn.classList.remove('sc-dl-tile-done'), 1500);
      } else {
        btn.classList.add('sc-dl-tile-error');
        if (labelEl) labelEl.textContent = 'Download failed — try again';
        setTimeout(() => {
          btn.classList.remove('sc-dl-tile-error');
          if (labelEl) labelEl.innerHTML = origLabel;
        }, 2000);
      }
      btn.classList.remove('sc-dl-tile-processing');
      btn.disabled = false;
      if (bar) bar.style.width = '0%';
    };

    xhr.onerror = function () {
      btn.classList.add('sc-dl-tile-error');
      if (labelEl) labelEl.textContent = 'Download failed — try again';
      setTimeout(() => {
        btn.classList.remove('sc-dl-tile-error');
        if (labelEl) labelEl.innerHTML = origLabel;
      }, 2000);
      btn.classList.remove('sc-dl-tile-processing');
      btn.disabled = false;
      if (bar) bar.style.width = '0%';
    };

    xhr.ontimeout = function () {
      btn.classList.add('sc-dl-tile-error');
      if (labelEl) labelEl.textContent = 'Download timed out — try again';
      setTimeout(() => {
        btn.classList.remove('sc-dl-tile-error');
        if (labelEl) labelEl.innerHTML = origLabel;
      }, 2000);
      btn.classList.remove('sc-dl-tile-processing');
      btn.disabled = false;
      if (bar) bar.style.width = '0%';
    };

    xhr.send();
    }); // end getTurnstileToken().then
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    const url = urlInput.value.trim();

    if (!url) {
      showError('Please paste a Snapchat video URL.');
      return;
    }

    if (!URL_PATTERN.test(url)) {
      showError('Please enter a valid Snapchat link (e.g. snapchat.com/spotlight/..., story.snapchat.com/s/..., snapchat.com/p/..., snapchat.com/@user/highlight/..., or snapchat.com/@username for stories).');
      return;
    }

    setLoading(true);
    resultMount.innerHTML = '';

    try {
      const token = await getTurnstileToken();
      const res = await fetch('/api/snapchat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url, turnstileToken: token || undefined }),
      });
      const text = await res.text();
      let json: any;
      try {
        json = JSON.parse(text);
      } catch {
        throw new Error('Invalid Snapchat link or the API is busy. Please check the link and try again.');
      }

      if (!res.ok || !json.success) {
        throw new Error(json.error || 'Failed to fetch the video. Please try again.');
      }

      renderResult(json.video, url);
    } catch (err: any) {
      showError(err.message || 'Something went wrong. Please try again.');
    } finally {
      setLoading(false);
    }
  });
</script>
