---
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

import { getLangFromUrl, getAlternateLangLinks } from '../i18n/utils';
import { languages, localeCodes } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  keywords?: string;
  noindex?: boolean;
  platform?: 'tiktok' | 'instagram' | 'facebook' | 'x' | 'snapchat';
  jsonLd?: string;
  appName?: string;
  skipSoftwareApp?: boolean;
  heroImage?: string;
  lang?: string;
  localizedHreflang?: boolean;
}

const {
  title = 'TikSaveHub — Download TikTok Videos Without Watermark',
  description = 'Download TikTok videos in HD quality without watermark. Free, fast, and no account needed. Paste any TikTok link and save the video instantly.',
  canonical,
  ogImage = '/og-default.png',
  ogType = 'website',
  keywords = 'tiktok video downloader, tiktok video downloader without watermark, tiktok video downloader no watermark, tiktok video downloader online, free tiktok video downloader, download tiktok videos, save tiktok videos',
  noindex = false,
  platform = 'tiktok',
  jsonLd,
  appName = 'TikSaveHub',
  skipSoftwareApp = false,
  heroImage,
  lang: propLang,
  localizedHreflang = true,
} = Astro.props;

const detectedLang = propLang || getLangFromUrl(Astro.url);
const currentLang = detectedLang in languages ? detectedLang : 'en';
const ogLocale = localeCodes[currentLang] || 'en';

const siteURL = String(Astro.site ?? 'https://tiksavehub.com').replace(/\/+$/, '');

// Detect locale prefix from the current URL (e.g. "/de/tiktok..." → "de").
const urlSegments = Astro.url.pathname.split('/');
const detectedLocale = urlSegments[1] && urlSegments[1] in languages ? urlSegments[1] : '';

// Canonical: pages pass a root-relative path (e.g. canonical="/" or
// canonical="/tiktok-video-downloader-without-watermark").  For locale pages
// we must prepend the locale so the canonical is SELF-REFERENCING, not
// pointing at the English version.
const rawCanonical = canonical ?? Astro.url.pathname;
// If the page already includes the locale prefix in its canonical, don't add it again.
const canonicalPath = detectedLocale && !rawCanonical.startsWith(`/${detectedLocale}`)
  ? `/${detectedLocale}${rawCanonical === '/' ? '/' : rawCanonical}`
  : rawCanonical;
const normalizedCanonicalPath =
  canonicalPath === '/' ? '/' : canonicalPath.replace(/\/+$/, '');
const canonicalURL = new URL(normalizedCanonicalPath, siteURL);

const ogImageURL = new URL(ogImage, siteURL);

// Centralized SoftwareApplication (WebApplication) JSON-LD — emitted on every indexable page.
const softwareAppSchema: Record<string, unknown> = {
  '@type': 'SoftwareApplication',
  name: appName,
  url: canonicalURL.toString(),
  image: ogImageURL.toString(),
  description,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  inLanguage: currentLang,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    category: 'Free',
  },
  author: {
    '@type': 'Organization',
    name: 'TikSaveHub',
    url: siteURL.toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'TikSaveHub',
    url: siteURL.toString(),
  },
};

const graph: Record<string, unknown>[] = [];
if (!noindex && !skipSoftwareApp) {
  graph.push(softwareAppSchema);
}
if (jsonLd) {
  try {
    const parsed = JSON.parse(jsonLd) as Record<string, unknown> | Record<string, unknown>[];
    // Support a raw array of schemas from index pages.
    if (Array.isArray(parsed)) {
      graph.push(...parsed);
    } else if (Array.isArray(parsed['@graph'])) {
      // Support a nested @graph from pages that emit multiple schema types.
      graph.push(...(parsed['@graph'] as Record<string, unknown>[]));
    } else {
      graph.push(parsed);
    }
  } catch {
    // Ignore malformed page-level JSON-LD
  }
}

const structuredData =
  graph.length > 0
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
    : undefined;
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="TikSaveHub Blog" href="/rss.xml" />

    {(() => {
      // English-only pages (e.g. blog posts) must not declare localized
      // alternates: "/de/blog/{slug}" does not exist and would 404.
      if (localizedHreflang === false) return null;
      // Strip the locale prefix from the pathname so alternates are built from
      // the base path (e.g. "/de/blog" → "/blog", then each locale gets its
      // own prefixed version: /ja/blog, /es/blog, /blog for English).
      const baseHreflangPath = detectedLocale
        ? '/' + Astro.url.pathname.split('/').slice(2).join('/').replace(/\/+$/, '') || '/'
        : Astro.url.pathname;
      const altLinks = getAlternateLangLinks(baseHreflangPath, siteURL);
      return altLinks.map(({ lang: altLang, href }) => (
        <link rel="alternate" hreflang={altLang} href={href} />
      ));
    })()}
    {/* x-default always points to the English (no-locale) version */}
    <link rel="alternate" hreflang="x-default" href={`${siteURL}${(() => {
      const p = rawCanonical === '/' ? '/' : rawCanonical.replace(/\/+$/, '');
      return detectedLocale && p.startsWith(`/${detectedLocale}/`)
        ? p.slice(detectedLocale.length + 1) || '/'
        : p;
    })()}`} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="TikSaveHub" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tiksavehub" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Preload hero image for LCP */}
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}

    <!-- Preconnect to analytics + LCP resource hints -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Theme color matches the page background in light & dark mode -->
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />

    <!-- CSS loads synchronously to prevent FOUC -->

    <!-- Anti-FOUC: apply dark class before first paint (non-blocking) -->
    <script is:inline defer>
      (function() {
        var saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google Analytics (single consolidated tag — both measurement IDs, non-blocking) -->
    <script is:inline defer src="https://www.googletagmanager.com/gtag/js?id=G-T1HSMNWEX2"></script>
    <script is:inline defer>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-T1HSMNWEX2');
      gtag('config', 'G-15RCTH6L8J');
    </script>

    <!-- Monetag Ad Hooks (non-blocking — dispatches paste/download/result events for ad triggers) -->
    <script is:inline defer>
      (function(){
        var EVENTS={PASTE:'tiksavehub:paste',DOWNLOAD:'tiksavehub:download',RESULT:'tiksavehub:result'};
        document.addEventListener('click',function(e){
          var t=e.target;
          if(t.closest('[data-ad-hook="paste"]')||t.closest('.paste-btn')){
            document.dispatchEvent(new CustomEvent(EVENTS.PASTE));
          }
          if(t.closest('[data-ad-hook="download"]')||t.closest('.download-submit-btn')||t.closest('[id*="download-btn"]')||t.closest('.dl-tile')||t.closest('.fb-dl-tile')||t.closest('.sc-dl-tile')||t.closest('.ig-dl-tile')){
            document.dispatchEvent(new CustomEvent(EVENTS.DOWNLOAD));
          }
        },true);
        var rm=document.getElementById('result-mount');
        if(rm){
          new MutationObserver(function(muts){
            for(var i=0;i<muts.length;i++){
              if(muts[i].addedNodes.length>0){
                document.dispatchEvent(new CustomEvent(EVENTS.RESULT));
                break;
              }
            }
          }).observe(rm,{childList:true});
        }
      })();
    </script>

    {structuredData && <script is:inline defer type="application/ld+json" set:html={structuredData}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <NavBar />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer platform={platform} />
  </body>
</html>
