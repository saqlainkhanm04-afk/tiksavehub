---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Server Error — TikSaveHub"
  description="Something went wrong on our end. Please try again or come back later."
  noindex={true}
>
  <section class="error-section">
    <div class="error-inner container-page">
      <div class="error-card">
        <span class="error-code">500</span>
        <h1 class="error-title">Server error</h1>
        <p class="error-desc">
          Something went wrong on our end. Please try again in a moment.
          If the problem persists, feel free to reach out.
        </p>
        <div class="error-actions">
          <a href="/" class="btn-primary-lg">
            Back to TikSaveHub
          </a>
          <a href="/contact" class="btn-ghost-lg">
            Contact Support
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .error-section {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 200px);
    padding: var(--spacing-5xl) var(--spacing-lg);
    background-color: var(--color-canvas-soft);
  }

  .error-inner {
    display: flex;
    justify-content: center;
  }

  .error-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
    text-align: center;
    max-width: 460px;
  }

  .error-code {
    font-size: 120px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -6px;
    background: linear-gradient(135deg, var(--color-grad-ship-start), var(--color-grad-ship-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .error-title {
    font-size: var(--text-display-lg);
    font-weight: 600;
    letter-spacing: -1.28px;
    color: var(--color-ink);
    margin: 0;
  }

  .error-desc {
    font-size: var(--text-body-md);
    color: var(--color-body);
    line-height: 1.6;
    margin: 0;
  }

  .error-actions {
    display: flex;
    gap: var(--spacing-md);
    margin-top: var(--spacing-sm);
  }

  .btn-primary-lg {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-xl);
    border-radius: var(--radius-full);
    background-color: var(--color-ink);
    color: var(--color-on-primary);
    font-size: var(--text-body-md);
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    border: none;
    cursor: pointer;
    line-height: 2;
    letter-spacing: -0.1px;
  }

  .btn-primary-lg:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  .btn-ghost-lg {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-xl);
    border-radius: var(--radius-full);
    background-color: transparent;
    color: var(--color-ink);
    font-size: var(--text-body-md);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    border: 1px solid var(--color-hairline);
    cursor: pointer;
    line-height: 2;
    letter-spacing: -0.1px;
  }

  .btn-ghost-lg:hover {
    background-color: var(--color-canvas);
    border-color: var(--color-hairline-strong);
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .error-section {
      padding: var(--spacing-4xl) var(--spacing-md);
    }

    .error-code {
      font-size: 80px;
      letter-spacing: -4px;
    }

    .error-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary-lg,
    .btn-ghost-lg {
      justify-content: center;
    }
  }
</style>
