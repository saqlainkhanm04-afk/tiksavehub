---
import Layout from '../../layouts/Layout.astro';
import SocialShare from '../../components/SocialShare.astro';
import PostCtaBox from '../../components/PostCtaBox.astro';
import { posts } from '../../data/blog-posts';
import { postsByLang } from '../../data/blog-i18n/index.js';
import '../../styles/blog-post.css';

const usDate = (iso: string) => {
  const [y, m, d] = iso.split('-');
  return `${m}/${d}/${y}`;
};

export const prerender = true;

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const postCta = 'cta' in post ? post.cta : undefined;

const site = Astro.site?.toString().replace(/\/+$/, '') ?? 'https://tiksavehub.com';
const pageUrl = `${site}/blog/${post.slug}`;

const relatedPosts = posts
  .filter((p) => p.slug !== post.slug && (p.category === post.category || p.tags.some((t) => post.tags.includes(t))))
  .slice(0, 3);

// Blog covers are hand-drawn SVG artwork for the on-page hero. Google's
// Article rich result only accepts raster images (ideally >=1200px wide), and
// rejects SVG outright â€” which is why the structured-data image must fall back
// to the 1200x630 PNG card whenever the cover is not a raster file.
const RASTER_COVER = /\.(png|jpe?g|webp|avif)$/i;
const ARTICLE_IMAGE_FALLBACK = '/og-blog.png';
const articleImagePath = RASTER_COVER.test(post.cover) ? post.cover : ARTICLE_IMAGE_FALLBACK;
const articleImageUrl = `${site}${articleImagePath}`;
const articleImage =
  articleImagePath === ARTICLE_IMAGE_FALLBACK
    ? { '@type': 'ImageObject', url: articleImageUrl, width: 1200, height: 630 }
    : articleImageUrl;

// hreflang: point to localized equivalents of this English post (matched by enSlug).
const localizedEquivalents = Object.entries(postsByLang as Record<string, Array<{ enSlug: string; slug: string }>>)
  .flatMap(([langCode, list]) => {
    const match = list.find((p) => p.enSlug === post.slug);
    return match ? [{ lang: langCode, href: `${site}/${langCode}/blog/${match.slug}` }] : [];
  });
const enHreflang = localizedEquivalents.length > 0
  ? [{ lang: 'en', href: `${site}/blog/${post.slug}` }, ...localizedEquivalents]
  : undefined;

const articleJsonLd: Record<string, unknown> = {
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  image: articleImage,
  datePublished: post.date,
  dateModified: post.date,
  articleSection: post.category,
  isAccessibleForFree: true,
  inLanguage: 'en',
  keywords: post.tags.join(', '),
  // E-E-A-T: posts are written by a real, named person (Samneil), not a
  // faceless "Editorial Team" â€” see /about for the human behind the site.
  author: {
    '@type': 'Person',
    '@id': `${site}/authors/samneil#samneil`,
    name: post.author,
    url: `${site}/authors/samneil`,
    image: `${site}/images/authors/samneil.png`,
    sameAs: [
      'https://github.com/tiksavehub',
      'https://twitter.com/tiksavehub',
    ],
  },
  publisher: {
    '@type': 'Organization',
    name: 'TikSaveHub',
    logo: {
      '@type': 'ImageObject',
      url: `${site}/web-app-manifest-512x512.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
};

const faqSchema = post.faq && post.faq.length
  ? {
      '@type': 'FAQPage',
      mainEntity: post.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    }
  : undefined;

const howToSchema = post.howTo
  ? {
      '@type': 'HowTo',
      name: post.howTo.name,
      description: post.howTo.description,
      step: post.howTo.steps.map((step, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: step.name,
        text: step.text,
      })),
    }
  : undefined;

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: site,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: `${site}/blog`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.title,
      item: pageUrl,
    },
  ],
};

// Standalone author entity (Person) so the named human behind the site is a
// first-class node in the graph, not just an inline property of BlogPosting.
const authorSchema = {
  '@type': 'Person',
  '@id': `${site}/authors/samneil#samneil`,
  name: post.author,
  url: `${site}/authors/samneil`,
  image: `${site}/images/authors/samneil.png`,
  sameAs: [
    'https://github.com/tiksavehub',
    'https://twitter.com/tiksavehub',
  ],
  jobTitle: 'Independent developer and founder of TikSaveHub',
  description:
    'Samneil builds and maintains TikSaveHub and writes its how-to and troubleshooting guides.',
  knowsAbout: ['Video downloaders', 'Web development', 'Social media tools'],
  worksFor: {
    '@type': 'Organization',
    name: 'TikSaveHub',
    url: site,
  },
};

const pageJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [articleJsonLd, authorSchema, faqSchema, howToSchema, breadcrumbJsonLd].filter(Boolean),
});

function renderContent(md: string): string {
  const lines = md.split('\n');
  const out: string[] = [];
  let inList = false;
  let listTag = '';

  function closeList() {
    if (inList) {
      out.push(`</${listTag}>`);
      inList = false;
    }
  }

  for (const raw of lines) {
    const line = raw;
    if (line.startsWith('## ')) {
      closeList();
      out.push(`<h2>${line.slice(3)}</h2>`);
    } else if (line.startsWith('### ')) {
      closeList();
      const headingText = line.slice(4);
      // Step headings get special treatment
      const stepMatch = headingText.match(/^(Step \d+:.*)$/);
      if (stepMatch) {
        out.push(renderStep(stepMatch[1]));
      } else if (headingText.endsWith('?')) {
        // Question headings
        out.push(`<div class="question-heading"><h3>${headingText}</h3></div>`);
      } else {
        out.push(`<h3>${headingText}</h3>`);
      }
    } else if (line.trimStart().startsWith('![')) {
      closeList();
      const imgMatch = line.trim().match(/^!\[(.+?)\]\((.+?)\)$/);
      if (imgMatch) {
        out.push(
          `<figure class="post-figure"><img src="${imgMatch[2]}" alt="${imgMatch[1]}" loading="lazy" decoding="async" width="800" height="450" /></figure>`
        );
      } else {
        out.push(`<p>${inline(line)}</p>`);
      }
    } else if (line.startsWith('---')) {
      closeList();
      out.push('<hr />');
    } else if (line.startsWith('- ')) {
      if (!inList) {
        inList = true;
        listTag = 'ul';
        out.push('<ul>');
      }
      const item = line.slice(2);
      // Check for bold label: **Label:** description
      const boldLabelMatch = item.match(/^\*\*(.+?):\*\*\s*(.*)/);
      if (boldLabelMatch) {
        out.push(`<li class="qa-item"><span class="qa-label">${boldLabelMatch[1]}</span><span class="qa-answer">${inline(boldLabelMatch[2])}</span></li>`);
      } else {
        out.push(`<li>${inline(item)}</li>`);
      }
    } else if (/^\d\. /.test(line)) {
      if (!inList) {
        inList = true;
        listTag = 'ol';
        out.push('<ol>');
      }
      out.push(`<li>${inline(line.replace(/^\d\. /, ''))}</li>`);
    } else if (line.trim() === '') {
      closeList();
    } else {
      closeList();
      // Check for bold label: **Label:** description
      const boldLabelMatch = line.match(/^\*\*(.+?):\*\*\s*(.*)/);
      if (boldLabelMatch) {
        out.push(renderQACard(boldLabelMatch[1], boldLabelMatch[2]));
      } else {
        out.push(`<p>${inline(line)}</p>`);
      }
    }
  }
  closeList();
  return out.join('\n');
}

function renderStep(title: string): string {
  const numMatch = title.match(/Step (\d+)/);
  const num = numMatch ? numMatch[1] : '';
  const label = title.replace(/Step \d+: /, '');
  return `
<div class="step-card">
  <span class="step-number">${num}</span>
  <div class="step-body">
    <h3 class="step-title">${label}</h3>
  </div>
</div>`;
}

function renderQACard(question: string, answer: string): string {
  return `
<div class="qa-card">
  <div class="qa-q">${question}</div>
  <div class="qa-a">${inline(answer)}</div>
</div>`;
}

function inline(text: string): string {
  let html = text;
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2" class="post-inline-link">$1</a>');
  return html;
}

const tagColors = [
  'rgba(124, 58, 237, 0.12)',
  'rgba(0, 124, 240, 0.12)',
  'rgba(236, 72, 153, 0.12)',
  'rgba(16, 185, 129, 0.12)',
];
const tagBorderColors = [
  'rgba(124, 58, 237, 0.25)',
  'rgba(0, 124, 240, 0.25)',
  'rgba(236, 72, 153, 0.25)',
  'rgba(16, 185, 129, 0.25)',
];
const tagTextColors = [
  '#7c3aed',
  '#007cf0',
  '#ec4899',
  '#10b981',
];
---

<Layout
  title={post.metaTitle ?? `${post.title} â€” TikSaveHub Blog`}
  description={post.excerpt}
  keywords={`tiksavehub, tiktok downloader, ${post.tags.join(', ')}`}
  canonical={`/blog/${post.slug}`}
  ogImage={post.cover}
  jsonLd={pageJsonLd}
  skipSoftwareApp
  hreflangAlternates={enHreflang}
  localizedHreflang={enHreflang ? true : false}
>
  <!-- Hero -->
  <section class="post-hero" aria-labelledby="post-title">
    <div class="post-hero-bg"></div>
    <div class="post-hero-inner container-page">
      <nav class="post-breadcrumb" aria-label="Breadcrumb">
        <a href="/" class="breadcrumb-link">Home</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/blog" class="breadcrumb-link">Blog</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current" aria-current="page">{post.title}</span>
      </nav>
      <div class="post-hero-content">
        <div class="post-tags">
          {post.tags.map((tag, i) => (
            <span
              class="post-tag"
              style={`background: ${tagColors[i % tagColors.length]}; border-color: ${tagBorderColors[i % tagBorderColors.length]}; color: ${tagTextColors[i % tagTextColors.length]};`}
            >{tag}</span>
          ))}
        </div>
        <h1 id="post-title" class="post-title">{post.title}</h1>
        <div class="post-meta">
          <a href="/authors/samneil" class="post-author">{post.author}</a>
          <span class="post-meta-sep">Â·</span>
          <time datetime={post.date}>{usDate(post.date)}</time>
          <span class="post-meta-sep">Â·</span>
          <span>{post.readingTime}</span>
        </div>
        {postCta && (
          <PostCtaBox
            variant="top"
            headline={postCta.headline}
            text={postCta.text}
            href={postCta.href}
            label={postCta.label}
          />
        )}
        <!-- Featured Banner -->
        <div class="post-featured-banner" aria-hidden="true">
          <div class="banner-row">
            <span class="banner-btn banner-btn-tiktok">TikTok</span>
            <span class="banner-arrow">&rarr;</span>
            <span class="banner-btn banner-btn-instagram">Instagram Reels</span>
            <span class="banner-arrow">&rarr;</span>
            <span class="banner-btn banner-btn-youtube">YouTube Shorts</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="post-body-section">
    <div class="post-body-inner container-page">
      <article class="post-article">
        <div class="post-content">
          <div class="post-content-inner" set:html={renderContent(post.content)} />
        </div>
      </article>

      <!-- CTA -->
      {postCta ? (
        <PostCtaBox
          variant="end"
          headline={postCta.headline}
          text={postCta.text}
          href={postCta.href}
          label={postCta.label}
        />
      ) : (
        <div class="post-cta-card">
          <div class="post-cta-content">
            <h2 class="post-cta-title">Ready to download your first clean video?</h2>
            <p class="post-cta-text">Remove watermarks from TikTok videos in seconds. Free, fast, and no account needed.</p>
            <a href="/" class="post-cta-btn">Try TikSaveHub Now</a>
          </div>
        </div>
      )}

      <!-- Share -->
      <div class="post-share">
        <SocialShare
          url={`/blog/${post.slug}`}
          title={`${post.title} â€” TikSaveHub Blog`}
          description={post.excerpt}
          image={post.cover}
        />
      </div>

      {/* Related Articles */}
      {relatedPosts.length > 0 && (
        <div class="post-related">
          <h2 class="post-related-title">Related Articles</h2>
          <div class="post-related-grid">
            {relatedPosts.map((rp) => (
              <a href={`/blog/${rp.slug}`} class="post-related-card">
                <span class="post-related-tag">{rp.category}</span>
                <h3 class="post-related-headline">{rp.title}</h3>
                <p class="post-related-excerpt">{rp.excerpt}</p>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Back -->
      <div class="post-back">
        <a href="/blog" class="post-back-link">&larr; Back to Blog</a>
      </div>
    </div>
  </section>

  <script>
    // Inline content image fallback: if a markdown image fails to load,
    // swap it to the default placeholder so the article never shows a broken box.
    const POST_IMG_FALLBACK = '/blog/cover-default.svg';
    const applyPostImgFallback = (img: HTMLImageElement) => {
      if (img.dataset.imgFallback) return;
      img.dataset.imgFallback = '1';
      img.src = POST_IMG_FALLBACK;
    };
    document.querySelectorAll<HTMLImageElement>('.post-content-inner img').forEach((img) => {
      img.addEventListener('error', () => applyPostImgFallback(img));
      if (img.complete && img.naturalWidth === 0) applyPostImgFallback(img);
    });
  </script>
</Layout>

