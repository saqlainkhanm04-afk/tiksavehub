---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const contactJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@graph': [
 {
 '@type': 'ContactPage',
 name: 'Contact Us. TikSaveHub',
 description: 'Get in touch with TikSaveHub for support, inquiries, or feedback.',
 url: 'https://tiksavehub.com/contact',
 },
 {
 '@type': 'Organization',
 name: 'TikSaveHub',
 url: 'https://tiksavehub.com',
 logo: 'https://tiksavehub.com/logo.png',
 contactPoint: {
 '@type': 'ContactPoint',
 contactType: 'customer support',
 email: 'support@tiksavehub.com',
 availableLanguage: 'English',
 },
 },
 ],
});
---

<Layout
 title="Contact Us. TikSaveHub"
 description="Get in touch with TikSaveHub. Reach out for support, inquiries, or feedback about our TikTok video downloader."
 keywords="contact tiksavehub, tiksavehub support, contact us, tiktok downloader help"
 canonical="/contact"
 ogImage="/og-contact.png"
 skipSoftwareApp
 jsonLd={contactJsonLd}
>
 <section class="legal-section" aria-labelledby="legal-headline">
 <div class="legal-inner container-page">
 <!-- Breadcrumb -->
 <nav aria-label="Breadcrumb" class="legal-breadcrumb">
 <ol class="breadcrumb-list">
 <li>
 <a href="/"><span>Home</span></a>
 </li>
 <li aria-current="page">
 <span>Contact Us</span>
 </li>
 </ol>
 </nav>

 <div class="legal-header">
 <span class="section-eyebrow text-caption-mono">Support</span>
 <h1 id="legal-headline" class="legal-title">Contact Us</h1>
 <p class="legal-meta">We'd love to hear from you.</p>
 </div>

 <div class="legal-card">
 <div class="legal-content">

 <section class="legal-clause">
 <h2 class="legal-h2">Get in Touch</h2>
 <p>
 Have a question, suggestion, or need help? Reach out to us and we'll get back to you as soon as possible.
 </p>
 </section>

 <section class="legal-clause">
 <h2 class="legal-h2">Contact Information</h2>
 <p class="legal-contact">
 <strong>Email:</strong> <a href="mailto:support@tiksavehub.com">support@tiksavehub.com</a>
 </p>
 </section>

 <section class="legal-clause">
 <h2 class="legal-h2">Response Time</h2>
 <p>
 We aim to respond to all inquiries within 24–48 hours. For faster assistance, please include a clear description of your issue or question.
 </p>
 </section>

 </div>
 </div>

 <!-- Back to home -->
 <div class="legal-back">
 <a href="/" class="btn-primary-sm">&larr; Back to TikSaveHub</a>
 </div>
 </div>
 </section>
</Layout>

<style>
  .legal-section {
    background-color: var(--color-canvas-soft);
    padding: var(--spacing-5xl) var(--spacing-lg);
  }

  .legal-inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
    max-width: 760px;
    margin-inline: auto;
  }

  .legal-breadcrumb {
    margin-bottom: 0;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-body-sm);
    color: var(--color-mute);
  }

  .breadcrumb-list li + li::before {
    content: '/';
    margin-right: 6px;
    color: var(--color-hairline-strong);
  }

  .breadcrumb-list a {
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-list a:hover {
    color: var(--color-ink);
  }

  .legal-header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .section-eyebrow {
    color: var(--color-mute);
  }

  .legal-title {
    font-size: var(--text-display-xl);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -2.5px;
    color: var(--color-ink);
    margin: 0;
  }

  .legal-meta {
    font-size: var(--text-body-sm);
    color: var(--color-mute);
    margin: 0;
  }

  .legal-card {
    background-color: var(--color-canvas);
    border-radius: var(--radius-lg);
    padding: var(--spacing-3xl);
    box-shadow:
      inset 0 0 0 1px #0000000a,
      0px 1px 1px #00000005,
      0px 4px 8px #0000000a;
  }

  .legal-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
  }

  .legal-clause {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .legal-h2 {
    font-size: var(--text-display-md);
    font-weight: 600;
    letter-spacing: -1.28px;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.25;
  }

  .legal-content p {
    font-size: var(--text-body-md);
    color: var(--color-body);
    line-height: 1.75;
    margin: 0;
    letter-spacing: -0.1px;
  }

  .legal-contact {
    background-color: var(--color-canvas-soft);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    font-size: var(--text-body-md);
    color: var(--color-body);
    line-height: 1.75;
  }

  .legal-contact strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  .legal-content a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .legal-content a:hover {
    color: var(--color-link-deep);
  }

  .legal-back {
    display: flex;
    justify-content: center;
  }

  .btn-primary-sm {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: var(--radius-full);
    background-color: var(--color-ink);
    color: var(--color-on-primary);
    font-size: var(--text-body-sm);
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    border: none;
    cursor: pointer;
    line-height: 2.2;
    letter-spacing: -0.1px;
  }

  .btn-primary-sm:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .dark .legal-card {
    box-shadow:
      inset 0 0 0 1px #ffffff0a,
      0px 1px 1px #00000010,
      0px 4px 8px #00000020;
  }

  .dark .legal-contact {
    background-color: var(--color-canvas-soft-2);
  }

  @media (max-width: 600px) {
    .legal-section {
      padding: var(--spacing-4xl) var(--spacing-md);
    }

    .legal-title {
      font-size: 32px;
      letter-spacing: -1.5px;
    }

    .legal-card {
      padding: var(--spacing-lg);
    }

    .legal-h2 {
      font-size: var(--text-display-sm);
    }

    .breadcrumb-list {
      font-size: var(--text-caption);
    }
  }
</style>
