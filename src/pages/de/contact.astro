---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';

const contactJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      name: 'Kontakt — TikSaveHub',
      description: 'Kontaktiere TikSaveHub. Support, Fragen und Feedback — schreib uns einfach an.',
      url: 'https://tiksavehub.com/contact',
    },
    {
      '@type': 'Organization',
      name: 'TikSaveHub',
      url: 'https://tiksavehub.com',
      logo: 'https://tiksavehub.com/web-app-manifest-512x512.png',
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: 'support@tiksavehub.com',
        availableLanguage: 'German',
      },
    },
  ],
});
---

<Layout
  title="Kontakt — TikSaveHub"
  description="Kontaktiere TikSaveHub. Support, Fragen und Feedback zum TikTok-Video-Downloader."
  keywords="tiksavehub kontakt,tiksavehub support,kontakt,tiktok downloader hilfe"
  canonical="/contact"
  ogImage="/og-contact.png"
  lang="de"
  skipSoftwareApp
  jsonLd={contactJsonLd}
>
  <section class="legal-section" aria-labelledby="legal-headline">
    <div class="legal-inner container-page">
      <nav aria-label="Breadcrumb" class="legal-breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/"><span>Startseite</span></a><meta itemprop="position" content="1" /></li>
          <li aria-current="page"><span>Kontakt</span><meta itemprop="position" content="2" /></li>
        </ol>
      </nav>

      <div class="legal-header">
        <span class="section-eyebrow text-caption-mono">Support</span>
        <h1 id="legal-headline" class="legal-title">Kontakt</h1>
        <p class="legal-meta">Schreib uns gerne an.</p>
      </div>

      <div class="legal-card">
        <div class="legal-content">

          <section class="legal-clause">
            <h2 class="legal-h2">So erreichst du uns</h2>
            <p>Bei Fragen, Vorschlägen oder SUPPORT-Anliegen — schreib uns einfach. Wir melden uns so schnell wie möglich bei dir.</p>
          </section>

          <section class="legal-clause">
            <h2 class="legal-h2">Kontaktdaten</h2>
            <p class="legal-contact"><strong>E-Mail:</strong> <a href="mailto:support@tiksavehub.com">support@tiksavehub.com</a></p>
          </section>

          <section class="legal-clause">
            <h2 class="legal-h2">Antwortzeit</h2>
            <p>Wir bemühen uns, alle Anfragen innerhalb von 24 bis 48 Stunden zu beantworten. Für einen schnelleren Support beschreibe bitte dein Anliegen oder deine Frage möglichst genau.</p>
          </section>

        </div>
      </div>

      <div class="legal-back"><a href="/" class="btn-primary-sm">&larr; Zurück zu TikSaveHub</a></div>
    </div>
  </section>
</Layout>

<style>
  .legal-section{background-color:var(--color-canvas-soft);padding:var(--spacing-5xl) var(--spacing-lg)}.legal-inner{display:flex;flex-direction:column;gap:var(--spacing-2xl);max-width:760px;margin-inline:auto}.legal-breadcrumb{margin-bottom:0}.breadcrumb-list{display:flex;align-items:center;gap:6px;list-style:none;margin:0;padding:0;font-size:var(--text-body-sm);color:var(--color-mute)}.breadcrumb-list li+li::before{content:'/';margin-right:6px;color:var(--color-hairline-strong)}.breadcrumb-list a{color:var(--color-body);text-decoration:none;transition:color .15s ease}.breadcrumb-list a:hover{color:var(--color-ink)}.legal-header{display:flex;flex-direction:column;gap:var(--spacing-sm)}.section-eyebrow{color:var(--color-mute)}.legal-title{font-size:var(--text-display-xl);font-weight:600;line-height:1.05;letter-spacing:-2.5px;color:var(--color-ink);margin:0}.legal-meta{font-size:var(--text-body-sm);color:var(--color-mute);margin:0}.legal-card{background-color:var(--color-canvas);border-radius:var(--radius-lg);padding:var(--spacing-3xl);box-shadow:inset 0 0 0 1px #0000000a,0 1px 1px #00000005,0 4px 8px #0000000a}.legal-content{display:flex;flex-direction:column;gap:var(--spacing-2xl)}.legal-clause{display:flex;flex-direction:column;gap:var(--spacing-md)}.legal-h2{font-size:var(--text-display-md);font-weight:600;letter-spacing:-1.28px;color:var(--color-ink);margin:0;line-height:1.25}.legal-content p{font-size:var(--text-body-md);color:var(--color-body);line-height:1.75;margin:0;letter-spacing:-.1px}.legal-contact{background-color:var(--color-canvas-soft);border-radius:var(--radius-md);padding:var(--spacing-lg);font-size:var(--text-body-md);color:var(--color-body);line-height:1.75}.legal-contact strong{font-weight:600;color:var(--color-ink)}.legal-content a{color:var(--color-link);text-decoration:underline;text-underline-offset:2px;transition:color .15s ease}.legal-content a:hover{color:var(--color-link-deep)}.legal-back{display:flex;justify-content:center}.btn-primary-sm{display:inline-flex;align-items:center;gap:var(--spacing-xs);padding:var(--spacing-xs) var(--spacing-lg);border-radius:var(--radius-full);background-color:var(--color-ink);color:var(--color-on-primary);font-size:var(--text-body-sm);font-weight:500;text-decoration:none;transition:opacity .2s ease,transform .2s ease;border:none;cursor:pointer;line-height:2.2;letter-spacing:-.1px}.btn-primary-sm:hover{opacity:.85;transform:translateY(-1px)}.dark .legal-card{box-shadow:inset 0 0 0 1px #ffffff0a,0 1px 1px #00000010,0 4px 8px #00000020}.dark .legal-contact{background-color:var(--color-canvas-soft-2)}@media(max-width:600px){.legal-section{padding:var(--spacing-4xl) var(--spacing-md)}.legal-title{font-size:32px;letter-spacing:-1.5px}.legal-card{padding:var(--spacing-lg)}.legal-h2{font-size:var(--text-display-sm)}.breadcrumb-list{font-size:var(--text-caption)}}
</style>
