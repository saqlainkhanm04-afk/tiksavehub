  flex-direction: column;
  gap: var(--spacing-md);
  position: sticky;
  top: 80px;
 }

 .seo-sidebar-card {
  background-color: var(--color-canvas);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow:
   inset 0 0 0 1px #0000000a,
   0px 1px 1px #00000005,
   0px 4px 8px #0000000a;
 }

 .seo-sidebar-highlight {
  background: linear-gradient(135deg, #007cf008, #00dfd808);
  border: 1px solid #007cf020;
 }

 .seo-sidebar-title {
  font-size: var(--text-body-md-strong);
  font-weight: 600;
  color: var(--color-ink);
  margin: 0 0 var(--spacing-md) 0;
 }

 .seo-sidebar-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
 }

 .seo-sidebar-list li {
  font-size: var(--text-body-sm);
  color: var(--color-body);
  line-height: 1.5;
 }

 .seo-sidebar-list a {
  color: var(--color-body);
  text-decoration: none;
  transition: color 0.15s ease;
 }

 .seo-sidebar-list a:hover {
  color: var(--color-ink);
 }

 .seo-sidebar-mono li {
  font-family: var(--font-mono);
  font-size: var(--text-caption);
  color: var(--color-mute);
 }

 .seo-sidebar-text {
  font-size: var(--text-body-sm);
  color: var(--color-body);
  margin: 0 0 var(--spacing-md) 0;
  line-height: 1.5;
 }

 .seo-sidebar-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
 }

 @media (max-width: 960px) {
  .seo-content-grid {
   grid-template-columns: 1fr;
  }

  .seo-content-sidebar {
   position: static;
   display: grid;
   grid-template-columns: repeat(2, 1fr);
  }
 }

 @media (max-width: 600px) {
  .seo-content-section {
   padding: var(--spacing-3xl) var(--spacing-md);
  }

  .seo-content-sidebar {
   grid-template-columns: 1fr;
  }
 }
</style>

<script>
 const dlTriggers = document.querySelectorAll<HTMLButtonElement>('.dl-faq-trigger');
 dlTriggers.forEach((btn) => {
  btn.addEventListener('click', () => {
   const isOpen = btn.getAttribute('aria-expanded') === 'true';
   const panelId = btn.getAttribute('aria-controls')!;
   const panel = document.getElementById(panelId);
   dlTriggers.forEach((otherBtn) => { if (otherBtn !== btn) { otherBtn.setAttribute('aria-expanded', 'false'); const otherId = otherBtn.getAttribute('aria-controls')!; document.getElementById(otherId)?.setAttribute('hidden', ''); } });
   if (isOpen) { btn.setAttribute('aria-expanded', 'false'); panel?.setAttribute('hidden', ''); } else { btn.setAttribute('aria-expanded', 'true'); panel?.removeAttribute('hidden'); }
  });
 });
</script>
