  totalTime: 'PT2M',
  step: [
    {
      '@type': 'HowToStep',
      name: 'TikTok-Videlink kopieren',
      text: 'Öffnen Sie die TikTok-App, finden Sie das Video, das Sie speichern möchten, tippen Sie auf Freigabe und wählen Sie Link kopieren.',
      position: 1,
