const faqData = [
 {
  id: 'dl-ww',
  q: 'Wie lade ich TikTok-Videos ohne Wasserzeichen herunter?',
  a: 'Kopier den Link von TikTok, füg ihn oben auf der Seite ein und klick auf Herunterladen. TikSaveHub holt das originale Videofile. Das saubere MP4, das TikTok an deinen Browser schickt. Bevor das Wasserzeichen überhaupt draufgesetzt wird. Zwei bis drei Sekunden später ist ein wasserzeichenfreies MP4 ready zum Speichern.',
 },
 {
  id: 'dl-hd',
  q: 'Kann ich TikTok-Videos in HD 1080p speichern?',
  a: 'TikSaveHub holt genau die Qualität, die TikTok für das Video bereitstellt. Die meisten populären Creator laden in 1080p (1920×1080 Pixel) hoch, und genau das wird heruntergeladen. Keine Neukodierung, keine zusätzliche Komprimierung. Das Tool greift auf den originalen Stream zu, der in deinem Browser abspielt. Was du auf TikTok siehst, bekommst du auch.\n\nWenn ein Creator nur in 720p oder 480p hochgeladen hat, kann TikSaveHub das nicht magisch hochskalieren. Die Qualität hängt komplett davon ab, was der Creator exportiert hat. Aber bei mehreren Streams mit verschiedenen Bitrates wählt das Tool immer den höchsten aus.',
 },
 {
  id: 'dl-iphone',
  q: 'Kann ich TikSaveHub auf meinem iPhone (Safari) nutzen?',
  a: 'Geht auf jedem iPhone mit iOS 13 oder neuer. Öffne Safari, kopier einen TikTok-Link, füg ihn bei TikSaveHub ein und tippe auf Herunterladen. Die Datei landet im Download-Manager von Safari. Zieh von oben nach unten, um ihn zu sehen, dann tipp auf die Lupe, um ihn in der Dateien-App zu öffnen.\n\nEin paar Sachen, die du wissen solltest: Bei älteren iOS-Versionen (12 und früher) werden Downloads manchmal komplett blockiert, wegen Apples Einschränkungen. Falls Safari eine komische Meldung wie "Diese Datei kann nicht heruntergeladen werden" ausgibt, hilft meist ein Wechsel zu Chrome auf demselben iPhone. Das Tool selbst ist browserunabhängig. Es ist eher das Betriebssystem, das manchmal Querulant spielt.',
 },
 {
  id: 'dl-devices',
  q: 'Läuft TikSaveHub auf Android und PC?',
  a: 'Jedes Gerät mit einem modernen Browser. Android-Handys, Windows-PCs, Macs, Linux-Rechner, Tablets. Egal. TikSaveHub läuft komplett im Browser, also gibt es nichts zu installieren.',
 },
 {
  id: 'dl-links',
  q: 'Welche TikTok-Linkformate unterstützt TikSaveHub (vm.tiktok.com oder vt.tiktok.com)?',
  a: 'Jedes TikTok-URL-Format funktioniert. Volle Links (tiktok.com/@user/video/...), gekürzte Freigabe-Links (vm.tiktok.com/...) und mobile Freigabe-Links (vt.tiktok.com/...) werden alle automatisch aufgelöst. TikSaveHub ist egal, wie der Link kopiert wurde. Aus dem Freigabemenü, aus der Browser-Adresszeile oder aus einer Textnachricht. Einfach einfügen, und das Tool macht den Rest.',
 },
 {
  id: 'dl-free',
  q: 'Ist TikSaveHub wirklich kostenlos und ohne Anmeldung?',
  a: 'Komplett kostenlos. Keine Anmeldung, keine E-Mail-Sammlung, kein verstecktes Abo. Link einfügen, Video herunterladen, fertig.\n\nWas TikSaveHub NICHT macht: Es fragt nicht nach einem Konto, zeigt keine Werbung vor dem Download und begrenzt nicht die täglichen Downloads. Die Verarbeitung läuft serverseitig, also gibt es keine Browser-Erweiterung zu installieren und keine App herunterzuladen. Manche "kostenlosen" TikTok-Downloader schieben dich nach ein paar Speicherungen auf ein kostenpflichtiges Abo. Das hier nicht.',
 },
 {
  id: 'dl-account',
  q: 'Brauche ich ein TikTok-Konto zum Herunterladen?',
  a: 'Nein. Solange das Video auf TikTok öffentlich zugänglich ist, kann TikSaveHub es holen. Link über Teilen → Link kopieren, bei TikSaveHub einfügen, und der Download startet. Private oder eingeschränkte Videos gehen nicht. Aber TikSaveHub sagt dir das ehrlich, anstatt einen verwirrenden Fehler auszuspucken oder still zu versagen.',
 },
 {
  id: 'dl-legal',
  q: 'Ist es legal, TikTok-Videos ohne Wasserzeichen herunterzuladen?',
  a: 'Ein TikTok-Video zum Offline-Schauen oder für den persönlichen Gebrauch speichern, das fällt in eine Grauzone, die allgemein toleriert wird. TikToks AGBs verbieten technisch das Herunterladen außerhalb der App, aber diese Klausel richtet sich gegen automatisiertes Scraping und massenhaftes Weiterverbreiten. Nicht gegen jemanden, der sich ein Video für den Flug speichert.\n\nRechtlich heikel wird es bei kommerzieller Nutzung. Ein Compilations-Channel mit TikToks anderer Leute, jemandes Video in einer Werbekampagne verwenden oder Inhalte ohne Quellenangabe reposten. Das kann Urheberrechtsverletzung sein, unabhängig davon, ob das Wasserzeichen entfernt wurde. Quell-Creator angeben, dessen Arbeit nicht ohne Erlaubnis monetarisieren, und auf der richtigen Seite bleiben.',
 },
 {
  id: 'dl-remove',
  q: 'Wie entfernt TikSaveHub das TikTok-Wasserzeichen?',
  a: 'TikTok verwahrt eine saubere Version jedes Videos auf seinen Servern für das Streaming. Das Wasserzeichen wird erst hinzugefügt, wenn jemand über die App selbst speichert. TikSaveHub lädt genau diesen originalen Streaming-File. Ohne Logo, ohne Überlagerung.',
 },
 {
  id: 'dl-private',
  q: 'Kann TikSaveHub Videos von privaten TikTok-Konten herunterladen?',
  a: 'Nein. Das ist eine harte technische Grenze, keine Policy-Entscheidung. Private Videos sind über die öffentliche API von TikTok nicht zugänglich. Kein seriöser Downloader, und es gibt genug dubiose, die etwas anderes behaupten, kann auf private Inhalte zugreifen, ohne die AGBs von TikTok zu verletzen. Wenn ein Video als privat markiert ist, kann es einfach nicht von außen abgerufen werden.',
 },
 {
  id: 'dl-format',
  q: 'In welchem Format und in welcher Qualität werden die heruntergeladenen Videos?',
  a: 'MP4. Das ist das Format, in dem TikTok streamt, und das wird auch gespeichert. Qualität bis 1080p, je nachdem, was der Creator hochgeladen hat.',
 },
 {
  id: 'dl-limits',
  q: 'Gibt es Grenzen, wie viele TikTok-Videos ich herunterladen kann?',
  a: 'Keine täglichen Limits, keine Download-Quotas, keine Premium-Obergrenze. So viele Videos speichern wie nötig. Jeder Download dauert ungefähr dieselben zwei bis drei Sekunden, egal wie viele an dem Tag schon heruntergeladen wurden.',
 },
];

const faqJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqData.map((faq) => ({
  '@type': 'Question',
  name: faq.q,
  acceptedAnswer: {
   '@type': 'Answer',
   text: faq.a.replace(/<[^>]*>/g, ''),
  },
 })),
});

const howToJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@type': 'HowTo',
 name: 'TikTok-Videos ohne Wasserzeichen herunterladen',
 description: 'Schritt-für-Schritt-Anleitung, um TikTok-Videos in HD-Qualität ohne Wasserzeichen mit TikSaveHub zu speichern.',
 totalTime: 'PT2M',
 step: [
  {
   '@type': 'HowToStep',
   name: 'TikTok-Videlink kopieren',
   text: 'Öffne die TikTok-App, finde das Video, das du speichern möchtest, tippe auf Teilen und wähle Link kopieren.',
   position: 1,
  },
  {
   '@type': 'HowToStep',
   name: 'Link bei TikSaveHub einfügen',
   text: 'Besuche TikSaveHub.com und füge den kopierten TikTok-Link in das Download-Eingabefeld ein.',
   position: 2,
  },
  {
   '@type': 'HowToStep',
   name: 'Auf Herunterladen klicken',
   text: 'Klicke auf die Schaltfläche Herunterladen und warte ein paar Sekunden, während das Video verarbeitet wird.',
   position: 3,
  },
  {
   '@type': 'HowToStep',
   name: 'HD-Video speichern',
   text: 'Wähle die HD-MP4-Option (ohne Wasserzeichen) und speichere die Videodatei auf deinem Gerät.',
   position: 4,
  },
 ],
 tool: {
  '@type': 'HowToTool',
  name: 'TikSaveHub',
 },
});

const combinedJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd)],
});
