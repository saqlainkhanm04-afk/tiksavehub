      text: 'Wählen Sie die HD-MP4-Option (ohne Wasserzeichen) und speichern Sie die Videodatei auf Ihrem Gerät.',
      position: 4,
    },
  ],
  tool: {
    '@type': 'HowToTool',
    name: 'TikSaveHub',
  },
});

const combinedJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd)],
});
