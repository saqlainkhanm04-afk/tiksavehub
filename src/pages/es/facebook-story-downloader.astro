import FbBlogLinksSection from '../../components/FbBlogLinksSection.astro';
import FbInternalLinks from '../../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../../components/FacebookDownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';
import { getLocalizedPath, type Lang } from '../../i18n/utils';
const lp = (p: string) => getLocalizedPath(p, 'es' as Lang);

const faqData = [
  { id: 'story-free', q: '¿Cómo puedo descargar una historia de Facebook gratis online?', a: 'Para descargar una historia de Facebook gratis online, copia el enlace de la historia pública, pégalo en TikSaveHub y pulsa descargar. Nuestra herramienta procesa el enlace al instante y guarda la foto o el video de alta calidad directamente en tu dispositivo.' },
  { id: 'story-anonymous', q: '¿Puedo guardar una historia de Facebook de forma anónima sin que se enteren?', a: 'Sí, puedes guardar una historia de Facebook de forma anónima con TikSaveHub. Como no necesitas iniciar sesión para descargar historias públicas, el creador nunca sabrá que viste o descargaste su contenido.' },
  { id: 'story-notified', q: '¿Se enterará alguien si descargo su historia de Facebook?', a: 'No, el creador no recibirá ninguna notificación. TikSaveHub obtiene el contenido directamente de los servidores de Facebook, lo que garantiza que tu descarga sea completamente privada y tu nombre nunca aparezca en la lista de personas que vieron su historia.' },
  { id: 'story-hd', q: '¿Puedo descargar historias de Facebook en HD o 1080p?', a: 'Sí, TikSaveHub descarga las historias de Facebook en la resolución más alta disponible, hasta HD 1080p. Si el creador subió una historia en alta definición, obtendrás esa calidad exacta en tu descarga.' },
  { id: 'story-iphone', q: '¿Funciona el descargador de historias en Safari para iPhone?', a: 'Sí, TikSaveHub está totalmente optimizado como descargador de historias para Safari en iPhone. Solo pega el enlace de la historia, toca descargar y guarda el video MP4 o la imagen JPG directamente en tus Fotos o en la app de Archivos.' },
  { id: 'story-android', q: '¿Cómo guardo una historia de FB en la galería de Android?', a: 'Para guardar una historia de FB en tu galería de Android, abre Chrome, pega la URL de la historia pública en TikSaveHub y toca descargar. El archivo se guardará automáticamente en tu carpeta de Descargas y aparecerá en tu Galería.' },
  { id: 'story-private', q: '¿Puedo descargar historias de Facebook de cuentas privadas?', a: 'No, TikSaveHub no puede descargar historias de cuentas privadas. Para respetar la privacidad del usuario, nuestra herramienta solo accede y descarga historias públicas.' },
  { id: 'story-expired', q: '¿Puedo descargar una historia de Facebook caducada?', a: 'No, no puedes descargar historias caducadas. Una vez que una historia desaparece tras 24 horas, su enlace ya no está activo. Sin embargo, si el usuario guarda la historia caducada en sus "Destacados", podrás descargarla desde allí.' },
  { id: 'story-photo-video', q: '¿Puedo descargar tanto fotos como videos de historias de Facebook?', a: 'Sí, TikSaveHub admite ambos formatos. Las historias de foto se descargan al instante como imágenes JPG o PNG de alta calidad, mientras que las historias de video se guardan como archivos MP4 nítidos.' },
  { id: 'story-no-login', q: '¿Necesito iniciar sesión en Facebook para descargar una historia?', a: 'No se requiere inicio de sesión. Puedes descargar historias públicas de Facebook de forma totalmente anónima sin ingresar tu nombre de usuario, contraseña o datos de cuenta en nuestro sitio.' },
  { id: 'story-no-limit', q: '¿Tiene TikSaveHub un límite diario de descargas de historias?', a: 'No. TikSaveHub es completamente gratis y no tiene límites diarios de descarga. Puedes guardar tantas historias públicas de Facebook como quieras, sin restricciones ni costos ocultos.' },
  { id: 'story-whyfail', q: '¿Por qué no puedo descargar una historia de Facebook?', a: 'Las descargas suelen fallar si la historia es privada, ha caducado tras 24 horas o el enlace se copió incorrectamente. Asegúrate de copiar el enlace de una historia visible públicamente e inténtalo de nuevo.' },
  { id: 'story-someone-know', q: '¿Se enterará alguien si descargo su historia de Facebook?', a: 'No. TikSaveHub obtiene las historias directamente de los servidores de Facebook, el creador no recibe ninguna notificación y tu nombre nunca aparece en su lista de espectadores. Tu descarga es completamente anónima.' },
  { id: 'story-multiple-segments', q: '¿Puedo descargar varios segmentos de una historia a la vez?', a: 'Sí. Cuando pegas un enlace de historia, TikSaveHub procesa todos los segmentos disponibles. Puedes descargar cada segmento de foto o video de forma individual, tal como aparecen en la historia.' },
];

const faqJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqData.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') } })) });

const howToJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Cómo descargar historias de Facebook en HD',
  description: 'Guía paso a paso para descargar historias de Facebook en calidad HD sin marca de agua con TikSaveHub.',
  totalTime: 'PT1M',
  step: [
    { '@type': 'HowToStep', name: 'Copia el enlace de la historia', text: 'Abre la app o el sitio de Facebook, mira la historia, toca el menú de compartir y elige Copiar Enlace.', position: 1 },
    { '@type': 'HowToStep', name: 'Pega el enlace en TikSaveHub', text: 'Visita TikSaveHub y pega el enlace de la historia copiado en el campo de entrada.', position: 2 },
    { '@type': 'HowToStep', name: 'Descarga la historia en HD', text: 'Haz clic en el botón Descargar y guarda el video MP4 en HD o la imagen JPG en tu dispositivo.', position: 3 },
  ],
  tool: { '@type': 'HowToTool', name: 'TikSaveHub' },
});

const webAppJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'TikSaveHub - Descargador de Historias de Facebook',
  url: 'https://tiksavehub.com/es/facebook-story-downloader',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: 'Descargador gratuito online de historias de Facebook. Guarda historias de FB como videos MP4 en HD o imágenes JPG sin marca de agua.',
});

const combinedJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd), JSON.parse(webAppJsonLd)] });
---

<Layout
  title="Descargador de Historias Facebook Gratis | TikSaveHub"
  description="Descarga historias de Facebook antes de que desaparezcan en 24 horas. Gratis, rápido y anónimo. Guarda stories de FB en HD sin iniciar sesión."
  keywords="descargador de historias de facebook, descargar stories de facebook, guardar historias de facebook, facebook story downloader, descargar facebook stories gratis, facebook story saver, guardar stories de fb, descargar historias de facebook en hd"
  canonical="/facebook-story-downloader"
  ogImage="/og-downloader.png"
  ogType="website"
  platform="facebook"
  jsonLd={combinedJsonLd}
  appName="TikSaveHub — Descargador de Historias de Facebook"
  lang="es"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://tiksavehub.com" }, { "@type": "ListItem", "position": 2, "name": "Descargador de Historias de Facebook", "item": "https://tiksavehub.com/facebook-story-downloader" } ] })} />

