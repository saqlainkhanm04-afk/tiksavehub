---
// TikSaveHub Homepage — hub page for all tools (Español)
export const prerender = true;

import Layout from '../../layouts/Layout.astro';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TikSaveHub',
  url: 'https://tiksavehub.com',
  logo: 'https://tiksavehub.com/web-app-manifest-512x512.png',
  description: 'Descarga videos de TikTok, Instagram, Facebook y X (Twitter) en calidad HD — gratis, rápido, sin marca de agua.',
  sameAs: [
    'https://twitter.com/tiksavehub',
    'https://www.facebook.com/tiksavehub',
    'https://www.instagram.com/tiksavehub',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'support@tiksavehub.com',
  },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TikSaveHub',
  url: 'https://tiksavehub.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://tiksavehub.com/tiktok-video-downloader-without-watermark?url={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const base = '/es';

const tools = [
  {
    title: 'Descargador de Videos de TikTok',
    description: 'Guarda videos de TikTok sin marca de agua en calidad HD. Gratis, rápido, sin registro.',
    href: `${base}/tiktok-video-downloader-without-watermark`,
    icon: 'tiktok',
    badge: 'Popular',
  },
  {
    title: 'TikTok a MP3',
    description: 'Extrae audio de videos de TikTok como archivos MP3 de alta calidad hasta 320kbps.',
    href: `${base}/tiktok-to-mp3`,
    icon: 'audio',
    badge: null,
  },
  {
    title: 'Descargador de Instagram Reels',
    description: 'Descarga Instagram Reels sin marca de agua en HD. Funciona en todos los dispositivos.',
    href: `${base}/instagram-reels-downloader-without-watermark`,
    icon: 'instagram',
    badge: 'Nuevo',
  },
  {
    title: 'Descargador de Videos de Instagram',
    description: 'Guarda videos y publicaciones de Instagram en calidad HD. Sin necesidad de app.',
    href: `${base}/instagram-video-downloader-without-watermark`,
    icon: 'instagram',
    badge: null,
  },
  {
    title: 'Descargador de Historias de Instagram',
    description: 'Descarga Historias de Instagram antes de que expiren. Gratis y anónimo.',
    href: `${base}/instagram-story-downloader-without-watermark`,
    icon: 'instagram',
    badge: null,
  },
  {
    title: 'Descargador de Videos de Facebook',
    description: 'Descarga videos, Reels y publicaciones de Facebook en calidad HD.',
    href: `${base}/facebook-video-downloader`,
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Descargador de Reels de Facebook',
    description: 'Guarda Reels de Facebook sin marca de agua en calidad HD.',
    href: `${base}/facebook-reels-downloader`,
    icon: 'facebook',
    badge: 'Nuevo',
  },
  {
    title: 'Facebook a MP3',
    description: 'Extrae audio de videos de Facebook como archivos MP3 de alta calidad.',
    href: `${base}/facebook-to-mp3`,
    icon: 'audio',
    badge: null,
  },
  {
    title: 'Facebook Story Downloader',
    description: 'Descarga historias de Facebook antes de que expiren. Gratis y anónimo.',
    href: `${base}/facebook-story-downloader`,
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Facebook Photo Downloader',
    description: 'Descarga fotos y álbumes de Facebook en calidad HD completa.',
    href: `${base}/facebook-photo-downloader`,
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Instagram Audio Downloader',
    description: 'Extrae audio de Instagram Reels y videos como MP3 de alta calidad.',
    href: `${base}/instagram-audio-downloader`,
    icon: 'audio',
    badge: null,
  },
  {
    title: 'Descargador de Videos de X (Twitter)',
    description: 'Descarga videos y GIFs de X (Twitter) en calidad HD.',
    href: `${base}/x-video-downloader`,
    icon: 'x',
    badge: null,
  },
];

const faqData = [
  { q: '¿TikSaveHub es gratis?', a: 'Sí. TikSaveHub es 100% gratis sin costos ocultos. Puedes descargar videos ilimitados de TikTok, Instagram, Facebook y X sin pagar nada.' },
  { q: '¿Necesito instalar una app?', a: 'No. TikSaveHub funciona completamente en tu navegador. No se necesita app, extensión ni instalación de software.' },
  { q: '¿Puedo descargar videos privados?', a: 'No. TikSaveHub solo funciona con videos públicos que puedes ver en un navegador. No se puede acceder al contenido de cuentas privadas.' },
  { q: '¿Qué dispositivos son compatibles?', a: 'TikSaveHub funciona en todos los dispositivos modernos — iPhone, Android, Windows PC, Mac y tablets. Cualquier navegador (Safari, Chrome, Firefox, Edge) funcionará.' },
  { q: '¿Es legal descargar videos?', a: 'Descargar videos para uso personal generalmente está permitido. Siempre respeta los derechos de autor y obtén permiso antes de reutilizar o usar contenido comercialmente.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Descargadores de Video TikSaveHub',
  description: 'Herramientas gratuitas en línea para descargar videos de TikTok, Instagram, Facebook y X (Twitter) en calidad HD.',
  numberOfItems: tools.length,
  itemListElement: tools.map((tool, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: tool.title,
      url: `https://tiksavehub.com${tool.href}`,
      description: tool.description,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'All',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
  })),
};

const features = [
  {
    title: 'Calidad HD',
    description: 'Descarga siempre en la máxima resolución disponible — hasta 1080p.',
    icon: 'hd',
  },
  {
    title: 'Sin Marca de Agua',
    description: 'Descargas limpias sin branding ni superposiciones de ninguna plataforma.',
    icon: 'clean',
  },
  {
    title: 'Funciona en Todos lados',
    description: 'Úsalo en iPhone, Android, PC o tablet — cualquier navegador, sin necesidad de app.',
    icon: 'devices',
  },
  {
    title: '100% Gratis',
    description: 'Descargas ilimitadas sin costos ocultos, sin necesidad de registro.',
    icon: 'free',
  },
];
---

<Layout
  title="TikSaveHub — Descargar Videos de TikTok Sin Marca de Agua"
  description="Descarga videos de TikTok en calidad HD sin marca de agua. Gratis, rápido y sin registro."
  keywords="descargador tiktok, descargar videos tiktok sin marca de agua, tiktok mp3, descargar reels instagram, descargar videos facebook, hd video downloader, gratis"
  canonical="/"
  ogImage="/og-default.png"
  jsonLd={JSON.stringify([organizationJsonLd, websiteJsonLd, itemListJsonLd, faqJsonLd])}
  appName="TikSaveHub"
  lang="es"
>
  <!-- Hero -->
  <section class="home-hero" aria-labelledby="home-headline">
    <div class="home-hero-gradient gradient-mesh" aria-hidden="true"></div>
    <div class="home-hero-inner container-page">
      <div class="home-badge-row">
        <span class="badge-pill home-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          Gratis · HD · Sin Marca de Agua
        </span>
      </div>

      <h1 id="home-headline" class="home-headline">
        Descarga Videos De<br />
        <span class="headline-gradient">TikTok, Instagram, Facebook & X</span>
      </h1>

      <p class="home-sub text-body-lg">
        Guarda videos en calidad HD sin marcas de agua. Gratis, rápido y funciona en cualquier dispositivo — sin app ni registro.
      </p>

      <div class="home-tools-grid">
        {tools.map((tool) => (
          <a href={tool.href} class="home-tool-card" aria-label={tool.title}>
            <div class="home-tool-icon" aria-hidden="true">
              {tool.icon === 'tiktok' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
              )}
              {tool.icon === 'instagram' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              )}
              {tool.icon === 'facebook' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              )}
              {tool.icon === 'x' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
              )}
              {tool.icon === 'audio' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              )}
            </div>
            <div class="home-tool-info">
              <h2 class="home-tool-title">{tool.title}</h2>
              <p class="home-tool-desc">{tool.description}</p>
            </div>
            {tool.badge && <span class="home-tool-badge">{tool.badge}</span>}
          </a>
        ))}
      </div>

      <div class="home-trust">
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          100% Gratis
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Sin Marca de Agua
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Calidad HD
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Sin Registro
        </span>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="home-features" aria-labelledby="features-headline">
    <div class="home-features-inner container-page">
      <span class="section-eyebrow text-caption-mono">Por Qué TikSaveHub</span>
      <h2 id="features-headline" class="section-headline">Diseñado para velocidad, calidad y simplicidad</h2>
      <div class="home-features-grid">
        {features.map((f) => (
          <div class="home-feature-card">
            <div class="home-feature-icon" aria-hidden="true">
              {f.icon === 'hd' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7v10"/><path d="M6 7v10"/><path d="M10 7v10"/><path d="M14 7v10"/><path d="M18 7v10"/><path d="M22 7v10"/></svg>
              )}
              {f.icon === 'clean' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              )}
              {f.icon === 'devices' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              )}
              {f.icon === 'free' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              )}
            </div>
            <h3 class="home-feature-title">{f.title}</h3>
            <p class="home-feature-desc">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="home-how" aria-labelledby="how-headline">
    <div class="home-how-inner container-page">
      <span class="section-eyebrow text-caption-mono">Cómo Funciona</span>
      <h2 id="how-headline" class="section-headline">Tres pasos para descargar cualquier video</h2>
      <div class="home-steps">
        <div class="home-step">
          <span class="home-step-num">1</span>
          <h3 class="home-step-title">Copia el Enlace del Video</h3>
          <p class="home-step-desc">Abre TikTok, Instagram, Facebook o X. Encuentra el video que quieres guardar y copia su enlace.</p>
        </div>
        <div class="home-step">
          <span class="home-step-num">2</span>
          <h3 class="home-step-title">Pega en TikSaveHub</h3>
          <p class="home-step-desc">Ve a la página de la herramienta correcta y pega el enlace del video en el cuadro de descarga.</p>
        </div>
        <div class="home-step">
          <span class="home-step-num">3</span>
          <h3 class="home-step-title">Descarga en HD</h3>
          <p class="home-step-desc">Haz clic en Descargar y guarda el archivo MP4 limpio y sin marca de agua en tu dispositivo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="home-faq" aria-labelledby="faq-headline">
    <div class="home-faq-inner container-page">
      <span class="section-eyebrow text-caption-mono">Preguntas Frecuentes</span>
      <h2 id="faq-headline" class="section-headline">Preguntas frecuentes</h2>
      <div class="home-faq-grid">
        <details class="home-faq-item">
          <summary class="home-faq-q">¿TikSaveHub es gratis?</summary>
          <p class="home-faq-a">Sí. TikSaveHub es 100% gratis sin costos ocultos. Puedes descargar videos ilimitados de TikTok, Instagram, Facebook y X sin pagar nada.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">¿Necesito instalar una app?</summary>
          <p class="home-faq-a">No. TikSaveHub funciona completamente en tu navegador. No se necesita app, extensión ni instalación de software.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">¿Puedo descargar videos privados?</summary>
          <p class="home-faq-a">No. TikSaveHub solo funciona con videos públicos que puedes ver en un navegador. No se puede acceder al contenido de cuentas privadas.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">¿Qué dispositivos son compatibles?</summary>
          <p class="home-faq-a">TikSaveHub funciona en todos los dispositivos modernos — iPhone, Android, Windows PC, Mac y tablets. Cualquier navegador (Safari, Chrome, Firefox, Edge) funcionará.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">¿Es legal descargar videos?</summary>
          <p class="home-faq-a">Descargar videos para uso personal generalmente está permitido. Siempre respeta los derechos de autor y obtén permiso antes de reutilizar o usar contenido comercialmente.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Blog Teaser -->
  <section class="home-blog" aria-labelledby="blog-headline">
    <div class="home-blog-inner container-page">
      <span class="section-eyebrow text-caption-mono">Del Blog</span>
      <h2 id="blog-headline" class="section-headline">Guías, consejos y tutoriales</h2>
      <div class="home-blog-grid">
        <a href={`${base}/blog/facebook-video-downloader-guide`} class="home-blog-card">
          <span class="home-blog-tag">Guías de Facebook</span>
          <h3 class="home-blog-title">Descargador de Videos de Facebook: Guarda Videos de FB en HD (Guía 2026)</h3>
          <p class="home-blog-excerpt">Descarga videos, Reels y clips de Watch de Facebook en HD 1080p sin marca de agua. Paso a paso para iPhone, Android y PC.</p>
        </a>
        <a href={`${base}/blog/x-video-downloader-guide`} class="home-blog-card">
          <span class="home-blog-tag">Guías de X y Twitter</span>
          <h3 class="home-blog-title">Descargador de Videos de X: Guarda Videos de Twitter en HD (Guía 2026)</h3>
          <p class="home-blog-excerpt">Descarga videos, GIFs y audio de X (Twitter) en HD 1080p sin marca de agua. Gratis, sin registro.</p>
        </a>
        <a href={`${base}/blog/tiktok-video-downloader-without-watermark`} class="home-blog-card">
          <span class="home-blog-tag">Guías de TikTok</span>
          <h3 class="home-blog-title">Descargador de Videos de TikTok Sin Marca de Agua (HD y Gratis)</h3>
          <p class="home-blog-excerpt">Descarga videos de TikTok sin marca de agua en calidad HD. Rápido, gratis y funciona en iPhone, Android y PC.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ─── Hero ─── */
  .home-hero {
    position: relative;
    padding: var(--spacing-5xl) var(--spacing-lg) var(--spacing-4xl);
    overflow: hidden;
    text-align: center;
  }

  .home-hero-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .home-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xl);
    max-width: 900px;
    margin-inline: auto;
  }

  .home-badge-row {
    display: flex;
    justify-content: center;
  }

  .home-badge {
    background: rgba(124, 58, 237, 0.1);
    border-color: rgba(124, 58, 237, 0.25);
    color: #7c3aed;
  }

  .dark .home-badge {
    background: rgba(192, 132, 252, 0.15);
    border-color: rgba(192, 132, 252, 0.3);
    color: #c084fc;
  }

  .home-headline {
    font-size: 52px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -2.5px;
    color: var(--color-ink);
    margin: 0;
  }

  .home-sub {
    max-width: 600px;
    text-align: center;
    margin: 0;
  }

  /* ─── Tools Grid ─── */
  .home-tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    width: 100%;
    max-width: 900px;
  }

  .home-tool-card {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    position: relative;
  }

  .home-tool-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(124, 58, 237, 0.15);
    border-color: rgba(124, 58, 237, 0.3);
  }

  .home-tool-icon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(0, 124, 240, 0.1));
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7c3aed;
  }

  .dark .home-tool-icon {
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.15), rgba(56, 189, 248, 0.1));
    color: #c084fc;
  }

  .home-tool-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }

  .home-tool-title {
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -0.3px;
    color: var(--color-ink);
    margin: 0;
  }

  .home-tool-desc {
    font-size: 13px;
    color: var(--color-mute);
    line-height: 1.4;
    margin: 0;
  }

  .home-tool-badge {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #fff;
    letter-spacing: -0.2px;
  }

  .home-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  /* ─── Features ─── */
  .home-features {
    padding: var(--spacing-5xl) var(--spacing-lg);
  }

  .home-features-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-3xl);
  }

  .home-features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
    width: 100%;
  }

  .home-feature-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-md);
    padding: var(--spacing-xl);
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    transition: box-shadow 0.2s ease;
  }

  .home-feature-card:hover {
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.1);
  }

  .home-feature-icon {
    width: 52px;
