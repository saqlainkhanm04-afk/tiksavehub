];

const faqJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqData.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) });

const howToJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'HowTo', name: 'Cómo Descargar Reels de Instagram Sin Marca de Agua', description: 'Guía paso a paso para descargar Reels de Instagram en calidad HD sin marca de agua usando TikSaveHub.', totalTime: 'PT2M', step: [ { '@type': 'HowToStep', name: 'Copia el enlace del Reel de Instagram', text: 'Abre la aplicación de Instagram, encuentra el Reel que quieres guardar, toca el icono de compartir y selecciona Copiar Enlace.', position: 1 }, { '@type': 'HowToStep', name: 'Pega el enlace en TikSaveHub', text: 'Visita TikSaveHub.com y pega el enlace del Reel copiado en el campo de entrada de descarga.', position: 2 }, { '@type': 'HowToStep', name: 'Haz clic en Descargar', text: 'Haz clic en el botón Descargar y espera unos segundos mientras el Reel se procesa.', position: 3 }, { '@type': 'HowToStep', name: 'Guarda el video en HD', text: 'Elige la opción MP4 en HD (sin marca de agua) y guarda el archivo de video en tu dispositivo.', position: 4 } ], tool: { '@type': 'HowToTool', name: 'TikSaveHub' } });

const combinedJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd)] });
