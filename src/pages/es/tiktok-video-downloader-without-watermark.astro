export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import DownloadForm from '../../components/DownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';
import SocialShare from '../../components/SocialShare.astro';

const faqData = [
 {
  id: 'dl-ww',
  q: 'Como puedo descargar videos de TikTok sin marca de agua en TikSaveHub?',
  a: 'Copia el enlace del video en TikTok, pegalo en el campo de entrada de esta pagina y dale a Descargar. TikSaveHub toma el archivo de video original, el que TikTok le sirve a tu navegador antes de que le pongan la marca de agua. Dos o tres segundos despues, tienes un MP4 listo para guardar sin ningun logo encima.',
 },
 {
  id: 'dl-hd',
  q: 'Puedo guardar videos de TikTok en calidad HD 1080p usando TikSaveHub?',
  a: 'TikSaveHub descarga la mejor calidad que TikTok tenga disponible para ese video. La mayoria de creadores populares suben en 1080p (1920x1080 pixeles) y eso es exactamente lo que se descarga. Sin recodificar, sin compresion extra. La herramienta toma el stream original que se reproduce en tu navegador, asi que lo que ves en TikTok es lo que obtienes.\n\nSi un creator solo subio en 720p o 480p, TikSaveHub no puede magia para subirlo. La calidad depende de lo que el creador exporto. Pero cuando hay multiples streams con diferentes bitrates, la herramienta siempre elige el mas alto disponible.',
 },
 {
  id: 'dl-iphone',
  q: 'Puedo usar TikSaveHub para descargar videos de TikTok en mi iPhone (Safari)?',
  a: 'Funciona en cualquier iPhone con iOS 13 o posterior. Abre Safari, copia un enlace de TikTok, pegalo en TikSaveHub y toca Descargar. El archivo cae en el gestor de descargas de Safari. Desliza hacia abajo desde la parte superior de Safari para verlo, luego toca la lupa para abrirlo en la app Archivos.\n\nUn par de cosas que vale la saber. Versiones antiguas de iOS (12 y anteriores) a veces bloquean descargas por completo por las restricciones de Apple. Ademas, si Safari tira un mensaje raro de "este tipo de archivo no se puede descargar", cambiar a Chrome en el mismo iPhone suele arreglarlo. La herramienta no le importa que navegador uses. El sistema operativo del telefono es el que a veces pone problemas.',
 },
 {
  id: 'dl-devices',
  q: 'Puedo usar TikSaveHub en Android y PC para descargar videos de TikTok?',
  a: 'Cualquier dispositivo con un navegador moderno. Telefonos Android, PCs Windows, Macs, maquinas Linux, tablets. No importa. TikSaveHub funciona enteramente en el navegador, asi que no hay nada que instalar.',
 },
 {
  id: 'dl-links',
  q: 'Que formatos de enlaces de TikTok admite TikSaveHub (vm.tiktok.com o vt.tiktok.com)?',
  a: 'Todos los formatos de URLs de TikTok funcionan. Enlaces completos (tiktok.com/@user/video/...), enlaces acortados (vm.tiktok.com/...) y enlaces moviles (vt.tiktok.com/...) se resuelven automaticamente. A TikSaveHub no le importa como se copio el enlace. Del menu de compartir, de la barra de direcciones del navegador o de un mensaje de texto. Pegalo y la herramienta se encarga del resto.',
 },
 {
  id: 'dl-free',
  q: 'Es TikSaveHub gratuito, y necesito registrarme o instalar algun software?',
  a: 'Totalmente gratis. Sin registro, sin recoleccion de correos, sin suscripcion escondida. Pega un enlace, descarga el video, listo.\n\nLo que TikSaveHub no hace: no te pide cuenta, no muestra ads intermedios antes de las descargas y no pone limite diario. El procesamiento ocurre del lado del servidor, asi que no hay extension de navegador que instalar ni app que bajar. Algunos descargadores "gratis" de TikTok te empujan a un plan de pago despues de unas descargas. Este no.',
 },
 {
  id: 'dl-account',
  q: 'Necesito una cuenta de TikTok para descargar videos en TikSaveHub?',
  a: 'No se necesita cuenta de TikTok. Mientras el video sea publicamente accesible en TikTok, TikSaveHub puede traerlo. Copia el enlace via Compartir > Copiar Enlace, pegalo en la herramienta y la descarga empieza. Los videos privados o restringidos no van a funcionar. Pero TikSaveHub te dice eso con honestanza en vez de tirar un error confuso o fallar silenciosamente.',
 },
 {
  id: 'dl-legal',
  q: 'Es legal descargar videos de TikTok sin marca de agua?',
  a: 'Guardar un video de TikTok para verlo offline o para uso personal cae en una zona gris que se tolera bastante. Los Terminos de Servicio de TikTok tecnicamente prohiben descargar fuera de la app, pero esa clausula va contra bots de scraping y redistribucion masiva. No contra alguien que guarda un video para verlo en un avion.\n\nDonde se pone legalmente complicado es el uso comercial. Correr un canal de compilaciones con TikToks de otros, usar el video de alguien en una campana publicitaria o repostear contenido sin credito. Eso puede constituir infraccion de derechos de autor sin importar si quitaste la marca de agua. Credit al creador original, no monetizar su trabajo sin permiso, y mantente del lado correcto.',
 },
 {
  id: 'dl-remove',
  q: 'Como elimina TikSaveHub la marca de agua de TikTok?',
  a: 'TikTok mantiene una version limpia de cada video en sus servidores para streaming. La marca de agua solo se aplica cuando alguien guarda desde la app. TikSaveHub descarga ese archivo original de streaming, el que no tiene ningun logo ni superposicion.',
 },
 {
  id: 'dl-private',
  q: 'Puede TikSaveHub descargar videos de cuentas privadas de TikTok?',
  a: 'No. Esto es una pared tecnica dura, no una decision de politica. Los videos privados no se exponen a traves de la API publica de TikTok. Ningun descargador legitimo, y hay un monton de turbios que dicen lo contrario, puede acceder a contenido privado sin violar los terminos de TikTok. Si el video esta configurado como privado, simplemente no se puede traer desde fuera de la cuenta.',
 },
 {
  id: 'dl-format',
  q: 'Que formato de archivo y calidad tendran mis videos de TikTok descargados?',
  a: 'MP4. Ese es el formato en el que TikTok transmite, y eso es lo que se guarda. La calidad llega hasta 1080p dependiendo de lo que el creador subio.',
 },
 {
  id: 'dl-limits',
  q: 'Hay algun limite en cuantos videos de TikTok puedo descargar?',
  a: 'Sin topes diarios, sin cuotas de descarga, sin limite premium. Guarda tantos videos como necesites. Cada descarga se procesa en mas o menos los mismos dos o tres segundos sin importar cuantas se hayan hecho ese dia.',
 },
];

const faqJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqData.map((faq) => ({
  '@type': 'Question',
  name: faq.q,
  acceptedAnswer: {
   '@type': 'Answer',
   text: faq.a.replace(/<[^>]*>/g, ''),
  },
 })),
});

const howToJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@type': 'HowTo',
 name: 'Como Descargar Videos de TikTok Sin Marca de Agua',
 description: 'Guia paso a paso para guardar videos de TikTok en calidad HD sin marca de agua usando TikSaveHub.',
 totalTime: 'PT2M',
 step: [
  {
   '@type': 'HowToStep',
   name: 'Copia el enlace del video de TikTok',
   text: 'Abre la app de TikTok, encuentra el video que quieres guardar, toca Compartir y selecciona Copiar Enlace.',
   position: 1,
  },
  {
   '@type': 'HowToStep',
   name: 'Pega el enlace en TikSaveHub',
   text: 'Visita TikSaveHub.com y pega el enlace de TikTok copiado en el campo de entrada de descarga.',
   position: 2,
  },
  {
   '@type': 'HowToStep',
   name: 'Haz clic en Descargar',
   text: 'Haz clic en el boton Descargar y espera unos segundos mientras el video se procesa.',
   position: 3,
  },
  {
   '@type': 'HowToStep',
   name: 'Guarda el video en HD',
   text: 'Elige la opcion MP4 en HD (sin marca de agua) y guarda el archivo de video en tu dispositivo.',
   position: 4,
  },
 ],
 tool: {
  '@type': 'HowToTool',
  name: 'TikSaveHub',
 },
});

const combinedJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd)],
});
