---
// Facebook Photo Downloader — SEO-optimized landing page
// URL: /facebook-photo-downloader
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import FbHeroSection from '../components/FbHeroSection.astro';
import FbSeoArticle from '../components/FbSeoArticle.astro';
import FbStepsSection from '../components/FbStepsSection.astro';
import FbFeaturesSection from '../components/FbFeaturesSection.astro';
import FbFaqSection from '../components/FbFaqSection.astro';
import FbCtaBand from '../components/FbCtaBand.astro';
import FbInternalLinks from '../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../components/FacebookDownloadForm.astro';
import StatsSection from '../components/StatsSection.astro';

const faqData = [
  {
    id: 'photo-hd',
    q: 'What quality do I get when I download a Facebook photo?',
    a: 'You get the full-resolution original the person uploaded — not the compressed preview Facebook shows in your feed. Our downloader finds the original image on Facebook\u2019s CDN and saves it at its maximum available size, so profiles, captions, or tiny thumbnails are never what you end up with.',
  },
  {
    id: 'photo-iphone',
    q: 'How do I save a Facebook photo on iPhone?',
    a: 'Copy the photo link (tap Share on the photo and choose "Copy Link"), paste it into the box above, and tap Download Photo. The image saves to your iPhone\u2019s Files app under Downloads or straight to your camera roll, depending on your browser — no app needed.',
  },
  {
    id: 'photo-android',
    q: 'Can I download Facebook photos on Android?',
    a: 'Yes. Paste the photo link into the field above and tap Download Photo — the full-size image saves to your Android device\u2019s gallery or Downloads folder instantly, no app or extension required.',
  },
  {
    id: 'photo-private',
    q: 'Can I download a photo from a private Facebook profile?',
    a: 'We can only download photos that are publicly accessible. Photos and albums from private accounts are protected — we cannot bypass privacy settings, and we never try.',
  },
  {
    id: 'photo-formats',
    q: 'Which photo links does this tool support?',
    a: 'It accepts standard photo links like facebook.com/photo.php?fbid=…, facebook.com/{profile}/photos/…, and photo permalinks from the Share menu. If the page is a video post instead, our other tools — like the <a href="/facebook-video-downloader">Facebook video downloader</a> — will handle it.',
  },
  {
    id: 'photo-legal',
    q: 'Is saving Facebook photos allowed?',
    a: 'Saving a photo for personal, offline use is fine, and our downloader never modifies the image. But do not repost or reuse photos commercially without the owner\u2019s permission — always respect copyright and credit the original creator.',
  },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]*>/g, ''),
    },
  })),
});
---

<Layout
  title="Facebook Photo Downloader — Save Full-Resolution Photos Free | TikSaveHub"
  description="Download Facebook photos in full resolution free — no sign-up, no watermark. Save any public fb photo on iPhone, Android or PC in one click with TikSaveHub."
  keywords="download facebook photos full resolution free, facebook photo downloader online, save facebook photo link, facebook photo saver, download fb photos hd, facebook picture downloader, save facebook profile photos, facebook photo download link"
  canonical="/facebook-photo-downloader"
  ogImage="/og-downloader.png"
  ogType="website"
  platform="facebook"
  jsonLd={faqJsonLd}
  appName="TikSaveHub — Facebook Photo Downloader"
  appRating={{ value: '4.8', count: '8740' }}
>
  <!-- JSON-LD Structured Data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://tiksavehub.com" },
      { "@type": "ListItem", "position": 2, "name": "Facebook Photo Downloader", "item": "https://tiksavehub.com/facebook-photo-downloader" }
