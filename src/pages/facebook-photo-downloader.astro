        body: 'Photos are just the start — videos, Reels, stories, and MP3 audio are all covered on the same TikSaveHub page.',
      },
    ]}
  />

  <!-- FAQ -->
  <FbFaqSection
    eyebrow="FAQ"
    headline="Facebook photo download questions, answered."
    prefix="photo"
    faqs={faqData}
