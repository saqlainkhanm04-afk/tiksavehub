const faqJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqData.map((faq) => ({
 '@type': 'Question',
 name: faq.q,
 acceptedAnswer: {
 '@type': 'Answer',
 text: faq.a.replace(/<[^>]*>/g, ''),
 },
 })),
});

const howToJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@type': 'HowTo',
 name: 'How to Download Facebook Stories in HD',
 description: 'Step-by-step guide to download Facebook stories in HD quality without watermark using TikSaveHub.',
 totalTime: 'PT1M',
 step: [
 {
 '@type': 'HowToStep',
 name: 'Copy the story link',
 text: 'Open the Facebook app or website, view the story, tap the share menu, and choose Copy Link.',
 position: 1,
 },
 {
 '@type': 'HowToStep',
 name: 'Paste the link into TikSaveHub',
 text: 'Visit TikSaveHub and paste the copied story link into the download input field.',
 position: 2,
 },
 {
 '@type': 'HowToStep',
 name: 'Download the story in HD',
 text: 'Click the Download button and save the HD MP4 video or JPG image to your device.',
 position: 3,
 },
 ],
 tool: {
 '@type': 'HowToTool',
 name: 'TikSaveHub',
 },
});

const webAppJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@type': 'WebApplication',
 name: 'TikSaveHub - Facebook Story Downloader',
 url: 'https://tiksavehub.com/facebook-story-downloader',
 applicationCategory: 'MultimediaApplication',
 operatingSystem: 'Any',
 offers: {
 '@type': 'Offer',
 price: '0',
 priceCurrency: 'USD',
 },
 description: 'Free online Facebook story downloader. Save FB stories as HD MP4 videos or JPG images without watermark.',
});

const combinedJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd), JSON.parse(webAppJsonLd)],
});
