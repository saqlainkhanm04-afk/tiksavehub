---
// Facebook to MP3 Converter — SEO-optimized landing page
// URL: /facebook-to-mp3 — MP3 mode form (audio tile pre-selected)
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import FbHeroSection from '../components/FbHeroSection.astro';
import FbSeoArticle from '../components/FbSeoArticle.astro';
import FbStepsSection from '../components/FbStepsSection.astro';
import FbFeaturesSection from '../components/FbFeaturesSection.astro';
import FbFaqSection from '../components/FbFaqSection.astro';
import FbCtaBand from '../components/FbCtaBand.astro';
import FbInternalLinks from '../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../components/FacebookDownloadForm.astro';
import StatsSection from '../components/StatsSection.astro';

const faqData = [
  {
    id: 'mp3-how',
    q: 'How can I convert a Facebook video to MP3?',
    a: 'To convert a Facebook video to MP3, simply copy the public video link, paste it into TikSaveHub, and click download. Our tool instantly extracts the audio and saves it as a high-quality MP3 file without requiring you to download the full video.',
  },
  {
    id: 'mp3-reel',
    q: 'Can I download audio from a Facebook Reel?',
    a: 'Yes, you can easily download Facebook Reel audio. Just paste the Reel URL into TikSaveHub, and we will extract the exact background music, voiceover, or original sound and save it directly as an MP3.',
  },
  {
    id: 'mp3-what-is',
    q: 'What is a Facebook sound downloader online?',
    a: 'A Facebook sound downloader online is a web tool like TikSaveHub that lets you strip the audio track from any public Facebook video or Reel. It converts the media into a clean MP3 file directly in your browser, saving you from downloading bulky video files.',
  },
  {
    id: 'mp3-audio-only',
    q: 'Can I extract audio from an FB video without downloading the video?',
    a: 'Absolutely. Our extract audio from FB video tool processes the media stream on our servers and delivers only the MP3 file. You never have to download or store the heavy MP4 video file on your device.',
  },
  {
    id: 'mp3-320',
