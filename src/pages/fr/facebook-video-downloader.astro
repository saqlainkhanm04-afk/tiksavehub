export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import FacebookDownloadForm from '../../components/FacebookDownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';
import SocialShare from '../../components/SocialShare.astro';

const faqData = [
  {
    id: 'fb-hd-1080p',
    q: 'Comment puis-je télécharger une vidéo Facebook en HD 1080p ?',
    a: 'Pour télécharger une vidéo Facebook en HD 1080p, copiez simplement le lien de la vidéo publique, collez-le dans TikSaveHub et cliquez sur télécharger. Si la publication Facebook originale a une source 1080p, notre outil extractera automatiquement et fournira cette option haute définition.',
  },
  {
    id: 'fb-4k',
    q: 'Puis-je télécharger des vidéos Facebook en 4K ?',
    a: 'Oui, vous pouvez télécharger des vidéos 4K, mais seulement si le créateur original a téléchargé la vidéo sur Facebook en résolution 4K. TikSaveHub récupère la qualité maximale disponible directement depuis les serveurs de Facebook.',
  },
  {
    id: 'fb-iphone',
