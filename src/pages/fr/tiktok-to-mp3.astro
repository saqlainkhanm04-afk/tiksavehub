import SocialShare from '../../components/SocialShare.astro';

const faqData = [
 {
  id: 'mp3-how',
  q: 'Comment convertir une video TikTok en MP3 ?',
  a: 'Copiez le lien de la video TikTok, collez-le dans le champ de saisie de cette page, et cliquez sur Telecharger. TikSaveHub extrait la piste audio de la video et la convertit en MP3. L\'operation dure deux a trois secondes. Pas d\'application a installer, pas de compte a creer. Collez le lien et telechargez.',
 },
 {
  id: 'mp3-quality',
  q: 'Quelle qualite audio propose TikSaveHub ?',
  a: 'TikSaveHub extrait l\'audio au debit le plus eleve disponible dans la video source. La plupart des videos TikTok contiennent de l\'audio AAC a 128kbps, qui se convertit en un fichier MP3 propre. Le resultat correspond a ce que vous entendez sur TikTok. Pas de compression supplementaire, pas de perte de qualite pendant la conversion.\n\nUn point a connaître : TikSaveHub ne peut pas ameliorer un audio deja compresse par TikTok. Si la source est a 128kbps, le MP3 sera a 128kbps. Mais il ne sera pas inferieur. La conversion est sans perte. Ce qui entre ressort identique, simplement au format MP3 au lieu d\'AAC.',
 },
 {
  id: 'mp3-iphone',
  q: 'Puis-je convertir des videos TikTok en MP3 sur mon iPhone ?',
  a: 'Ca fonctionne sur tout iPhone avec Safari (iOS 13 ou plus recent). Ouvrez TikTok, copiez le lien de la video, basculez sur Safari, collez le lien dans TikSaveHub, et appuyez sur Telecharger. Le fichier MP3 apparait dans le gestionnaire de telechargements de Safari. Faites glisser vers le bas pour le localiser, puis appuyez sur la loupe pour l\'ouvrir dans l\'appli Fichiers.\n\nLes anciens iPhones sous iOS 12 ou anterieur bloquent parfois les telechargements. Dans ce cas, passer sur Chrome sur le meme appareil resoud generalement le probleme. L\'outil fonctionne avec n\'importe quel navigateur. C\'est le systeme d\'exploitation qui cree parfois des difficultes.',
 },
 {
  id: 'mp3-devices',
  q: 'TikSaveHub fonctionne-t-il sur Android et PC ?',
  a: 'Tout appareil avec un navigateur moderne. Telephones Android, PC Windows, Mac, machines Linux, tablettes. Sans distinction. TikSaveHub est entierement base sur le navigateur, rien a installer.',
