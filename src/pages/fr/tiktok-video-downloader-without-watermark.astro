const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]*>/g, ''),
    },
  })),
});

const howToJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Comment télécharger des vidéos TikTok sans filigrane',
  description: 'Guide étape par étape pour télécharger des vidéos TikTok en qualité HD sans filigrane avec TikSaveHub.',
  totalTime: 'PT2M',
  step: [
    {
      '@type': 'HowToStep',
      name: 'Copiez le lien de la vidéo TikTok',
      text: 'Ouvrez l\'application TikTok, trouvez la vidéo que vous souhaitez enregistrer, appuyez sur Partager et sélectionnez Copier le lien.',
      position: 1,
    },
    {
      '@type': 'HowToStep',
      name: 'Collez le lien dans TikSaveHub',
      text: 'Visitez TikSaveHub.com et collez le lien TikTok copié dans le champ de saisie de téléchargement.',
      position: 2,
    },
    {
      '@type': 'HowToStep',
      name: 'Cliquez sur Télécharger',
      text: 'Cliquez sur le bouton Télécharger et attendez quelques secondes pendant que la vidéo est traitée.',
      position: 3,
    },
    {
      '@type': 'HowToStep',
      name: 'Enregistrez la vidéo HD',
      text: 'Choisissez l\'option MP4 HD (sans filigrane) et enregistrez le fichier vidéo sur votre appareil.',
      position: 4,
    },
  ],
  tool: {
    '@type': 'HowToTool',
    name: 'TikSaveHub',
  },
});

const combinedJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd)],
});
