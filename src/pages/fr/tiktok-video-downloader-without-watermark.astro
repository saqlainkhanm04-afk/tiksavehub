   name: 'Enregistre la video HD',
   text: 'Choisis l\'option MP4 HD (sans filigrane) et enregistre le fichier sur ton appareil.',
   position: 4,
  },
 ],
 tool: {
  '@type': 'HowToTool',
  name: 'TikSaveHub',
