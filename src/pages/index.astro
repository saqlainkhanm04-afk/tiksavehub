---
// TikSaveHub Homepage — hub page for all tools
export const prerender = true;

import Layout from '../layouts/Layout.astro';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TikSaveHub',
  url: 'https://tiksavehub.com',
  logo: 'https://tiksavehub.com/web-app-manifest-512x512.png',
  description: 'Download videos from TikTok, Instagram, Facebook, and X (Twitter) in HD quality — free, fast, no watermark.',
  sameAs: [
    'https://twitter.com/tiksavehub',
    'https://www.facebook.com/tiksavehub',
    'https://www.instagram.com/tiksavehub',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'support@tiksavehub.com',
  },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TikSaveHub',
  url: 'https://tiksavehub.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://tiksavehub.com/tiktok-video-downloader-without-watermark?url={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const tools = [
  {
    title: 'TikTok Video Downloader',
    description: 'Save TikTok videos without watermark in HD quality. Free, fast, no sign-up.',
    href: '/tiktok-video-downloader-without-watermark',
    icon: 'tiktok',
    badge: 'Popular',
  },
  {
    title: 'TikTok to MP3',
    description: 'Extract audio from TikTok videos as high-quality MP3 files up to 320kbps.',
    href: '/tiktok-to-mp3',
    icon: 'audio',
    badge: null,
  },
  {
    title: 'Instagram Reels Downloader',
    description: 'Download Instagram Reels without watermark in HD. Works on all devices.',
    href: '/instagram-reels-downloader-without-watermark',
    icon: 'instagram',
    badge: 'New',
  },
  {
    title: 'Instagram Video Downloader',
    description: 'Save Instagram videos and posts in HD quality. No app required.',
    href: '/instagram-video-downloader-without-watermark',
    icon: 'instagram',
    badge: null,
  },
  {
    title: 'Instagram Story Downloader',
    description: 'Download Instagram Stories before they expire. Free and anonymous.',
    href: '/instagram-story-downloader-without-watermark',
    icon: 'instagram',
    badge: null,
  },
  {
    title: 'Facebook Video Downloader',
    description: 'Download Facebook videos, Reels, and posts in HD quality.',
    href: '/facebook-video-downloader',
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Facebook Reels Downloader',
    description: 'Save Facebook Reels without watermark in HD quality.',
    href: '/facebook-reels-downloader',
    icon: 'facebook',
    badge: 'New',
  },
  {
    title: 'Facebook to MP3',
    description: 'Extract audio from Facebook videos as high-quality MP3 files.',
    href: '/facebook-to-mp3',
    icon: 'audio',
    badge: null,
  },
  {
    title: 'Facebook Story Downloader',
    description: 'Download Facebook Stories before they expire. Free and anonymous.',
    href: '/facebook-story-downloader',
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Facebook Photo Downloader',
    description: 'Download Facebook photos and albums in full HD quality.',
    href: '/facebook-photo-downloader',
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Instagram Audio Downloader',
    description: 'Extract audio from Instagram Reels and videos as high-quality MP3.',
    href: '/instagram-audio-downloader',
    icon: 'audio',
    badge: null,
  },
  {
    title: 'X (Twitter) Video Downloader',
    description: 'Download videos and GIFs from X (Twitter) in HD quality.',
    href: '/x-video-downloader',
    icon: 'x',
    badge: null,
  },
];

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'TikSaveHub Video Downloaders',
  description: 'Free online tools to download videos from TikTok, Instagram, Facebook, and X (Twitter) in HD quality.',
  numberOfItems: tools.length,
  itemListElement: tools.map((tool, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: tool.title,
      url: `https://tiksavehub.com${tool.href}`,
      description: tool.description,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'All',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
  })),
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is TikSaveHub free to use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. TikSaveHub is 100% free with no hidden fees. You can download unlimited videos from TikTok, Instagram, Facebook, and X without paying anything.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to install an app?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. TikSaveHub works entirely in your browser. No app, extension, or software installation is required.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I download private videos?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. TikSaveHub only works with public videos that you can view in a browser. Private account content cannot be accessed.',
      },
    },
    {
      '@type': 'Question',
      name: 'What devices are supported?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'TikSaveHub works on all modern devices — iPhone, Android, Windows PC, Mac, and tablets. Any browser (Safari, Chrome, Firefox, Edge) will work.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is it legal to download videos?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Downloading videos for personal use is generally allowed. Always respect copyright and get permission before reposting or using content commercially.',
      },
    },
  ],
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://tiksavehub.com',
    },
  ],
};

const features = [
  {
    title: 'HD Quality',
    description: 'Always download at the highest available resolution — up to 1080p.',
    icon: 'hd',
  },
  {
    title: 'No Watermark',
    description: 'Clean downloads with no branding or overlay from any platform.',
    icon: 'clean',
  },
  {
    title: 'Works Everywhere',
    description: 'Use on iPhone, Android, PC, or tablet — any browser, no app needed.',
    icon: 'devices',
  },
  {
    title: '100% Free',
    description: 'Unlimited downloads with no hidden fees, no sign-up required.',
    icon: 'free',
  },
];
---

<Layout
  title="TikSaveHub — Download TikTok, Instagram, Facebook & X Videos in HD"
  description="Download videos from TikTok, Instagram, Facebook, and X (Twitter) in HD quality without watermarks. Free, fast, and no sign-up required."
  keywords="tiktok downloader, instagram downloader, facebook downloader, x video downloader, download videos without watermark, hd video downloader, free video downloader"
  canonical="/"
  ogImage="/og-default.png"
  jsonLd={JSON.stringify([organizationJsonLd, websiteJsonLd, itemListJsonLd, faqJsonLd, breadcrumbJsonLd])}
  appName="TikSaveHub"
>
  <!-- Hero -->
  <section class="home-hero" aria-labelledby="home-headline">
    <div class="home-hero-gradient gradient-mesh" aria-hidden="true"></div>
    <div class="home-hero-inner container-page">
      <div class="home-badge-row">
        <span class="badge-pill home-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          Free · HD · No Watermark
        </span>
      </div>

      <h1 id="home-headline" class="home-headline">
        Download Videos From<br />
        <span class="headline-gradient">TikTok, Instagram, Facebook & X</span>
      </h1>

      <p class="home-sub text-body-lg">
        Save videos in HD quality without watermarks. Free, fast, and works on any device — no app or sign-up needed.
      </p>

      <div class="home-tools-grid">
        {tools.map((tool) => (
          <a href={tool.href} class="home-tool-card" aria-label={tool.title}>
            <div class="home-tool-icon" aria-hidden="true">
              {tool.icon === 'tiktok' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
              )}
              {tool.icon === 'instagram' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              )}
              {tool.icon === 'facebook' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              )}
              {tool.icon === 'x' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
              )}
              {tool.icon === 'audio' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              )}
            </div>
            <div class="home-tool-info">
              <h2 class="home-tool-title">{tool.title}</h2>
              <p class="home-tool-desc">{tool.description}</p>
            </div>
            {tool.badge && <span class="home-tool-badge">{tool.badge}</span>}
          </a>
        ))}
      </div>

      <div class="home-trust">
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          100% Free
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          No Watermark
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          HD Quality
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          No Sign-up
        </span>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="home-features" aria-labelledby="features-headline">
    <div class="home-features-inner container-page">
      <span class="section-eyebrow text-caption-mono">Why TikSaveHub</span>
      <h2 id="features-headline" class="section-headline">Built for speed, quality, and simplicity</h2>
      <div class="home-features-grid">
        {features.map((f) => (
          <div class="home-feature-card">
            <div class="home-feature-icon" aria-hidden="true">
              {f.icon === 'hd' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7v10"/><path d="M6 7v10"/><path d="M10 7v10"/><path d="M14 7v10"/><path d="M18 7v10"/><path d="M22 7v10"/></svg>
              )}
              {f.icon === 'clean' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              )}
              {f.icon === 'devices' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              )}
              {f.icon === 'free' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              )}
            </div>
            <h3 class="home-feature-title">{f.title}</h3>
            <p class="home-feature-desc">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="home-how" aria-labelledby="how-headline">
    <div class="home-how-inner container-page">
      <span class="section-eyebrow text-caption-mono">How It Works</span>
      <h2 id="how-headline" class="section-headline">Three steps to download any video</h2>
      <div class="home-steps">
        <div class="home-step">
          <span class="home-step-num">1</span>
          <h3 class="home-step-title">Copy the Video Link</h3>
          <p class="home-step-desc">Open TikTok, Instagram, Facebook, or X. Find the video you want to save and copy its link.</p>
        </div>
        <div class="home-step">
          <span class="home-step-num">2</span>
          <h3 class="home-step-title">Paste on TikSaveHub</h3>
          <p class="home-step-desc">Go to the right tool page and paste the video link into the download box.</p>
        </div>
        <div class="home-step">
          <span class="home-step-num">3</span>
          <h3 class="home-step-title">Download in HD</h3>
          <p class="home-step-desc">Click Download and save the clean, watermark-free MP4 file to your device.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="home-faq" aria-labelledby="faq-headline">
    <div class="home-faq-inner container-page">
      <span class="section-eyebrow text-caption-mono">FAQ</span>
      <h2 id="faq-headline" class="section-headline">Frequently asked questions</h2>
      <div class="home-faq-grid">
        <details class="home-faq-item">
          <summary class="home-faq-q">Is TikSaveHub free to use?</summary>
          <p class="home-faq-a">Yes. TikSaveHub is 100% free with no hidden fees. You can download unlimited videos from TikTok, Instagram, Facebook, and X without paying anything.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">Do I need to install an app?</summary>
          <p class="home-faq-a">No. TikSaveHub works entirely in your browser. No app, extension, or software installation is required.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">Can I download private videos?</summary>
          <p class="home-faq-a">No. TikSaveHub only works with public videos that you can view in a browser. Private account content cannot be accessed.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">What devices are supported?</summary>
          <p class="home-faq-a">TikSaveHub works on all modern devices — iPhone, Android, Windows PC, Mac, and tablets. Any browser (Safari, Chrome, Firefox, Edge) will work.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">Is it legal to download videos?</summary>
          <p class="home-faq-a">Downloading videos for personal use is generally allowed. Always respect copyright and get permission before reposting or using content commercially.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Blog Teaser -->
  <section class="home-blog" aria-labelledby="blog-headline">
    <div class="home-blog-inner container-page">
      <span class="section-eyebrow text-caption-mono">From the Blog</span>
      <h2 id="blog-headline" class="section-headline">Guides, tips, and tutorials</h2>
      <div class="home-blog-grid">
        <a href="/blog/facebook-video-downloader-guide" class="home-blog-card">
          <span class="home-blog-tag">Facebook Guides</span>
          <h3 class="home-blog-title">Facebook Video Downloader: Save FB Videos in HD (2026 Guide)</h3>
          <p class="home-blog-excerpt">Download Facebook videos, Reels, and Watch clips in HD 1080p without watermark. Step-by-step for iPhone, Android, and PC.</p>
        </a>
        <a href="/blog/x-video-downloader-guide" class="home-blog-card">
          <span class="home-blog-tag">X & Twitter Guides</span>
          <h3 class="home-blog-title">X Video Downloader: Save Twitter Videos in HD (2026 Guide)</h3>
          <p class="home-blog-excerpt">Download X (Twitter) videos, GIFs, and audio in HD 1080p without watermark. Free, no sign-up.</p>
        </a>
        <a href="/blog/tiktok-video-downloader-without-watermark" class="home-blog-card">
          <span class="home-blog-tag">TikTok Guides</span>
          <h3 class="home-blog-title">TikTok Video Downloader Without Watermark (HD & Free)</h3>
          <p class="home-blog-excerpt">Download TikTok videos without watermark in HD quality. Fast, free, and works on iPhone, Android, and PC.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ─── Hero ─── */
  .home-hero {
    position: relative;
    padding: var(--spacing-5xl) var(--spacing-lg) var(--spacing-4xl);
    overflow: hidden;
    text-align: center;
  }

  .home-hero-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .home-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xl);
    max-width: 900px;
    margin-inline: auto;
  }

  .home-badge-row {
    display: flex;
    justify-content: center;
  }

  .home-badge {
    background: rgba(124, 58, 237, 0.1);
    border-color: rgba(124, 58, 237, 0.25);
    color: #7c3aed;
  }

  .dark .home-badge {
    background: rgba(192, 132, 252, 0.15);
    border-color: rgba(192, 132, 252, 0.3);
    color: #c084fc;
  }

  .home-headline {
    font-size: 52px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -2.5px;
    color: var(--color-ink);
    margin: 0;
  }

  .home-sub {
    max-width: 600px;
    text-align: center;
    margin: 0;
  }

  /* ─── Tools Grid ─── */
  .home-tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    width: 100%;
    max-width: 900px;
  }

  .home-tool-card {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    position: relative;
  }

  .home-tool-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(124, 58, 237, 0.15);
    border-color: rgba(124, 58, 237, 0.3);
  }

  .home-tool-icon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(0, 124, 240, 0.1));
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7c3aed;
  }

  .dark .home-tool-icon {
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.15), rgba(56, 189, 248, 0.1));
    color: #c084fc;
  }

  .home-tool-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }

  .home-tool-title {
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -0.3px;
    color: var(--color-ink);
    margin: 0;
  }

  .home-tool-desc {
    font-size: 13px;
    color: var(--color-mute);
    line-height: 1.4;
    margin: 0;
  }

  .home-tool-badge {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #fff;
    letter-spacing: -0.2px;
  }

  .home-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  /* ─── Features ─── */
  .home-features {
    padding: var(--spacing-5xl) var(--spacing-lg);
  }

  .home-features-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-3xl);
  }

  .home-features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
    width: 100%;
  }

  .home-feature-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-md);
    padding: var(--spacing-xl);
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    transition: box-shadow 0.2s ease;
  }

  .home-feature-card:hover {
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.1);
  }

  .home-feature-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(0, 124, 240, 0.1));
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7c3aed;
  }

  .dark .home-feature-icon {
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.15), rgba(56, 189, 248, 0.1));
    color: #c084fc;
  }

  .home-feature-title {
    font-size: 16px;
    font-weight: 650;
    letter-spacing: -0.3px;
    color: var(--color-ink);
    margin: 0;
  }

  .home-feature-desc {
    font-size: 14px;
    color: var(--color-mute);
    line-height: 1.5;
    margin: 0;
  }

