<script>
  const pfpForm = document.getElementById('igpfp-form') as HTMLFormElement | null;
  const pfpInput = document.getElementById('igpfp-username') as HTMLInputElement | null;
  const pfpSubmit = document.getElementById('igpfp-submit') as HTMLButtonElement | null;
  const pfpStatus = document.getElementById('igpfp-status') as HTMLParagraphElement | null;
  const pfpResult = document.getElementById('igpfp-result') as HTMLDivElement | null;
  const pfpName = document.getElementById('igpfp-name') as HTMLHeadingElement | null;
  const pfpHandle = document.getElementById('igpfp-handle') as HTMLParagraphElement | null;
  const pfpImage = document.getElementById('igpfp-image') as HTMLImageElement | null;
  const pfpSize = document.getElementById('igpfp-size') as HTMLParagraphElement | null;
  const pfpBadge = document.getElementById('igpfp-badge') as HTMLSpanElement | null;
  const pfpDownload = document.getElementById('igpfp-download') as HTMLAnchorElement | null;
  const pfpProfile = document.getElementById('igpfp-profile') as HTMLAnchorElement | null;
  const pfpNote = document.getElementById('igpfp-note') as HTMLParagraphElement | null;

  function setPfpStatus(message: string, tone: '' | 'error' | 'success' = ''): void {
    if (!pfpStatus) return;
    pfpStatus.textContent = message;
    if (tone) pfpStatus.dataset.tone = tone;
    else delete pfpStatus.dataset.tone;
  }

  function pfpProxy(source: string, filename?: string): string {
    const params = new URLSearchParams({ url: source });
    if (filename) {
      params.set('download', '1');
      params.set('filename', filename);
    }
    return `/api/proxy-image?${params.toString()}`;
  }

  function imageExtension(source: string): string {
    try {
      const match = new URL(source).pathname.match(/\.(jpe?g|png|webp|gif|avif)$/i);
      if (!match) return 'jpg';
      const ext = match[1].toLowerCase();
      return ext === 'jpeg' ? 'jpg' : ext;
    } catch {
      return 'jpg';
    }
  }

  function scrollToResult(target: HTMLElement | null): void {
    if (!target) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
  }

  pfpForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const value = pfpInput?.value.trim() || '';
    if (!value) {
      setPfpStatus('Enter a public Instagram username or profile link first.', 'error');
      pfpInput?.focus();
      return;
    }

    if (pfpSubmit) pfpSubmit.disabled = true;
    if (pfpResult) pfpResult.hidden = true;
    setPfpStatus('Loading the public profile picture…');

    try {
      const response = await fetch(`/api/instagram-profile?username=${encodeURIComponent(value)}`);
      const payload = await response.json().catch(() => null) as any;
      if (!response.ok || !payload?.success) {
        throw new Error(String(payload?.error || 'This Instagram profile could not be loaded.'));
      }

      const profile = payload.profile || {};
      const source = String(profile.profilePicUrl || '');
      if (!source) throw new Error('This profile does not expose a downloadable picture.');

      const handle = String(profile.username || value.replace(/^@+/, ''));
      const name = String(profile.fullName || `@${handle}`);
      const followers = Number(profile.followerCount);
      const followerText = Number.isFinite(followers)
        ? `${followers.toLocaleString()} followers`
        : 'Public profile';

      if (pfpName) pfpName.textContent = name;
      if (pfpHandle) pfpHandle.textContent = `@${handle} · ${followerText}`;
      if (pfpNote) {
        pfpNote.textContent = profile.isPrivate
          ? 'This is a private account. Only its public avatar was requested.'
          : 'Public profile metadata. No login or private content was accessed.';
      }
      if (pfpImage) {
        pfpImage.alt = `Instagram profile picture for @${handle}`;
        pfpImage.onload = () => {
          if (!pfpSize) return;
          const width = pfpImage.naturalWidth;
          const height = pfpImage.naturalHeight;
          pfpSize.textContent = width && height
            ? `Full-size image · ${width} x ${height} pixels`
            : 'Full-size image loaded';
          if (pfpBadge) pfpBadge.textContent = width >= 640 ? 'HD profile picture' : 'Full-size avatar';
        };
        pfpImage.onerror = () => {
          if (pfpSize) pfpSize.textContent = 'Preview could not be displayed. The download may still work.';
          if (pfpBadge) pfpBadge.textContent = 'Profile picture';
        };
        pfpImage.src = pfpProxy(source);
      }

      const filename = `${handle}-instagram-profile-picture.${imageExtension(source)}`;
      if (pfpDownload) {
        pfpDownload.href = pfpProxy(source, filename);
        pfpDownload.setAttribute('download', filename);
      }
      if (pfpProfile) {
        pfpProfile.href = `https://www.instagram.com/${encodeURIComponent(handle)}/`;
      }

      if (pfpResult) pfpResult.hidden = false;
      setPfpStatus('Profile picture ready. Check the dimensions and download.', 'success');
      scrollToResult(pfpResult);
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      setPfpStatus(message, 'error');
    } finally {
      if (pfpSubmit) pfpSubmit.disabled = false;
    }
  });
</script>
