---
// Instagram Profile Picture Downloader. SEO-optimized landing page.
// URL: /instagram-profile-picture-downloader
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import '../styles/tool-pages.css';

const faqData = [
  {
    id: 'pfp-how',
    q: 'How do I download an Instagram profile picture?',
    a: 'Enter a public Instagram username or paste the profile URL into the field above. TikSaveHub loads the profile metadata and shows the full-size avatar. Press Download full-size PFP and the image saves to your device. You do not need to log in or install an app.',
  },
  {
    id: 'pfp-hd',
    q: 'Is the Instagram profile picture really HD?',
    a: 'The downloader requests profile_pic_url_hd, the largest avatar Instagram exposes in public profile metadata. Many accounts return 320x320, 640x640, or 1080x1080 files. Instagram controls the source size, so the tool cannot add detail that the account did not upload. The exact dimensions are shown after the image loads.',
  },
  {
    id: 'pfp-private',
    q: 'Can I download the profile picture of a private Instagram account?',
    a: 'A private account can still have a public avatar, and that avatar is visible in search and profile previews. If Instagram returns the profile picture, TikSaveHub can save it. The tool cannot view private posts, Stories, or Reels, and it cannot bypass a login wall.',
  },
  {
    id: 'pfp-copy',
    q: 'Why does saving the image directly look blurry?',
    a: 'A long-press or right-click often saves the small display thumbnail, not the original avatar. The version rendered in the Instagram interface can be 150x150 even when Instagram stores a larger file. TikSaveHub requests the HD field and serves that file instead, which is why the downloaded image can be much sharper.',
  },
  {
    id: 'pfp-url',
    q: 'Can I use a profile link instead of a username?',
    a: 'Yes. Paste a link such as instagram.com/username or @username. The downloader extracts the handle and ignores tracking parameters. Post, Reel, Story, and Explore links are rejected because they do not identify a single profile.',
  },
  {
    id: 'pfp-legal',
    q: 'Can I use someone else\'s Instagram profile picture?',
    a: 'The photo belongs to the person who posted it. Saving it for a private reference or a personal mockup is different from publishing it in an ad, a product, or a monetized video. Ask for permission before commercial use, and never use a profile picture to impersonate someone or mislead people about an account.',
  },
  {
    id: 'pfp-devices',
    q: 'Does this work on iPhone, Android, and desktop?',
    a: 'Yes. The tool runs in mobile Safari, Chrome, Firefox, Edge, and other modern browsers. On iPhone the file goes to Files, and you can move it to Photos. On Android it goes to Downloads or the gallery. On desktop it appears in the browser download folder.',
  },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]*>/g, ''),
    },
  })),
});

const howToJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to download an Instagram profile picture in HD',
  description: 'Save a full-size Instagram avatar from a public profile.',
  totalTime: 'PT1M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Find the Instagram profile',
      text: 'Open the public profile and copy the username or profile link.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Load the profile picture',
      text: 'Paste the username or link into the downloader and press Get profile picture.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Download the full-size image',
      text: 'Check the preview and dimensions, then press Download full-size PFP.',
    },
  ],
});

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd)],
});
