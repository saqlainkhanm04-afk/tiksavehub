---
// Facebook to MP3 — SEO-optimized landing page (Italian)
// URL: /facebook-to-mp3
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import FbHeroSection from '../../components/FbHeroSection.astro';
import FbStepsSection from '../../components/FbStepsSection.astro';
import FbFeaturesSection from '../../components/FbFeaturesSection.astro';
import FbFaqSection from '../../components/FbFaqSection.astro';
import FbCtaBand from '../../components/FbCtaBand.astro';
import FbInternalLinks from '../../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../../components/FacebookDownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';
import { getLocalizedPath, type Lang } from '../../i18n/utils';
const lp = (p: string) => getLocalizedPath(p, 'it' as Lang);

const faqData = [
  { id: 'mp3-how', q: 'Come convertire un video Facebook in MP3?', a: 'Copia il link del video Facebook, incollalo su TikSaveHub, seleziona l\'opzione MP3 e clicca Download. Otterrai un file MP3 ad alta qualità.' },
  { id: 'mp3-quality', q: 'Qual è la qualità dell\'MP3?', a: 'L\'audio viene estratto alla massima qualità disponibile, fino a 320kbps. Ottieni un file MP3 pulito e di alta qualità.' },
  { id: 'mp3-reels', q: 'Posso convertire un Reel di Facebook in MP3?', a: 'Sì, puoi convertire qualsiasi Reel di Facebook in MP3.' },
  { id: 'mp3-free', q: 'La conversione di Facebook in MP3 è gratuita?', a: 'Sì, TikSaveHub è al 100% gratuito.' },
  { id: 'mp3-no-login', q: 'Devo accedere a Facebook?', a: 'No, non è necessario accedere. Serve solo il link pubblico del video.' },
];

const faqJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqData.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') } })) });
---

<Layout
  title="Converti Facebook in MP3 | Gratis | TikSaveHub"
  description="Converti video Facebook in MP3 ad alta qualità, fino a 320kbps. Gratuito, veloce e senza registrazione. Estrai audio da Reels e video."
  keywords="facebook mp3 conversione, facebook to mp3, scarica audio facebook, facebook mp3 converter"
  canonical="/facebook-to-mp3"
  ogImage="/og-downloader.png"
  ogType="website"
  platform="facebook"
  jsonLd={faqJsonLd}
  appName="TikSaveHub — Facebook to MP3"
  lang="it"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://tiksavehub.com" }, { "@type": "ListItem", "position": 2, "name": "Facebook to MP3", "item": "https://tiksavehub.com/facebook-to-mp3" } ] })} />

  <FbHeroSection
    crumb="Facebook to MP3"
    badge="Gratis · Alta qualità · 320kbps"
    title="Facebook to MP3 — Estrai audio da video Facebook"
    subline="Converti video Facebook in MP3 ad alta qualità. Gratuito e veloce."
    sub="Estrai l\'audio dei video Facebook, Reel e Watch come MP3 ad alta qualità fino a 320kbps. Gratuito, veloce e senza registrazione. Incolla il link e ottieni l\'audio istantaneamente."
    trust={['100% gratuito', 'Fino a 320kbps', 'Nessuna registrazione', 'Veloce come la luce', 'Funziona su tutti i dispositivi']}
    shareUrl="/facebook-to-mp3"
    shareTitle="Facebook to MP3 — Estrai audio da video Facebook"
    shareDescription="Converti video Facebook in MP3 ad alta qualità. Gratuito e veloce."
  >
    <FacebookDownloadForm mode="mp3" />
  </FbHeroSection>

  <StatsSection stats={[ { value: '100% Gratuito', label: 'Scarica video Facebook istantaneamente senza filigrana', icon: 'download' }, { value: 'Senza Registrazione', label: 'Funziona su qualsiasi dispositivo, da qualsiasi luogo', icon: 'globe' }, { value: 'Qualità HD', label: 'Risoluzione originale, senza filigrana, senza login', icon: 'star' } ]} />

  <FbStepsSection
    eyebrow="Guida passo dopo passo"
    headline="Come convertire Facebook in MP3."
    sub="3 semplici passaggi."
    steps={[ { num: '01', icon: 'copy', title: 'Copia il link del video', body: 'Apri Facebook, trova il video di cui vuoi estrarre l\'audio, tocca Condividi e poi "Copia link".' }, { num: '02', icon: 'paste', title: 'Incolla su TikSaveHub', body: 'Torna qui, incolla il link nel campo di inserimento e seleziona l\'opzione MP3.' }, { num: '03', icon: 'download', title: 'Scarica l\'MP3', body: 'Clicca Download per ottenere istantaneamente il file MP3 ad alta qualità.' } ]} />

  <FbFeaturesSection
    eyebrow="Funzionalità"
    headline="Perché scegliere TikSaveHub per Facebook in MP3."
    features={[ { icon: 'music', accent: 'develop', title: 'Alta qualità fino a 320kbps', body: 'Estrai l\'audio alla massima qualità — fino a 320kbps, senza perdita.' }, { icon: 'zap', accent: 'preview', title: 'Conversione ultra-veloce', body: 'Elaborazione lato server — ottieni l\'MP3 in pochi secondi.' }, { icon: 'shield', accent: 'ship', title: 'Senza marchio d\'acqua', body: 'Audio pulito — nessun marchio d\'acqua, logo o pubblicità.' }, { icon: 'list', accent: 'develop', title: 'Supporta tutti i formati', body: 'Video Watch, Reel, post, link fb.watch — supporta tutto.' }, { icon: 'device', accent: 'preview', title: 'Funziona ovunque', body: 'iPhone, Android, PC, Mac — funziona su qualsiasi browser.' }, { icon: 'globe', accent: 'ship', title: 'Gratis e illimitato', body: 'Nessun limite giornaliero, nessun costo. Converti quante volte vuoi.' } ]} />

  <FbFaqSection eyebrow="Domande frequenti" headline="Domande su Facebook in MP3." prefix="mp3" faqs={faqData} />

  <FbCtaBand headline="Estrai l\'audio dai tuoi video Facebook preferiti." sub="Gratuito, veloce, alta qualità — incolla il link e ottieni l\'MP3." ctaHref="#download-tool" ctaLabel="Converti in MP3 ora" />

  <FbInternalLinks
    headline="Altri strumenti Facebook gratuiti"
    links={[ { href: lp('/facebook-video-downloader'), icon: 'fb', title: 'Facebook Video Downloader', desc: 'Scarica video Facebook in HD.' }, { href: lp('/facebook-reels-downloader'), icon: 'fb', title: 'Facebook Reels Downloader', desc: 'Salva i Reels Facebook senza marchio d\'acqua.' }, { href: lp('/facebook-story-downloader'), icon: 'story', title: 'Facebook Story Downloader', desc: 'Salva le storie Facebook prima che scompaiano.' }, { href: lp('/facebook-photo-downloader'), icon: 'photo', title: 'Facebook Photo Downloader', desc: 'Salva le foto Facebook in risoluzione originale.' } ]}
    lang="it"
  />

  <!-- Related Tools -->
  <section class="related-tools-section">
    <div class="container-page" style="max-width:900px;margin-inline:auto;padding:var(--spacing-3xl) var(--spacing-lg);">
      <h2 class="related-tools-headline">Altri Strumenti</h2>
      <div class="related-tools-grid">
            <a href="/it/tiktok-video-downloader-without-watermark" class="related-tool-link">TikTok Video Downloader</a>
            <a href="/it/tiktok-to-mp3" class="related-tool-link">TikTok a MP3</a>
            <a href="/it/instagram-reels-downloader-without-watermark" class="related-tool-link">Instagram Reels Downloader</a>
            <a href="/it/instagram-video-downloader-without-watermark" class="related-tool-link">Instagram Video Downloader</a>
      </div>
    </div>
  </section>

</Layout>