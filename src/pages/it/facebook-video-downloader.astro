  <SocialShare url="/facebook-video-downloader" title="Facebook Video Downloader HD — Gratis, senza filigrana" description="Scarica video e Reels da Facebook in HD. Gratis, veloce, senza filigrana. MP4 o MP3." />

  <!-- Related Tools -->
  <section class="related-tools-section">
    <div class="container-page" style="max-width:900px;margin-inline:auto;padding:var(--spacing-3xl) var(--spacing-lg);">
