  <FbFeaturesSection
    eyebrow="Funzionalit—"
    headline="Perch— TikSaveHub viene scelto."
    features={[ { icon: 'shield', accent: 'develop', title: 'Qualit— HD', body: 'Scarica video e Reels Facebook in HD fino a 1080p. Nessuna ri-codifica o compressione — esattamente quello che il creatore ha caricato.' }, { icon: 'music', accent: 'preview', title: 'Estrazione audio MP3', body: 'Converti qualsiasi video o Reel Facebook in audio MP3 con un solo tocco. Salva colonne sonore, clip e podcast per l\'ascolto offline.' }, { icon: 'zap', accent: 'ship', title: 'Veloce come la luce', body: 'Elaborazione lato server — i download iniziano in pochi secondi. Basta incollare il link e cliccare Download.' }, { icon: 'list', accent: 'develop', title: 'Tutti i formati di link', body: 'Reels, link Watch, post video, link m.facebook.com, link brevi fb.watch — tutti i formati di video Facebook pubblici sono supportati.' }, { icon: 'device', accent: 'preview', title: 'Funziona su tutti i dispositivi', body: 'iPhone, Android, tablet, desktop — TikSaveHub funziona con un browser web. Nessuna installazione di app, estensioni o problemi di compatibilit—.' }, { icon: 'globe', accent: 'ship', title: 'Download illimitati', body: 'Nessun limite giornaliero, nessun tetto, nessun piano premium. Scarica quanti video Facebook vuoi — ogni giorno, per sempre. Completamente gratuito.' } ]} />

