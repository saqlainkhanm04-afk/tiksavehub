---
// TikSaveHub Homepage — hub page for all tools (Italiano)
export const prerender = true;

import Layout from '../../layouts/Layout.astro';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TikSaveHub',
  url: 'https://tiksavehub.com',
  logo: 'https://tiksavehub.com/web-app-manifest-512x512.png',
  description: 'Scarica video TikTok, Instagram, Facebook e X (Twitter) in HD senza filigrana — gratis, veloce, nessuna registrazione.',
  sameAs: [
    'https://twitter.com/tiksavehub',
    'https://www.facebook.com/tiksavehub',
    'https://www.instagram.com/tiksavehub',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'support@tiksavehub.com',
  },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TikSaveHub',
  url: 'https://tiksavehub.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://tiksavehub.com/tiktok-video-downloader-without-watermark?url={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const base = '/it';

const tools = [
  {
    title: 'TikTok Video Downloader',
    description: 'Scarica video TikTok senza filigrana in HD. Gratis, veloce, nessuna registrazione.',
    href: `${base}/tiktok-video-downloader-without-watermark`,
    icon: 'tiktok',
    badge: 'Popolare',
  },
  {
    title: 'TikTok a MP3',
    description: 'Estrai audio dai video TikTok in MP3 ad alta qualità fino a 320kbps.',
    href: `${base}/tiktok-to-mp3`,
    icon: 'audio',
    badge: null,
  },
  {
    title: 'Instagram Reels Downloader',
    description: 'Scarica Reels Instagram senza filigrana in HD. Funziona su tutti i dispositivi.',
    href: `${base}/instagram-reels-downloader-without-watermark`,
    icon: 'instagram',
    badge: 'Nuovo',
  },
  {
    title: 'Instagram Video Downloader',
    description: 'Scarica video e post Instagram in HD. Nessuna app richiesta.',
    href: `${base}/instagram-video-downloader-without-watermark`,
    icon: 'instagram',
    badge: null,
  },
  {
    title: 'Instagram Story Downloader',
    description: 'Scarica storie Instagram prima che scadano. Gratis e anonimo.',
    href: `${base}/instagram-story-downloader-without-watermark`,
    icon: 'instagram',
    badge: null,
  },
  {
    title: 'Facebook Video Downloader',
    description: 'Scarica video, Reels e post Facebook in HD.',
    href: `${base}/facebook-video-downloader`,
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Facebook Reels Downloader',
    description: 'Scarica Facebook Reels senza filigrana in HD.',
    href: `${base}/facebook-reels-downloader`,
    icon: 'facebook',
    badge: 'Nuovo',
  },
  {
    title: 'Facebook a MP3',
    description: 'Estrai audio dai video Facebook in MP3 ad alta qualità.',
    href: `${base}/facebook-to-mp3`,
    icon: 'audio',
    badge: null,
  },
  {
    title: 'Facebook Story Downloader',
    description: 'Scarica storie Facebook prima che escirano. Gratis e anonimo.',
    href: `${base}/facebook-story-downloader`,
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Facebook Photo Downloader',
    description: 'Scarica foto e album Facebook in qualità HD completa.',
    href: `${base}/facebook-photo-downloader`,
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Instagram Audio Downloader',
    description: 'Estrai audio da Reels e video Instagram come MP3 ad alta qualità.',
    href: `${base}/instagram-audio-downloader`,
    icon: 'audio',
    badge: null,
  },
  {
    title: 'X (Twitter) Video Downloader',
    description: 'Scarica video e GIF da X (Twitter) in HD.',
    href: `${base}/x-video-downloader`,
    icon: 'x',
    badge: null,
  },
];

const faqData = [
  { q: 'TikSaveHub è gratuito?', a: 'Sì. TikSaveHub è al 100% gratuito e non ha costi nascosti. Puoi scaricare video illimitati da TikTok, Instagram, Facebook e X senza pagare nulla.' },
  { q: 'Devo installare un\'app?', a: 'No. TikSaveHub funziona completamente nel tuo browser. Nessuna app, nessuna estensione, nessuna installazione di software.' },
  { q: 'Posso scaricare video privati?', a: 'No. TikSaveHub funziona solo con video pubblici che puoi visualizzare in un browser. Non è possibile accedere ai contenuti di account privati.' },
  { q: 'Quali dispositivi sono supportati?', a: 'TikSaveHub funziona su tutti i dispositivi moderni — iPhone, Android, Windows PC, Mac e tablet. Qualsiasi browser (Safari, Chrome, Firefox, Edge) funziona.' },
  { q: 'È legale scaricare video?', a: 'Scaricare video per uso personale è generalmente consentito. Rispetta sempre i diritti d\'autore e ottieni il permesso prima di ripubblicare o utilizzare commercialmente i contenuti.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'TikSaveHub Video Downloader',
  description: 'Strumenti gratuiti online per scaricare video da TikTok, Instagram, Facebook e X (Twitter) in HD.',
  numberOfItems: tools.length,
  itemListElement: tools.map((tool, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: tool.title,
      url: `https://tiksavehub.com${tool.href}`,
      description: tool.description,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'All',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
  })),
};

const features = [
  {
    title: 'Qualità HD',
    description: 'Scarica sempre alla risoluzione più alta disponibile — fino a 1080p.',
    icon: 'hd',
  },
  {
    title: 'Nessuna Filigrana',
    description: 'Download puliti senza branding o sovrapposizioni da qualsiasi piattaforma.',
    icon: 'clean',
  },
  {
    title: 'Funziona Ovunque',
    description: 'Usa su iPhone, Android, PC o tablet — qualsiasi browser, nessuna app necessaria.',
    icon: 'devices',
  },
  {
    title: '100% Gratuito',
    description: 'Download illimitati senza costi nascosti, nessuna registrazione richiesta.',
    icon: 'free',
  },
];
---

<Layout
  title="TikSaveHub — Scarica Video TikTok, Instagram e Facebook Gratis"
  description="Scarica video TikTok in HD senza filigrana. Gratis, veloce, nessuna registrazione."
  keywords="tiktok downloader, scarica video tiktok, instagram downloader, facebook downloader, x video downloader, scarica video senza filigrana, hd video downloader, downloader video gratuito"
  canonical="/"
  ogImage="/og-default.png"
  jsonLd={JSON.stringify([organizationJsonLd, websiteJsonLd, itemListJsonLd, faqJsonLd])}
  appName="TikSaveHub"
>
  <!-- Hero -->
  <section class="home-hero" aria-labelledby="home-headline">
    <div class="home-hero-gradient gradient-mesh" aria-hidden="true"></div>
    <div class="home-hero-inner container-page">
      <div class="home-badge-row">
        <span class="badge-pill home-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          Gratis · HD · Nessuna Filigrana
        </span>
      </div>

      <h1 id="home-headline" class="home-headline">
        Scarica Video Da<br />
        <span class="headline-gradient">TikTok, Instagram, Facebook & X</span>
      </h1>

      <p class="home-sub text-body-lg">
        Salva video in HD senza filigrana. Gratis, veloce e su qualsiasi dispositivo — nessuna app o registrazione necessaria.
      </p>

      <div class="home-tools-grid">
        {tools.map((tool) => (
          <a href={tool.href} class="home-tool-card" aria-label={tool.title}>
            <div class="home-tool-icon" aria-hidden="true">
              {tool.icon === 'tiktok' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
              )}
              {tool.icon === 'instagram' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              )}
              {tool.icon === 'facebook' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              )}
              {tool.icon === 'x' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
              )}
              {tool.icon === 'audio' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              )}
            </div>
            <div class="home-tool-info">
              <h2 class="home-tool-title">{tool.title}</h2>
              <p class="home-tool-desc">{tool.description}</p>
            </div>
            {tool.badge && <span class="home-tool-badge">{tool.badge}</span>}
          </a>
        ))}
      </div>

      <div class="home-trust">
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          100% Gratuito
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Nessuna Filigrana
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Qualità HD
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Nessuna Registrazione
        </span>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="home-features" aria-labelledby="features-headline">
    <div class="home-features-inner container-page">
      <span class="section-eyebrow text-caption-mono">Perché TikSaveHub</span>
      <h2 id="features-headline" class="section-headline">Costruito per Velocità, Qualità e Semplicità</h2>
      <div class="home-features-grid">
        {features.map((f) => (
          <div class="home-feature-card">
            <div class="home-feature-icon" aria-hidden="true">
              {f.icon === 'hd' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7v10"/><path d="M6 7v10"/><path d="M10 7v10"/><path d="M14 7v10"/><path d="M18 7v10"/><path d="M22 7v10"/></svg>
              )}
              {f.icon === 'clean' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              )}
              {f.icon === 'devices' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              )}
              {f.icon === 'free' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              )}
            </div>
            <h3 class="home-feature-title">{f.title}</h3>
            <p class="home-feature-desc">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="home-how" aria-labelledby="how-headline">
    <div class="home-how-inner container-page">
      <span class="section-eyebrow text-caption-mono">Come Funziona</span>
      <h2 id="how-headline" class="section-headline">Tre Passi per Scaricare Qualsiasi Video</h2>
      <div class="home-steps">
        <div class="home-step">
          <span class="home-step-num">1</span>
          <h3 class="home-step-title">Copia il Link del Video</h3>
          <p class="home-step-desc">Apri TikTok, Instagram, Facebook o X. Trova il video che vuoi salvare e copia il link.</p>
        </div>
        <div class="home-step">
          <span class="home-step-num">2</span>
          <h3 class="home-step-title">Incolla su TikSaveHub</h3>
          <p class="home-step-desc">Vai alla pagina dello strumento giusto e incolla il link del video nel campo di download.</p>
        </div>
        <div class="home-step">
          <span class="home-step-num">3</span>
          <h3 class="home-step-title">Scarica in HD</h3>
          <p class="home-step-desc">Clicca su Scarica e salva il file MP4 pulito e senza filigrana sul tuo dispositivo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="home-faq" aria-labelledby="faq-headline">
    <div class="home-faq-inner container-page">
      <span class="section-eyebrow text-caption-mono">Domande Frequenti</span>
      <h2 id="faq-headline" class="section-headline">Domande Frequenti</h2>
      <div class="home-faq-grid">
        <details class="home-faq-item">
          <summary class="home-faq-q">TikSaveHub è gratuito?</summary>
          <p class="home-faq-a">Sì. TikSaveHub è al 100% gratuito e non ha costi nascosti. Puoi scaricare video illimitati da TikTok, Instagram, Facebook e X senza pagare nulla.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">Devo installare un'app?</summary>
          <p class="home-faq-a">No. TikSaveHub funziona completamente nel tuo browser. Nessuna app, nessuna estensione, nessuna installazione di software.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">Posso scaricare video privati?</summary>
          <p class="home-faq-a">No. TikSaveHub funziona solo con video pubblici che puoi visualizzare in un browser. Non è possibile accedere ai contenuti di account privati.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">Quali dispositivi sono supportati?</summary>
          <p class="home-faq-a">TikSaveHub funziona su tutti i dispositivi moderni — iPhone, Android, Windows PC, Mac e tablet. Qualsiasi browser (Safari, Chrome, Firefox, Edge) funziona.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">È legale scaricare video?</summary>
          <p class="home-faq-a">Scaricare video per uso personale è generalmente consentito. Rispetta sempre i diritti d'autore e ottieni il permesso prima di ripubblicare o utilizzare commercialmente i contenuti.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Blog Teaser -->
  <section class="home-blog" aria-labelledby="blog-headline">
    <div class="home-blog-inner container-page">
      <span class="section-eyebrow text-caption-mono">Dal Blog</span>
      <h2 id="blog-headline" class="section-headline">Guide, Consigli e Tutorial</h2>
      <div class="home-blog-grid">
        <a href={`${base}/blog/facebook-video-downloader-guide`} class="home-blog-card">
          <span class="home-blog-tag">Guide Facebook</span>
          <h3 class="home-blog-title">Facebook Video Downloader: Salva Video FB in HD (Guida 2026)</h3>
          <p class="home-blog-excerpt">Scarica video, Reels e clip di Facebook Watch in HD 1080p senza filigrana. Guida passo-passo per iPhone, Android e PC.</p>
        </a>
        <a href={`${base}/blog/x-video-downloader-guide`} class="home-blog-card">
          <span class="home-blog-tag">Guide X & Twitter</span>
          <h3 class="home-blog-title">X Video Downloader: Salva Video Twitter in HD (Guida 2026)</h3>
          <p class="home-blog-excerpt">Scarica video, GIF e audio da X (Twitter) in HD 1080p senza filigrana. Gratis, senza registrazione.</p>
        </a>
        <a href={`${base}/blog/tiktok-video-downloader-without-watermark`} class="home-blog-card">
          <span class="home-blog-tag">Guide TikTok</span>
          <h3 class="home-blog-title">TikTok Video Downloader Senza Filigrana (HD & Gratuito)</h3>
          <p class="home-blog-excerpt">Scarica video TikTok senza filigrana in HD. Veloce, gratuito e funziona su iPhone, Android e PC.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-hero { position: relative; padding: var(--spacing-5xl) var(--spacing-lg) var(--spacing-4xl); overflow: hidden; text-align: center; }
  .home-hero-gradient { position: absolute; inset: 0; z-index: 0; }
  .home-hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: var(--spacing-xl); max-width: 900px; margin-inline: auto; }
  .home-badge-row { display: flex; justify-content: center; }
  .home-badge { background: rgba(124, 58, 237, 0.1); border-color: rgba(124, 58, 237, 0.25); color: #7c3aed; }
  .home-headline { font-size: 52px; font-weight: 700; line-height: 1.1; letter-spacing: -2.5px; color: var(--color-ink); margin: 0; }
  .home-sub { max-width: 600px; text-align: center; margin: 0; }
  .home-tools-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-md); width: 100%; max-width: 900px; }
  .home-tool-card { display: flex; align-items: flex-start; gap: var(--spacing-md); padding: var(--spacing-lg); border-radius: var(--radius-xl); background: var(--color-canvas); border: 1px solid var(--color-hairline); text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; position: relative; }
  .home-tool-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px -8px rgba(124, 58, 237, 0.15); border-color: rgba(124, 58, 237, 0.3); }
  .home-tool-icon { width: 40px; height: 40px; min-width: 40px; border-radius: var(--radius-md); background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(0, 124, 240, 0.1)); display: flex; align-items: center; justify-content: center; color: #7c3aed; }
  .home-tool-info { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
  .home-tool-title { font-size: 15px; font-weight: 650; letter-spacing: -0.3px; color: var(--color-ink); margin: 0; }
  .home-tool-desc { font-size: 13px; color: var(--color-mute); line-height: 1.4; margin: 0; }
  .home-tool-badge { position: absolute; top: var(--spacing-sm); right: var(--spacing-sm); font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: var(--radius-full); background: linear-gradient(135deg, #7c3aed, #ec4899); color: #fff; letter-spacing: -0.2px; }
  .home-trust { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--spacing-sm); margin-top: var(--spacing-md); }
  .home-features { padding: var(--spacing-5xl) var(--spacing-lg); }
  .home-features-inner { display: flex; flex-direction: column; align-items: center; gap: var(--spacing-3xl); }
  .home-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--spacing-lg); width: 100%; }
  .home-feature-card { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--spacing-md); padding: var(--spacing-xl); border-radius: var(--radius-xl); background: var(--color-canvas); border: 1px solid var(--color-hairline); transition: box-shadow 0.2s ease; }
  .home-feature-card:hover { box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.1); }
  .home-feature-icon { width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(0, 124, 240, 0.1)); display: flex; align-items: center; justify-content: center; color: #7c3aed; }
  .home-feature-title { font-size: 16px; font-weight: 650; letter-spacing: -0.3px; color: var(--color-ink); margin: 0; }
  .home-feature-desc { font-size: 14px; color: var(--color-mute); line-height: 1.5; margin: 0; }
  .home-how { padding: var(--spacing-5xl) var(--spacing-lg); background: linear-gradient(180deg, transparent, rgba(124, 58, 237, 0.03), transparent); }
  .home-how-inner { display: flex; flex-direction: column; align-items: center; gap: var(--spacing-3xl); }
  .home-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-xl); width: 100%; }
  .home-step { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--spacing-md); }
  .home-step-num { width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, #7c3aed, #007cf0); color: #fff; font-size: 20px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .home-step-title { font-size: 18px; font-weight: 650; letter-spacing: -0.5px; color: var(--color-ink); margin: 0; }
  .home-step-desc { font-size: 15px; color: var(--color-mute); line-height: 1.6; margin: 0; max-width: 280px; }
  .home-faq { padding: var(--spacing-5xl) var(--spacing-lg); }
