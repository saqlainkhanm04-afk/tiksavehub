const faqData = [
 {
  id: 'mp3-how',
  q: 'Come convertire un video TikTok in MP3?',
  a: 'Copia il link del video TikTok, incollalo nel campo di input su questa pagina e premi Scarica. TikSaveHub estrae la traccia audio dal video e la converte in MP3. Tutto in due o tre secondi. Niente app da installare, niente account da creare. Incolli e scarichi. Semplice.',
