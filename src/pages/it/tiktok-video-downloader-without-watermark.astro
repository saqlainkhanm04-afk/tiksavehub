   '@type': 'HowToStep',
   name: 'Incolla il link in TikSaveHub',
   text: 'Visita TikSaveHub.com e incolla il link TikTok copiato nel campo di download.',
   position: 2,
  },
  {
   '@type': 'HowToStep',
   name: 'Clicca Scarica',
   text: 'Clicca il pulsante Scarica e attendi qualche secondo mentre il video viene elaborato.',
   position: 3,
  },
  {
   '@type': 'HowToStep',
   name: 'Salva il video HD',
   text: 'Scegli l\'opzione MP4 HD (senza filigrana) e salva il file video sul tuo dispositivo.',
   position: 4,
  },
 ],
 tool: {
  '@type': 'HowToTool',
  name: 'TikSaveHub',
 },
});

const combinedJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd)],
});
