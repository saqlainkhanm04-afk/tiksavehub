---
// Facebook Photo Downloader — SEO-optimized landing page (日本語)
// URL: /facebook-photo-downloader
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import FbHeroSection from '../../components/FbHeroSection.astro';
import FbStepsSection from '../../components/FbStepsSection.astro';
import FbFeaturesSection from '../../components/FbFeaturesSection.astro';
import FbFaqSection from '../../components/FbFaqSection.astro';
import FbCtaBand from '../../components/FbCtaBand.astro';
import FbInternalLinks from '../../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../../components/FacebookDownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';
import { getLocalizedPath, type Lang } from '../../i18n/utils';
const lp = (p: string) => getLocalizedPath(p, 'ja' as Lang);

const faqData = [
  { id: 'photo-hd', q: 'Facebookの写真をHDでダウンロードするにはどうすればいいですか？', a: 'Facebook投稿のリンクをコピーし、TikSaveHubに貼り付けてダウンロードをクリックします。投稿内のすべての写真が元の解像度でダウンロードされます。' },
  { id: 'photo-zip', q: 'Facebookの写真をまとめてダウンロードできますか？', a: 'はい、投稿に複数の写真が含まれている場合、すべての写真がフル解像度のZIPファイルとしてまとめてダウンロードされます。' },
  { id: 'photo-private', q: '非公開のFacebook写真をダウンロードできますか？', a: 'いいえ、TikSaveHubは公開されているFacebook写真のみをダウンロードできます。' },
  { id: 'photo-quality', q: 'ダウンロードした写真の品質はどのくらいですか？', a: 'Facebookで利用可能な最大解像度でダウンロードされます。最大2048x2048ピクセルです。' },
  { id: 'photo-iphone', q: 'iPhoneでFacebook写真を保存するにはどうすればいいですか？', a: 'Safariを開き、TikSaveHubにリンクを貼り付けてダウンロードをタップすると、写真が写真アプリに保存されます。' },
  { id: 'photo-free', q: 'Facebook写真のダウンロードは無料ですか？', a: 'はい、TikSaveHubは100%無料です。制限なく好きなだけダウンロードできます。' },
  { id: 'photo-multiple', q: 'アルバムに複数の写真があるのに、なぜ1枚しかダウンロードできないのですか？', a: '"共有"リンクを貼り付けると、Facebookのアクセス制限により、最初の写真のみを確実に取得できます。追加の写真については、ブラウザで各写真を個別に開き、アドレスバーから直接URLをコピーして、ここに1枚ずつ貼り付けてください。' },
];

const faqJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqData.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') } })) });
---

<Layout
  title="Facebook Photo Downloader — 無料でフル解像度 | TikSaveHub"
  description="Facebookの写真をフル解像度でダウンロード。無料、高速、登録不要。FB写真をHDで保存。"
  keywords="facebook 写真 ダウンローダー, facebook photo downloader, facebook 写真 保存, fb 写真 ダウンロード"
  canonical="/facebook-photo-downloader"
  ogImage="/og-downloader.png"
  ogType="website"
  platform="facebook"
  jsonLd={faqJsonLd}
  appName="TikSaveHub — Facebook Photo Downloader"
  lang="ja"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://tiksavehub.com" }, { "@type": "ListItem", "position": 2, "name": "Facebook Photo Downloader", "item": "https://tiksavehub.com/facebook-photo-downloader" } ] })} />

  <FbHeroSection
    crumb="Facebook Photo Downloader"
    badge="無料 · フル解像度 · 登録不要"
    title="Facebook Photo Downloader — フル解像度、無料"
    subline="Facebookの写真をフル解像度でダウンロード。無料で高速。"
    sub="Facebook投稿の写真を最大解像度で保存 — 無料、高速、登録不要。Facebook投稿リンクを貼り付けてすべての写真をZIPでダウンロード。"
    trust={['100%無料', 'フル解像度', '登録不要', 'ZIP対応', 'すべてのデバイスで動作']}
    shareUrl="/facebook-photo-downloader"
    shareTitle="Facebook Photo Downloader — 無料でHD"
    shareDescription="Facebookの写真をフル解像度でダウンロード。無料で高速。"
  >
    <FacebookDownloadForm mode="photo" lang="ja" />
  </FbHeroSection>

  <StatsSection stats={[ { value: '100% 無料', label: 'Facebook写真をウォーターマークなしで即座にダウンロード', icon: 'download' }, { value: '登録不要', label: 'あらゆるデバイス、世界中どこでも動作します', icon: 'globe' }, { value: 'HD画質', label: '元の解像度、ウォーターマークなし、ログイン不要', icon: 'star' } ]} />

  <FbStepsSection
    eyebrow="ステップバイステップガイド"
    headline="Facebook写真のダウンロード方法。"
    sub="3つの簡単なステップ。"
    steps={[ { num: '01', icon: 'copy', title: '投稿リンクをコピー', body: 'Facebookを開き、保存したい写真の投稿を見つけて共有をタップし「リンクをコピー」します。' }, { num: '02', icon: 'paste', title: 'TikSaveHubに貼り付け', body: 'ここに戻ってリンクを入力欄に貼り付けます。' }, { num: '03', icon: 'download', title: '写真をダウンロード', body: 'ダウンロードをクリックします。複数の写真がある場合はZIPファイルとしてまとめてダウンロードされます。' } ]} />

  <FbFeaturesSection
    eyebrow="機能"
    headline="Facebook写真にTikSaveHubを選ぶ理由。"
    features={[ { icon: 'shield', accent: 'develop', title: 'フル解像度', body: '最大2048x2048ピクセルでダウンロード — 元の品質のまま。' }, { icon: 'list', accent: 'preview', title: '複数写真をZIPで', body: '投稿に複数の写真がある場合は、便利なZIPファイルにまとめてダウンロード。' }, { icon: 'zap', accent: 'ship', title: '超高速', body: '数秒でダウンロード — 貼り付けて、クリックして、保存完了。' }, { icon: 'globe', accent: 'develop', title: '匿名', body: 'オーナーに知られることなくダウンロード。完全にプライベート。' }, { icon: 'device', accent: 'preview', title: 'すべてのデバイスで動作', body: 'iPhone、Android、PC、Mac — すべてのブラウザで動作。' }, { icon: 'music', accent: 'ship', title: '無料で無制限', body: '毎日の制限なし、コストなし。好きなだけダウンロード。' } ]} />

  <FbFaqSection eyebrow="よくある質問" headline="Facebook写真に関する質問。" prefix="photo" faqs={faqData} />

  <FbCtaBand headline="お気に入りのFacebook写真を保存しましょう。" sub="無料、高速、フル解像度 — リンクを貼り付けてダウンロード。" ctaHref="#download-tool" ctaLabel="今すぐ写真をダウンロード" />

  <FbInternalLinks
    headline="その他の無料Facebookツール"
    links={[ { href: lp('/facebook-video-downloader'), icon: 'fb', title: 'Facebook Video Downloader', desc: 'FacebookビデオをHDでダウンロード。' }, { href: lp('/facebook-reels-downloader'), icon: 'fb', title: 'Facebook Reels Downloader', desc: 'Facebook Reelsをウォーターマークなしで保存。' }, { href: lp('/facebook-story-downloader'), icon: 'story', title: 'Facebook Story Downloader', desc: 'Facebookストーリーを消える前に保存。' }, { href: lp('/facebook-to-mp3'), icon: 'mp3', title: 'Facebook to MP3 Converter', desc: 'FacebookビデオからMP3音声を抽出。' } ]}
    lang="ja"
  />

  <!-- Related Tools -->
  <section class="related-tools-section">
    <div class="container-page" style="max-width:900px;margin-inline:auto;padding:var(--spacing-3xl) var(--spacing-lg);">
      <h2 class="related-tools-headline">その他のツール</h2>
      <div class="related-tools-grid">
            <a href="/ja/tiktok-video-downloader-without-watermark" class="related-tool-link">TikTok Video Downloader</a>
            <a href="/ja/tiktok-to-mp3" class="related-tool-link">TikTok MP3</a>
            <a href="/ja/instagram-reels-downloader-without-watermark" class="related-tool-link">Instagram Reels Downloader</a>
            <a href="/ja/instagram-video-downloader-without-watermark" class="related-tool-link">Instagram Video Downloader</a>
      </div>
    </div>
  </section>

</Layout>