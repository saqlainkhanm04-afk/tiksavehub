---
// Facebook to MP3 — SEO-optimized landing page (日本語)
// URL: /facebook-to-mp3
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import FbHeroSection from '../../components/FbHeroSection.astro';
import FbStepsSection from '../../components/FbStepsSection.astro';
import FbFeaturesSection from '../../components/FbFeaturesSection.astro';
import FbFaqSection from '../../components/FbFaqSection.astro';
import FbCtaBand from '../../components/FbCtaBand.astro';
import FbInternalLinks from '../../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../../components/FacebookDownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';

const faqData = [
  { id: 'mp3-how', q: 'FacebookビデオをMP3に変換するにはどうすればいいですか？', a: 'Facebookビデオのリンクをコピーし、TikSaveHubに貼り付けてMP3オプションを選択してダウンロードをクリックします。高品質MP3ファイルが得られます。' },
  { id: 'mp3-quality', q: 'MP3の品質はどのくらいですか？', a: '音声は最大320kbpsの最大品質で抽出されます。クリーンな高品質MP3ファイルが得られます。' },
  { id: 'mp3-reels', q: 'Facebook ReelをMP3に変換できますか？', a: 'はい、任意のFacebook ReelをMP3に変換できます。' },
  { id: 'mp3-free', q: 'FacebookをMP3に変換するのは無料ですか？', a: 'はい、TikSaveHubは100%無料です。' },
  { id: 'mp3-no-login', q: 'Facebookにログインする必要がありますか？', a: 'いいえ、ログインは不要です。公開されているビデオリンクのみが必要です。' },
];

const faqJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqData.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') } })) });
---

<Layout
  title="Facebook to MP3 — FBビデオから音声を抽出 | TikSaveHub"
  description="Facebookビデオを高品質MP3ファイルに変換。最大320kbps。無料、高速、登録不要。"
  keywords="facebook mp3 変換, facebook to mp3, facebook 音声 ダウンロード, facebook mp3 converter"
  canonical="/facebook-to-mp3"
  ogImage="/og-downloader.png"
  ogType="website"
  platform="facebook"
  jsonLd={faqJsonLd}
  appName="TikSaveHub — Facebook to MP3"
  lang="ja"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://tiksavehub.com" }, { "@type": "ListItem", "position": 2, "name": "Facebook to MP3", "item": "https://tiksavehub.com/facebook-to-mp3" } ] })} />

  <FbHeroSection
    crumb="Facebook to MP3"
    badge="無料 · 高品質 · 320kbps"
    title="Facebook to MP3 — FBビデオから音声を抽出"
    subline="Facebookビデオを高品質MP3に変換。無料で高速。"
    sub="Facebookビデオ、Reel、Watchの音声を最大320kbpsの高品質MP3として抽出。無料、高速、登録不要。リンクを貼り付けて即座に音声をダウンロード。"
    trust={['100%無料', '最大320kbps', '登録不要', '超高速', 'すべてのデバイスで動作']}
    shareUrl="/facebook-to-mp3"
    shareTitle="Facebook to MP3 — FBビデオから音声を抽出"
    shareDescription="Facebookビデオを高品質MP3に変換。無料で高速。"
  >
    <FacebookDownloadForm mode="mp3" />
  </FbHeroSection>

  <StatsSection stats={[ { value: '100% 無料', label: 'TikTok動画をウォーターマークなしで即座にダウンロード', icon: 'download' }, { value: '登録不要', label: 'あらゆるデバイス、世界中どこでも動作します', icon: 'globe' }, { value: 'HD画質', label: '元の解像度、ウォーターマークなし、ログイン不要', icon: 'star' } ]} />

  <FbStepsSection
    eyebrow="ステップバイステップガイド"
    headline="FacebookをMP3に変換する方法。"
    sub="3つの簡単なステップ。"
    steps={[ { num: '01', icon: 'copy', title: 'ビデオリンクをコピー', body: 'Facebookを開き、音声を抽出したいビデオを見つけて共有をタップし「リンクをコピー」します。' }, { num: '02', icon: 'paste', title: 'TikSaveHubに貼り付け', body: 'ここに戻ってリンクを入力欄に貼り付け、MP3オプションを選択します。' }, { num: '03', icon: 'download', title: 'MP3をダウンロード', body: 'ダウンロードをクリックして高品質MP3ファイルを即座に取得します。' } ]} />

  <FbFeaturesSection
    eyebrow="機能"
    headline="Facebook to MP3にTikSaveHubを選ぶ理由。"
    features={[ { icon: 'music', accent: 'develop', title: '高品質 最大320kbps', body: '最大品質で音声を抽出 — 最大320kbps、ロスなし。' }, { icon: 'zap', accent: 'preview', title: '超高速変換', body: 'サーバーサイド処理 — 数秒でMP3を取得。' }, { icon: 'shield', accent: 'ship', title: 'ウォーターマークなし', body: 'クリーンな音声 — ウォーターマーク、ロゴ、広告なし。' }, { icon: 'list', accent: 'develop', title: 'すべての形式に対応', body: 'Watchビデオ、Reel、投稿、fb.watchリンク — すべて対応。' }, { icon: 'device', accent: 'preview', title: 'すべてのデバイスで動作', body: 'iPhone、Android、PC、Mac — すべてのブラウザで動作。' }, { icon: 'globe', accent: 'ship', title: '無料で無制限', body: '毎日の制限なし、コストなし。好きなだけ変換。' } ]} />

  <FbFaqSection eyebrow="よくある質問" headline="Facebook to MP3に関する質問。" prefix="mp3" faqs={faqData} />

  <FbCtaBand headline="お気に入りのFacebookビデオから音声を抽出。" sub="無料、高速、高品質 — リンクを貼り付けてMP3を取得。" ctaHref="#download-tool" ctaLabel="今すぐMP3に変換" />

  <FbInternalLinks
    headline="その他の無料Facebookツール"
    links={[ { href: '/facebook-video-downloader', icon: 'fb', title: 'Facebook Video Downloader', desc: 'FacebookビデオをHDでダウンロード。' }, { href: '/facebook-reels-downloader', icon: 'fb', title: 'Facebook Reels Downloader', desc: 'Facebook Reelsをウォーターマークなしで保存。' }, { href: '/facebook-story-downloader', icon: 'story', title: 'Facebook Story Downloader', desc: 'Facebookストーリーを消える前に保存。' }, { href: '/facebook-photo-downloader', icon: 'photo', title: 'Facebook Photo Downloader', desc: 'Facebookの写真をフル解像度で保存。' } ]}
  />

  <!-- Related Tools -->
  <section class="related-tools-section">
    <div class="container-page" style="max-width:900px;margin-inline:auto;padding:var(--spacing-3xl) var(--spacing-lg);">
      <h2 class="related-tools-headline">その他のツール</h2>
      <div class="related-tools-grid">
            <a href="/ja/tiktok-video-downloader-without-watermark" class="related-tool-link">TikTok Video Downloader</a>
            <a href="/ja/tiktok-to-mp3" class="related-tool-link">TikTok MP3</a>
            <a href="/ja/instagram-reels-downloader-without-watermark" class="related-tool-link">Instagram Reels Downloader</a>
            <a href="/ja/instagram-video-downloader-without-watermark" class="related-tool-link">Instagram Video Downloader</a>
      </div>
    </div>
  </section>

</Layout>