const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]*>/g, ''),
    },
  })),
});

const howToJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'HDでFacebook動画をダウンロードする方法',
  description: 'TikSaveHubを使用してFacebook動画、Reels、投稿をHD品質でダウンロードするステップバイステップガイド。',
  totalTime: 'PT2M',
  step: [
    {
      '@type': 'HowToStep',
      name: 'Facebook動画のリンクをコピー',
      text: '保存したいFacebook動画を開き、共有ボタンをクリックしてリンクをコピーを選択します。',
      position: 1,
    },
    {
      '@type': 'HowToStep',
      name: 'リンクをTikSaveHubに貼り付け',
      text: 'TikSaveHub.comにアクセスし、コピーしたFacebookリンクをダウンロード入力フィールドに貼り付けます。',
