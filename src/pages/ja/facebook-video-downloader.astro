      name: 'HD動画を保存',
      text: 'HD MP4オプションを選択し、動画ファイルをデバイスに保存します。',
      position: 4,
    },
  ],
  tool: {
    '@type': 'HowToTool',
    name: 'TikSaveHub',
  },
});

const combinedJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd)],
});
