 /* ─── Internal Links Section ─── */
 .mp3-internal-section {
  background-color: var(--color-canvas-soft);
  padding: var(--spacing-5xl) var(--spacing-lg);
  border-top: 1px solid var(--color-hairline);
 }

 .mp3-internal-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-3xl);
 }

 .mp3-internal-headline {
  text-align: center;
  max-width: 400px;
 }

 .mp3-internal-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-md);
  width: 100%;
 }

 .mp3-internal-card {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  padding: var(--spacing-lg);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-hairline);
  background-color: var(--color-canvas);
  text-decoration: none;
  transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  position: relative;
 }

 .mp3-internal-card:hover {
  border-color: var(--color-hairline-strong);
  transform: translateY(-3px);
  box-shadow:
   inset 0 0 0 1px #00000008,
   0px 2px 2px #0000000a,
   0px 8px 16px -4px #0000001a;
 }

 .mp3-internal-icon {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #7c3aed12, #ec489918);
  color: #7c3aed;
  box-shadow: inset 0 0 0 1px #7c3aed20;
 }

 .mp3-internal-title {
  font-size: var(--text-body-md-strong);
  font-weight: 600;
  color: var(--color-ink);
  letter-spacing: -0.3px;
 }

 .mp3-internal-desc {
  font-size: var(--text-body-sm);
  color: var(--color-body);
  line-height: 1.5;
  margin: 0;
 }

 .mp3-internal-arrow {
  position: absolute;
  top: var(--spacing-lg);
  right: var(--spacing-lg);
  color: var(--color-mute);
  font-size: 18px;
  transition: color 0.15s ease, transform 0.25s ease;
 }

 .mp3-internal-card:hover .mp3-internal-arrow {
  color: var(--color-ink);
  transform: translateX(4px);
 }

 @media (max-width: 960px) {
  .mp3-internal-grid {
   grid-template-columns: 1fr;
   max-width: 480px;
  }
 }

 @media (max-width: 600px) {
  .mp3-internal-section {
   padding: var(--spacing-3xl) var(--spacing-md);
  }
 }

</style>

<script>
 const mp3Triggers = document.querySelectorAll('.mp3-faq-trigger');

 mp3Triggers.forEach((btn) => {
  btn.addEventListener('click', () => {
   const isOpen = btn.getAttribute('aria-expanded') === 'true';
   const panelId = btn.getAttribute('aria-controls')!;
   const panel = document.getElementById(panelId);

   mp3Triggers.forEach((otherBtn) => {
    if (otherBtn !== btn) {
     otherBtn.setAttribute('aria-expanded', 'false');
     const otherId = otherBtn.getAttribute('aria-controls')!;
     document.getElementById(otherId)?.setAttribute('hidden', '');
    }
   });

   if (isOpen) {
    btn.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('hidden', '');
   } else {
    btn.setAttribute('aria-expanded', 'true');
    panel?.removeAttribute('hidden');
   }
  });
 });
</script>
