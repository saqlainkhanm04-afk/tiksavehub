    animation: pulse-dot 2s ease-in-out infinite;
  }

  .dl-hero-headline {
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -2.5px;
    color: var(--color-ink);
