---
// Facebook Photo Downloader — SEO-optimized landing page (Korean)
// URL: /facebook-photo-downloader
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import FbHeroSection from '../../components/FbHeroSection.astro';
import FbStepsSection from '../../components/FbStepsSection.astro';
import FbFeaturesSection from '../../components/FbFeaturesSection.astro';
import FbFaqSection from '../../components/FbFaqSection.astro';
import FbCtaBand from '../../components/FbCtaBand.astro';
import FbInternalLinks from '../../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../../components/FacebookDownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';
import { getLocalizedPath, type Lang } from '../../i18n/utils';
const lp = (p: string) => getLocalizedPath(p, 'ko' as Lang);

const faqData = [
  { id: 'photo-hd', q: 'Facebook 사진을 HD로 다운로드하려면 어떻게 하나요?', a: 'Facebook 게시물 링크를 복사하여 TikSaveHub에 붙여넣고 다운로드를 클릭합니다. 게시물의 모든 사진이 원본 해상도로 다운로드됩니다.' },
  { id: 'photo-zip', q: 'Facebook 사진을 한 번에 다운로드할 수 있나요?', a: '네, 게시물에 여러 장의 사진이 있으면 모든 사진이 고해상도 ZIP 파일로 한 번에 다운로드됩니다.' },
  { id: 'photo-private', q: '비공개 Facebook 사진을 다운로드할 수 있나요?', a: '아니요, TikSaveHub는 공개된 Facebook 사진만 다운로드할 수 있습니다.' },
  { id: 'photo-quality', q: '다운로드한 사진의 품질은 어떤가요?', a: 'Facebook에서 사용 가능한 최대 해상도로 다운로드됩니다. 최대 2048x2048픽셀입니다.' },
  { id: 'photo-iphone', q: 'iPhone에서 Facebook 사진을 저장하려면 어떻게 하나요?', a: 'Safari를 열고 TikSaveHub에 링크를 붙여넣은 후 다운로드를 탭하면 사진 앱에 저장됩니다.' },
  { id: 'photo-free', q: 'Facebook 사진 다운로드가 무료인가요?', a: '네, TikSaveHub는 100% 무료입니다. 제한 없이 원하는 만큼 다운로드할 수 있습니다.' },
  { id: 'photo-multiple', q: '앨범에 여러 장의 사진이 있는데 왜 1장만 다운로드되나요?', a: '"공유" 링크를 붙여넣으면 Facebook의 접근 제한으로 인해 첫 번째 사진만 안정적으로 가져올 수 있습니다. 추가 사진은 브라우저에서 각 사진을 개별적으로 열고, 주소 표시줄에서 직접 URL을 복사하여 여기에 하나씩 붙여넣으세요.' },
];

const faqJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqData.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') } })) });
---

<Layout
  title="페이스북 사진 다운로더 HD | 무료 고해상도 | TikSaveHub"
  description="페이스북 사진을 고해상도로 무료 다운로드. 게시물의 모든 사진을 한 번에 ZIP 파일로 저장. 빠르고 회원가입 없이 페이스북 이미지를 보존하세요."
  keywords="facebook 사진 다운로더, facebook photo downloader, facebook 사진 저장, fb 사진 다운로드"
  canonical="/facebook-photo-downloader"
  ogImage="/og-downloader.png"
  ogType="website"
  platform="facebook"
  jsonLd={faqJsonLd}
  appName="TikSaveHub — Facebook Photo Downloader"
  lang="ko"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "홈", "item": "https://tiksavehub.com" }, { "@type": "ListItem", "position": 2, "name": "Facebook Photo Downloader", "item": "https://tiksavehub.com/facebook-photo-downloader" } ] })} />

  <FbHeroSection
    crumb="Facebook Photo Downloader"
    badge="무료 · 고해상도 · 회원가입 불필요"
    title="Facebook Photo Downloader — 고해상도, 무료"
    subline="Facebook 사진을 고해상도로 다운로드. 무료로 빠르게."
    sub="Facebook 게시물의 사진을 최대 해상도로 저장 — 무료, 빠르고 회원가입 불필요. Facebook 게시물 링크를 붙여넣어 모든 사진을 ZIP으로 다운로드하세요."
    trust={['100% 무료', '고해상도', '회원가입 불필요', 'ZIP 지원', '모든 기기에서 작동']}
    shareUrl="/facebook-photo-downloader"
    shareTitle="Facebook Photo Downloader — 무료 HD"
    shareDescription="Facebook 사진을 고해상도로 다운로드. 무료로 빠르게."
  >
    <FacebookDownloadForm mode="photo" lang="ko" />
  </FbHeroSection>

  <StatsSection stats={[ { value: '100% 무료', label: '워터마크 없이 Facebook 사진을 즉시 다운로드', icon: 'download' }, { value: '가입 불필요', label: '모든 기기에서, 전 세계 어디에서든 작동', icon: 'globe' }, { value: 'HD 품질', label: '원본 해상도, 워터마크 없음, 로그인 불필요', icon: 'star' } ]} />

  <FbStepsSection
    eyebrow="단계별 가이드"
    headline="Facebook 사진 다운로드 방법."
    sub="간단한 3단계."
    steps={[ { num: '01', icon: 'copy', title: '게시물 링크 복사', body: 'Facebook을 열고 저장할 사진이 있는 게시물을 찾아 공유를 탭한 후 "링크 복사"를 선택합니다.' }, { num: '02', icon: 'paste', title: 'TikSaveHub에 붙여넣기', body: '여기로 돌아와 링크를 입력 필드에 붙여넣습니다.' }, { num: '03', icon: 'download', title: '사진 다운로드', body: '다운로드를 클릭합니다. 여러 장의 사진이 있으면 ZIP 파일로 한 번에 다운로드됩니다.' } ]} />

  <FbFeaturesSection
    eyebrow="기능"
    headline="Facebook 사진에 TikSaveHub를 선택하는 이유."
    features={[ { icon: 'shield', accent: 'develop', title: '고해상도', body: '최대 2048x2048픽셀로 다운로드 — 원본 품질 그대로.' }, { icon: 'list', accent: 'preview', title: '여러 사진 ZIP', body: '게시물에 여러 사진이 있으면 편리한 ZIP 파일로 다운로드.' }, { icon: 'zap', accent: 'ship', title: '초고속', body: '수 초 만에 다운로드 — 붙여넣고, 클릭하고, 저장 완료.' }, { icon: 'globe', accent: 'develop', title: '익명', body: '소유자에게 알리지 않고 다운로드. 완전히 프라이빗.' }, { icon: 'device', accent: 'preview', title: '모든 기기에서 작동', body: 'iPhone, Android, PC, Mac — 모든 브라우저에서 작동.' }, { icon: 'music', accent: 'ship', title: '무료 무제한', body: '일일 제한 없음, 비용 없음. 원하는 만큼 다운로드.' } ]} />

  <FbFaqSection eyebrow="자주 묻는 질문" headline="Facebook 사진 관련 질문." prefix="photo" faqs={faqData} />

  <FbCtaBand headline="좋아하는 Facebook 사진을 저장하세요." sub="무료, 빠르고 고해상도 — 링크를 붙여넣어 다운로드." ctaHref="#download-tool" ctaLabel="지금 사진 다운로드" />

  <FbInternalLinks
    headline="기타 무료 Facebook 도구"
    links={[ { href: lp('/facebook-video-downloader'), icon: 'fb', title: 'Facebook Video Downloader', desc: 'Facebook 동영상을 HD로 다운로드.' }, { href: lp('/facebook-reels-downloader'), icon: 'fb', title: 'Facebook Reels Downloader', desc: 'Facebook Reels를 워터마크 없이 저장.' }, { href: lp('/facebook-story-downloader'), icon: 'story', title: 'Facebook Story Downloader', desc: 'Facebook 스토리가 사라지기 전에 저장.' }, { href: lp('/facebook-to-mp3'), icon: 'mp3', title: 'Facebook to MP3 Converter', desc: 'Facebook 동영상에서 MP3 오디오 추출.' } ]}
    lang="ko"
  />

  <!-- Related Tools -->
  <section class="related-tools-section">
    <div class="container-page" style="max-width:900px;margin-inline:auto;padding:var(--spacing-3xl) var(--spacing-lg);">
      <h2 class="related-tools-headline">추가 도구</h2>
      <div class="related-tools-grid">
            <a href="/ko/tiktok-video-downloader-without-watermark" class="related-tool-link">TikTok Video Downloader</a>
            <a href="/ko/tiktok-to-mp3" class="related-tool-link">TikTok MP3</a>
            <a href="/ko/instagram-reels-downloader-without-watermark" class="related-tool-link">Instagram Reels Downloader</a>
            <a href="/ko/instagram-video-downloader-without-watermark" class="related-tool-link">Instagram Video Downloader</a>
      </div>
    </div>
  </section>

</Layout>