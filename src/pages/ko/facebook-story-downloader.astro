---
// Facebook Story Downloader — SEO-optimized landing page (Korean)
// URL: /facebook-story-downloader
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import FbHeroSection from '../../components/FbHeroSection.astro';
import FbStepsSection from '../../components/FbStepsSection.astro';
import FbFeaturesSection from '../../components/FbFeaturesSection.astro';
import FbFaqSection from '../../components/FbFaqSection.astro';
import FbCtaBand from '../../components/FbCtaBand.astro';
import FbInternalLinks from '../../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../../components/FacebookDownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';

const faqData = [
  { id: 'story-hd', q: 'Facebook 스토리를 HD로 다운로드하려면 어떻게 하나요?', a: '공개된 Facebook 스토리 링크를 복사하여 TikSaveHub에 붙여넣고 다운로드를 클릭합니다. 스토리가 사용 가능한 경우 원본 품질의 MP4로 저장됩니다.' },
  { id: 'story-24h', q: 'Facebook 스토리는 24시간 후에 사라지나요?', a: '네, Facebook 스토리는 24시간 후에 자동으로 사라집니다. 사라지기 전에 링크를 복사하여 다운로드할 수 있습니다.' },
  { id: 'story-private', q: '비공개 Facebook 스토리를 다운로드할 수 있나요?', a: '아니요, TikSaveHub는 공개된 Facebook 스토리만 다운로드할 수 있습니다.' },
  { id: 'story-no-login', q: 'Facebook 스토리를 다운로드하기 위해 로그인이 필요한가요?', a: '아니요, 로그인은 불필요합니다. 공개된 스토리 링크만 있으면 됩니다.' },
  { id: 'story-iphone', q: 'iPhone에서 Facebook 스토리를 저장하려면 어떻게 하나요?', a: 'Safari를 열고 TikSaveHub에 링크를 붙여넣은 후 다운로드를 탭하면 MP4가 파일 앱에 저장됩니다.' },
  { id: 'story-android', q: 'Android에서 Facebook 스토리를 저장하려면 어떻게 하나요?', a: 'Chrome을 열고 TikSaveHub에 링크를 붙여넣은 후 다운로드를 탭하면 비디오가 다운로드 폴더에 저장됩니다.' },
];

const faqJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqData.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') } })) });
---

<Layout
  title="페이스북 스토리 다운로더 | 무료 익명 저장 | TikSaveHub"
  description="페이스북 스토리가 24시간 후 사라지기 전에 무료로 다운로드. 익명으로 빠르게 페이스북 스토리를 MP4로 저장. 로그인 없이 공개 스토리 링크만으로 가능합니다."
  keywords="facebook 스토리 다운로더, facebook stories 다운로드, facebook story downloader, 스토리 저장"
  canonical="/facebook-story-downloader"
  ogImage="/og-downloader.png"
  ogType="website"
  platform="facebook"
  jsonLd={faqJsonLd}
  appName="TikSaveHub — Facebook Story Downloader"
  lang="ko"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "홈", "item": "https://tiksavehub.com" }, { "@type": "ListItem", "position": 2, "name": "Facebook Story Downloader", "item": "https://tiksavehub.com/facebook-story-downloader" } ] })} />

  <FbHeroSection
    crumb="Facebook Story Downloader"
    badge="무료 · HD · 익명"
    title="Facebook Story Downloader — 사라지기 전에 다운로드"
    subline="Facebook 스토리를 HD로 사라지기 전에 저장. 무료로 익명."
    sub="Facebook 스토리는 24시간 후에 사라집니다. 로그인 없이 사라지기 전에 다운로드 — 무료, 빠르게. Facebook 스토리 링크를 붙여넣어 MP4를 저장하세요."
    trust={['100% 무료', '익명', 'HD', '로그인 불필요', '모든 기기에서 작동']}
    shareUrl="/facebook-story-downloader"
    shareTitle="Facebook Story Downloader — 무료 익명"
    shareDescription="Facebook 스토리가 사라지기 전에 다운로드. 무료로 익명."
  >
    <FacebookDownloadForm mode="story" />
  </FbHeroSection>

  <StatsSection stats={[ { value: '100% 무료', label: '워터마크 없이 Facebook 동영상을 즉시 다운로드', icon: 'download' }, { value: '가입 불필요', label: '모든 기기에서, 전 세계 어디에서든 작동', icon: 'globe' }, { value: 'HD 품질', label: '원본 해상도, 워터마크 없음, 로그인 불필요', icon: 'star' } ]} />

  <FbStepsSection
    eyebrow="단계별 가이드"
    headline="Facebook 스토리 다운로드 방법."
    sub="간단한 3단계."
    steps={[ { num: '01', icon: 'copy', title: '스토리 링크 복사', body: 'Facebook을 열고 저장할 스토리를 찾아 공유를 탭한 후 "링크 복사"를 선택합니다.' }, { num: '02', icon: 'paste', title: 'TikSaveHub에 붙여넣기', body: '여기로 돌아와 링크를 입력 필드에 붙여넣습니다.' }, { num: '03', icon: 'download', title: '스토리 다운로드', body: '다운로드를 클릭하여 MP4 파일을 기기에 저장합니다.' } ]} />

  <FbFeaturesSection
    eyebrow="기능"
    headline="Facebook 스토리에 TikSaveHub를 선택하는 이유."
    features={[ { icon: 'shield', accent: 'develop', title: '워터마크 없음', body: '스토리를 공개된 그대로의 품질로 다운로드 — 워터마크 없음.' }, { icon: 'zap', accent: 'preview', title: '사라지기 전에 다운로드', body: '24시간 후 삭제되는 일시적 스토리를 저장.' }, { icon: 'music', accent: 'ship', title: '초고속', body: '수 초 만에 다운로드 — 붙여넣고, 클릭하고, 저장 완료.' }, { icon: 'globe', accent: 'develop', title: '익명', body: '소유자에게 알리지 않고 다운로드. 완전히 프라이빗.' }, { icon: 'device', accent: 'preview', title: '모든 기기에서 작동', body: 'iPhone, Android, PC, Mac — 모든 브라우저에서 작동.' }, { icon: 'list', accent: 'ship', title: '무료 무제한', body: '일일 제한 없음, 비용 없음. 원하는 만큼 다운로드.' } ]} />

  <FbFaqSection eyebrow="자주 묻는 질문" headline="Facebook 스토리 관련 질문." prefix="story" faqs={faqData} />

  <FbCtaBand headline="스토리가 사라지기 전에 저장하세요." sub="무료, 빠르고 익명 — 스토리 링크를 붙여넣어 HD로 저장." ctaHref="#download-tool" ctaLabel="지금 스토리 다운로드" />

  <FbInternalLinks
    headline="기타 무료 Facebook 도구"
    links={[ { href: '/facebook-video-downloader', icon: 'fb', title: 'Facebook Video Downloader', desc: 'Facebook 풀레0 LENGTH 비디오를 HD로 다운로드.' }, { href: '/facebook-reels-downloader', icon: 'fb', title: 'Facebook Reels Downloader', desc: 'Facebook Reels를 워터마크 없이 저장.' }, { href: '/facebook-to-mp3', icon: 'mp3', title: 'Facebook to MP3 Converter', desc: 'Facebook 비디오에서 MP3 오디오 추출.' }, { href: '/facebook-photo-downloader', icon: 'photo', title: 'Facebook Photo Downloader', desc: 'Facebook 사진을 전체 해상도로 저장.' } ]}
  />

  <!-- Related Tools -->
  <section class="related-tools-section">
    <div class="container-page" style="max-width:900px;margin-inline:auto;padding:var(--spacing-3xl) var(--spacing-lg);">
      <h2 class="related-tools-headline">추가 도구</h2>
      <div class="related-tools-grid">
            <a href="/ko/tiktok-video-downloader-without-watermark" class="related-tool-link">TikTok Video Downloader</a>
            <a href="/ko/tiktok-to-mp3" class="related-tool-link">TikTok MP3</a>
            <a href="/ko/instagram-reels-downloader-without-watermark" class="related-tool-link">Instagram Reels Downloader</a>
            <a href="/ko/instagram-video-downloader-without-watermark" class="related-tool-link">Instagram Video Downloader</a>
      </div>
    </div>
  </section>

</Layout>