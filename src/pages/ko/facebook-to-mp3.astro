---
// Facebook to MP3 — SEO-optimized landing page (Korean)
// URL: /facebook-to-mp3
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import FbHeroSection from '../../components/FbHeroSection.astro';
import FbStepsSection from '../../components/FbStepsSection.astro';
import FbFeaturesSection from '../../components/FbFeaturesSection.astro';
import FbFaqSection from '../../components/FbFaqSection.astro';
import FbCtaBand from '../../components/FbCtaBand.astro';
import FbInternalLinks from '../../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../../components/FacebookDownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';

const faqData = [
  { id: 'mp3-how', q: 'Facebook 비디오를 MP3로 변환하려면 어떻게 하나요?', a: 'Facebook 비디오 링크를 복사하여 TikSaveHub에 붙여넣고 MP3 옵션을 선택한 후 다운로드를 클릭합니다. 고품질 MP3 파일을 얻을 수 있습니다.' },
  { id: 'mp3-quality', q: 'MP3 품질은 어떤가요?', a: '최대 320kbps의 최고 품질로 오디오를 추출합니다. 깨끗한 고품질 MP3 파일을 얻을 수 있습니다.' },
  { id: 'mp3-reels', q: 'Facebook Reel을 MP3로 변환할 수 있나요?', a: '네, 모든 Facebook Reel을 MP3로 변환할 수 있습니다.' },
  { id: 'mp3-free', q: 'Facebook을 MP3로 변환이 무료인가요?', a: '네, TikSaveHub는 100% 무료입니다.' },
  { id: 'mp3-no-login', q: 'Facebook에 로그인이 필요한가요?', a: '아니요, 로그인은 불필요합니다. 공개된 비디오 링크만 있으면 됩니다.' },
];

const faqJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqData.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') } })) });
---

<Layout
  title="페이스북 MP3 변환기 | FB 비디오 오디오 추출 | TikSaveHub"
  description="페이스북 비디오를 고품질 MP3 파일로 변환. 최대 320kbps로 오디오 추출. 무료, 빠르고 로그인 없이 FB 영상의 사운드를 저장하세요."
  keywords="facebook mp3 변환, facebook to mp3, facebook 오디오 다운로드, facebook mp3 converter"
  canonical="/facebook-to-mp3"
  ogImage="/og-downloader.png"
  ogType="website"
  platform="facebook"
  jsonLd={faqJsonLd}
  appName="TikSaveHub — Facebook to MP3"
  lang="ko"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "홈", "item": "https://tiksavehub.com" }, { "@type": "ListItem", "position": 2, "name": "Facebook to MP3", "item": "https://tiksavehub.com/facebook-to-mp3" } ] })} />

  <FbHeroSection
    crumb="Facebook to MP3"
    badge="무료 · 고품질 · 320kbps"
    title="Facebook to MP3 — FB 비디오에서 오디오 추출"
    subline="Facebook 비디오를 고품질 MP3로 변환. 무료로 빠르게."
    sub="Facebook 비디오, Reel, Watch의 오디오를 최대 320kbps의 고품질 MP3로 추출. 무료, 빠르고 로그인 불필요. 링크를 붙여넣어 즉시 오디오를 다운로드하세요."
    trust={['100% 무료', '최대 320kbps', '로그인 불필요', '초고속', '모든 기기에서 작동']}
    shareUrl="/facebook-to-mp3"
    shareTitle="Facebook to MP3 — FB 비디오에서 오디오 추출"
    shareDescription="Facebook 비디오를 고품질 MP3로 변환. 무료로 빠르게."
  >
    <FacebookDownloadForm mode="mp3" />
  </FbHeroSection>

  <StatsSection stats={[ { value: '100% 무료', label: '워터마크 없이 Facebook 동영상을 즉시 다운로드', icon: 'download' }, { value: '가입 불필요', label: '모든 기기에서, 전 세계 어디에서든 작동', icon: 'globe' }, { value: 'HD 품질', label: '원본 해상도, 워터마크 없음, 로그인 불필요', icon: 'star' } ]} />

  <FbStepsSection
    eyebrow="단계별 가이드"
    headline="Facebook을 MP3로 변환하는 방법."
    sub="간단한 3단계."
    steps={[ { num: '01', icon: 'copy', title: '비디오 링크 복사', body: 'Facebook을 열고 오디오를 추출할 비디오를 찾아 공유를 탭한 후 "링크 복사"를 선택합니다.' }, { num: '02', icon: 'paste', title: 'TikSaveHub에 붙여넣기', body: '여기로 돌아와 링크를 입력 필드에 붙여넣고 MP3 옵션을 선택합니다.' }, { num: '03', icon: 'download', title: 'MP3 다운로드', body: '다운로드를 클릭하여 고품질 MP3 파일을 즉시 받으세요.' } ]} />

  <FbFeaturesSection
    eyebrow="기능"
    headline="Facebook to MP3에 TikSaveHub를 선택하는 이유."
    features={[ { icon: 'music', accent: 'develop', title: '고품질 최대 320kbps', body: '최고 품질로 오디오 추출 — 최대 320kbps, 손실 없음.' }, { icon: 'zap', accent: 'preview', title: '초고속 변환', body: '서버 사이드 처리 — 수 초 만에 MP3를 받으세요.' }, { icon: 'shield', accent: 'ship', title: '워터마크 없음', body: '깨끗한 오디오 — 워터마크, 로고, 광고 없음.' }, { icon: 'list', accent: 'develop', title: '모든 형식 지원', body: 'Watch 비디오, Reel, 게시물, fb.watch 링크 — 모두 지원.' }, { icon: 'device', accent: 'preview', title: '모든 기기에서 작동', body: 'iPhone, Android, PC, Mac — 모든 브라우저에서 작동.' }, { icon: 'globe', accent: 'ship', title: '무료 무제한', body: '일일 제한 없음, 비용 없음. 원하는 만큼 변환.' } ]} />

  <FbFaqSection eyebrow="자주 묻는 질문" headline="Facebook to MP3 관련 질문." prefix="mp3" faqs={faqData} />

  <FbCtaBand headline="좋아하는 Facebook 비디오에서 오디오를 추출하세요." sub="무료, 빠르고 고품질 — 링크를 붙여넣어 MP3를 받으세요." ctaHref="#download-tool" ctaLabel="지금 MP3로 변환" />

  <FbInternalLinks
    headline="기타 무료 Facebook 도구"
    links={[ { href: '/facebook-video-downloader', icon: 'fb', title: 'Facebook Video Downloader', desc: 'Facebook 비디오를 HD로 다운로드.' }, { href: '/facebook-reels-downloader', icon: 'fb', title: 'Facebook Reels Downloader', desc: 'Facebook Reels를 워터마크 없이 저장.' }, { href: '/facebook-story-downloader', icon: 'story', title: 'Facebook Story Downloader', desc: 'Facebook 스토리가 사라지기 전에 저장.' }, { href: '/facebook-photo-downloader', icon: 'photo', title: 'Facebook Photo Downloader', desc: 'Facebook 사진을 전체 해상도로 저장.' } ]}
  />

  <!-- Related Tools -->
  <section class="related-tools-section">
    <div class="container-page" style="max-width:900px;margin-inline:auto;padding:var(--spacing-3xl) var(--spacing-lg);">
      <h2 class="related-tools-headline">추가 도구</h2>
      <div class="related-tools-grid">
            <a href="/ko/tiktok-video-downloader-without-watermark" class="related-tool-link">TikTok Video Downloader</a>
            <a href="/ko/tiktok-to-mp3" class="related-tool-link">TikTok MP3</a>
            <a href="/ko/instagram-reels-downloader-without-watermark" class="related-tool-link">Instagram Reels Downloader</a>
            <a href="/ko/instagram-video-downloader-without-watermark" class="related-tool-link">Instagram Video Downloader</a>
      </div>
    </div>
  </section>

</Layout>