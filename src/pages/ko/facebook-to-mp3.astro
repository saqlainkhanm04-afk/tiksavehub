export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import FbHeroSection from '../../components/FbHeroSection.astro';
import FbSeoArticle from '../../components/FbSeoArticle.astro';
import FbStepsSection from '../../components/FbStepsSection.astro';
import FbFeaturesSection from '../../components/FbFeaturesSection.astro';
import FbUseCasesSection from '../../components/FbUseCasesSection.astro';
import FbComparisonSection from '../../components/FbComparisonSection.astro';
import FbTroubleshootingSection from '../../components/FbTroubleshootingSection.astro';
import FbFaqSection from '../../components/FbFaqSection.astro';
import FbCtaBand from '../../components/FbCtaBand.astro';
import FbBlogLinksSection from '../../components/FbBlogLinksSection.astro';
import FbInternalLinks from '../../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../../components/FacebookDownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';
import { getLocalizedPath, type Lang } from '../../i18n/utils';
const lp = (p: string) => getLocalizedPath(p, 'ko' as Lang);

const faqData = [
  { id: 'mp3-how', q: 'Facebook 비디오를 MP3로 변환하려면 어떻게 하나요?', a: 'Facebook 공개 영상의 링크를 복사해 TikSaveHub에 붙여넣고 다운로드를 누르기만 하면 됩니다. 도구가 오디오 트랙을 즉시 추출해 별도의 영상 없이 고품질 MP3 파일로 저장합니다.' },
  { id: 'mp3-reel', q: 'Facebook Reel에서 오디오를 다운로드할 수 있나요?', a: '네, Facebook Reel 오디오를 쉽게 다운로드할 수 있습니다. Reel URL을 TikSaveHub에 붙여넣으면 배경 음악, 내레이션 또는 원본 사운드를 그대로 추출해 MP3로 저장합니다.' },
