---
// TikTok Video Downloader — SEO-optimized landing page (Korean)
// URL: /tiktok-video-downloader-without-watermark
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import DownloadForm from '../../components/DownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';
import SocialShare from '../../components/SocialShare.astro';

const faqData = [
  { id: 'tt-how', q: 'TikTok 동영상을 다운로드하려면 어떻게 해야 하나요?', a: 'TikTok 링크를 TikSaveHub에 붙여넣고 다운로드를 클릭하세요.' },
  { id: 'tt-watermark', q: '워터마크 없이 다운로드할 수 있나요?', a: '네, TikSaveHub는 워터마크 없는 TikTok 동영상 다운로드를 지원합니다.' },
  { id: 'tt-free', q: 'TikTok 동영상 다운로드는 무료인가요?', a: '네, TikSaveHub는 100% 무료입니다.' },
  { id: 'tt-mp3', q: 'TikTok을 MP3로 변환할 수 있나요?', a: '네, TikTok to MP3 도구로 가능합니다.' },
  { id: 'tt-private', q: '비공개 TikTok 동영상을 다운로드할 수 있나요?', a: '아니요, 공개된 동영상만 지원됩니다.' },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') },
  })),
});
---

<Layout
  title="틱톡 비디오 다운로더 워터마크 없이 | TikSaveHub"
  description="틱톡 동영상을 워터마크 없이 HD MP4로 다운로드하세요. TikSaveHub는 무료, 빠르고 로그인 없이 틱톡 영상을 고품질로 저장할 수 있는 온라인 다운로더입니다."
  keywords="tiktok 다운로더, tiktok video downloader, tiktok 워터마크 제거, tiktok mp4"
  canonical="/tiktok-video-downloader-without-watermark"
  ogImage="/og-downloader.png"
  ogType="website"
  platform="tiktok"
  jsonLd={faqJsonLd}
  appName="TikSaveHub — TikTok 다운로더"
  lang="ko"
>
  <section class="dl-hero" aria-labelledby="dl-hero-headline">
    <div class="dl-hero-gradient gradient-mesh" aria-hidden="true"></div>
    <div class="dl-hero-inner container-page">
      <div class="dl-badge-row"><span class="badge-pill dl-badge"><span class="badge-dot" aria-hidden="true"></span> 무료 · 워터마크 없음 · HD</span></div>
      <h1 id="dl-hero-headline" class="dl-hero-headline">TikTok 다운로더</h1>
      <p class="dl-hero-sub text-body-lg">TikTok 동영상을 워터마크 없이 HD 품질로 다운로드. 무료로 빠르게.</p>
      <div class="dl-hero-form" id="download-tool"><DownloadForm /></div>
      <div class="dl-hero-trust">
        <span class="trust-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> 100% 무료</span>
        <span class="trust-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> 워터마크 없음</span>
        <span class="trust-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> HD 품질</span>
      </div>
    </div>
  </section>

  <StatsSection stats={[ { value: '100% 무료', label: '워터마크 없이 TikTok 동영상을 즉시 다운로드', icon: 'download' }, { value: '가입 불필요', label: '모든 기기에서, 전 세계 어디에서든 작동', icon: 'globe' }, { value: 'HD 품질', label: '원본 해상도, 워터마크 없음, 로그인 불필요', icon: 'star' } ]} />

  <section class="dl-faq-section" aria-labelledby="dl-faq-headline">
    <div class="dl-faq-inner container-page">
      <span class="section-eyebrow text-caption-mono">자주 묻는 질문</span>
      <h2 id="dl-faq-headline" class="section-headline">TikTok 다운로더 관련 질문</h2>
      <div class="dl-faq-grid">
        {faqData.map((faq) => (
          <details class="dl-faq-item"><summary class="dl-faq-q">{faq.q}</summary><p class="dl-faq-a">{faq.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <SocialShare url="/tiktok-video-downloader-without-watermark" title="TikTok 다운로더 — 워터마크 없는 HD MP4" description="TikTok 동영상을 워터마크 없이 HD MP4로 다운로드." />

  <!-- Related Tools -->
  <section class="related-tools-section">
    <div class="container-page" style="max-width:900px;margin-inline:auto;padding:var(--spacing-3xl) var(--spacing-lg);">
      <h2 class="related-tools-headline">추가 도구</h2>
      <div class="related-tools-grid">
            <a href="/ko/instagram-reels-downloader-without-watermark" class="related-tool-link">Instagram Reels Downloader</a>
            <a href="/ko/instagram-video-downloader-without-watermark" class="related-tool-link">Instagram Video Downloader</a>
            <a href="/ko/instagram-story-downloader-without-watermark" class="related-tool-link">Instagram Story Downloader</a>
            <a href="/ko/instagram-audio-downloader" class="related-tool-link">Instagram Audio Downloader</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .dl-hero { position: relative; padding: var(--spacing-5xl) var(--spacing-lg) var(--spacing-4xl); overflow: hidden; text-align: center; }
  .dl-hero-gradient { position: absolute; inset: 0; z-index: 0; }
  .dl-hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: var(--spacing-xl); max-width: 800px; margin-inline: auto; }
  .dl-badge-row { display: flex; justify-content: center; }
  .dl-badge { background: rgba(124, 58, 237, 0.1); border-color: rgba(124, 58, 237, 0.25); color: #7c3aed; }
  .dl-hero-headline { font-size: 44px; font-weight: 700; line-height: 1.1; letter-spacing: -2px; color: var(--color-ink); margin: 0; }
  .dl-hero-sub { max-width: 600px; text-align: center; margin: 0; }
  .dl-hero-form { width: 100%; max-width: 640px; }
  .dl-hero-trust { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--spacing-sm); }
  .dl-faq-section { padding: var(--spacing-5xl) var(--spacing-lg); }
  .dl-faq-inner { display: flex; flex-direction: column; align-items: center; gap: var(--spacing-3xl); }
  .dl-faq-grid { display: flex; flex-direction: column; gap: var(--spacing-md); width: 100%; max-width: 700px; }
  .dl-faq-item { border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); overflow: hidden; }
  .dl-faq-q { padding: var(--spacing-lg) var(--spacing-xl); font-size: 16px; font-weight: 600; color: var(--color-ink); cursor: pointer; list-style: none; }
  .dl-faq-q::-webkit-details-marker { display: none; }
  .dl-faq-a { padding: 0 var(--spacing-xl) var(--spacing-lg); font-size: 15px; color: var(--color-body); line-height: 1.7; margin: 0; }
  .section-eyebrow { color: #7c3aed; text-transform: uppercase; letter-spacing: 0.5px; }
  .section-headline { font-size: 32px; font-weight: 700; letter-spacing: -1.5px; color: var(--color-ink); margin: 0; text-align: center; }
  @media (max-width: 600px) { .dl-hero-headline { font-size: 30px; } .section-headline { font-size: 24px; } }

  .related-tools-section { padding: var(--spacing-2xl) 0; }
  .related-tools-headline { font-size: 20px; font-weight: 700; letter-spacing: -0.5px; color: var(--color-ink); margin: 0 0 var(--spacing-lg); text-align: center; }
  .related-tools-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--spacing-sm); }
  .related-tool-link { display: block; padding: var(--spacing-md) var(--spacing-lg); border-radius: var(--radius-lg); background: var(--color-canvas); border: 1px solid var(--color-hairline); text-decoration: none; font-size: 14px; font-weight: 600; color: var(--color-ink); transition: border-color 0.2s ease, box-shadow 0.2s ease; }
  .related-tool-link:hover { border-color: rgba(124, 58, 237, 0.3); box-shadow: 0 4px 12px -4px rgba(124, 58, 237, 0.15); }
  @media (max-width: 600px) { .related-tools-grid { grid-template-columns: 1fr; } }
</style>