---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { posts } from '../../data/blog-posts';

const categories = [
  { id: 'All', label: 'Todos' },
  { id: 'TikTok Guides', label: 'Guias TikTok' },
  { id: 'Instagram Tips', label: 'Dicas Instagram' },
  { id: 'Facebook Guides', label: 'Guias Facebook' },
  { id: 'X & Twitter Guides', label: 'X & Twitter' },
  { id: 'Audio Extraction', label: 'Extração de Áudio' },
  { id: 'Tech & Security', label: 'Tecnologia & Segurança' },
];

const sorted = [...posts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const [featured, ...restPosts] = sorted;
const categoryCounts = categories.reduce<Record<string, number>>((acc, cat) => {
  if (cat.id === 'All') {
    acc[cat.id] = posts.length;
  } else {
    acc[cat.id] = posts.filter((p) => p.category === cat.id).length;
  }
  return acc;
}, {});

const categoryMeta: Record<string, { label: string; icon: string }> = {
  'TikTok Guides': { label: 'TikTok', icon: 'tiktok' },
  'Instagram Tips': { label: 'Instagram', icon: 'instagram' },
  'Facebook Guides': { label: 'Facebook', icon: 'facebook' },
  'X & Twitter Guides': { label: 'X / Twitter', icon: 'x' },
  'Audio Extraction': { label: 'Audio', icon: 'audio' },
  'Tech & Security': { label: 'Segurança', icon: 'shield' },
};

const toolCards = [
  {
    href: '/tiktok-video-downloader-without-watermark',
    title: 'Downloader de Vídeos do TikTok',
    desc: 'Salve vídeos do TikTok em HD sem marca d\'água.',
    icon: 'tiktok',
  },
  {
    href: '/tiktok-to-mp3',
    title: 'Conversor de TikTok para MP3',
    desc: 'Extraia áudio de vídeos do TikTok.',
    icon: 'audio',
  },
  {
    href: '/instagram-video-downloader-without-watermark',
    title: 'Downloader de Vídeos do Instagram',
    desc: 'Salve vídeos de postagens do Instagram em HD.',
    icon: 'instagram',
  },
];
---

<Layout
  lang="pt"
  title="Guias de Redes Sociais & Dicas de Downloader de Vídeos — TikSaveHub"
  description="Dicas de redes sociais, guias de download de vídeos e tutoriais. Como salvar vídeos, Reels e áudio do TikTok, Instagram, Facebook e X (Twitter) sem marca d'água no TikSaveHub."
  keywords="blog tiksavehub, dicas redes sociais, guia downloader tiktok, guia downloader instagram, guia downloader facebook, guia downloader twitter, tutorial download videos, salvar videos sem marca d'agua"
  canonical="/blog"
  ogImage="/og-blog.png"
  skipSoftwareApp
>
  <!-- HERO -->
  <section class="blog-hero" aria-labelledby="blog-headline">
    <div class="blog-hero-bg gradient-mesh" aria-hidden="true"></div>
    <div class="blog-hero-inner container-page">
      <div class="blog-hero-content">
        <span class="blog-hero-badge">
          <span class="blog-hero-badge-dot" aria-hidden="true"></span>
          Base de Conhecimento & Guias
        </span>

        <h1 id="blog-headline" class="blog-hero-title">
          Salve conteúdo de forma inteligente com nossas dicas.
        </h1>

        <p class="blog-hero-sub text-body-lg">
          Guias para salvar vídeos, Reels e áudio do TikTok, Instagram, Facebook e X sem marca d'água — sem adivinhações, de forma simples.
        </p>

        <!-- Search -->
        <div class="blog-search" role="search">
          <svg class="blog-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            id="blog-search-input"
            class="blog-search-input"
            type="search"
            placeholder="Pesquisar guias, tutoriais ou tópicos..."
            aria-label="Pesquisar artigos"
            autocomplete="off"
          />
          <kbd class="blog-search-kbd">⌘K</kbd>
        </div>

        <!-- Category pills -->
        <nav class="blog-cat-row" aria-label="Filtrar por categoria">
          {categories.map((cat) => (
            <button
              type="button"
              class="blog-cat-pill"
              data-cat={cat.id}
              aria-pressed={cat.id === 'All' ? 'true' : 'false'}
            >
              {cat.label}
              <span class="blog-cat-count">{categoryCounts[cat.id]}</span>
            </button>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <!-- FEATURED POST -->
  <section class="blog-featured" aria-labelledby="featured-headline">
    <div class="blog-featured-inner container-page">
      <div class="blog-section-head">
        <span class="section-eyebrow text-caption-mono">Destaque</span>
        <h2 id="featured-headline" class="blog-section-title">Guia em Tendência</h2>
      </div>

      <a class="featured-card" href={`/blog/${featured.slug}`} data-featured>
        <div class="featured-cover">
          <img
            src={featured.cover}
            alt={featured.title}
            loading="eager"
            decoding="async"
            width="800"
            height="450"
          />
          <span class="featured-badge">Guia em Tendência</span>
        </div>

        <div class="featured-body">
          <div class="featured-meta-row">
            <span class="featured-cat">{featured.category}</span>
            <time class="featured-date text-caption-mono" datetime={featured.date}>{featured.date}</time>
            <span class="featured-reading">{featured.readingTime}</span>
          </div>
          <h3 class="featured-title">{featured.title}</h3>
          <p class="featured-excerpt">{featured.excerpt}</p>
          <span class="featured-cta" aria-hidden="false">Ler artigo completo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ARTICLES + SIDEBAR -->
  <section class="blog-main" aria-labelledby="articles-headline">
    <div class="blog-main-inner container-page">
      <div class="blog-layout">
        <div class="blog-articles">
          <div class="blog-section-head">
            <span class="section-eyebrow text-caption-mono">Todos os Artigos</span>
            <h2 id="articles-headline" class="section-title">Guias & Tutoriais Recentes</h2>
          </div>

          <p id="blog-empty" class="blog-empty" hidden>Nenhum artigo encontrado para sua pesquisa. Tente outras palavras-chave ou categorias.</p>

          <div id="blog-grid" class="article-grid">
            {restPosts.map((post) => {
              const cat = categoryMeta[post.category] ?? { label: post.category, icon: 'doc' };
              return (
                <a class="article-card" href={`/blog/${post.slug}`} data-title={post.title.toLowerCase()} data-cat={post.category}>
                  <div class="article-cover">
                    <img src={post.cover} alt={post.title} loading="lazy" decoding="async" width="800" height="450" />
                    <span class="article-tag">{cat.label}</span>
                  </div>
                  <div class="article-body">
                    <time class="article-date text-caption-mono" datetime={post.date}>{post.date}</time>
                    <h3 class="article-title">{post.title}</h3>
                    <p class="article-excerpt">{post.excerpt}</p>
                    <div class="article-footer">
                      <span class="article-author">{post.author.replace(' Editorial Team', '')}</span>
                      <span class="article-sep" aria-hidden="true">·</span>
                      <span class="article-reading">{post.readingTime}</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="blog-aside" aria-label="Recursos">
          <!-- Quick Tools -->
          <div class="aside-card quick-tools">
            <span class="aside-eyebrow text-caption-mono">Ferramentas Rápidas</span>
            <h3 class="aside-title">Downloaders Gratuitos</h3>
            <div class="tool-list">
              {toolCards.map((tool) => (
                <a class="tool-card" href={tool.href}>
                  <span class={`tool-icon tool-icon-${tool.icon}`} aria-hidden="true">
                    {tool.icon === 'tiktok' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v12a3 3 0 1 1-2-2.83"/><path d="M9 3c1.5 0 3 .5 4 1.5S14 8 16 8"/></svg>
                    )}
                    {tool.icon === 'audio' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                    )}
                    {tool.icon === 'instagram' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                    )}
                  </span>
                  <span class="tool-info">
                    <span class="tool-title">{tool.title}</span>
                    <span class="tool-desc">{tool.desc}</span>
                  </span>
                  <span class="tool-arrow" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </span>
                </a>
              ))}
            </div>
            <a href="/tiktok-video-downloader-without-watermark" class="aside-btn">
              Experimente o TikSaveHub Grátis
            </a>
          </div>

          <!-- Newsletter -->
          <div class="aside-widget newsletter-card">
            <span class="aside-eyebrow text-caption-mono">Newsletter</span>
            <h3 class="newsletter-title">Novidades sobre crescimento em redes sociais e dicas de download.</h3>
            <p class="newsletter-text">
              Uma dica útil por semana. Sem spam, cancele quando quiser.
            </p>
            <form id="newsletter-form" class="newsletter-form" action="#" novalidate>
              <label class="visually-hidden" for="newsletter-email">E-mail</label>
              <input
                id="newsletter-email"
                class="newsletter-input"
                type="email"
                name="email"
                placeholder="voce@email.com"
                required
              />
              <button type="submit" class="newsletter-btn">
                Inscrever-se
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
            </form>
            <p id="newsletter-msg" class="newsletter-msg" role="status" aria-live="polite"></p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="blog-cta" aria-labelledby="blog-cta-headline">
    <div class="blog-cta-inner container-page">
      <div class="blog-cta-card">
        <h2 id="blog-cta-headline" class="blog-cta-title">
          Comece a baixar agora.
        </h2>
        <p class="blog-cta-sub">
          Cole links do TikTok, Instagram, Facebook ou X e salve vídeos em HD — grátis e sem marca d'água.
        </p>
        <a href="/tiktok-video-downloader-without-watermark" class="blog-cta-btn">
          Experimentar o TikSaveHub
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .blog-hero { position: relative; padding: var(--spacing-5xl) var(--spacing-lg) var(--spacing-5xl); overflow: hidden; border-bottom: 1px solid var(--color-hairline); }
  .blog-hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0.9; }
  .blog-hero-inner { position: relative; z-index: 1; display: flex; justify-content: center; }
  .blog-hero-content { display: flex; flex-direction: column; align-items: center; gap: var(--spacing-lg); text-align: center; max-width: 720px; }
  .blog-hero-badge { display: inline-flex; align-items: center; gap: 8px; font-size: var(--text-body-sm); font-weight: 600; letter-spacing: -0.2px; color: var(--color-ink); padding: var(--spacing-xs) var(--spacing-md); height: 36px; border-radius: var(--radius-full); background-color: var(--color-canvas); box-shadow: inset 0 0 0 1px #00000014, 0px 2px 2px #0000000a, 0px 8px 16px -4px #0000001a; }
  .dark .blog-hero-badge { background-color: var(--color-canvas-soft); box-shadow: inset 0 0 0 1px #ffffff14; }
  .blog-hero-badge-dot { width: 8px; height: 8px; border-radius: 50%; background: linear-gradient(135deg, var(--color-grad-develop-start), var(--color-grad-preview-end)); box-shadow: 0 0 12px 2px rgba(0, 124, 240, 0.5); animation: pulse-dot 2s ease-in-out infinite; }
  .blog-hero-title { font-size: clamp(34px, 6vw, 54px); font-weight: 700; line-height: 1.06; letter-spacing: -2.4px; color: var(--color-ink); margin: 0; max-width: 680px; background: linear-gradient(135deg, #007cf0 0%, #7928ca 48%, #ff0080 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .dark .blog-hero-title { color: #fafafa; background: linear-gradient(135deg, #38bdf8 0%, #c084fc 48%, #f472b6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .blog-hero-sub { color: var(--color-body); margin: 0; max-width: 560px; }
  .blog-search { position: relative; width: 100%; max-width: 560px; }
  .blog-search-icon { position: absolute; left: var(--spacing-md); top: 50%; transform: translateY(-50%); color: var(--color-mute); pointer-events: none; }
  .blog-search-input { width: 100%; height: 52px; padding: 0 var(--spacing-lg) 0 calc(var(--spacing-lg) + 28px); font-size: var(--text-body-md); color: var(--color-ink); background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-full); outline: none; transition: border-color 0.2s ease, box-shadow 0.2s ease; -webkit-appearance: none; }
  .blog-search-input::placeholder { color: var(--color-mute); }
  .blog-search-input:focus { border-color: transparent; box-shadow: 0 0 0 2px var(--color-grad-develop-start), 0 0 0 5px rgba(0, 124, 240, 0.12); }
  .blog-search-kbd { position: absolute; right: var(--spacing-sm); top: 50%; transform: translateY(-50%); display: inline-flex; align-items: center; height: 24px; padding: 0 8px; font-family: var(--font-mono); font-size: var(--text-caption); color: var(--color-mute); background-color: var(--color-canvas-soft-2); border-radius: var(--radius-sm); box-shadow: inset 0 0 0 1px var(--color-hairline); }
  @media (max-width: 600px) { .blog-search-kbd { display: none; } }
  .blog-cat-row { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--spacing-xs); }
  .blog-cat-pill { display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 var(--spacing-md); font-size: var(--text-body-sm); font-weight: 500; letter-spacing: -0.2px; color: var(--color-body); background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-full); cursor: pointer; transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease; font-family: inherit; }
  .blog-cat-pill:hover { border-color: var(--color-hairline-strong); color: var(--color-ink); transform: translateY(-1px); }
  .blog-cat-pill[aria-pressed='true'] { color: #ffffff; background: linear-gradient(135deg, var(--color-grad-develop-start), var(--color-grad-preview-start)); border-color: transparent; box-shadow: 0 4px 14px -4px rgba(0, 124, 240, 0.55); }
  .blog-cat-count { display: inline-flex; align-items: center; justify-content: center; min-width: 18px; height: 18px; padding: 0 5px; font-size: 11px; font-weight: 700; border-radius: var(--radius-full); background-color: var(--color-canvas-soft-2); color: var(--color-mute); }
  .blog-cat-pill[aria-pressed='true'] .blog-cat-count { background-color: rgba(255, 255, 255, 0.2); color: #ffffff; }
  .blog-featured, .blog-main { padding: var(--spacing-5xl) var(--spacing-lg); }
  .blog-featured { background-color: var(--color-canvas-soft); }
  .blog-featured-inner, .blog-main-inner { display: flex; flex-direction: column; gap: var(--spacing-3xl); }
  .blog-section-head { display: flex; flex-direction: column; align-items: flex-start; gap: var(--spacing-xs); }
  .blog-section-title, .section-title { font-size: var(--text-display-lg); font-weight: 600; letter-spacing: -1.28px; color: var(--color-ink); margin: 0; }
  .featured-card { display: grid; grid-template-columns: 1.05fr 1fr; gap: var(--spacing-3xl); align-items: center; background-color: var(--color-canvas); border-radius: var(--radius-xl); padding: var(--spacing-2xl); text-decoration: none; box-shadow: inset 0 0 0 1px #0000000a, 0px 1px 1px #00000005, 0px 4px 8px #0000000a; transition: transform 0.25s ease, box-shadow 0.25s ease; position: relative; overflow: hidden; }
  .featured-card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(600px circle at 100% 0%, rgba(0, 124, 240, 0.06) 0%, transparent 60%), radial-gradient(500px circle at 0% 100%, rgba(121, 40, 202, 0.06) 0%, transparent 60%); pointer-events: none; }
  .featured-card:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px #00000014, 0px 2px 2px #0000000a, 0px 16px 32px -8px #0000001f; }
  .dark .featured-card { box-shadow: inset 0 0 0 1px #ffffff0f; }
  .dark .featured-card:hover { box-shadow: inset 0 0 0 1px #ffffff0f, 0px 2px 2px #00000015, 0px 16px 32px #00000040; }
  .featured-cover { position: relative; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 16 / 9; }
  .featured-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .featured-badge { position: absolute; top: var(--spacing-sm); left: var(--spacing-sm); display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; font-size: var(--text-caption); font-weight: 700; letter-spacing: 0.2px; color: #ffffff; border-radius: var(--radius-full); background: linear-gradient(135deg, var(--color-grad-ship-start), var(--color-grad-ship-end)); box-shadow: 0 4px 12px -2px rgba(255, 77, 77, 0.5); }
  .featured-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background-color: #ffffff; animation: pulse-dot 1.6s ease-in-out infinite; }
  .featured-body { display: flex; flex-direction: column; gap: var(--spacing-sm); position: relative; z-index: 1; }
  .featured-meta-row { display: flex; align-items: center; flex-wrap: wrap; gap: var(--spacing-xs); }
  .featured-cat { font-size: var(--text-body-sm); font-weight: 600; color: var(--color-grad-develop-start); background: linear-gradient(135deg, rgba(0, 124, 240, 0.1), rgba(0, 223, 216, 0.1)); border: 1px solid rgba(0, 124, 240, 0.2); padding: 2px 10px; border-radius: var(--radius-full); }
  .dark .featured-cat { color: #7dd3fc; }
  .featured-date { color: var(--color-mute); font-size: var(--text-caption); }
  .featured-reading { font-size: var(--text-caption); color: var(--color-mute); padding: 1px 8px; border-radius: var(--radius-full); background-color: var(--color-canvas-soft-2); }
  .featured-title { font-size: clamp(24px, 3vw, 32px); font-weight: 700; letter-spacing: -1.28px; line-height: 1.15; color: var(--color-ink); margin: 0; }
  .featured-excerpt { font-size: var(--text-body-md); color: var(--color-body); line-height: 1.65; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .featured-cta { display: inline-flex; align-items: center; gap: var(--spacing-xs); margin-top: var(--spacing-xs); font-size: var(--text-body-md); font-weight: 600; color: var(--color-grad-develop-start); transition: gap 0.2s ease; }
  .featured-card:hover .featured-cta { gap: var(--spacing-sm); }
  .dark .featured-cta { color: #60a5fa; }
  .blog-main { background-color: var(--color-canvas); }
  .blog-layout { display: grid; grid-template-columns: 1fr 340px; gap: var(--spacing-4xl); align-items: start; }
  .blog-articles { display: flex; flex-direction: column; gap: var(--spacing-2xl); }
  .blog-empty { font-size: var(--text-body-md); color: var(--color-body); padding: var(--spacing-3xl); text-align: center; border: 1px dashed var(--color-hairline-strong); border-radius: var(--radius-lg); margin: 0; }
  .article-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-lg); }
  .article-card { display: flex; flex-direction: column; background-color: var(--color-canvas); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); overflow: hidden; text-decoration: none; transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease; }
  .article-card:hover { transform: translateY(-4px); border-color: transparent; box-shadow: inset 0 0 0 1px #00000014, 0px 4px 8px #0000000a, 0px 16px 32px -8px #0000001a; }
  .dark .article-card { border-color: var(--color-hairline); }
  .dark .article-card:hover { box-shadow: inset 0 0 0 1px #ffffff14, 0px 4px 8px #00000020, 0px 16px 32px #00000050; }
  .article-cover { position: relative; aspect-ratio: 16 / 9; overflow: hidden; }
  .article-cover img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .article-card:hover .article-cover img { transform: scale(1.04); }
  .article-tag { position: absolute; bottom: var(--spacing-sm); left: var(--spacing-sm); display: inline-flex; padding: 3px 10px; font-size: var(--text-caption); font-weight: 700; color: #ffffff; border-radius: var(--radius-full); background-color: rgba(23, 23, 23, 0.78); backdrop-filter: blur(6px); letter-spacing: 0.1px; }
  .article-body { display: flex; flex-direction: column; gap: var(--spacing-xs); padding: var(--spacing-lg); flex: 1; }
  .article-date { color: var(--color-mute); font-size: var(--text-caption); }
  .article-title { font-size: var(--text-display-sm); font-weight: 600; letter-spacing: -0.6px; line-height: 1.3; color: var(--color-ink); margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; transition: color 0.15s ease; }
  .article-card:hover .article-title { color: var(--color-grad-develop-start); }
