---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';

const contactJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      name: 'Contato — TikSaveHub',
      description: 'Entre em contato com o TikSaveHub. Suporte, perguntas e feedback.',
      url: 'https://tiksavehub.com/contact',
    },
    {
      '@type': 'Organization',
      name: 'TikSaveHub',
      url: 'https://tiksavehub.com',
      logo: 'https://tiksavehub.com/logo.png',
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: 'support@tiksavehub.com',
        availableLanguage: 'Portuguese',
      },
    },
  ],
});
---

<Layout
  lang="pt"
  title="Contato — TikSaveHub"
  description="Entre em contato com o TikSaveHub. Suporte, perguntas e feedback sobre nosso downloader de vídeos do TikTok."
  keywords="contato tiksavehub, suporte tiksavehub, contato, ajuda downloader tiktok"
  canonical="/contact"
  ogImage="/og-contact.png"
  skipSoftwareApp
  jsonLd={contactJsonLd}
>
  <section class="legal-section" aria-labelledby="legal-headline">
    <div class="legal-inner container-page">
      <nav aria-label="Breadcrumb" class="legal-breadcrumb">
        <ol class="breadcrumb-list">
          <li>
            <a href="/pt"><span>Início</span></a>
                  </li>
          <li aria-current="page">
            <span>Contato</span>
                  </li>
        </ol>
      </nav>

      <div class="legal-header">
        <span class="section-eyebrow text-caption-mono">Suporte</span>
        <h1 id="legal-headline" class="legal-title">Contato</h1>
        <p class="legal-meta">Fale conosco.</p>
      </div>

      <div class="legal-card">
        <div class="legal-content">

          <section class="legal-clause">
            <h2 class="legal-h2">Como entrar em contato</h2>
            <p>
              Se você tiver alguma pergunta, sugestão ou precisar de suporte, não hesite em nos contatar. Responderemos o mais rápido possível.
            </p>
          </section>

          <section class="legal-clause">
            <h2 class="legal-h2">Informações de Contato</h2>
              <p class="legal-contact">
                <strong>E-mail:</strong> <a href="mailto:support@tiksavehub.com">support@tiksavehub.com</a>
              </p>
          </section>

          <section class="legal-clause">
            <h2 class="legal-h2">Tempo de Resposta</h2>
            <p>
              Nosso objetivo é responder a todas as solicitações dentro de 24 a 48 horas. Para um suporte mais rápido, descreva claramente o problema ou pergunta com detalhes.
            </p>
          </section>

        </div>
      </div>

      <div class="legal-back">
        <a href="/pt" class="btn-primary-sm">&larr; Voltar ao TikSaveHub</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal-section { background-color: var(--color-canvas-soft); padding: var(--spacing-5xl) var(--spacing-lg); }
  .legal-inner { display: flex; flex-direction: column; gap: var(--spacing-2xl); max-width: 760px; margin-inline: auto; }
  .legal-breadcrumb { margin-bottom: 0; }
  .breadcrumb-list { display: flex; align-items: center; gap: 6px; list-style: none; margin: 0; padding: 0; font-size: var(--text-body-sm); color: var(--color-mute); }
  .breadcrumb-list li + li::before { content: '/'; margin-right: 6px; color: var(--color-hairline-strong); }
  .breadcrumb-list a { color: var(--color-body); text-decoration: none; transition: color 0.15s ease; }
  .breadcrumb-list a:hover { color: var(--color-ink); }
  .legal-header { display: flex; flex-direction: column; gap: var(--spacing-sm); }
  .section-eyebrow { color: var(--color-mute); }
  .legal-title { font-size: var(--text-display-xl); font-weight: 600; line-height: 1.05; letter-spacing: -2.5px; color: var(--color-ink); margin: 0; }
  .legal-meta { font-size: var(--text-body-sm); color: var(--color-mute); margin: 0; }
  .legal-card { background-color: var(--color-canvas); border-radius: var(--radius-lg); padding: var(--spacing-3xl); box-shadow: inset 0 0 0 1px #0000000a, 0px 1px 1px #00000005, 0px 4px 8px #0000000a; }
  .legal-content { display: flex; flex-direction: column; gap: var(--spacing-2xl); }
  .legal-clause { display: flex; flex-direction: column; gap: var(--spacing-md); }
  .legal-h2 { font-size: var(--text-display-md); font-weight: 600; letter-spacing: -1.28px; color: var(--color-ink); margin: 0; line-height: 1.25; }
  .legal-content p { font-size: var(--text-body-md); color: var(--color-body); line-height: 1.75; margin: 0; letter-spacing: -0.1px; }
  .legal-contact { background-color: var(--color-canvas-soft); border-radius: var(--radius-md); padding: var(--spacing-lg); font-size: var(--text-body-md); color: var(--color-body); line-height: 1.75; }
  .legal-contact strong { font-weight: 600; color: var(--color-ink); }
  .legal-content a { color: var(--color-link); text-decoration: underline; text-underline-offset: 2px; transition: color 0.15s ease; }
  .legal-content a:hover { color: var(--color-link-deep); }
  .legal-back { display: flex; justify-content: center; }
  .btn-primary-sm { display: inline-flex; align-items: center; gap: var(--spacing-xs); padding: var(--spacing-xs) var(--spacing-lg); border-radius: var(--radius-full); background-color: var(--color-ink); color: var(--color-on-primary); font-size: var(--text-body-sm); font-weight: 500; text-decoration: none; transition: opacity 0.2s ease, transform 0.2s ease; border: none; cursor: pointer; line-height: 2.2; letter-spacing: -0.1px; }
  .btn-primary-sm:hover { opacity: 0.85; transform: translateY(-1px); }
  .dark .legal-card { box-shadow: inset 0 0 0 1px #ffffff0a, 0px 1px 1px #00000010, 0px 4px 8px #00000020; }
  .dark .legal-contact { background-color: var(--color-canvas-soft-2); }
  @media (max-width: 600px) { .legal-section { padding: var(--spacing-4xl) var(--spacing-md); } .legal-title { font-size: 32px; letter-spacing: -1.5px; } .legal-card { padding: var(--spacing-lg); } .legal-h2 { font-size: var(--text-display-sm); } .breadcrumb-list { font-size: var(--text-caption); } }
</style>
