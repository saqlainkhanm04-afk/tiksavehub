  { id: 'reels-no-limit', q: 'Há limite diário para baixar Facebook Reels?', a: 'Não, o TikSaveHub é 100% gratuito com zero limite diário de downloads.' },
  { id: 'reels-whyfail', q: 'Por que não consigo baixar um Facebook Reel?', a: 'O download geralmente falha quando o Reel está definido como privado, foi removido ou o URL copiado está incompleto.' },
];

const faqJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqData.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') } })) });
