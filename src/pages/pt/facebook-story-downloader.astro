---
// Facebook Story Downloader — SEO-optimized landing page (Portuguese)
// URL: /facebook-story-downloader
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import FbHeroSection from '../../components/FbHeroSection.astro';
import FbStepsSection from '../../components/FbStepsSection.astro';
import FbFeaturesSection from '../../components/FbFeaturesSection.astro';
import FbFaqSection from '../../components/FbFaqSection.astro';
import FbCtaBand from '../../components/FbCtaBand.astro';
import FbInternalLinks from '../../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../../components/FacebookDownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';

const faqData = [
  { id: 'story-hd', q: 'Como baixar stories do Facebook em HD?', a: 'Copie o link de um story público do Facebook, cole no TikSaveHub e clique em baixar. Se o story estiver disponível, será salvo como MP4 na qualidade original.' },
  { id: 'story-24h', q: 'Os stories do Facebook desaparecem após 24 horas?', a: 'Sim, stories do Facebook desaparecem automaticamente após 24 horas. Copie o link e baixe antes que desapareçam.' },
  { id: 'story-private', q: 'Posso baixar stories do Facebook privados?', a: 'Não, o TikSaveHub só pode baixar stories públicos do Facebook.' },
  { id: 'story-no-login', q: 'Preciso fazer login no Facebook para baixar stories?', a: 'Não, login não é necessário. Basta ter o link de um story público.' },
  { id: 'story-iphone', q: 'Como salvar stories do Facebook no iPhone?', a: 'Abra o Safari, cole o link no TikSaveHub e toque em baixar. O MP4 será salvo no app de arquivos.' },
  { id: 'story-android', q: 'Como salvar stories do Facebook no Android?', a: 'Abra o Chrome, cole o link no TikSaveHub e toque em baixar. O vídeo será salvo na pasta de downloads.' },
];

const faqJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqData.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') } })) });
---

<Layout
  title="Facebook Story Downloader — Grátis e anônimo | TikSaveHub"
  description="Baixe stories do Facebook antes de desaparecerem. Grátis, rápido, anônimo. Salve stories do FB em HD sem login."
  keywords="facebook story downloader, facebook stories download, facebook story downloader, stories salvar"
  canonical="/facebook-story-downloader"
  ogImage="/og-downloader.png"
  ogType="website"
  platform="facebook"
  jsonLd={faqJsonLd}
  appName="TikSaveHub — Facebook Story Downloader"
  lang="pt"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Início", "item": "https://tiksavehub.com" }, { "@type": "ListItem", "position": 2, "name": "Facebook Story Downloader", "item": "https://tiksavehub.com/facebook-story-downloader" } ] })} />

  <FbHeroSection
    crumb="Facebook Story Downloader"
    badge="Grátis · HD · Anônimo"
    title="Facebook Story Downloader — Baixe antes que desapareçam"
    subline="Salve stories do Facebook em HD antes que desapareçam. Grátis e anônimo."
    sub="Stories do Facebook desaparecem após 24 horas. Baixe antes que desapareçam sem login — grátis e rápido. Cole o link do story do Facebook e salve o MP4."
    trust={['100% grátis', 'Anônimo', 'HD', 'Sem cadastro', 'Funciona em todos os dispositivos']}
    shareUrl="/facebook-story-downloader"
    shareTitle="Facebook Story Downloader — Grátis e anônimo"
    shareDescription="Baixe stories do Facebook antes de desaparecerem. Grátis e anônimo."
  >
    <FacebookDownloadForm mode="story" />
  </FbHeroSection>

  <StatsSection stats={[ { value: '100% Gratuito', label: 'Baixe vídeos do TikTok instantaneamente sem marca d\'água', icon: 'download' }, { value: 'Sem Cadastro', label: 'Funciona em qualquer dispositivo, de qualquer lugar', icon: 'globe' }, { value: 'Qualidade HD', label: 'Resolução original, sem marca d\'água, sem login', icon: 'star' } ]} />

  <FbStepsSection
    eyebrow="Guia passo a passo"
    headline="Como baixar stories do Facebook."
    sub="3 passos simples."
    steps={[ { num: '01', icon: 'copy', title: 'Copie o link do story', body: 'Abra o Facebook, encontre o story que deseja salvar, toque em compartilhar e selecione "Copiar link".' }, { num: '02', icon: 'paste', title: 'Cole no TikSaveHub', body: 'Volte aqui e cole o link no campo de entrada.' }, { num: '03', icon: 'download', title: 'Baixe o story', body: 'Clique em baixar e salve o arquivo MP4 no seu dispositivo.' } ]} />

  <FbFeaturesSection
    eyebrow="Recursos"
    headline="Por que escolher o TikSaveHub para stories do Facebook."
    features={[ { icon: 'shield', accent: 'develop', title: 'Sem marca d\'água', body: 'Baixe o story na qualidade original — sem marca d\'água.' }, { icon: 'zap', accent: 'preview', title: 'Baixe antes que desapareçam', body: 'Salve histórias temporárias que são excluídas após 24 horas.' }, { icon: 'music', accent: 'ship', title: 'Ultra rápido', body: 'Baixe em segundos — cole, clique e salve.' }, { icon: 'globe', accent: 'develop', title: 'Anônimo', body: 'Baixe o story sem que o proprietário saiba. Totalmente privado.' }, { icon: 'device', accent: 'preview', title: 'Funciona em todos os dispositivos', body: 'iPhone, Android, PC, Mac — funciona em todos os navegadores.' }, { icon: 'list', accent: 'ship', title: 'Gratuito e ilimitado', body: 'Sem limite diário, sem custo. Baixe quantos quiser.' } ]} />

  <FbFaqSection eyebrow="Perguntas frequentes" headline="Perguntas sobre stories do Facebook." prefix="story" faqs={faqData} />

  <FbCtaBand headline="Salve aquele story antes que desapareça." sub="Grátis, rápido, anônimo — cole o link do story e salve em HD." ctaHref="#download-tool" ctaLabel="Baixar story agora" />

  <FbInternalLinks
    headline="Outras ferramentas gratuitas do Facebook"
    links={[ { href: '/facebook-video-downloader', icon: 'fb', title: 'Facebook Video Downloader', desc: 'Baixe vídeos completos do Facebook em HD.' }, { href: '/facebook-reels-downloader', icon: 'fb', title: 'Facebook Reels Downloader', desc: 'Salve Facebook Reels sem marca d\'água.' }, { href: '/facebook-to-mp3', icon: 'mp3', title: 'Facebook to MP3 Converter', desc: 'Extraia áudio de vídeos do Facebook para MP3.' }, { href: '/facebook-photo-downloader', icon: 'photo', title: 'Facebook Photo Downloader', desc: 'Salve fotos do Facebook em resolução total.' } ]}
  />

  <!-- Related Tools -->
  <section class="related-tools-section">
    <div class="container-page" style="max-width:900px;margin-inline:auto;padding:var(--spacing-3xl) var(--spacing-lg);">
      <h2 class="related-tools-headline">Mais Ferramentas</h2>
      <div class="related-tools-grid">
            <a href="/pt/tiktok-video-downloader-without-watermark" class="related-tool-link">TikTok Video Downloader</a>
            <a href="/pt/tiktok-to-mp3" class="related-tool-link">TikTok para MP3</a>
            <a href="/pt/instagram-reels-downloader-without-watermark" class="related-tool-link">Instagram Reels Downloader</a>
            <a href="/pt/instagram-video-downloader-without-watermark" class="related-tool-link">Instagram Video Downloader</a>
      </div>
    </div>
  </section>

</Layout>