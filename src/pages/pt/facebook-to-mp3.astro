---
// Facebook to MP3 — SEO-optimized landing page (Portuguese)
// URL: /facebook-to-mp3
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import FbHeroSection from '../../components/FbHeroSection.astro';
import FbStepsSection from '../../components/FbStepsSection.astro';
import FbFeaturesSection from '../../components/FbFeaturesSection.astro';
import FbFaqSection from '../../components/FbFaqSection.astro';
import FbCtaBand from '../../components/FbCtaBand.astro';
import FbInternalLinks from '../../components/FbInternalLinks.astro';
import FacebookDownloadForm from '../../components/FacebookDownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';
import { getLocalizedPath, type Lang } from '../../i18n/utils';
const lp = (p: string) => getLocalizedPath(p, 'pt' as Lang);

const faqData = [
  { id: 'mp3-how', q: 'Como converter vídeo do Facebook para MP3?', a: 'Copie o link de um vídeo do Facebook, cole no TikSaveHub, selecione a opção MP3 e clique em baixar. Você receberá um arquivo MP3 de alta qualidade.' },
  { id: 'mp3-quality', q: 'Qual é a qualidade do MP3?', a: 'O áudio é extraído na qualidade máxima de até 320kbps. Você recebe um arquivo MP3 limpo e de alta qualidade.' },
  { id: 'mp3-reels', q: 'Posso converter Facebook Reel para MP3?', a: 'Sim, você pode converter qualquer Facebook Reel para MP3.' },
  { id: 'mp3-free', q: 'Converter Facebook para MP3 é gratuito?', a: 'Sim, o TikSaveHub é 100% gratuito.' },
  { id: 'mp3-no-login', q: 'Preciso fazer login no Facebook?', a: 'Não, login não é necessário. Só é necessário o link de um vídeo público.' },
];

const faqJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqData.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') } })) });
---

<Layout
  title="Facebook to MP3 — Extraia áudio de vídeos do FB | TikSaveHub"
  description="Converta vídeos do Facebook em arquivos MP3 de alta qualidade. Até 320kbps. Grátis, rápido, sem cadastro."
  keywords="facebook mp3 conversor, facebook to mp3, facebook áudio download, facebook mp3 converter"
  canonical="/facebook-to-mp3"
  ogImage="/og-downloader.png"
  ogType="website"
  platform="facebook"
  jsonLd={faqJsonLd}
  appName="TikSaveHub — Facebook to MP3"
  lang="pt"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Início", "item": "https://tiksavehub.com" }, { "@type": "ListItem", "position": 2, "name": "Facebook to MP3", "item": "https://tiksavehub.com/facebook-to-mp3" } ] })} />

  <FbHeroSection
    crumb="Facebook to MP3"
    badge="Grátis · Alta qualidade · 320kbps"
    title="Facebook to MP3 — Extraia áudio de vídeos do FB"
    subline="Converta vídeos do Facebook em MP3 de alta qualidade. Grátis e rápido."
    sub="Extraia o áudio de vídeos, Reels e Watch do Facebook como MP3 de alta qualidade até 320kbps. Grátis, rápido, sem cadastro. Cole o link e baixe o áudio instantaneamente."
    trust={['100% grátis', 'Até 320kbps', 'Sem cadastro', 'Ultra rápido', 'Funciona em todos os dispositivos']}
    shareUrl="/facebook-to-mp3"
    shareTitle="Facebook to MP3 — Extraia áudio de vídeos do FB"
    shareDescription="Converta vídeos do Facebook em MP3 de alta qualidade. Grátis e rápido."
  >
    <FacebookDownloadForm mode="mp3" />
  </FbHeroSection>

  <StatsSection stats={[ { value: '100% Gratuito', label: 'Baixe vídeos do TikTok instantaneamente sem marca d\'água', icon: 'download' }, { value: 'Sem Cadastro', label: 'Funciona em qualquer dispositivo, de qualquer lugar', icon: 'globe' }, { value: 'Qualidade HD', label: 'Resolução original, sem marca d\'água, sem login', icon: 'star' } ]} />

  <FbStepsSection
    eyebrow="Guia passo a passo"
    headline="Como converter Facebook para MP3."
    sub="3 passos simples."
    steps={[ { num: '01', icon: 'copy', title: 'Copie o link do vídeo', body: 'Abra o Facebook, encontre o vídeo do qual deseja extrair o áudio, toque em compartilhar e selecione "Copiar link".' }, { num: '02', icon: 'paste', title: 'Cole no TikSaveHub', body: 'Volte aqui, cole o link no campo de entrada e selecione a opção MP3.' }, { num: '03', icon: 'download', title: 'Baixe o MP3', body: 'Clique em baixar e obtenha o arquivo MP3 de alta qualidade instantaneamente.' } ]} />

  <FbFeaturesSection
    eyebrow="Recursos"
    headline="Por que escolher o TikSaveHub para Facebook to MP3."
    features={[ { icon: 'music', accent: 'develop', title: 'Alta qualidade até 320kbps', body: 'Extraia áudio na qualidade máxima — até 320kbps, sem perda.' }, { icon: 'zap', accent: 'preview', title: 'Conversão ultra rápida', body: 'Processamento no servidor — obtenha o MP3 em segundos.' }, { icon: 'shield', accent: 'ship', title: 'Sem marca d\'água', body: 'Áudio limpo — sem marca d\'água, logotipo ou anúncios.' }, { icon: 'list', accent: 'develop', title: 'Compatível com todos os formatos', body: 'Vídeos Watch, Reels, posts, links fb.watch — todos suportados.' }, { icon: 'device', accent: 'preview', title: 'Funciona em todos os dispositivos', body: 'iPhone, Android, PC, Mac — funciona em todos os navegadores.' }, { icon: 'globe', accent: 'ship', title: 'Gratuito e ilimitado', body: 'Sem limite diário, sem custo. Converta quantos quiser.' } ]} />

  <FbFaqSection eyebrow="Perguntas frequentes" headline="Perguntas sobre Facebook to MP3." prefix="mp3" faqs={faqData} />

  <FbCtaBand headline="Extraia áudio de seus vídeos favoritos do Facebook." sub="Grátis, rápido, alta qualidade — cole o link e obtenha o MP3." ctaHref="#download-tool" ctaLabel="Converter para MP3 agora" />

  <FbInternalLinks
    headline="Outras ferramentas gratuitas do Facebook"
    links={[ { href: lp('/facebook-video-downloader'), icon: 'fb', title: 'Facebook Video Downloader', desc: 'Baixe vídeos do Facebook em HD.' }, { href: lp('/facebook-reels-downloader'), icon: 'fb', title: 'Facebook Reels Downloader', desc: 'Salve Facebook Reels sem marca d\'água.' }, { href: lp('/facebook-story-downloader'), icon: 'story', title: 'Facebook Story Downloader', desc: 'Salve stories do Facebook antes de desaparecerem.' }, { href: lp('/facebook-photo-downloader'), icon: 'photo', title: 'Facebook Photo Downloader', desc: 'Salve fotos do Facebook em resolução total.' } ]}
    lang="pt"
  />

  <!-- Related Tools -->
  <section class="related-tools-section">
    <div class="container-page" style="max-width:900px;margin-inline:auto;padding:var(--spacing-3xl) var(--spacing-lg);">
      <h2 class="related-tools-headline">Mais Ferramentas</h2>
      <div class="related-tools-grid">
            <a href="/pt/tiktok-video-downloader-without-watermark" class="related-tool-link">TikTok Video Downloader</a>
            <a href="/pt/tiktok-to-mp3" class="related-tool-link">TikTok para MP3</a>
            <a href="/pt/instagram-reels-downloader-without-watermark" class="related-tool-link">Instagram Reels Downloader</a>
            <a href="/pt/instagram-video-downloader-without-watermark" class="related-tool-link">Instagram Video Downloader</a>
      </div>
    </div>
  </section>

</Layout>