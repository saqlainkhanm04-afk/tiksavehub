---
// TikSaveHub Homepage — hub page for all tools (Portuguese)
export const prerender = true;

import Layout from '../../layouts/Layout.astro';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TikSaveHub',
  url: 'https://tiksavehub.com',
  logo: 'https://tiksavehub.com/web-app-manifest-512x512.png',
  description: 'Baixe vídeos do TikTok, Instagram, Facebook e X (Twitter) em qualidade HD — grátis, rápido, sem marca d\'água.',
  sameAs: [
    'https://twitter.com/tiksavehub',
    'https://www.facebook.com/tiksavehub',
    'https://www.instagram.com/tiksavehub',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'support@tiksavehub.com',
  },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TikSaveHub',
  url: 'https://tiksavehub.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://tiksavehub.com/tiktok-video-downloader-without-watermark?url={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const base = '/pt';

const tools = [
  {
    title: 'Baixar Vídeos do TikTok',
    description: 'Salve vídeos do TikTok sem marca d\'água em qualidade HD. Grátis, rápido, sem cadastro.',
    href: `${base}/tiktok-video-downloader-without-watermark`,
    icon: 'tiktok',
    badge: 'Popular',
  },
  {
    title: 'TikTok para MP3',
    description: 'Extraia áudio de vídeos do TikTok como arquivos MP3 de alta qualidade até 320kbps.',
    href: `${base}/tiktok-to-mp3`,
    icon: 'audio',
    badge: null,
  },
  {
    title: 'Baixar Reels do Instagram',
    description: 'Baixe Reels do Instagram sem marca d\'água em HD. Funciona em todos os dispositivos.',
    href: `${base}/instagram-reels-downloader-without-watermark`,
    icon: 'instagram',
    badge: 'Novo',
  },
  {
    title: 'Baixar Vídeos do Instagram',
    description: 'Salve vídeos e posts do Instagram em qualidade HD. Sem necessidade de aplicativo.',
    href: `${base}/instagram-video-downloader-without-watermark`,
    icon: 'instagram',
    badge: null,
  },
  {
    title: 'Baixar Stories do Instagram',
    description: 'Baixe Stories do Instagram antes que expirem. Grátis e anônimo.',
    href: `${base}/instagram-story-downloader-without-watermark`,
    icon: 'instagram',
    badge: null,
  },
  {
    title: 'Baixar Vídeos do Facebook',
    description: 'Baixe vídeos, Reels e posts do Facebook em qualidade HD.',
    href: `${base}/facebook-video-downloader`,
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Baixar Reels do Facebook',
    description: 'Salve Reels do Facebook sem marca d\'água em qualidade HD.',
    href: `${base}/facebook-reels-downloader`,
    icon: 'facebook',
    badge: 'Novo',
  },
  {
    title: 'Facebook para MP3',
    description: 'Extraia áudio de vídeos do Facebook como arquivos MP3 de alta qualidade.',
    href: `${base}/facebook-to-mp3`,
    icon: 'audio',
    badge: null,
  },
  {
    title: 'Facebook Story Downloader',
    description: 'Baixe stories do Facebook antes que expirem. Grátis e anônimo.',
    href: `${base}/facebook-story-downloader`,
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Facebook Photo Downloader',
    description: 'Baixe fotos e álbuns do Facebook em qualidade HD completa.',
    href: `${base}/facebook-photo-downloader`,
    icon: 'facebook',
    badge: null,
  },
  {
    title: 'Instagram Audio Downloader',
    description: 'Extraia áudio de Reels e vídeos do Instagram como MP3 de alta qualidade.',
    href: `${base}/instagram-audio-downloader`,
    icon: 'audio',
    badge: null,
  },
  {
    title: 'Baixar Vídeos do X (Twitter)',
    description: 'Baixe vídeos e GIFs do X (Twitter) em qualidade HD.',
    href: `${base}/x-video-downloader`,
    icon: 'x',
    badge: null,
  },
  {
    title: 'Snapchat Downloader',
    description: 'Salve vídeos do Snapchat em qualidade HD. Grátis, rápido, sem cadastro.',
    href: `${base}/snapchat-downloader`,
    icon: 'snapchat',
    badge: null,
  },
  {
    title: 'Snapchat Story Downloader',
    description: 'Baixe Stories do Snapchat antes que expirem. Grátis e anônimo.',
    href: `${base}/snapchat-story-downloader`,
    icon: 'snapchat',
    badge: null,
  },
  {
    title: 'Snapchat to MP3',
    description: 'Extraia o áudio de vídeos do Snapchat como arquivos MP3 de alta qualidade.',
    href: `${base}/snapchat-to-mp3`,
    icon: 'snapchat',
    badge: null,
  },
];

const faqData = [
  { q: 'O TikSaveHub é gratuito?', a: 'Sim. O TikSaveHub é 100% gratuito sem taxas ocultas. Você pode baixar vídeos ilimitados do TikTok, Instagram, Facebook e X sem pagar nada.' },
  { q: 'Preciso instalar um aplicativo?', a: 'Não. O TikSaveHub funciona inteiramente no seu navegador. Não é necessário aplicativo, extensão ou instalação de software.' },
  { q: 'Posso baixar vídeos privados?', a: 'Não. O TikSaveHub só funciona com vídeos públicos que você pode visualizar em um navegador. O conteúdo de contas privadas não pode ser acessado.' },
  { q: 'Quais dispositivos são compatíveis?', a: 'O TikSaveHub funciona em todos os dispositivos modernos — iPhone, Android, Windows PC, Mac e tablets. Qualquer navegador (Safari, Chrome, Firefox, Edge) funciona.' },
  { q: 'É legal baixar vídeos?', a: 'Baixar vídeos para uso pessoal geralmente é permitido. Sempre respeite os direitos autorais e obtenha permissão antes de republicar ou usar conteúdo comercialmente.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'TikSaveHub — Baixadores de Vídeo',
  description: 'Ferramentas gratuitas online para baixar vídeos do TikTok, Instagram, Facebook e X (Twitter) em qualidade HD.',
  numberOfItems: tools.length,
  itemListElement: tools.map((tool, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: tool.title,
      url: `https://tiksavehub.com${tool.href}`,
      description: tool.description,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'All',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
  })),
};

const features = [
  {
    title: 'Qualidade HD',
    description: 'Sempre baixe na máxima resolução disponível — até 1080p.',
    icon: 'hd',
  },
  {
    title: 'Sem Marca d\'Água',
    description: 'Downloads limpos, sem marca ou sobreposição de nenhuma plataforma.',
    icon: 'clean',
  },
  {
    title: 'Funciona em Todos os Lugares',
    description: 'Use no iPhone, Android, PC ou tablet — qualquer navegador, sem aplicativo.',
    icon: 'devices',
  },
  {
    title: '100% Grátis',
    description: 'Downloads ilimitados sem taxas ocultas, sem necessidade de cadastro.',
    icon: 'free',
  },
];
---

<Layout
  title="TikSaveHub — Baixar Vídeos do TikTok Sem Marca d'Água"
  description="Baixe vídeos do TikTok em qualidade HD sem marca d'água. Grátis, rápido e sem cadastro."
  keywords="baixar tiktok, downloader tiktok, baixar videos tiktok sem marca dagua, tiktok hd, baixar reels instagram, baixar videos facebook, downloader instagram, downloader facebook, x video downloader"
  canonical="/"
  ogImage="/og-default.png"
   jsonLd={JSON.stringify({ '@context': 'https://schema.org', '@graph': [organizationJsonLd, websiteJsonLd, itemListJsonLd, faqJsonLd] })}
  appName="TikSaveHub"
>
  <!-- Hero -->
  <section class="home-hero" aria-labelledby="home-headline">
    <div class="home-hero-gradient gradient-mesh" aria-hidden="true"></div>
    <div class="home-hero-inner container-page">
      <div class="home-badge-row">
        <span class="badge-pill home-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          Grátis · HD · Sem Marca d'Água
        </span>
      </div>

      <h1 id="home-headline" class="home-headline">
        Baixe Vídeos Do<br />
        <span class="headline-gradient">TikTok, Instagram, Facebook & X</span>
      </h1>

      <p class="home-sub text-body-lg">
        Salve vídeos em qualidade HD sem marca d'água. Grátis, rápido e funciona em qualquer dispositivo — sem aplicativo ou cadastro.
      </p>

      <h2 class="home-tools-heading">Ferramentas Populares</h2>

      <div class="home-tools-grid">
        {tools.map((tool) => (
          <a href={tool.href} class="home-tool-card" aria-label={tool.title}>
            <div class="home-tool-icon" aria-hidden="true">
              {tool.icon === 'tiktok' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
              )}
              {tool.icon === 'instagram' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              )}
              {tool.icon === 'facebook' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              )}
              {tool.icon === 'x' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
              )}
              {tool.icon === 'audio' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              )}
              {tool.icon === 'snapchat' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.37 12.87a1.5 1.5 0 0 0 .13-1.24l-1.5-3A2.5 2.5 0 0 0 13.87 6h-3.74a2.5 2.5 0 0 0-3.13 2.63l-1.5 3a1.5 1.5 0 0 0 .13 1.24c.3.52.83.83 1.15 1.03l-.33.36a7.5 7.5 0 0 0 2.6 1.3c.4.52.9 1.44 1.95.86 0-.94.37-1.35.5-2.2.14.85.5 1.26.5 2.19 1.05.6 1.56-.33 1.95-.86a7.5 7.5 0 0 0 2.6-1.3l-.33-.36c.32-.2.85-.51 1.15-1.03z"/></svg>
              )}
            </div>
            <div class="home-tool-info">
              <h2 class="home-tool-title">{tool.title}</h2>
              <p class="home-tool-desc">{tool.description}</p>
            </div>
            {tool.badge && <span class="home-tool-badge">{tool.badge}</span>}
          </a>
        ))}
      </div>

      <div class="home-trust">
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          100% Grátis
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Sem Marca d'Água
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Qualidade HD
        </span>
        <span class="trust-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Sem Cadastro
        </span>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="home-features" aria-labelledby="features-headline">
    <div class="home-features-inner container-page">
      <span class="section-eyebrow text-caption-mono">Por que TikSaveHub</span>
      <h2 id="features-headline" class="section-headline">Feito para velocidade, qualidade e simplicidade</h2>
      <div class="home-features-grid">
        {features.map((f) => (
          <div class="home-feature-card">
            <div class="home-feature-icon" aria-hidden="true">
              {f.icon === 'hd' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7v10"/><path d="M6 7v10"/><path d="M10 7v10"/><path d="M14 7v10"/><path d="M18 7v10"/><path d="M22 7v10"/></svg>
              )}
              {f.icon === 'clean' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              )}
              {f.icon === 'devices' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              )}
              {f.icon === 'free' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              )}
            </div>
            <h3 class="home-feature-title">{f.title}</h3>
            <p class="home-feature-desc">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="home-how" aria-labelledby="how-headline">
    <div class="home-how-inner container-page">
      <span class="section-eyebrow text-caption-mono">Como Funciona</span>
      <h2 id="how-headline" class="section-headline">Três passos para baixar qualquer vídeo</h2>
      <div class="home-steps">
        <div class="home-step">
          <span class="home-step-num">1</span>
          <h3 class="home-step-title">Copie o Link do Vídeo</h3>
          <p class="home-step-desc">Abra o TikTok, Instagram, Facebook ou X. Encontre o vídeo que deseja salvar e copie o link.</p>
        </div>
        <div class="home-step">
          <span class="home-step-num">2</span>
          <h3 class="home-step-title">Cole no TikSaveHub</h3>
          <p class="home-step-desc">Vá até a página da ferramenta certa e cole o link do vídeo na caixa de download.</p>
        </div>
        <div class="home-step">
          <span class="home-step-num">3</span>
          <h3 class="home-step-title">Baixe em HD</h3>
          <p class="home-step-desc">Clique em Baixar e salve o arquivo MP4 limpo e sem marca d'água no seu dispositivo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="home-faq" aria-labelledby="faq-headline">
    <div class="home-faq-inner container-page">
      <span class="section-eyebrow text-caption-mono">Perguntas Frequentes</span>
      <h2 id="faq-headline" class="section-headline">Perguntas frequentes</h2>
      <div class="home-faq-grid">
        <details class="home-faq-item">
          <summary class="home-faq-q">O TikSaveHub é gratuito?</summary>
          <p class="home-faq-a">Sim. O TikSaveHub é 100% gratuito sem taxas ocultas. Você pode baixar vídeos ilimitados do TikTok, Instagram, Facebook e X sem pagar nada.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">Preciso instalar um aplicativo?</summary>
          <p class="home-faq-a">Não. O TikSaveHub funciona inteiramente no seu navegador. Não é necessário aplicativo, extensão ou instalação de software.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">Posso baixar vídeos privados?</summary>
          <p class="home-faq-a">Não. O TikSaveHub só funciona com vídeos públicos que você pode visualizar em um navegador. O conteúdo de contas privadas não pode ser acessado.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">Quais dispositivos são compatíveis?</summary>
          <p class="home-faq-a">O TikSaveHub funciona em todos os dispositivos modernos — iPhone, Android, Windows PC, Mac e tablets. Qualquer navegador (Safari, Chrome, Firefox, Edge) funciona.</p>
        </details>
        <details class="home-faq-item">
          <summary class="home-faq-q">É legal baixar vídeos?</summary>
          <p class="home-faq-a">Baixar vídeos para uso pessoal geralmente é permitido. Sempre respeite os direitos autorais e obtenha permissão antes de republicar ou usar conteúdo comercialmente.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Blog Teaser -->
  <section class="home-blog" aria-labelledby="blog-headline">
    <div class="home-blog-inner container-page">
      <span class="section-eyebrow text-caption-mono">Do Blog</span>
      <h2 id="blog-headline" class="section-headline">Guias, dicas e tutoriais</h2>
      <div class="home-blog-grid">
        <a href={`/blog/facebook-video-downloader-guide`} class="home-blog-card">
          <span class="home-blog-tag">Guias do Facebook</span>
          <h3 class="home-blog-title">Baixar Vídeos do Facebook: Salve Vídeos do FB em HD (Guia 2026)</h3>
          <p class="home-blog-excerpt">Baixe vídeos do Facebook, Reels e clipes do Watch em HD 1080p sem marca d'água. Passo a passo para iPhone, Android e PC.</p>
        </a>
        <a href={`/blog/x-video-downloader-guide`} class="home-blog-card">
          <span class="home-blog-tag">Guias do X & Twitter</span>
          <h3 class="home-blog-title">Baixar Vídeos do X: Salve Vídeos do Twitter em HD (Guia 2026)</h3>
          <p class="home-blog-excerpt">Baixe vídeos, GIFs e áudio do X (Twitter) em HD 1080p sem marca d'água. Grátis, sem cadastro.</p>
        </a>
        <a href={`/blog/tiktok-video-downloader-without-watermark`} class="home-blog-card">
          <span class="home-blog-tag">Guias do TikTok</span>
          <h3 class="home-blog-title">Baixar Vídeos do TikTok Sem Marca d'Água (HD & Grátis)</h3>
          <p class="home-blog-excerpt">Baixe vídeos do TikTok sem marca d'água em qualidade HD. Rápido, grátis e funciona no iPhone, Android e PC.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ─── Hero ─── */
  .home-hero {
    position: relative;
    padding: var(--spacing-5xl) var(--spacing-lg) var(--spacing-4xl);
    overflow: hidden;
    text-align: center;
  }

  .home-hero-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .home-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xl);
    max-width: 900px;
    margin-inline: auto;
  }

  .home-badge-row {
    display: flex;
    justify-content: center;
  }

  .home-badge {
    background: rgba(124, 58, 237, 0.1);
    border-color: rgba(124, 58, 237, 0.25);
    color: #7c3aed;
  }

  .dark .home-badge {
    background: rgba(192, 132, 252, 0.15);
    border-color: rgba(192, 132, 252, 0.3);
    color: #c084fc;
  }

  .home-headline {
    font-size: 52px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -2.5px;
    color: var(--color-ink);
    margin: 0;
  }

  .home-sub {
    max-width: 600px;
    text-align: center;
    margin: 0;
  }

  .home-tools-heading {
    margin: 0;
    font-size: var(--text-heading-md);
    font-weight: 600;
    letter-spacing: -0.5px;
    color: var(--color-ink);
    text-align: center;
  }

  /* ─── Tools Grid ─── */
  .home-tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    width: 100%;
    max-width: 900px;
  }

  .home-tool-card {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    position: relative;
  }

  .home-tool-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(124, 58, 237, 0.15);
    border-color: rgba(124, 58, 237, 0.3);
  }

  .home-tool-icon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(0, 124, 240, 0.1));
    display: flex;
    align-items: center;
