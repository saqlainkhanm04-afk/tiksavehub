export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Mp3DownloadForm from '../../components/Mp3DownloadForm.astro';
import StatsSection from '../../components/StatsSection.astro';
import SocialShare from '../../components/SocialShare.astro';

const faqData = [
 {
  id: 'mp3-how',
  q: 'Como converter um vídeo do TikTok em MP3?',
  a: 'Copie o link do vídeo do TikTok, cole no campo de entrada nesta página e clique em Baixar. O TikSaveHub extrai a faixa de áudio do vídeo e converte para MP3. O processo inteiro leva uns dois a três segundos. Nenhum app pra instalar, nenhuma conta pra criar. Só colar e baixar.',
 },
 {
  id: 'mp3-quality',
  q: 'Qual é a qualidade do áudio que o TikSaveHub fornece?',
  a: 'O TikSaveHub extrai o áudio na maior taxa de bits disponível no vídeo original. A maioria dos vídeos do TikTok carrega áudio AAC de 128kbps, que vira um MP3 limpo. O resultado soa igual ao que você ouve no TikTok. Sem compressão extra, sem perda de qualidade durante a conversão.\n\nUma coisa importante: o TikSaveHub não melhora áudio que já foi comprimido pelo TikTok. Se o original é 128kbps, o MP3 vai ser 128kbps. Mas não vai ser pior. A conversão é sem perda. O que entra sai igual, só que em formato MP3 ao invés de AAC.',
 },
 {
  id: 'mp3-iphone',
  q: 'Consigo converter vídeos do TikTok em MP3 no iPhone?',
  a: 'Funciona em qualquer iPhone com Safari (iOS 13 ou superior). Abra o TikTok, copie o link do vídeo, volte pro Safari, cole o link no TikSaveHub e toque em Baixar. O arquivo MP3 cai no gerenciador de downloads do Safari. Puxe pra baixo pra ver, depois toque na lupa pra abrir no app Arquivos.\n\niPhones mais antigos com iOS 12 ou inferior às vezes bloqueiam downloads completamente. Se isso acontecer, trocar pro Chrome no mesmo celular costuma resolver. A ferramenta não se importa com qual navegador roda. O sistema operacional que causa o problema.',
 },
 {
  id: 'mp3-devices',
  q: 'O TikSaveHub funciona em Android e PC?',
  a: 'Qualquer dispositivo com navegador moderno. Celulares Android, PCs Windows, Macs, Linux, tablets. Não importa. O TikSaveHub é totalmente baseado em navegador, então não tem nada pra instalar.',
 },
 {
  id: 'mp3-free',
  q: 'O TikSaveHub é gratuito pra usar?',
  a: 'Completamente gratuito. Sem cadastro, sem coleta de e-mail, sem plano pago escondido. Cole um link, converta o áudio, pronto.\n\nA maioria dos "conversores gratuitos" do TikTok começa a empurrar plano pago depois de cinco ou seis conversões. O TikSaveHub não. Conversões ilimitadas, zero custo. O processamento roda do lado do servidor, então não tem extensão de navegador pra instalar nem app pra baixar.',
 },
 {
  id: 'mp3-account',
  q: 'Preciso ter conta no TikTok?',
  a: 'Não precisa de conta no TikTok. Enquanto o vídeo for público, o TikSaveHub consegue extrair o áudio. Copie o link via Compartilhar, Copiar Link, cole na ferramenta e a conversão começa. Vídeos privados ou restritos não funcionam. Mas o TikSaveHub te avisa honestamente ao invés de mostrar um erro confuso.',
 },
 {
  id: 'mp3-legal',
  q: 'É legal baixar áudio do TikTok?',
  a: 'Salvar áudio do TikTok pra uso pessoal. Ouvir offline, guardar um som favorito. Cai numa zona cinza que é amplamente tolerada. Os Termos de Serviço do TikTok tecnicamente proíbem downloads fora do app, mas essa cláusula visa bots que fazem scraping em massa, não uma pessoa salvando um clipe de áudio.\n\nUso comercial é diferente. Usar áudio do TikTok num anúncio, num vídeo do YouTube, num podcast ou qualquer conteúdo monetizado requer permissão explícita do criador original. Direitos autorais se aplicam ao áudio em si, não só ao vídeo. Dê crédito ao criador, não monetize o trabalho dele sem permissão.',
 },
 {
  id: 'mp3-speed',
  q: 'Quanto tempo a conversão demora?',
  a: 'Uns dois a três segundos numa conexão de banda larga normal. O servidor busca o vídeo do TikTok, remove a faixa de áudio e converte pra MP3 numa passada só. Em redes móveis mais lentas, pode levar uns cinco segundos. O gargalo costuma ser a transferência do arquivo, não a conversão em si.',
 },
 {
  id: 'mp3-private',
  q: 'Consigo converter vídeos privados do TikTok em MP3?',
  a: 'Não. O TikSaveHub só funciona com vídeos públicos. Conteúdo privado ou só pra amigos não é acessível pela API pública do TikTok. Nenhum conversor legítimo consegue burlar isso. É uma barreira técnica, não uma escolha de política.',
 },
 {
  id: 'mp3-format',
  q: 'Que formato de arquivo vou receber?',
  a: 'MP3. É esse o formato. Funciona em todo dispositivo, todo player de música, todo sistema operacional. A extensão do arquivo é .mp3.',
 },
 {
  id: 'mp3-limits',
  q: 'Existem limites?',
  a: 'Nenhum limite diário, nenhuma cota de conversão, nenhum teto premium. Converta quantos vídeos do TikTok precisar. Cada conversão roda na mesma janela de dois a três segundos, independente de quantas já foram feitas no dia.',
 },
 {
  id: 'mp3-why',
  q: 'Por que usar o TikSaveHub ao invés de outros conversores?',
  a: 'Olha, a maioria dos conversores de TikTok pra MP3 é frustrante de usar. O SSSTikTok esconde downloads atrás de três camadas de pop-up. O SnapTik começou a travar conversões atrás de limites diários gratuitos. O SaveFrom quer criação de conta antes de qualquer coisa funcionar. Isso não são rumores. São padrões consistentes que usuários relatam em fóruns e sites de avaliação.\n\nO TikSaveHub aborda diferente: cole um link, receba um MP3, pronto. Sem anúncios interrompendo, sem paredes de conta, sem limites diários. A conversão roda no lado do servidor (mais rápida que ferramentas baseadas em navegador) e o resultado é um MP3 limpo que toca em qualquer lugar. Não é complicado. É só honesto sobre o que um conversor deveria fazer.',
 },
];

const faqJsonLd = JSON.stringify({
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqData.map((faq) => ({
  '@type': 'Question',
  name: faq.q,
  acceptedAnswer: {
   '@type': 'Answer',
   text: faq.a.replace(/<[^>]*>/g, ''),
  },
 })),
});
