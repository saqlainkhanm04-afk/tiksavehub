  },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]*>/g, ''),
    },
  })),
});

const howToJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Como Baixar Vídeos do TikTok Sem Marca d\'Água',
  description: 'Guia passo a passo para baixar vídeos do TikTok em qualidade HD sem marca d\'água usando o TikSaveHub.',
  totalTime: 'PT2M',
  step: [
    {
      '@type': 'HowToStep',
      name: 'Copie o link do vídeo do TikTok',
      text: 'Abra o aplicativo do TikTok, encontre o vídeo que deseja salvar, toque em Compartilhar e selecione Copiar Link.',
      position: 1,
    },
    {
      '@type': 'HowToStep',
      name: 'Cole o link no TikSaveHub',
      text: 'Acesse o TikSaveHub.com e cole o link copiado do TikTok no campo de download.',
      position: 2,
    },
    {
      '@type': 'HowToStep',
      name: 'Clique em Baixar',
      text: 'Clique no botão Baixar e aguarde alguns segundos enquanto o vídeo é processado.',
      position: 3,
    },
    {
      '@type': 'HowToStep',
      name: 'Salve o vídeo em HD',
      text: 'Escolha a opção MP4 em HD (sem marca d\'água) e salve o arquivo de vídeo no seu dispositivo.',
      position: 4,
    },
  ],
  tool: {
    '@type': 'HowToTool',
    name: 'TikSaveHub',
  },
});

const combinedJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd)],
});
