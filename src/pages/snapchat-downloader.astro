<style>
  /* ─── Hero ─── */
  .dl-hero {
    position: relative;
    padding: var(--spacing-section) var(--spacing-lg) var(--spacing-5xl);
    overflow: hidden;
    background-color: var(--color-canvas);
    text-align: center;
  }

  .dl-hero-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.85;
  }

  .dl-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .dl-breadcrumb { margin-bottom: var(--spacing-sm); }

  .breadcrumb-list {
    display: flex; align-items: center; gap: 6px; list-style: none; margin: 0; padding: 0;
    font-size: var(--text-body-sm); color: var(--color-mute);
  }

  .breadcrumb-list li + li::before { content: '/'; margin-right: 6px; color: var(--color-hairline-strong); }

  .breadcrumb-list a { color: var(--color-body); text-decoration: none; transition: color 0.15s ease; }
  .breadcrumb-list a:hover { color: var(--color-ink); }

  .dl-badge-row { display: flex; justify-content: center; }
  .dl-badge { animation: fadeInUp 0.5s ease 0.1s both; }

  .badge-dot {
    display: inline-block; width: 6px; height: 6px;
    background: linear-gradient(135deg, #FFFC00, #FFC800);
    border-radius: 50%; animation: pulse-dot 2s ease-in-out infinite;
  }

  .dl-hero-headline {
    font-size: clamp(36px, 6vw, 56px); font-weight: 600; line-height: 1.05;
    letter-spacing: -2.5px; color: var(--color-ink); margin: 0; max-width: 700px;
    text-wrap: balance; animation: fadeInUp 0.5s ease 0.2s both;
  }

  .headline-gradient {
    background: linear-gradient(135deg, #FFFC00 0%, #FFC800 40%, #ca8a04 70%, #FFFC00 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }

  .dl-hero-subline {
    font-size: clamp(20px, 3vw, 28px); font-weight: 600; line-height: 1.2;
    letter-spacing: -0.5px; margin: 0; max-width: 560px; animation: fadeInUp 0.5s ease 0.25s both;
  }

  .dl-hero-sub {
    color: var(--color-body); margin: 0; max-width: 560px;
    animation: fadeInUp 0.5s ease 0.3s both;
  }

  .dl-hero-form-wrap {
    width: 100%; max-width: 760px; animation: fadeInUp 0.5s ease 0.4s both;
  }

  .dl-hero-trust {
    display: flex; align-items: center; gap: var(--spacing-sm); flex-wrap: wrap;
    justify-content: center; animation: fadeInUp 0.5s ease 0.5s both;
  }

  .dl-hero-share { animation: fadeInUp 0.5s ease 0.55s both; }

  .dl-hero-define {
    max-width: 560px; margin: 0; padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-md); background-color: var(--color-canvas);
    box-shadow: inset 0 0 0 1px #0000000a, 0px 1px 1px #00000005, 0px 4px 8px #0000000a;
    animation: fadeInUp 0.5s ease 0.25s both;
  }
  .dl-hero-define p {
    margin: 0; font-size: var(--text-body-md); color: var(--color-body);
    line-height: 1.7; letter-spacing: -0.1px;
  }

  .trust-chip {
    display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-body-sm);
    font-weight: 500; color: var(--color-body); padding: 0 var(--spacing-md); height: 36px;
    border-radius: var(--radius-full); border: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .trust-chip svg { color: #ca8a04; }

  .trust-chip:hover {
    border-color: var(--color-hairline-strong); transform: translateY(-2px);
    box-shadow: 0 4px 12px -2px rgba(255, 252, 0, 0.2);
  }

  @media (hover: hover) {
    .trust-chip:hover {
      border-color: var(--color-hairline-strong); transform: translateY(-2px);
      box-shadow: 0 4px 12px -2px rgba(255, 252, 0, 0.2);
    }
  }

  @media (max-width: 600px) {
    .dl-hero { padding: var(--spacing-3xl) var(--spacing-md) var(--spacing-3xl); }
    .dl-hero-headline { font-size: clamp(22px, 5vw, 32px); letter-spacing: -1px; }
    .trust-chip { font-size: var(--text-caption); height: 36px; padding: 0 var(--spacing-sm); }
    .breadcrumb-list { font-size: 11px; }
  }

