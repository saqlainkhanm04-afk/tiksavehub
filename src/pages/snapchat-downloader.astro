];

// FAQPage Schema (all visible FAQ questions)
const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]*>/g, ''),
    },
  })),
});

// HowTo Schema
const howToJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Download Snapchat Videos in Original Quality',
  description: 'Step-by-step guide to download Snapchat videos, Spotlight clips, and Stories in HD original quality using TikSaveHub. Free, no sign-up required, works on iPhone, Android, and desktop.',
  totalTime: 'PT2M',
  step: [
