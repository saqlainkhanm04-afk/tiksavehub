    'https://twitter.com/tiksavehub',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    url: 'https://tiksavehub.com/contact',
    availableLanguage: ['English'],
  },
});

// SoftwareApplication is emitted once, centrally, by Layout.astro (dynamic
// per-page `appName`), so it is intentionally NOT repeated in this graph.
const combinedJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    JSON.parse(faqJsonLd),
    JSON.parse(howToJsonLd),
    JSON.parse(breadcrumbJsonLd),
