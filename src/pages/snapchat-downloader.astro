const combinedJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faqData.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a.replace(/<[^>]*>/g, ''),
        },
      })),
    },
    {
      '@type': 'HowTo',
      name: 'How to Download Snapchat Videos',
      description: 'Step-by-step guide to download Snapchat videos and Spotlight clips in HD quality using TikSaveHub \u2014 free, no sign-up required.',
      totalTime: 'PT1M',
      step: [
        {
          '@type': 'HowToStep',
          name: 'Copy the Snapchat link',
          text: 'Open the Snapchat app or website, find the video or Spotlight you want to download, and copy the URL from the share button or address bar.',
          url: 'https://tiksavehub.com/snapchat-downloader#how-it-works',
        },
        {
          '@type': 'HowToStep',
          name: 'Paste the link into TikSaveHub',
          text: 'Go to TikSaveHub and paste the copied Snapchat link into the input field at the top of the page. Use the Paste button to grab it from your clipboard.',
          url: 'https://tiksavehub.com/snapchat-downloader#how-it-works',
        },
        {
          '@type': 'HowToStep',
          name: 'Download HD or SD',
          text: 'Click the Download button. Choose Download HD Video or Download SD Video to save the MP4 to your device. You can also convert to MP3 audio.',
          url: 'https://tiksavehub.com/snapchat-downloader#how-it-works',
        },
      ],
      tool: [
        { '@type': 'HowToTool', name: 'TikSaveHub' },
        { '@type': 'HowToTool', name: 'Web Browser' },
      ],
    },
  ],
});
