import Layout from '../layouts/Layout.astro';
import SnapchatDownloadForm from '../components/SnapchatDownloadForm.astro';
import StatsSection from '../components/StatsSection.astro';
import SocialShare from '../components/SocialShare.astro';

const faqData = [
  {
  id: 'sc-faq-private',
  q: 'Does this work for private Snapchat accounts?',
  a: 'No. TikSaveHub only works for public Stories and Spotlight clips. We do not support private accounts because bypassing account privacy is a violation of our terms and Snapchat\'s security.',
