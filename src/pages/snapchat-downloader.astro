    .seo-content-sidebar { position: static; display: grid; grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .seo-content-section { padding: var(--spacing-3xl) var(--spacing-md); }
    .seo-content-sidebar { grid-template-columns: 1fr; }
  }
</style>

<script>
  const dlTriggers = document.querySelectorAll<HTMLButtonElement>('.dl-faq-trigger');

  dlTriggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      const panelId = btn.getAttribute('aria-controls')!;
      const panel = document.getElementById(panelId);

      dlTriggers.forEach((otherBtn) => {
        if (otherBtn !== btn) {
          otherBtn.setAttribute('aria-expanded', 'false');
          const otherId = otherBtn.getAttribute('aria-controls')!;
          document.getElementById(otherId)?.setAttribute('hidden', '');
        }
      });

      if (isOpen) {
        btn.setAttribute('aria-expanded', 'false');
        panel?.setAttribute('hidden', '');
      } else {
        btn.setAttribute('aria-expanded', 'true');
        panel?.removeAttribute('hidden');
      }
    });
  });
</script>
