  position: 3,
  name: 'Select quality and download',
  text: 'Click the Download button. Choose Download HD Video (up to 1080p) for full quality or Download SD Video for a smaller file. The MP4 saves directly to your device. You can also extract audio as MP3.',
  url: 'https://tiksavehub.com/snapchat-downloader#how-it-works',
  },
  ],
  tool: [
  { '@type': 'HowToTool', name: 'TikSaveHub' },
  { '@type': 'HowToTool', name: 'Web Browser (Chrome, Safari, Firefox, Edge)' },
  { '@type': 'HowToTool', name: 'Internet Connection' },
  ],
  supply: [
  { '@type': 'HowToSupply', name: 'Snapchat Video URL' },
  ],
});

// BreadcrumbList Schema
const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
  { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://tiksavehub.com' },
  { '@type': 'ListItem', 'position': 2, 'name': 'Snapchat Video Downloader', 'item': 'https://tiksavehub.com/snapchat-downloader' }
