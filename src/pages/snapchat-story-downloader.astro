<script>
  document.querySelectorAll<HTMLButtonElement>('.dl-faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      const panelId = btn.getAttribute('aria-controls')!;
      const panel = document.getElementById(panelId);
      document.querySelectorAll<HTMLButtonElement>('.dl-faq-trigger').forEach((otherBtn) => {
        if (otherBtn !== btn) {
          otherBtn.setAttribute('aria-expanded', 'false');
          document.getElementById(otherBtn.getAttribute('aria-controls')!)?.setAttribute('hidden', '');
        }
      });
      if (isOpen) { btn.setAttribute('aria-expanded', 'false'); panel?.setAttribute('hidden', ''); }
      else { btn.setAttribute('aria-expanded', 'true'); panel?.removeAttribute('hidden'); }
    });
  });
</script>
