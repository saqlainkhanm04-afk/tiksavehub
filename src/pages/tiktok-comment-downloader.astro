<script>
  const tcForm = document.getElementById('tc-form') as HTMLFormElement | null;
  const tcInput = document.getElementById('tc-url') as HTMLInputElement | null;
  const tcLimit = document.getElementById('tc-limit') as HTMLSelectElement | null;
  const tcSubmit = document.getElementById('tc-submit') as HTMLButtonElement | null;
  const tcStatus = document.getElementById('tc-status') as HTMLParagraphElement | null;
  const tcResult = document.getElementById('tc-result') as HTMLDivElement | null;
  const tcResultTitle = document.getElementById('tc-result-title') as HTMLHeadingElement | null;
  const tcResultMeta = document.getElementById('tc-result-meta') as HTMLParagraphElement | null;
  const tcDownload = document.getElementById('tc-download') as HTMLAnchorElement | null;
  const tcReset = document.getElementById('tc-reset') as HTMLButtonElement | null;

  interface CommentRow {
    id: string;
    text: string;
    likes: number;
    replies: number;
    createdAt: number | null;
    username: string;
    displayName: string;
    verified: boolean;
  }

  let lastCsvUrl = '';

  function setTcStatus(message: string, tone: '' | 'error' | 'success' = ''): void {
    if (!tcStatus) return;
    tcStatus.textContent = message;
    if (tone) tcStatus.dataset.tone = tone;
    else delete tcStatus.dataset.tone;
  }

  function scrollToResult(target: HTMLElement | null): void {
    if (!target) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
  }

  function safeText(value: string): string {
    const text = value.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
    return /^\s*[=+\-]/.test(text) ? `'${text}` : text;
  }

  function csvCell(value: string | number | null | undefined): string {
    const text = safeText(String(value ?? ''));
    return `"${text.replace(/"/g, '""')}"`;
  }

  function buildCsv(rows: CommentRow[], videoUrl: string): string {
    const header = [
      'comment_id',
      'video_url',
      'username',
      'display_name',
      'comment',
      'likes',
      'replies',
      'posted_at',
      'profile_url',
    ];
    const lines = [header.map(csvCell).join(',')];
    for (const row of rows) {
      const date = row.createdAt && Number.isFinite(row.createdAt) ? new Date(row.createdAt * 1000) : null;
      const posted = date && !Number.isNaN(date.getTime()) ? date.toISOString() : '';
      const profile = row.username ? `https://www.tiktok.com/@${row.username}` : '';
      lines.push([
        csvCell(row.id),
        csvCell(videoUrl),
        csvCell(row.username ? `@${row.username}` : ''),
        csvCell(row.displayName),
        csvCell(row.text),
        csvCell(row.likes),
        csvCell(row.replies),
        csvCell(posted),
        csvCell(profile),
      ].join(','));
    }
    return `\uFEFF${lines.join('\r\n')}\r\n`;
  }

  function saveCsv(csv: string, name: string): void {
    if (lastCsvUrl) URL.revokeObjectURL(lastCsvUrl);
    lastCsvUrl = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
    if (tcDownload) {
      tcDownload.href = lastCsvUrl;
      tcDownload.setAttribute('download', name);
    }
    const anchor = document.createElement('a');
    anchor.href = lastCsvUrl;
    anchor.download = name;
    anchor.style.display = 'none';
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();
  }

  async function exportComments(): Promise<void> {
    const videoUrl = tcInput?.value.trim() || '';
    if (!videoUrl) {
      setTcStatus('Paste a public TikTok video link first.', 'error');
      tcInput?.focus();
      return;
    }

    const limit = Math.max(100, Math.min(5000, Number(tcLimit?.value) || 500));
    if (tcSubmit) tcSubmit.disabled = true;
    if (tcResult) tcResult.hidden = true;
    setTcStatus('Reading the public comment thread…');

    const rows: CommentRow[] = [];
    const seen = new Set<string>();
    const seenCursors = new Set<string>();
    let cursor = '0';
    let hasMore = true;
    let total: number | null = null;
    let videoId = '';
    let page = 0;

    try {
      while (hasMore && rows.length < limit && page < 100) {
        if (page > 0 && seenCursors.has(cursor)) break;
        seenCursors.add(cursor);

        setTcStatus(`Fetching comments… ${rows.length.toLocaleString()} collected${total ? ` of about ${total.toLocaleString()}` : ''}.`);
        const endpoint = `/api/tiktok-comments?url=${encodeURIComponent(videoUrl)}&count=50&cursor=${encodeURIComponent(cursor)}`;
        const response = await fetch(endpoint);
        const payload = await response.json().catch(() => null) as any;
        if (!response.ok || !payload?.success) {
          throw new Error(String(payload?.error || 'The comments could not be loaded. Try another public video.'));
        }

        videoId = String(payload.videoId || videoId);
        if (Number.isFinite(Number(payload.total))) total = Number(payload.total);
        const batch = Array.isArray(payload.comments) ? payload.comments as CommentRow[] : [];
        for (const comment of batch) {
          if (!comment || !comment.id || seen.has(comment.id)) continue;
          seen.add(comment.id);
          rows.push(comment);
          if (rows.length >= limit) break;
        }

        hasMore = Boolean(payload.hasMore) && batch.length > 0;
        const next = payload.nextCursor;
        if (next === null || next === undefined) break;
        cursor = String(next);
        page += 1;
        if (hasMore) await new Promise((resolve) => setTimeout(resolve, 120));
      }

      if (rows.length === 0) {
        throw new Error('No public comments were returned. Check that the video is public and comments are enabled.');
      }

      const suffix = videoId || new Date().toISOString().slice(0, 10);
      const filename = `tiktok-comments-${suffix}.csv`;
      saveCsv(buildCsv(rows, videoUrl), filename);

      if (tcResultTitle) tcResultTitle.textContent = 'Comment export ready';
      if (tcResultMeta) {
        const totalText = total ? `, about ${total.toLocaleString()} available in the thread` : '';
        tcResultMeta.textContent = `${rows.length.toLocaleString()} comments saved${totalText}. The CSV download should start automatically.`;
      }
      if (tcResult) tcResult.hidden = false;
      setTcStatus(`Exported ${rows.length.toLocaleString()} comments to CSV.`, 'success');
      scrollToResult(tcResult);
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      setTcStatus(message, 'error');
    } finally {
      if (tcSubmit) tcSubmit.disabled = false;
    }
  }

  tcForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    void exportComments();
  });

  tcReset?.addEventListener('click', () => {
    if (tcResult) tcResult.hidden = true;
    if (tcInput) {
      tcInput.value = '';
      tcInput.focus();
    }
    setTcStatus('Paste another public TikTok video link to start a new export.');
  });
</script>
