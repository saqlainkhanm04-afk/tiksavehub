---
// TikTok Thumbnail Downloader. SEO-optimized landing page for cover images.
// URL: /tiktok-thumbnail-downloader
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import '../styles/tool-pages.css';

const faqData = [
  {
    id: 'thumb-how',
    q: 'How do I download a TikTok thumbnail?',
    a: 'Copy the link of any public TikTok video and paste it into the field above. TikSaveHub reads the video metadata and shows every cover image TikTok exposes for that post. Choose the version you want and press Download. The image saves directly to your phone or computer.',
  },
  {
    id: 'thumb-hd',
    q: 'Are TikTok thumbnails available in HD?',
    a: 'TikSaveHub always saves the largest cover TikTok publishes for the video. TikTok does not store every cover at 1080p; many are 300x400 or 360x360. The tool shows the exact pixel dimensions before you download, so you can see what the source provides instead of receiving an upscaled image with fake sharpness.',
  },
  {
    id: 'thumb-types',
    q: 'What is the difference between the cover and the original cover?',
    a: 'The vertical cover is the image TikTok shows on the video player and in the feed. The original cover is the square or near-square image attached to the post metadata. Both can differ in crop, text overlay, and resolution. The downloader lists each version separately so you can choose the crop that fits your project.',
  },
  {
    id: 'thumb-private',
    q: 'Can I download a thumbnail from a private TikTok video?',
    a: 'No. Private, friends-only, and deleted videos do not expose public metadata. TikSaveHub only works when the post is public and TikTok still serves its cover. If the link is valid but the video is gone, the page will explain that instead of showing a broken image.',
  },
  {
    id: 'thumb-quality',
    q: 'Why is the thumbnail smaller than the video?',
    a: 'TikTok treats covers as preview images, not full video frames. The platform generates several compressed versions for the feed, search results, and the player. The highest available cover is usually smaller than a 1080p video frame. For a full-resolution image, you can download the video and export a frame in an editor.',
  },
  {
    id: 'thumb-legal',
    q: 'Can I use a downloaded TikTok thumbnail commercially?',
    a: 'The image still belongs to the creator or rights holder. Downloading a cover for personal reference, a private mood board, or a review is different from using it in an ad, a product page, or a monetized video. Ask the creator for permission before commercial use, and keep the original attribution intact.',
  },
  {
    id: 'thumb-devices',
    q: 'Does the TikTok thumbnail downloader work on iPhone and Android?',
    a: 'Yes. The tool runs in Safari, Chrome, Edge, Firefox, and other modern browsers. On iPhone the image lands in Files or Photos after you tap Download. On Android it goes to the Downloads folder or the gallery. No app, extension, or account is required.',
  },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]*>/g, ''),
    },
  })),
});

const howToJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to download a TikTok thumbnail',
  description: 'Save a TikTok cover image from any public video in three steps.',
  totalTime: 'PT1M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Copy the TikTok video link',
      text: 'Open the public TikTok video, tap Share, and choose Copy link.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Paste the link into TikSaveHub',
      text: 'Paste the link into the TikTok Thumbnail Downloader and press Get thumbnail.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Download the cover',
      text: 'Pick the vertical or original cover and press Download to save the image.',
    },
  ],
});

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [JSON.parse(faqJsonLd), JSON.parse(howToJsonLd)],
});
---

