</Layout>

<script>
  const thumbForm = document.getElementById('tt-thumb-form') as HTMLFormElement | null;
  const thumbInput = document.getElementById('tt-thumb-url') as HTMLInputElement | null;
  const thumbSubmit = document.getElementById('tt-thumb-submit') as HTMLButtonElement | null;
  const thumbStatus = document.getElementById('tt-thumb-status') as HTMLParagraphElement | null;
  const thumbResult = document.getElementById('tt-thumb-result') as HTMLDivElement | null;
  const thumbGrid = document.getElementById('tt-thumb-grid') as HTMLDivElement | null;
  const thumbTitle = document.getElementById('tt-thumb-title') as HTMLHeadingElement | null;
  const thumbMeta = document.getElementById('tt-thumb-meta') as HTMLParagraphElement | null;

  function setThumbStatus(message: string, tone: '' | 'error' | 'success' = ''): void {
    if (!thumbStatus) return;
    thumbStatus.textContent = message;
    if (tone) thumbStatus.dataset.tone = tone;
    else delete thumbStatus.dataset.tone;
  }

  function proxyUrl(source: string, filename?: string): string {
    const params = new URLSearchParams({ url: source });
    if (filename) {
      params.set('download', '1');
      params.set('filename', filename);
    }
    return `/api/proxy-image?${params.toString()}`;
  }

  function imageExtension(source: string): string {
    try {
      const match = new URL(source).pathname.match(/\.(jpe?g|png|webp|gif|avif)$/i);
      if (!match) return 'jpg';
      const ext = match[1].toLowerCase();
      return ext === 'jpeg' ? 'jpg' : ext;
    } catch {
      return 'jpg';
    }
  }

  function scrollToResult(target: HTMLElement | null): void {
    if (!target) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
  }

  function addThumbCard(label: string, source: string): void {
    if (!thumbGrid) return;
    const card = document.createElement('article');
    card.className = 'tp-thumb-card';

    const media = document.createElement('div');
    media.className = 'tp-thumb-media';
    const image = document.createElement('img');
    image.loading = 'lazy';
    image.alt = `${label} for this TikTok video`;
    media.appendChild(image);

    const body = document.createElement('div');
    body.className = 'tp-thumb-body';
    const copy = document.createElement('div');
    const title = document.createElement('p');
    title.className = 'tp-thumb-label';
    title.textContent = label;
    const size = document.createElement('p');
    size.className = 'tp-thumb-size';
    size.textContent = 'Loading dimensions…';
    copy.appendChild(title);
    copy.appendChild(size);

    const filename = `tiktok-thumbnail-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}.${imageExtension(source)}`;
    const download = document.createElement('a');
    download.className = 'tp-btn tp-btn--sm';
    download.href = proxyUrl(source, filename);
    download.textContent = 'Download';
    download.setAttribute('download', filename);

    const showDimensions = (): void => {
      if (image.naturalWidth && image.naturalHeight) {
        size.textContent = `${image.naturalWidth} x ${image.naturalHeight}`;
      } else {
        size.textContent = 'Preview unavailable';
      }
    };
    image.addEventListener('load', showDimensions);
    image.addEventListener('error', () => {
      size.textContent = 'Preview unavailable';
    });
    image.src = proxyUrl(source);
    if (image.complete) showDimensions();

    body.appendChild(copy);
    body.appendChild(download);
    card.appendChild(media);
    card.appendChild(body);
    thumbGrid.appendChild(card);
  }

  thumbForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const value = thumbInput?.value.trim() || '';
    if (!value) {
      setThumbStatus('Paste a public TikTok video link first.', 'error');
      thumbInput?.focus();
      return;
    }

    if (thumbSubmit) thumbSubmit.disabled = true;
    if (thumbResult) thumbResult.hidden = true;
    if (thumbGrid) thumbGrid.replaceChildren();
    setThumbStatus('Reading the public cover metadata…');

    try {
      const response = await fetch(`/api/download?url=${encodeURIComponent(value)}`);
      const payload = await response.json().catch(() => null) as any;
      if (!response.ok || !payload?.success) {
        throw new Error(String(payload?.error || 'This video could not be read. Check the link and try again.'));
      }

      const video = payload.video || {};
      const covers: Array<{ label: string; source: string }> = [];
      if (typeof video.cover === 'string' && video.cover) {
        covers.push({ label: 'Vertical cover', source: video.cover });
      }
      if (typeof video.origin_cover === 'string' && video.origin_cover && video.origin_cover !== video.cover) {
        covers.push({ label: 'Original cover', source: video.origin_cover });
      }
      if (covers.length === 0) {
        throw new Error('TikTok did not expose a cover image for this video. Try another public post.');
      }

      const author = video.author?.unique_id ? `@${video.author.unique_id}` : 'TikTok creator';
      const title = typeof video.title === 'string' && video.title.trim()
        ? video.title.trim().slice(0, 120)
        : 'TikTok video';
      if (thumbTitle) thumbTitle.textContent = title;
      if (thumbMeta) thumbMeta.textContent = `${author} · ${covers.length} cover ${covers.length === 1 ? 'version' : 'versions'} available`;

      covers.forEach((cover) => addThumbCard(cover.label, cover.source));
      if (thumbResult) thumbResult.hidden = false;
      setThumbStatus('Cover ready. Choose a version and press Download.', 'success');
      scrollToResult(thumbResult);
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      setThumbStatus(message, 'error');
    } finally {
      if (thumbSubmit) thumbSubmit.disabled = false;
    }
  });
</script>
