export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Mp3DownloadForm from '../components/Mp3DownloadForm.astro';
import StatsSection from '../components/StatsSection.astro';
import SocialShare from '../components/SocialShare.astro';

const faqData = [
  {
    id: 'mp3-free',
    q: 'Is TikSaveHub MP3 converter free to use?',
    a: 'Yes, our TikTok to MP3 converter is 100% free. There are no hidden fees, no subscriptions, and no account required. You can convert unlimited TikTok videos to MP3 audio at no cost.',
  },
  {
    id: 'mp3-quality',
    q: 'What audio quality can I expect?',
    a: 'The MP3 files are extracted at the highest available bitrate from the original TikTok video. You get clean, high-quality audio ready for music players, editing, or offline listening.',
  },
  {
    id: 'mp3-mobile',
    q: 'Does this MP3 converter work on mobile devices?',
    a: 'Yes, TikSaveHub works on iPhone, Android, tablets, and desktop. No app or software installation is required — just paste the TikTok video link and download the MP3.',
  },
  {
    id: 'mp3-legal',
    q: 'Is it legal to convert TikTok videos to MP3?',
    a: 'Converting TikTok videos to MP3 for personal offline listening is generally allowed. However, you should not distribute or use the audio commercially without permission from the original creator.',
  },
  {
    id: 'mp3-links',
    q: 'What TikTok links are supported for MP3 conversion?',
    a: 'Our MP3 converter supports all TikTok link formats, including standard video URLs, short links (vm.tiktok.com), and mobile share links (vt.tiktok.com).',
  },
  {
    id: 'mp3-video',
    q: 'Can I also download the TikTok video without watermark?',
    a: 'Yes. If you need the video file instead of audio, use our <a href="/tiktok-video-downloader-without-watermark">TikTok video downloader</a> to save a clean, watermark-free MP4 from the same link.',
  },
  {
    id: 'mp3-watermark',
    q: 'Will the extracted MP3 contain the TikTok watermark?',
    a: 'No. The TikTok watermark is a visual overlay on the video frame, so the extracted audio is completely clean — no splash sounds, no watermark, just the original sound.',
  },
  {
    id: 'mp3-private',
    q: 'Can I convert private TikTok videos to MP3?',
    a: 'We can only convert TikTok videos that you can open and share. Private or login-only TikTok videos cannot be processed, and we recommend respecting the creator\u2019s privacy settings.',
  },
  {
    id: 'mp3-iphone',
    q: 'How do I convert TikTok videos to MP3 on iPhone or iOS?',
    a: 'Copy the TikTok video link, paste it into the converter above, and tap Download MP3. The audio file is processed in seconds and saves directly to your iPhone — no app or account required.',
  },
  {
    id: 'mp3-batch',
    q: 'Can I convert multiple TikTok videos to MP3 at once?',
    a: 'TikSaveHub converts one video at a time to keep quality consistent. You can convert unlimited TikTok videos by pasting each link in turn — every conversion is free with no daily limits.',
  },
  {
    id: 'mp3-saved',
    q: 'Where do downloaded TikTok MP3 files get saved?',
    a: 'After you tap Download MP3, the audio file saves directly to your device — your Downloads folder on desktop, the Files app on iPhone, or the Downloads folder on Android. If you can’t locate it, open your browser’s download history.',
  },
  {
    id: 'mp3-whyfail',
    q: 'Why can’t I convert some TikTok videos to MP3?',
    a: 'We can only convert TikTok videos that are publicly accessible. Videos that are private, region-restricted, or removed cannot be processed — try another public link and the audio will be extracted in seconds.',
  },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]*>/g, ''),
    },
  })),
});
